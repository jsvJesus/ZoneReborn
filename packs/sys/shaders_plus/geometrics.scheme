        </ps>
        <vs>
            <file> shaders_plus/geometrics.hlsl </file>
            <entry> vs_line </entry>
            <sm> vs_6_0 </sm>
         </vs>
         <states>
            <rasterizer>
            <cullMode> NONE </cullMode>
            </rasterizer>
            <depthStencil>
                <depthEnable>TRUE </depthEnable>
                <depthWrite> TRUE </depthWrite>
            </depthStencil>
            <topology> LINE </topology>
         </states>
    </variant>
