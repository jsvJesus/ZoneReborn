<root>
    <variant>
        <name> rect </name>
        <objectCB> rect </objectCB>
        <rtv> forward </rtv>
        <root_signature> uber_variant </root_signature>
        <define>
            <name> RECT </name>
        </define>
        <ps>
            <file> shaders_plus/geometrics.hlsl </file>
            <entry> ps_main </entry>
            <sm> ps_6_0 </sm>
        </ps>
        <vs>
            <file> shaders_plus/geometrics.hlsl </file>
            <entry> vs_rect </entry>
            <sm> vs_6_0 </sm>
         </vs>
         <states>
            <rasterizer>
            <cullMode> NONE </cullMode>
            </rasterizer>
            <depthStencil>
                <depthEnable>FALSE</depthEnable>
                <depthWrite> FALSE </depthWrite>
            </depthStencil>
         </states>
    </variant>
    <variant>
        <name> rect_alpha </name>
        <objectCB> rect </objectCB>
        <rtv> forward </rtv>
        <root_signature> uber_variant </root_signature>
        <define>
            <name> RECT </name>
        </define>
        <ps>
            <file> shaders_plus/geometrics.hlsl </file>
            <entry> ps_main </entry>
            <sm> ps_6_0 </sm>
        </ps>
        <vs>
            <file> shaders_plus/geometrics.hlsl </file>
            <entry> vs_rect </entry>
            <sm> vs_6_0 </sm>
         </vs>
         <states>
            <rasterizer>
            <cullMode> NONE </cullMode>
            </rasterizer>
            <blend>
             <enable> TRUE </enable>
             <srcBlend>  SRC_ALPHA  </srcBlend>
             <destBlend>  INV_SRC_ALPHA </destBlend>
            </blend>
            <depthStencil>
                <depthEnable>FALSE</depthEnable>
                <depthWrite> FALSE </depthWrite>
            </depthStencil>
         </states>
    </variant>
    <variant>
        <name> depth_line </name>
        <objectCB> line </objectCB>
