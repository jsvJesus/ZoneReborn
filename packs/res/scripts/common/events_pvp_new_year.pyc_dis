        self._events = []
        for str_data, event_type in pvp_events:
            t_ = _toTimeStamp(str_data)
            self._events.append((t_, {'start_room': event_type}))
            for x in (60, 300, 3600):
                self._events.append((t_ - x - 5.0, {'announce_room': event_type,
                  't_': t_}))

        self.clearOld()

    def clearOld(self):
        cur_time = time.time()
        self._events = filter(lambda x: x[0] > cur_time, self._events)
        self._events.sort(key=lambda x: x[0])

    def printEvents(self):
        cur_time = time.time()
        print 'cur_time', _toStrTime(cur_time)
        for x in self._events:
            print delayToString(x[0] - cur_time), _toStrTime(x[0]), x

        print '-----'

    def getNextEventDelay(self):
        if not self._events:
            return None
        else:
            data = self._events[0]
            cur_time = time.time()
            delay = data[0] - cur_time
            return delay

    def popEvent(self):
        return self._events.pop(0)

    def getCurrent(self):
        if self._events:
            return self._events[0]


periodSystemPVP = _PeriodSystemPVP()