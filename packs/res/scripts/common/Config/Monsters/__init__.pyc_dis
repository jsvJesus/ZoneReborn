# Embedded file name: ./scripts/common/Config/Monsters/__init__.py
import BigWorld
import ResMgr
import json
import Colliders
from Localization import lc
config = None
DEBUG_LOG, DEBUG_MARK, DEBUG_NAVIGATION, DEBUG_RING, DEBUG_TRAPS = range(5)
DEFAULT_INNER_RADIUS = 10.0
DEFAULT_OUTER_RADIUS = 30.0

def parse_all():
    global config
    if config is not None:
        return
    else:
        config = {}

        def parse_json_data(type_id, json_data):
            config[type_id] = {}
            if BigWorld.component == 'client':
                config[type_id]['states'] = []
                config[type_id]['model_path'] = str(json_data['model'])
                config[type_id]['colliders'] = Colliders.get_colliders_cfg(json_data['colliders'])
                for state in json_data['states']:
                    state_data = {}
                    if 'on_entry' in state:
                        state_data['on_entry'] = eval('lambda self:' + state['on_entry'])
                    if 'on_exit' in state:
                        state_data['on_exit'] = eval('lambda self:' + state['on_exit'])
                    config[type_id]['states'].append(state_data)
                    if 'entry_action' in state:
                        state_data['entry_action'] = state['entry_action']
                    if 'persistent_action' in state:
                        state_data['persistent_action'] = state['persistent_action']

                config[type_id]['name'] = lc(json_data['name'])
            else:
                config[type_id]['states'] = []
                config[type_id]['conditions'] = []
                simple_fields = ('radius', 'health', 'velocity', 'experience', 'loot')
                for simple_field in simple_fields:
                    config[type_id][simple_field] = json_data[simple_field]

                for state in json_data['states']:
                    transitions = []
                    for transition in state['transitions']:
                        for index, to_state in enumerate(json_data['states']):
                            if transition['to_state'] == to_state['class']:
                                to_state_index = index
                                break
                        else:
                            print "State parsing error. Can't find state", transition['to_state']
                            raise RuntimeError

                        transition_data = {'to_state_index': to_state_index,
                         'condition_index': len(config[type_id]['conditions'])}
                        config[type_id]['conditions'].append(eval('lambda self:' + transition['condition']))
                        transitions.append(transition_data)

                    exec 'from AI.{0} import {0}'.format(state['class']) in globals()
                    state_data = {'class': eval(state['class']),
                     'transitions': transitions}
                    if 'velocity' in state:
                        state_data['velocity'] = state['velocity']
                    config[type_id]['states'].append(state_data)

            config[type_id]['combos'] = json_data['combos']

        doggy_json_data = json.loads(ResMgr.openSection('scripts/common/data/Monsters/Doggy.json').asBinary)
        bear_json_data = json.loads(ResMgr.openSection('scripts/common/data/Monsters/Bear.json').asBinary)
        verly_json_data = json.loads(ResMgr.openSection('scripts/common/data/Monsters/Verlioka.json').asBinary)
        parse_json_data(16, doggy_json_data)
        parse_json_data(17, bear_json_data)
        parse_json_data(18, verly_json_data)
        return


if BigWorld.component == 'client':
    parse_all()

def get_entry_action(type_id, state_id):
    return config[type_id]['states'][state_id].get('entry_action')


def get_persistent_action(type_id, state_id):
    return config[type_id]['states'][state_id].get('persistent_action')


def get_model_path(type_id):
    return config[type_id]['model_path']


def get_colliders(type_id):
    return config[type_id]['colliders']


def get_condition_by_index(type_id, condition_index):
    return config[type_id]['conditions'][condition_index]


def get_states(type_id):
    return config[type_id]['states']


def get_state_on_entry(type_id, state_id):
    return config[type_id]['states'][state_id].get('on_entry')


def get_state_on_exit(type_id, state_id):
    return config[type_id]['states'][state_id].get('on_exit')


def get_radius(type_id):
    return config[type_id]['radius']


def get_max_health(type_id):
    return config[type_id]['health']


def get_combo_wave(type_id, combo_index, wave_index):
    damage_config = config[type_id]['combos'][combo_index]['timing']
    if wave_index >= len(damage_config):
        return None
    else:
        return damage_config[wave_index]
        return None


def get_velocity(type_id, state_id):
    return config[type_id]['states'][state_id].get('velocity') or config[type_id]['velocity']


def get_name(type_id):
    return config[type_id]['name']


def get_experience(type_id):
    return config[type_id]['experience']


def get_combos(type_id):
    return config[type_id]['combos']


def get_loot(type_id):
    return config[type_id]['loot']