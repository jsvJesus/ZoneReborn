_loaded_transf_data = {}

def isValidTransfID(transform_id):
    return transform_id in TRANSFORMATIONS


def reloadFT():
    _loaded_transf_data.clear()
    for key in TRANSFORMATIONS.keys():
        ResMgr.purge(TRANSFORMATIONS[key])
        _read_data(key)


def _read_data(transform_id):
    transf = _loaded_transf_data.get(transform_id)
    if transf:
        return transf
    try:
        py_data_section = ResMgr.openSection(TRANSFORMATIONS[transform_id])
        raw_configs = json.loads(py_data_section.asBinary)
    except:
        print 'transform_id ', transform_id
        print 'TRANSFORMATIONS[transform_id] ', TRANSFORMATIONS[transform_id]
        raise

    try:
        collide_boxs_path = raw_configs.get('collide_boxs')
        if collide_boxs_path and collide_boxs_path != 'DEF':
            raw_configs['collide_boxs'] = Colliders.get_colliders_cfg(collide_boxs_path)
    except:
        traceback.print_exc()

    actions = {}
    for action in raw_configs['actions']:
        actions[action['action_name']] = action

    for action in raw_configs['random_actions']:
        action['action_name'] = 'random_actions_%s' % len(actions)
        actions[action['action_name']] = action

    if 'bored_actions' in raw_configs:
        for action in raw_configs['bored_actions']:
            action['action_name'] = 'bored_%s>' % len(actions) + action['action_name']
            actions[action['action_name']] = action

    if 'on_init_action' in raw_configs:
        actions['on_init_action'] = raw_configs['on_init_action']
    actions_keys = actions.keys()
    actions_keys.sort()
    id_to_actions = dict(zip(range(1, len(actions_keys) + 1), actions_keys))
    actions_to_id = dict(zip(actions_keys, range(1, len(actions_keys) + 1)))
    for action_id, action_name in id_to_actions.items():
        actions[action_name]['skill_id'] = action_id

    _loaded_transf_data[transform_id] = (raw_configs,
     actions,
     id_to_actions,
     actions_to_id)
    return _loaded_transf_data[transform_id]


for key in TRANSFORMATIONS.keys():
    _read_data(key)

class FunTransformation(object):

    def __init__(self, entitiy, transform_id):
        self.transform_id = transform_id
        raw_configs, actions, id_to_actions, actions_to_id = _read_data(transform_id)
        self.raw_configs = raw_configs
        self.actions = actions
        self.id_to_actions = id_to_actions
        self.actions_to_id = actions_to_id
        self.hide_in_world_marker = raw_configs.get('hide_in_world_marker', False)
        self.bored_actions_interval = 0
        self._borred_timer = 0
        self.fun_name = None
        self._is_phys_mod = False
        return

    def colliders(self):
        return self.raw_configs.get('collide_boxs')

    def getparam(self, param):
        value = self.raw_configs.get(param)
        if value != 'DEF':
            return value

    def getModelPath(self):
        return self.raw_configs.get('set_model')

    def getTints(self):
        return self.raw_configs.get('set_model_tint', {})

    def getScale(self):
        scale = self.raw_configs.get('model_scale')
        if scale and scale != 'DEF':
            return scale

    def isLockMouseScrollWeapon(self):
        return self.raw_configs.get('lock_mouse_scroll_weapon', False)

    def isHideInWorldMarker(self):
        return self.hide_in_world_marker

    def funName(self):
        return self.fun_name

    def isPhysicsMod(self):
        return self._is_phys_mod

    def hook_putMessage(self, channel_id, text, sender):
        replace = self.getparam('chat_in_replace_symbol')
        if replace and channel_id in CHAT_CHANNEL_HOOKED:
            text = self._replace_chat_text(text, replace)
        return (text, sender)

    def hook_send_message(self, channel_id, text):
        replace = self.getparam('chat_send_replace_symbol')
        if replace and channel_id in CHAT_CHANNEL_HOOKED:
            text = self._replace_chat_text(text, replace)
        return text

    def _replace_chat_text(self, text, str_symbols):
        if isinstance(text, str):
            text = text.decode('utf-8')
        if isinstance(str_symbols, str):
            str_symbols = str_symbols.decode('utf-8')
        symbols = [ s for s in str_symbols ]

        def dashrepl(matchobj):
            symbol = random.choice(symbols)
            if matchobj.group(1):
                return symbol.upper()
            return symbol.lower()

        return re.sub(u'([A-Z\u0410-\u042f])|([a-z\u0430-\u044f])|(\\w)', dashrepl, text)

    def init(self, entitiy):
        self.entitiy = entitiy
        avatar_name_lc = self.raw_configs.get('avatar_name_lc')
        if avatar_name_lc:
            self.fun_name = lc(avatar_name_lc)
        self._is_phys_mod = True
        for param in ('physics_modelWidth', 'physics_modelDepth', 'physics_modelHeight_Standing', 'physics_modelHeight_Crouched', 'physics_scrambleHeight'):
            val = self.getparam(param)
            if not isinstance(val, (float, int)):
                self._is_phys_mod = False
                break

        self.skills = {}
        for action_name, action in self.actions.items():
            skill = FunSkill(action)
            skill.attach(self.entitiy)
            self.skills[action_name] = skill

        self.entitiy.onInitTransform(self)

    def resetTransformation(self):
        self.entitiy.onResetTransform(self)
        for skill in self.skills.values():
            skill.stopTimers()

        BigWorld.cancelCallback(self._borred_timer)

    def startRandomActionLoop(self):
        for action in self.raw_configs['random_actions']:
            skill = self.getSkill(action['skill_id'])
            skill.run_forever()

        if self.actions.get('on_init_action'):
            BigWorld.callback(0.1, lambda : self.entitiy.startTransformAction('on_init_action', True))
        if 'bored_actions' in self.raw_configs:
            self.bored_actions_interval = self.raw_configs.get('bored_actions_interval_sec', None)
            self.breakBoredTimer()
        return

    def breakBoredTimer(self):
        if not self.bored_actions_interval:
            return
        BigWorld.cancelCallback(self._borred_timer)
        self._borred_timer = BigWorld.callback(self.bored_actions_interval, self._startBored)

    def _startBored(self):
        for action in self.raw_configs['bored_actions']:
            if action.get('chance', 1) > random.random():
                self.entitiy.startTransformAction(action['action_name'], True, event=None, print_errors=True)
                return

        self.breakBoredTimer()
        return

    def actionHook(self, actionName, okayToGo, event):
        if not self.entitiy or self.entitiy.isDestroyed:
            BWPersonality.settings.keyBindings.clearHook()
            post_proccess = self.getparam('post_proccess')
            if post_proccess:
                BWPersonality.GUICore.delPPEffect(post_proccess)
            BWPersonality.GUICore.transformScreenTexture(False)
            return
        else:
            transf_action = self.actions.get(actionName, None)
            if transf_action:
                self.entitiy.startTransformAction(actionName, okayToGo, event=event, print_errors=True)
                return True
            handled = False
            if self.entitiy.onActionEvent(actionName, okayToGo, event):
                return True
            for test_act in self.raw_configs['lock_aciton']:
                if actionName == test_act or test_act == 'ALL_ACTION':
                    handled = True
                    break

            for test_act in self.raw_configs['unlock_aciton']:
                if actionName == test_act or test_act == 'ALL_ACTION':
                    handled = False
                    break

            return handled

    def createSkill(self, event_id, status = None):
        action_name = self.id_to_actions[event_id]
        return self.createSkillByName(action_name)

    def createSkillByName(self, action_name):
        return FunSkill(self.actions[action_name])

    def getSkill(self, skill_id):
        action_name = self.id_to_actions[skill_id]
        return self.getSkillByName(action_name)

    def getSkillByName(self, action_name):
        return self.skills[action_name]


EV_STOP_SKILL = 0
EV_START_ANIMATION = 1
EV_APPLY_EFFECTS = 2
EV_END_ANIMATION = 3
EV_END_REUSE_TIMER = 4

class FunSkill(object):
    """docstring for FunSkill"""

    def __init__(self, param):
        self.param = param
        self.action_name = self.param['action_name']
        self.action_id = self.param['skill_id']
        self.skill_id = self.param['skill_id']
        self._t_eff = 0
        self._t_endanim = 0
        self._t_reuse = 0
        self._t_rand = 0
        self.entitiy = None
        self._start_skill_time = 0
        return

    def attach(self, entitiy):
        self.entitiy = entitiy

    def run_forever(self):
        interval = self.param.get('interval_sec', 0)
        if interval < 1.0:
            raise ValueError('small interval_sec=s for random loop' % self.action_name)
        interval = interval + interval * random.randrange(-0.1, 0.1, int=float)
        self._t_rand = BigWorld.callback(interval, self._loop)

    def _loop(self):
        if not self.entitiy or self.entitiy.isDestroyed:
            return
        else:
            interval = self.param.get('interval_sec', 0)
            interval += interval * random.randrange(-0.1, 0.1, int=float)
            self._t_rand = BigWorld.callback(interval, self._loop)
            if self.param.get('chance') > random.random():
                self.entitiy.startTransformAction(self.action_name, True, event=None, print_errors=True)
            return

    def use(self):
        self._start_skill_time = time.time()
        self._t_eff = BigWorld.callback(self.param['time_start_effect'], self.startApply)
        self._t_endanim = BigWorld.callback(self.param['time_end_animation'], self.endAnimation)
        self._t_reuse = BigWorld.callback(self.param['time_reuse_delay'], self.endReuse)
        BigWorld.callback(0, self.startAnimation)

    def stopTimers(self):
        for t in (self._t_eff,
         self._t_endanim,
         self._t_reuse,
         self._t_rand):
            if t:
                BigWorld.cancelCallback(t)

    def stopUse(self):
        self.stopTimers()
        if self.entitiy:
            self.entitiy.onStopSkill(self.action_id, self.action_name, self)

    def serverEvent(self, status):
        if status == EV_START_ANIMATION:
            self.use()
        elif status == EV_STOP_SKILL:
            self.stopUse()
        else:
            raise ValueError('\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd1\x83\xd1\x81 %s \xd0\xbd\xd0\xb5 \xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb5\xd0\xbd \xd0\xb1\xd1\x8b\xd1\x82\xd1\x8c \xd0\xbe\xd1\x82\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80' % status)

    def getStaminaUsage(self, status = EV_START_ANIMATION):
        if status == EV_START_ANIMATION:
            return self.param.get('stamina_cost', 0)
        return 0

    def getReuseTime(self):
        delta = self._start_skill_time + self.param.get('time_reuse_delay', 0) - time.time()
        if delta > 0:
            return delta
        return 0

    def getActionClass(self):
        return self.param['action_class']

    def startAnimation(self):
        if self.entitiy.isDestroyed:
            return
        self.entitiy.startTSAction(self.skill_id, self.action_name, self)

    def startApply(self):
        if self.entitiy.isDestroyed:
            return
        self.entitiy.startTSAapply(self.skill_id, self.action_name, self)

    def endAnimation(self):
        if self.entitiy.isDestroyed:
            return
        self.entitiy.endTSAnimation(self.skill_id, self.action_name, self)

    def endReuse(self):
        if self.entitiy.isDestroyed:
            return
        self.entitiy.endTSReuseTimer(self.skill_id, self.action_name, self)