class RESP_FLAGS:
    RED = 1
    GREEN = 2
    BLUE = 3
    YELLOW = 4
    _lc_ = {RED: u'red',
     GREEN: u'green',
     BLUE: u'blue',
     YELLOW: u'yellow'}
    _color_ = {RED: (255, 0, 0, 100),
     GREEN: (0, 255, 0, 100),
     BLUE: (0, 0, 255, 100),
     YELLOW: (255, 255, 0, 100)}

    @staticmethod
    def lcString(color_id):
        return RESP_FLAGS._lc_.get(color_id, '#UND')

    @staticmethod
    def color(color_id):
        return RESP_FLAGS._color_.get(color_id, (0, 0, 0, 10))