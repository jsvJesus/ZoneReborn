def get_inti_capture_time(init_date, init_time):
    """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc\xd0\xbe\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xb5 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xb2 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5 timestamp."""
    datetime_str = '{date} {time}'.format(date=init_date.strip(), time=init_time.strip())
    try:
        init_time = time.mktime(time.strptime(datetime_str, '%d.%m.%y %H:%M'))
    except ValueError:
        try:
            init_time = time.mktime(time.strptime(datetime_str, '%d.%m.%Y %H:%M'))
        except ValueError:
            print '\n\n\n\xd0\x9d\xd0\xb5\xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xb8\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82 \xd0\xb4\xd0\xb0\xd1\x82\xd1\x8b \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0: %s.\n\n\n' % datetime_str
            init_time = 0

    return init_time


def next_capture_time(inti_capture_time, cycle_time_secs):
    """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb5 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
    now = time.time()
    under_atack_time = inti_capture_time
    if under_atack_time < now:
        mult = (now - inti_capture_time) // cycle_time_secs
        under_atack_time += cycle_time_secs * mult
    while under_atack_time < now + 1:
        under_atack_time += cycle_time_secs

    return under_atack_time


def get_str_cost(cost):
    """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd1\x83 \xd1\x81 \xd1\x86\xd0\xb5\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xb2\xd0\xb0\xd0\xbb\xd1\x8e\xd1\x82\xd1\x8b."""
    if cost['gold_cost']:
        cost = cost['gold_cost']
        value_name = lc('BaseToCapture.GOLDS')
    else:
        cost = cost['rouble_cost']
        value_name = lc('BaseToCapture.RUBLES')
    str_cost = u'%s %s' % (cost, value_name)
    return str_cost


def check_money_buy(cost, base_money):
    cost_rouble, cost_gold = cost
    if cost_gold:
        if cost_gold > base_money['base_gold']:
            return False
    elif cost_rouble > base_money['base_money']:
        return False
    return True


def get_str_cost_dct(cost, base_money):
    """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x86\xd0\xb5\xd0\xbd\xd1\x83 \xd0\xb8 \xd1\x81\xd1\x87\xd0\xb5\xd1\x82 \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b  \xd1\x81 \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xb2\xd0\xb0\xd0\xbb\xd1\x8e\xd1\x82\xd1\x8b."""
    ret = {'cost': u'',
     'base_money': u'',
     'is_gold': False}
    if cost['gold_cost']:
        ret['cost'] = u'%s %s%s' % (lc('BaseToCapture.label_cost'), cost['gold_cost'], lc('BaseToCapture.GOLDS'))
        ret['base_money'] = u'%s %s%s' % (lc('BaseToCapture.label_base_money'), base_money['base_gold'], lc('BaseToCapture.GOLDS'))
        ret['is_gold'] = True
    else:
        ret['cost'] = u'%s %s%s' % (lc('BaseToCapture.label_cost'), cost['rouble_cost'], lc('BaseToCapture.RUBLES'))
        ret['base_money'] = u'%s %s%s' % (lc('BaseToCapture.label_base_money'), base_money['base_money'], lc('BaseToCapture.RUBLES'))
        ret['is_gold'] = False
    return ret


def can_create_guardian(position, spaceID):
    """\xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xb7\xd0\xb5\xd0\xbc\xd0\xbb\xd1\x8e, \xd0\xb2\xd0\xbd\xd1\x83\xd1\x82\xd1\x80\xd0\xb8 \xd0\xb3\xd0\xb5\xd0\xbe\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd0\xb8\xd0\xb8"""
    start = position + Math.Vector3(0, 0.4, 0)
    if not collide(spaceID, start, start + Math.Vector3(0, -1, 0)):
        return False
    if collide(spaceID, position, position + Math.Vector3(0, 1.8, 0)):
        return False
    return True