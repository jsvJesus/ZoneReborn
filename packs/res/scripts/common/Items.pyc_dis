    def itemTypeIsStacable(self, itemID):
        item_class = self.GetItemClass(itemID)
        if item_class in (ItemsCatalog.AMMO, ItemsCatalog.EXPLOSION, ItemsCatalog.LOOT):
            return True

    def GetMaxItemNumber(self):
        return self.MAX_ITEM_NUMBER

    def GetItemClassLC(self, item_class):
        lc_names = {self.WEAPON: 'WEAPON',
         self.CLOTH: 'CLOTH',
         self.ARTIFACT: 'ARTIFACT',
         self.GADGET: 'GADGET',
         self.BUFF: 'BUFF',
         self.PART: 'PART',
         self.AMMO: 'AMMO',
         self.EXPLOSION: 'EXPLOSION',
         self.LOOT: 'LOOT'}
        return lc_names.get(item_class, '?')

    def GetItemClass(self, typeID):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0 (\xd0\xb1\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x80\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb8\xd1\x81\xd0\xba) """
        return self.ITEM_TYPE_VALUES[bisect_left(self.ITEM_TYPE_RANGES, typeID)]

    def GetItemParam(self, ID, silence = False):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb0\xd1\x80\xd0\xb0\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80\xd1\x8b \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0 (\xd0\xb1\xd0\xb8\xd0\xbd\xd0\xb0\xd1\x80\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xb8\xd1\x81\xd0\xba) """
        if not ID:
            return None
        else:
            params_dict = self.ITEM_TYPE_PARAMS[bisect_left(self.ITEM_TYPE_RANGES, ID)]
            if not params_dict:
                print '\n!!!!!!WARNING Items.py GetItemParam unknown itemID:', ID
                traceback.print_stack()
                return None
            try:
                properties = params_dict[ID]
            except KeyError:
                if not silence:
                    print '\n!!!!!!ERROR Items.py GetItemParam: ID not in class range', ID
                    traceback.print_stack()
                return None

            base = properties.get('base')
            if base:
                base_properties = deepcopy(base)
                base_properties.update(properties)
                properties = base_properties
                del properties['base']
            return properties

    def GetItemCategory(self, typeID):
        params = self.GetItemParam(typeID)
        if not params:
            return IC.UNDEFINED
        return params.get('Category', IC.UNDEFINED)

