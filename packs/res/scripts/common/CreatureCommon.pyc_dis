# Embedded file name: ./scripts/common/CreatureCommon.py
import BigWorld
import bwdecorators
import traceback
from Config import Creatures as Cfg
from Config.Creatures import get_state_name
from Items import ItemsCatalog
if BigWorld.component == 'client':
    from sfx.SfxCatalog import SFX_HIT_CATALOG, Mat

class CreatureCommon:
    """Creature methods which are the same on cell and client."""

    @bwdecorators.callableOnGhost
    def get_config(self, param = None):
        if param is None:
            return Cfg.get_config(self.creatureType, self.level)
        else:
            return Cfg.get_config(self.creatureType, self.level)[param]
            return

    @bwdecorators.callableOnGhost
    def get_creature_state_name(self, state = None):
        if state is None:
            state = self.state
        state_dict = self.get_config(Cfg.STATES).get(state, {})
        state_name = state_dict.get('__name__', '???')
        return '%s:%s' % (state, state_name)

    @bwdecorators.callableOnGhost
    def is_impenetrable(self):
        return self.creatureType == 15

    @bwdecorators.callableOnGhost
    def get_flat_size(self):
        """ \xd0\xbf\xd0\xbb\xd0\xbe\xd1\x89\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbc\xd0\xbe\xd0\xb1\xd0\xb0 \xd1\x81\xd0\xb1\xd0\xbe\xd0\xba\xd1\x83 (\xd0\xbd\xd0\xb0\xd0\xbf\xd1\x80. \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb2\xd1\x8b\xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbf\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd0\xba\xd0\xbe\xd0\xb2) """
        config = self.get_config()
        CALC_MOBSIZE_PROJECTION = True
        if CALC_MOBSIZE_PROJECTION:
            SQRT_2_DIV_2 = 0.707
            h, w, d = config[Cfg.HEIGHT_IDLE], config[Cfg.WIDTH_IDLE], config[Cfg.DEPTH_IDLE]
            half_area = (h * w + w * d + h * d) * config[Cfg.MODEL_SCALE]
            side_projection = half_area * SQRT_2_DIV_2
            return side_projection
        else:
            volume = config[Cfg.HEIGHT_IDLE] * config[Cfg.WIDTH_IDLE] * config[Cfg.DEPTH_IDLE] * config[Cfg.MODEL_SCALE]
            return volume

    @bwdecorators.callableOnGhost
    def get_state_config(self, state = None):
        if state is None:
            return self.get_config(Cfg.STATES)[self.state]
        else:
            return self.get_config(Cfg.STATES)[state]
            return

    def get_main_effect(self):
        return self.get_config(Cfg.MAIN_EFFECT)

    def get_bleed_sfx(self, body_zone, ammo_type):
        bleed_sfx_config = self.get_config()['bleed_sfx']
        body_zone_name = Cfg.ZONE_TO_BODYNAME.get(body_zone, 'default')
        if not bleed_sfx_config.get(body_zone_name):
            bleed_sfx_material = bleed_sfx_config.get('default')
            bleed_sfx_material = Mat.get_material_id_by_name(bleed_sfx_material)
            bullet_category = ammo_type and (ItemsCatalog.GetItemParam(ammo_type).get('HitSfxCategory') or 'Default')
            return SFX_HIT_CATALOG[bullet_category].get(bleed_sfx_material) or SFX_HIT_CATALOG[bullet_category][Mat.Default]
        try:
            print "\nCreature Common: can't figure ammo type out to show needed sfx (using default values)"
            print 'body_zone:', repr(body_zone)
            print 'ammo_type:', repr(ammo_type)
            print 'bleed_sfx_material:', repr(bleed_sfx_material)
            from utils import force_utf8
            print self, force_utf8(self.name)
            traceback.print_stack()
        finally:
            return SFX_HIT_CATALOG['Bullet'][Mat.Flesh]

    @bwdecorators.callableOnGhost
    def get_escape_possibility(self):
        return get_state_name(self.creatureType, self.level, self.state) == 'escape'

    @bwdecorators.callableOnGhost
    def get_skill_config(self, skill_id):
        return self.get_config(Cfg.SKILLS)[skill_id]

    @bwdecorators.callableOnGhost
    def get_name(self):
        uniq_name = Cfg.get_uniq_mob_name(self.uniq_id)
        if uniq_name is not None:
            return uniq_name
        else:
            return self.get_config(Cfg.NAME)

    @bwdecorators.callableOnGhost
    def get_height(self):
        return self.get_config(Cfg.HEIGHT)

    @bwdecorators.callableOnGhost
    def get_height_idle_scaled(self):
        return self.get_config(Cfg.HEIGHT_IDLE) * self.get_config(Cfg.MODEL_SCALE)

    @bwdecorators.callableOnGhost
    def get_width(self):
        return self.get_config(Cfg.WIDTH)

    @bwdecorators.callableOnGhost
    def get_full_time_looting(self, open_type):
        if open_type == Cfg.TYPE_SEARCH:
            return self.get_config(Cfg.LOOTING_TIME)
        if open_type == Cfg.TYPE_BUTCH:
            return self.get_config(Cfg.BUCHERING_TIME)

    @bwdecorators.callableOnGhost
    def get_time_looting(self, open_type):
        if open_type == Cfg.TYPE_SEARCH:
            return self.get_config(Cfg.LOOTING_TIME) * (1 - self.left_looting_koef)
        if open_type == Cfg.TYPE_BUTCH:
            return self.get_config(Cfg.BUCHERING_TIME) * (1 - self.left_butch_koef)

    @bwdecorators.callableOnGhost
    def get_stiffness(self):
        return self.get_config(Cfg.STIFFNESS)

    @bwdecorators.callableOnGhost
    def is_friend_to(self, other):
        """ \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 other \xd0\xb2\xd0\xbf\xd1\x80\xd1\x8f\xd0\xb3\xd0\xb0\xd1\x82\xd1\x8c\xd1\x81\xd1\x8f \xd0\xb7\xd0\xb0 self
                (\xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd1\x81 \xd0\xbd\xd0\xb0\xd0\xbe\xd0\xb1\xd0\xbe\xd1\x80\xd0\xbe\xd1\x82: \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xba\xd1\x80\xd1\x8b\xd1\x81\xd0\xb0 \xd0\xb7\xd0\xb0\xd1\x89\xd0\xb8\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xb5\xd0\xb4\xd0\xb2\xd0\xb5\xd0\xb4\xd1\x8f, \xd1\x8d\xd1\x82\xd0\xbe \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb8\xd1\x82, \xd1\x87\xd1\x82\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xb4\xd0\xb2\xd0\xb5\xd0\xb4\xd1\x8c \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd1\x89\xd0\xb8\xd1\x89\xd0\xb0\xd1\x82\xd1\x8c \xd0\xba\xd1\x80\xd1\x8b\xd1\x81\xd1\x83)
        """
        other_assist_config = other.get_config(Cfg.ASSIST)
        if not other_assist_config:
            return True
        self_assist_config = self.get_config(Cfg.ASSIST)
        if not self_assist_config:
            return False
        return self_assist_config['clan'] in other_assist_config['friends']

    @bwdecorators.callableOnGhost
    def get_assist_radius(self):
        assist_config = self.get_config(Cfg.ASSIST)
        if not assist_config:
            return None
        else:
            return assist_config.get('radius')

    @bwdecorators.callableOnGhost
    def can_panic(self):
        """ \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd0\xbc\xd0\xbe\xd0\xb1 \xd0\xbf\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8c """
        return bool([ state for state in self.get_config(Cfg.STATES).values() if state.get('__name__') == 'escape' ])

    @bwdecorators.callableOnGhost
    def get_escape_speed(self):
        """ \xd1\x81\xd0\xba\xd0\xbe\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xb1\xd0\xb5\xd0\xb3\xd0\xb0 \xd0\xb2\xd0\xbe \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f \xd0\xbf\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb8 \xd0\xb8 \xd1\x81\xd1\x82\xd1\x80\xd0\xb0\xd1\x85\xd0\xb0 """
        return max([ state['speed']['escape'] for state in self.get_config(Cfg.STATES).values() if state.get('__name__') == 'escape' ])