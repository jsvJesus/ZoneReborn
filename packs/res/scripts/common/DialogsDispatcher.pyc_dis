empty_precondition = dict(ListOfNecessaryQuests=dict(listOfCompletedQuests=[], listOfOpenedQuests=[], listOfOnTestQuests=[]), ListOfMustNoQuests=dict(listOfCompletedQuests=[], listOfOpenedQuests=[], listOfOnTestQuests=[]), tests=[], Reputation='', KarmaPK=[])
empty_actions = dict(Exit=1, ToDialog=0, Event=0, GetQuest=[], FailQuest=[], CancelQuest=[], CompleteQuest=[], Data='', AnimationPlayer='', AnimationNPC='', GoToCamera='', CameraSmoothly=0, AvatarPoint='', PlaySound='')
empty_dialog = dict(DialogID=0, Holder='', Title=lc('Dialogs.Interface.OVER_DIALOG'), Text=u'', Nodes=[], Precondition=empty_precondition, Actions=copy.deepcopy(empty_actions))
restore_dialog = dict(DialogID=Constants.RESTORE_DIALOG_ID, Holder='undefined', Title=lc('Dialogs.Interface.RESTORE_DIALOG'), Text=u'', Nodes=[], Precondition=empty_precondition, Actions=copy.deepcopy(empty_actions))
restore_dialog['Actions']['Event'] = Dialog.EVENT_TYPE_RESTORE
Dialogs = parseDialogInf()
_dialogs_by_id = {}
for npc_dialogs in Dialogs.values():
    _dialogs_by_id.update(npc_dialogs)

_dialogs_by_id[Constants.RESTORE_DIALOG_ID] = restore_dialog
file_path_proh = 'scripts/common/data/Quests/ProhibitedQuests.json'

def load_prohibited_quests():
    global prohibited_to_fail_set
    global prohibited_to_take_set
    ResMgr.purge(file_path_proh)
    data = json.loads(ResMgr.openSection(file_path_proh).asBinary)
    prohibited_to_take_set = set(data['prohibited_to_take'])
    prohibited_to_fail_set = set(data['prohibited_to_cancel'])


if BigWorld.component != 'client':
    load_prohibited_quests()
else:
    prohibited_to_take_set, prohibited_to_fail_set = set(), set()

def is_quest_prohibited_to_take(quest_id):
    return quest_id in prohibited_to_take_set


def is_quest_prohibited_to_fail(quest_id):
    return quest_id in prohibited_to_fail_set


save_after_action = False

def perform_action(data):
    global save_after_action
    action, quest_id = data
    if action == 1:
        prohibited_to_take_set.add(quest_id)
    elif action == 2:
        if quest_id in prohibited_to_take_set:
            prohibited_to_take_set.remove(quest_id)
    elif action == 3:
        prohibited_to_fail_set.add(quest_id)
    elif action == 4:
        if quest_id in prohibited_to_fail_set:
            prohibited_to_fail_set.remove(quest_id)
    elif action == 5:
        load_prohibited_quests()
    if save_after_action:
        data = {'prohibited_to_take': list(prohibited_to_take_set),
         'prohibited_to_cancel': list(prohibited_to_fail_set)}
        with open(file_path_proh, 'w') as f:
            f.write(json.dumps(data, f))
            f.flush()
    save_after_action = False