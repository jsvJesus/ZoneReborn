    return dialog['Nodes']


merged_times = 0

def merge_rus_to_eng(callback):
    """ \xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd1\x83\xd1\x81\xd1\x81\xd0\xba\xd1\x83\xd1\x8e \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb2 \xd0\xb0\xd0\xbd\xd0\xb3\xd0\xbb\xd0\xb8\xd0\xb9\xd1\x81\xd0\xba\xd1\x83\xd1\x8e """
    global merged_times
    if merged_times > 0:
        raise RuntimeError
        return
    else:
        merged_times += 1
        rus_localization = parse_localized_data(DIALOG_TEXTFILE_RUS)
        for npc_name, dialogs in rus_localization.iteritems():
            for dialog_id, dialog_local_data in dialogs.iteritems():
                dialog = Dialogs[npc_name][dialog_id]
                if dialog['Title'] or dialog['Text']:
                    continue
                dialog['Title'] = dialog_local_data['Title']
                dialog['Text'] = dialog_local_data['Text']
                dialog_local_data['Title'] = None
                dialog_local_data['Text'] = None

        BigWorld.callback(0, callback)
        return


def getNPCDialogs(npc_name):
    """ \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd1\x80\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe ncp """
    dialogs_npc = Dialogs.get(npc_name, {})
    if dialogs_npc:
        return dialogs_npc.values()
    return []


def hasDialogsForMe(me_name):
    return bool(Dialogs.get(me_name))


def get_repairs_class(dialog):
    """ \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd1\x87\xd0\xb8\xd0\xbd\xd0\xb8\xd1\x82 \xd1\x87\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x89\xd0\xb8\xd0\xba """
    data = int(dialog['Actions']['Data'])
    if not data:
        return None
    elif data == Dialog.REPAIROPT_WEAPON:
        return ItemsCatalog.WEAPON
    elif data == Dialog.REPAIROPT_CLOTHER:
        return ItemsCatalog.CLOTH
    elif data == Dialog.REPAIROPT_GADGET:
        return ItemsCatalog.GADGET
    else:
        print 'DialogDispatcher (ERROR): bad repair class', data
        return None


def check_necessary_listOfCompletedQuests(dialog, quest_ids):
    quests_list = dialog['Precondition']['ListOfNecessaryQuests']['listOfCompletedQuests']
    if not quests_list:
        return True
    return quests_list['predicate']((quest_id in quest_ids for quest_id in quests_list['ids']))


