def reload_dialogs():
    """ \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd0\xb3\xd1\x80\xd1\x83\xd0\xb7\xd0\xba\xd0\xb0 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xbe\xd0\xb2
            \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5
    """
    global Dialogs
    ResMgr.purge(DIALOG_DATAFILE)
    ResMgr.purge(DIALOG_TEXTFILE_RUS)
    ResMgr.purge(DIALOG_TEXTFILE_ENG)
    Dialogs = parseDialogInf()
    print 'DialogsDispatcher: all the dialogs are reloaded!'


def parse_localized_data(file_path):
    localizedData = {}
    resXML = ResMgr.openSection(file_path)
    for item in resXML.values():
        name = item['Name'].asString
        dialogs = item.items()
        dialogs = filter(lambda x: x[0] == 'Dialog', dialogs)
        npcNode = {}
        for dialogTuple in dialogs:
            dialog = dialogTuple[1]
            dialogNode = {}
            id = dialog['ID'].asInt
            if BigWorld.component == 'client':
                dialogNode['Title'] = get_widestring(dialog, 'Title')
                dialogNode['Text'] = get_widestring(dialog, 'Text')
            npcNode[id] = dialogNode

        localizedData[name] = npcNode

    return localizedData


def parseDialogInf():
    result = {}

    def parseReputation(input_str):
        ret = {}
        if input_str:
            fractions = input_str.split(';')
            for f in fractions:
                fractionID, min_val, max_val = f.split(':')
                if min_val == '-Infinity':
                    min_val = -2147483647
                if max_val == 'Infinity':
                    max_val = 2147483647
                ret[int(fractionID)] = [int(min_val), int(max_val)]

        return ret

    if BigWorld.component == 'client':
        if Localization.Localization.globalLanguage == 'russian':
            filePath = DIALOG_TEXTFILE_RUS
        else:
            filePath = DIALOG_TEXTFILE_ENG
        localizedData = parse_localized_data(filePath)
    resXML = ResMgr.openSection(DIALOG_DATAFILE)
    for item in resXML.values():
        name = item['Name'].asString
        dialogs = item.items()
        dialogs = filter(lambda x: x[0] == 'Dialog', dialogs)
        npcNode = {}
        for dialogTuple in dialogs:
            dialog = dialogTuple[1]
            id = dialog['ID'].asInt
            dialogNode = {}
            dialogNode['DialogID'] = id
            dialogNode['Holder'] = name
            dialogNode['RootDialog'] = get_string(dialog, 'RootDialog')
            dialogNode['Nodes'] = get_int_array(dialog, 'Nodes')
            if BigWorld.component == 'client':
                localized = localizedData[name].get(id)
                if localized:
                    dialogNode['Title'] = localized['Title']
                    dialogNode['Text'] = localized['Text']
                else:
                    dialogNode['Title'] = None
                    dialogNode['Text'] = None
            if not dialog['Precondition']:
                precondition = {'ListOfNecessaryQuests': {},
                 'ListOfMustNoQuests': {}}
                preconditionNode = {}
                if precondition.has_key('clanOptions'):
                    options_string = precondition['clanOptions'].asString
                    if options_string and options_string[0] in ('|', '&'):
                        options_string = options_string[1:]
                    clan_options = [ int(value) for value in options_string.split(',') if value ]
                    preconditionNode['ClanOptions'] = clan_options
                if precondition.has_key('forDev') and precondition['forDev'].asInt:
                    preconditionNode['for_devs'] = True
                if precondition.has_key('NecessaryEffects'):
                    effects = []
                    necessaryEffects = precondition['NecessaryEffects']
                    for effect in necessaryEffects.values():
                        effect_id = effect['id'].asInt
                        stack = effect['stack'].asString.split(':')
                        stack[0] = int(stack[0]) if stack[0].isdigit() else None
                        stack[1] = int(stack[1]) if stack[1].isdigit() else None
                        effects.append({'id': effect_id,
                         'stack': stack})

                    preconditionNode['NecessaryEffects'] = effects
                if precondition.has_key('MustNoEffects'):
                    effects = []
                    mustnoEffects = precondition['MustNoEffects']
                    for effect in mustnoEffects.values():
                        effect_id = effect['id'].asInt
                        stack = effect['stack'].asString.split(':')
                        stack[0] = int(stack[0]) if stack[0].isdigit() else None
                        stack[1] = int(stack[1]) if stack[1].isdigit() else None
                        effects.append({'id': effect_id,
                         'stack': stack})

                    preconditionNode['MustNoEffects'] = effects
                preconditionNode['Reputation'] = parseReputation(get_string(precondition, 'Reputation'))
                if precondition.has_key('Skills'):
                    skills = {}
                    necessarySkills = precondition['Skills']
                    for skill in necessarySkills.values():
                        skill_name = skill['id'].asString
                        values = skill['value'].asString.split(':')
                        values[0] = int(values[0]) if values[0].isdigit() else None
                        values[1] = int(values[1]) if values[1].isdigit() else None
                        skills[skill_name] = values

                    preconditionNode['Skills'] = skills

                def parseSrkilllvl(skill_name):
                    skills = precondition[skill_name].asString.split(':')
                    if len(skills) == 1:
                        skills.append(None)
                    result = []
                    for skill in skills:
                        if skill:
                            result.append(int(skill))
                        else:
                            result.append(None)

                    return result

                if precondition.has_key('PlayerLevel'):
                    preconditionNode['PlayerLevel'] = parseSrkilllvl('PlayerLevel')
                if precondition.has_key('playerCombatLvl'):
                    preconditionNode['playerCombatLvl'] = parseSrkilllvl('playerCombatLvl')
                if precondition.has_key('playerSurvLvl'):
                    preconditionNode['playerSurvLvl'] = parseSrkilllvl('playerSurvLvl')
                if precondition.has_key('playerOtherLvl'):
                    preconditionNode['playerOtherLvl'] = parseSrkilllvl('playerOtherLvl')
                if dialog.has_key('CheckNodes'):
                    preconditionNode['check_nodes'] = get_int_array(dialog, 'CheckNodes')
                preconditionNode['KarmaPK'] = get_int_array(precondition, 'KarmaPK')
                if not precondition['ListOfNecessaryQuests']:
                    necessaryQuests = {}
                    listOfOnTestQuests = get_boolean_int_array(necessaryQuests, 'listOfOnTestQuests')
                    listOfCompletedQuests = get_boolean_int_array(necessaryQuests, 'listOfCompletedQuests')
                    listOfOpenedQuests = get_boolean_int_array(necessaryQuests, 'listOfOpenedQuests')
                    listOfFailedQuests = get_boolean_int_array(necessaryQuests, 'listOfFailQuests')
                    if necessaryQuests.has_key('listOfMassQuests'):
                        listOfMassQuests = [ int(value) for value in necessaryQuests['listOfMassQuests'].asString.split(',') if value ]
                        preconditionNode['MassQuest'] = listOfMassQuests[0]
                    preconditionNode['ListOfNecessaryQuests'] = {'listOfOnTestQuests': listOfOnTestQuests,
                     'listOfCompletedQuests': listOfCompletedQuests,
                     'listOfOpenedQuests': listOfOpenedQuests,
                     'listOfFailedQuests': listOfFailedQuests}
                    listOfOmniCounters = get_int_array(necessaryQuests, 'listOfOmniCounters')
                    if listOfOmniCounters:
                        preconditionNode['ListOfNecessaryQuests']['listOfOmniCounters'] = listOfOmniCounters
                    listOfRepeat = get_int_array(necessaryQuests, 'listOfRepeat')
                    if listOfRepeat:
                        preconditionNode['ListOfNecessaryQuests']['listOfRepeat'] = listOfRepeat
                    if not precondition['ListOfMustNoQuests']:
                        mustnoQuests = {}
                        listOfOnTestQuests = get_boolean_int_array(mustnoQuests, 'listOfOnTestQuests')
                        listOfCompletedQuests = get_boolean_int_array(mustnoQuests, 'listOfCompletedQuests')
                        listOfOpenedQuests = get_boolean_int_array(mustnoQuests, 'listOfOpenedQuests')
                        listOfFailedQuests = get_boolean_int_array(mustnoQuests, 'listOfFailQuests')
                        if mustnoQuests.has_key('listOfMassQuests'):
                            listOfMassQuests = [ int(value) for value in mustnoQuests['listOfMassQuests'].asString.split(',') if value ]
                            preconditionNode['NotMassQuest'] = listOfMassQuests[0]
                        preconditionNode['ListOfMustNoQuests'] = {'listOfOnTestQuests': listOfOnTestQuests,
                         'listOfCompletedQuests': listOfCompletedQuests,
                         'listOfOpenedQuests': listOfOpenedQuests,
                         'listOfFailedQuests': listOfFailedQuests}
                        listOfOmniCounters = get_int_array(mustnoQuests, 'listOfOmniCounters')
                        if listOfOmniCounters:
                            preconditionNode['ListOfMustNoQuests']['listOfOmniCounters'] = listOfOmniCounters
                        listOfRepeat = get_int_array(mustnoQuests, 'listOfRepeat')
                        if listOfRepeat:
                            preconditionNode['ListOfMustNoQuests']['listOfRepeat'] = listOfRepeat
                        dialogNode['Precondition'] = preconditionNode
                        actions = dialog['Actions']
                        actionsNode = {}
                        actionsNode['Event'] = get_int(actions, 'Event')
                        actionsNode['Data'] = get_string(actions, 'Data')
                        actionsNode['ToDialog'] = get_int(actions, 'ToDialog')
                        actionsNode['Exit'] = get_int(actions, 'Exit')
                        actionsNode['GetQuest'] = get_int_array(actions, 'GetQuest')
                        actionsNode['CompleteQuest'] = get_int_array(actions, 'CompleteQuest')
                        actionsNode['CancelQuest'] = get_int_array(actions, 'CancelQuest')
                        actionsNode['FailQuest'] = get_int_array(actions, 'FailQuest')
                        actionsNode['GoToCamera'] = get_string(actions, 'GoToCamera')
                        actionsNode['CameraSmoothly'] = get_int(actions, 'CameraSmoothly')
                        actionsNode['AvatarPoint'] = get_string(actions, 'AvatarPoint')
                        actionsNode['AnimationNPC'] = get_string(actions, 'AnimationNPC')
                        actionsNode['ItemNPC'] = get_string(actions, 'ItemNPC')
                        actionsNode['AnimationPlayer'] = get_string(actions, 'AnimationPlayer')
                        actionsNode['PlaySound'] = get_string(actions, 'PlaySound')
                        dialogNode['Actions'] = actionsNode
                        if dialog.has_key('DebugData'):
                            dialogNode['DebugData'] = dialog['DebugData'].asString
                        dialogNode['is_controller'] = dialog.has_key('isAutoNode') and bool(dialog['isAutoNode'].asInt)
                        dialogNode['default_node'] = dialog.has_key('defaultNode') and dialog['defaultNode'].asInt
                dialogNode['Exit'] = not dialogNode['Nodes'] and not dialogNode['Actions']['ToDialog'] and 1
            npcNode[id] = dialogNode

        result[name] = npcNode

    return result


def getDialogs(dialog_ids):
    return [ _dialogs_by_id[d_id] for d_id in dialog_ids if d_id in _dialogs_by_id ]


def get_replicas(npc_name):
    """ \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd1\x80\xd0\xb5\xd0\xbf\xd0\xbb\xd0\xb8\xd0\xba \xd0\xba\xd0\xbe\xd0\xbd\xd0\xba\xd1\x80\xd0\xb5\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd1\x81\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0 """
    dialogs = Dialogs.get(npc_name, {})
    return [ dialog['Title'] for dialog in dialogs.values() ]


def getDialog(npc_name, dialog_id):
    dialogs = getDialogs([dialog_id])
    if dialogs:
        return dialogs[0]


def get_root_dialog(npc_name):
    """ \xd0\xbd\xd0\xb0\xd0\xb9\xd1\x82\xd0\xb8 \xd0\xba\xd0\xbe\xd1\x80\xd0\xbd\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3 \xd0\xbe\xd1\x82 npc """
    dialogs_npc = Dialogs.get(npc_name)
    if not dialogs_npc:
        return None
    else:
        for dialog in dialogs_npc.values():
            if dialog['RootDialog']:
                return dialog

        return None


def get_dialog_by_id(dialog_id):
    """ \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3 \xd0\xbf\xd0\xbe \xd0\xb5\xd0\xb3\xd0\xbe \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd1\x83 """
    return _dialogs_by_id.get(dialog_id)


def check_reputation(dialog, reputation):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xbe\xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82\xd1\x81\xd0\xb2\xd0\xb8\xd1\x8f \xd1\x80\xd0\xb5\xd0\xbf\xd1\x83\xd1\x82\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd1\x83
            reputation - \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c (id \xd0\xb3\xd1\x80\xd1\x83\xd0\xbf\xd0\xbf\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xba\xd0\xb8 : (min, max))
    """
    dialog_reputation = dialog['Precondition']['Reputation']
    if not dialog_reputation:
        return True
    for fraction_id, (min_val, max_val) in dialog_reputation.items():
        rep = reputation.get(fraction_id, 0)
        if rep < min_val or rep > max_val:
            return False

    return True


def need_check_karma(dialog):
    return bool(dialog['Precondition']['KarmaPK'])


def need_check_reputation(dialog):
    return bool(dialog['Precondition']['Reputation'])


def need_check_effects(dialog):
    return bool(getNecessaryEffects(dialog) or getMustNoEffects(dialog))


_skills_check_keys = ('PlayerLevel', 'Skills', 'playerCombatLvl', 'playerSurvLvl', 'playerOtherLvl')

def need_check_skills(dialog):
    for key in _skills_check_keys:
        if key in dialog['Precondition']:
            return True

    return False


def check_karma(dialog, karma):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xba\xd0\xb0\xd1\x80\xd0\xbc\xd1\x8b \xd0\xb2 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb5
            \xd1\x87\xd1\x82\xd0\xbe \xd1\x82\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb5 "\xd1\x82\xd0\xb8\xd0\xbf \xd0\xba\xd0\xb0\xd1\x80\xd0\xbc\xd1\x8b" \xd0\xb8 \xd0\xb7\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbc \xd0\xbe\xd0\xbd \xd0\xbd\xd1\x83\xd0\xb6\xd0\xb5\xd0\xbd, \xd0\xbd\xd0\xb5 \xd0\xb8\xd0\xb7\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbd\xd0\xbe, \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x81\xd0\xbe\xd0\xb2\xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8
    """
    dialog_karma = dialog['Precondition']['KarmaPK']
    if not dialog_karma:
        return True
    karma_type, karma_a, karma_b = dialog_karma[0], dialog_karma[1], dialog_karma[2]
    if karma_type == 0 or karma_type == 1:
        if karma < karma_b:
            return False
    if karma_type == 0 or karma_type == 2:
        if karma > karma_a:
            return False
    return True


def check_skills(dialog, player_level, exp_levels, all_skills):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd0\xba\xd0\xb8\xd0\xbb\xd0\xbe\xd0\xb2 """

    def get_skill_value(skill_name):
        if skill_name in combat_skills.keys():
            return combat_skills[skill_name]['SkillValue']
        if skill_name in survival_skills.keys():
            return survival_skills[skill_name]['SkillValue']
        if skill_name in other_skills.keys():
            return other_skills[skill_name]['SkillValue']

    combat_skills = all_skills['CombatSkills']
    survival_skills = all_skills['SurvivalSkills']
    other_skills = all_skills['OtherSkills']
    skills = get_skills(dialog)
    for key, value in skills.items():
        skill_value = get_skill_value(key)
        if value[0] == None:
            result = skill_value <= value[1]
        elif value[1] == None:
            result = skill_value >= value[0]
        else:
            result = value[0] <= skill_value <= value[1]
        if not result:
            return False

    def check_skill(skill_name, skill_level):
        skill = dialog['Precondition'].get(skill_name)
        if not skill:
            return True
        min_val, max_val = skill[0], skill[1]
        if min_val == None and max_val == None:
            return True
        elif min_val == None:
            return skill_level <= max_val
        elif max_val == None:
            return skill_level >= min_val
        else:
            return min_val <= skill_level <= max_val

    return check_skill('PlayerLevel', player_level) and check_skill('playerCombatLvl', exp_levels[0]) and check_skill('playerSurvLvl', exp_levels[1]) and check_skill('playerOtherLvl', exp_levels[2])


def check_clan_options(dialog, player_clan_id, npc_clan_id, base_name, enemies, amount):
    """  \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 \xd0\xbe\xd0\xbf\xd1\x86\xd0\xb8\xd0\xb9
            \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 None \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbe\xd1\x88\xd0\xb8\xd0\xb1\xd0\xba\xd0\xb0
    """
    clan_options = dialog['Precondition'].get('ClanOptions')
    if not clan_options:
        return True
    if Dialog.CLANOPT_SINGLE in clan_options:
        if player_clan_id:
            return False
    if Dialog.CLANOPT_MEMBER in clan_options:
        if player_clan_id != npc_clan_id:
            return False
    if Dialog.CLANOPT_ANYCLAN in clan_options:
        if player_clan_id == 0:
            return False
    if Dialog.CLANOPT_NOTMEMBER in clan_options:
        if player_clan_id == npc_clan_id:
            return False
    if Dialog.CLANOPT_PEACE in clan_options:
        try:
            base_state = GData.get_base_to_capture_data(base_name)['base_state']
            if base_state != base_constants.PEACEFUL_STATE:
                return False
        except:
            traceback.print_stack()
            return None

    if Dialog.CLANOPT_CAPTURE in clan_options:
        try:
            base_state = GData.get_base_to_capture_data(base_name)['base_state']
            if base_state != base_constants.UNDERATACK_STATE:
                return False
        except:
            traceback.print_stack()
            return None

    if Dialog.CLANOPT_ENEMY in clan_options:
        if player_clan_id not in enemies:
            return False
    if Dialog.CLANOPT_NOTENEMY in clan_options:
        if player_clan_id in enemies:
            return False
    if Dialog.CLANOPT_GUARDED in clan_options and not amount:
        return False
    elif Dialog.CLANOPT_NOTGUARDED in clan_options and amount:
        return False
    else:
        return True


def check_effects(dialog, effects):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x8d\xd1\x84\xd1\x84\xd0\xb5\xd0\xba\xd1\x82\xd0\xbe\xd0\xb2 """

    def hasEffect(effect):
        for ef in effects:
            if ef['id'] == effect['id']:
                if not effect['stack'][0] and not effect['stack'][1]:
                    return True
                cur_stack = ef['stack']
                if not effect['stack'][0]:
                    return cur_stack <= effect['stack'][1]
                if not effect['stack'][1]:
                    return cur_stack >= effect['stack'][0]
                return effect['stack'][0] <= cur_stack <= effect['stack'][1]

        return False

    necessary_effects = getNecessaryEffects(dialog)
    for effect in necessary_effects:
        if not hasEffect(effect):
            return False

    mustno_effects = getMustNoEffects(dialog)
    for effect in mustno_effects:
        if hasEffect(effect):
            return False

    return True


def check_quests(dialog, closed_ids, opened_ids, ontest_ids, failed_ids):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
    if not check_necessary_listOfCompletedQuests(dialog, closed_ids):
        return False
    if not check_necessary_listOfOpenedQuests(dialog, opened_ids):
        return False
    if not check_necessary_listOfOnTestQuests(dialog, ontest_ids):
        return False
    if not check_necessary_listOfFailedQuests(dialog, failed_ids):
        return False
    if not check_mustno_listOfCompletedQuests(dialog, closed_ids):
        return False
    if not check_mustno_listOfOpenedQuests(dialog, opened_ids):
        return False
    if not check_mustno_listOfOnTestQuests(dialog, ontest_ids):
        return False
    if not check_mustno_listOfFailedQuests(dialog, failed_ids):
        return False
    return True


def get_subdialog_ids(dialog):
