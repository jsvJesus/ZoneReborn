def convert(item):
    data = dictConvert.get(item['complexItemType'], None)
    if not data:
        return
    else:
        newItemType, newTint = data
        item['complexItemType'] = newItemType
        param = ItemsUtils.GetComplexItemInconstanParams(item)
        param[ItemsCatalog.INC_WEAPON_TINTID] = newTint
        param[ItemsCatalog.INC_PERSONAL_ITEM] = 0
        ItemsUtils.SetComplexItemInconstanParams(item, param)
        return