class ShopProcedureResult:
    OK, ERROR, ERROR_PENDING, ERROR_CACHE, ERROR_CATALOG_INDEX, ERROR_SELLERNAME, ERROR_PRICE, ERROR_STATUS, ERROR_ITEMNOTFOUND, ERROR_SELLERNOTFOUND, ERROR_ITEMREMOVE0, ERROR_ITEMREMOVE1, ERROR_ITEMREMOVE2, ERROR_ITEMREMOVE3, ERROR_ITEMREMOVE4, ERROR_ITEMREMOVE5, ERROR_TIMEOUT, ERROR_PENDING_SELLER, ERROR_SELLER_IS_BUYER = range(19)

    @staticmethod
    def to_message(error_code):
        if error_code == ShopProcedureResult.ERROR_PENDING_SELLER:
            return 'Seller is busy. Try later.'
        if error_code == ShopProcedureResult.ERROR_CACHE:
            return 'Item not found.'
        return 'Shop procedure error. Error code: ' + str(error_code)


