class LogMethods(object):

    def __init__(self, method_names = None, logger = None, print_args = False, print_private = False, print_special = False, print_traceback = False):
        if method_names is None:
            self.method_names = {}
        elif isinstance(method_names, (list, tuple)):
            self.method_names = dict.fromkeys(method_names, None)
        elif isinstance(method_names, dict):
            self.method_names = method_names
        else:
            raise AttributeError('first argument must be list, tuple, dictionary or None')
        self.cls = None
        self.logger = self.check_or_create_logger(logger)
        self.print_args = print_args
        self.print_private = print_private
        self.print_special = print_special
        self.print_stack = print_traceback
        return

    def check_or_create_logger(self, logger):
        if logger is not None and not isinstance(logger, logging.Logger):
            raise AttributeError("'logger' must be instance of logging.Logger")
        logger = self._create_logger() if logger is None else logger
        return logger

    def logging_method(self, method, msg):
        """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb2\xd1\x8b\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xb0."""

        @functools.wraps(method)
        def wrapper(*args, **kws):
            result = method(*args, **kws)
            if self.print_args:
                message = '{0} *** Arguments: {1} {2}'.format(msg, args, kws)
            else:
                message = msg
            self.logger.info(message)
            if self.print_stack:
                traceback.print_stack()
            return result

        return wrapper

    def decorate_methods(self):

        def predicat(obj_attr):
            if not inspect.ismethod(obj_attr) and not inspect.isfunction(obj_attr):
                return False
            if not self.print_special and obj_attr.__name__.endswith('__') and obj_attr.__name__.startswith('__'):
                return False
            if not self.print_private and obj_attr.__name__.startswith('_'):
                return False
            if self.method_names and obj_attr.__name__ not in self.method_names:
                return False
            return True

        for method_name, obj in inspect.getmembers(self.cls, predicate=predicat):
            comment = self._create_comment(method_name, obj)
            setattr(self.cls, method_name, self.logging_method(obj, comment))

    def _create_comment(self, method_name, method):
        log_source = '{0}::{1}'.format(self.cls.__name__, method_name)
        if self.method_names and self.method_names[method_name] is not None:
            user_comment = self.method_names[method_name]
            comment = '{0} *** {1}'.format(log_source, user_comment)
        else:
            comment = log_source
        return comment

    def _create_logger(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb4\xd0\xb5\xd0\xb1\xd0\xb0\xd0\xb3\xd0\xb0 \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb5\xd1\x80."""
        logger = logging.getLogger('debug')
        if logger.handlers:
            return logger
        logger.setLevel(logging.DEBUG)
        formatter = logging.Formatter('%(asctime)-20s %(levelname)-10s %(message)s')
        crit_hand = logging.StreamHandler(sys.stderr)
        crit_hand.setLevel(logging.DEBUG)
        crit_hand.setFormatter(formatter)
        logger.addHandler(crit_hand)
        return logger

    def __call__(self, cls):
        self.cls = cls
        self.decorate_methods()
        return cls


def log_methods(method_names_or_class = None, logger = None):
    """\xd0\x94\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xba\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81\xd0\xb0, \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb8\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xb2.
    
