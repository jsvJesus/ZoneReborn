def encode_data(data):
    """\xd0\x9a\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd1\x8e\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb4\xd0\xb0 \xd0\xb2 utf-8 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xb2 json \xd0\xbe\xd0\xb1\xd1\x8a\xd0\xb5\xd0\xba\xd1\x82\xd0\xb5.
    
    \xd0\x98\xd0\xa1\xd0\x9f\xd0\x9e\xd0\x9b\xd0\xac\xd0\x97\xd0\x9e\xd0\x92\xd0\x90\xd0\xa2\xd0\xac \xd0\xa2\xd0\x9e\xd0\x9b\xd0\xac\xd0\x9a\xd0\x9e \xd0\x95\xd0\xa1\xd0\x9b\xd0\x98 \xd0\x9e\xd0\xa1\xd0\x9d\xd0\x9e\xd0\x92\xd0\x9d\xd0\x9e\xd0\x99 \xd0\x9e\xd0\x91\xd0\xaa\xd0\x95\xd0\x9a\xd0\xa2 - \xd0\xad\xd0\xa2\xd0\x9e \xd0\xa1\xd0\x9b\xd0\x9e\xd0\x92\xd0\x90\xd0\xa0\xd0\xac (\xd1\x81\xd0\xbe \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbe\xd0\xbc \xd0\xbd\xd0\xb5 \xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82).
    \xd0\x9f\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd1\x87\xd0\xb8 \xd0\xb2 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8e json.loads \xd0\xb2 \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 object_hook.
    \xd0\x91\xd0\xb5\xd0\xb7 \xd0\xbd\xd0\xb5\xd1\x91 \xd0\xb2\xd1\x81\xd0\xb5 \xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xba\xd0\xb8 \xd0\xb1\xd1\x83\xd0\xb4\xd1\x83\xd1\x82 \xd0\xb2 \xd1\x8e\xd0\xbd\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb4\xd0\xb5.
    """

    def _encode_dict(data):
        result = {}
        for key, value in data.items():
            if isinstance(key, unicode):
                key = key.encode('utf-8')
            if isinstance(value, unicode):
                value = value.encode('utf-8')
            elif isinstance(value, list):
                value = _encode_list(value)
            elif isinstance(value, dict):
                value = _encode_dict(value)
            result[key] = value

        return result

    def _encode_list(data):
        result = []
        for item in data:
            if isinstance(item, unicode):
                item = item.encode('utf-8')
            elif isinstance(item, list):
                item = _encode_list(item)
            elif isinstance(item, dict):
                item = _encode_dict(item)
            result.append(item)

        return result

    result = _encode_dict(data)
    return result


def hierarchy_get(fromDict, keys, default = None, use_default = True):
    """
            Works as dict.get, but for hierarchy of dicts/lists and list of keys, respectively.
            If use_default = = False then errors will thow instead of returning default
    """
    try:
        if len(keys) == 0:
            return fromDict
    except TypeError:
        if use_default:
            return default
        raise

    try:
        current = fromDict
        for i in xrange(len(keys)):
            current = current[keys[i]]

        return current
    except TypeError as AttributeError:
        if use_default:
            return default
        raise
    except KeyError:
        if use_default:
            return default
        raise


def hierarchy_set(obj, keys, value, create_dicts = False):
    tmp_obj = obj
    for key in keys[:-1]:
        try:
            tmp_obj = tmp_obj[key]
        except KeyError as IndexError:
            if create_dicts:
                tmp_obj[key] = {}
                tmp_obj = tmp_obj[key]
            else:
                raise

    tmp_obj[keys[-1]] = value


def iterate_dict_leaves(d, return_path = False):
    """Iterate through hierarchy of dicts to get leaves"""

    def get_leaf_recursive(obj):
        if isinstance(obj, dict):
            for key, value in obj.items():
                for inner_obj, inner_key in get_leaf_recursive(value):
                    yield (inner_obj, [key] + inner_key)

        else:
            yield (obj, [])

    for obj, path in get_leaf_recursive(d):
        if return_path:
            yield (obj, path)
        else:
            yield obj


def multi_get(d, *keys, **options):
    """ Return a tuple of values from dict by keys.
            options can have 'default' key (acts as default value in dict.get)
    """
    default = options.get('default')
    return tuple((d.get(key, default) for key in keys))


def hierarchial_update(dict_to, dict_from):
    """Updates a hierarchial dict using another dict. """

    def merge_objects_recursive(object_to, object_from):
        if isinstance(object_to, dict) and isinstance(object_from, dict):
            for key_from, value_from in object_from.items():
                object_to[key_from] = merge_objects_recursive(object_to.get(key_from), value_from)

            return object_to
        else:
            return object_from

    merge_objects_recursive(dict_to, dict_from)


def setattr_dict(object, values_dict):
    for key, value in values_dict.items():
        setattr(object, key, value)


def get_first(predicate, l, default = None):
    """Return first matching element of list, or default if not found."""
    try:
        return ifilter(predicate, l).next()
    except StopIteration:
        return default


def remove_first(predicate, l, default = None):
    """Remove and return first matching element of list, or default if not found."""
    for i, v in enumerate(l):
        if predicate(v):
            return l.pop(i)

    return default


def add_nonexistent(dictTo, dictFrom):
    """Add key:value pairs from dictFrom that are absent in dictTo."""
    for key, value in dictFrom.items():
        if key not in dictTo:
            dictTo[key] = value


def is_identifier(str):
    """Return True if str is valid Python identifier."""
    return bool(re.match(is_identifier.regexp, str))


is_identifier.regexp = re.compile('^[A-Za-z_]+\\w*$')

def dict_get(dictionary, key, default = None):
    """Get for PyFixedDictDataInstance."""
    try:
        return dictionary[key]
    except KeyError:
        return default


def has_branching(d):
    """Retrurn true if hierarchy of d has branching"""
    if isinstance(d, dict):
        if len(d) == 0:
            return False
        if len(d) == 1:
            for val in d.values():
                return has_branching(val)

        else:
            return True
    else:
        return False


def isDictOrFixedDict(val):
    if isinstance(val, dict):
        return True
    if val.__class__.__name__ == 'PyFixedDictDataInstance':
        return True
    return False


def safe_dicts_add(first, second):
    if first is not None and second is not None:
        return first + second
    elif first is not None:
        return first
    elif second is not None:
        return second
    else:
        return
        return


def add_dicts(first_dict, second_dict, custom_add_function = None, before_add_tree_function = None):
    if isDictOrFixedDict(first_dict) and isDictOrFixedDict(second_dict):
        for second_key in second_dict.keys():
            first_dict_value = first_dict.get(second_key)
            second_dict_value = second_dict[second_key]
            if first_dict_value is not None:
                first_dict[second_key] = add_dicts(first_dict_value, second_dict_value, custom_add_function, before_add_tree_function)
            elif before_add_tree_function:
                first_dict[second_key] = before_add_tree_function(second_dict_value)
            else:
                first_dict[second_key] = second_dict_value

        return first_dict
    elif custom_add_function is not None:
        return custom_add_function(first_dict, second_dict)
    else:
        return first_dict + second_dict
        return


def format_exc():
    exctype, ex, tb = sys.exc_info()
    try:
        md, ln, fn = traceback.extract_tb(tb)[-1][:3]
        path, md = os.path.split(md)
        result = '{classname}({message}) at `{modulename}`[line {line}] function `{function}`'.format(classname=ex.__class__.__name__, message=ex.args[0] if ex.args else '', modulename=md, line=ln, function=fn)
    finally:
        exctype = ex = tb = None

    return result


def deque_remove_by_index(dq, idx):
    l = len(dq)
    if idx <= l / 2:
        dq.rotate(-idx)
        dq.popleft()
        dq.rotate(idx)
    else:
        dq.rotate(l - 1 - idx)
        dq.pop()
        dq.rotate(idx - l + 1)


def get_items_count(items, key = lambda k: k):
    """Get a dict of counts, where keys is key(item), default keys == items."""
    res = defaultdict(int)
    for item in items:
        res[key(item)] += 1

    return res


def cached_results(func, _cache = {}):

    def call(*args, **kwargs):
        key = (args, frozenset(kwargs.items()))
        try:
            return _cache[key]
        except TypeError:
            print "ERROR: can't use unhashable args in <cached_results> decorator.", args, kwargs
            raise
        except KeyError:
            _cache[key] = func(*args, **kwargs)
            return _cache[key]

    return call


def get_list_diff(list1, list2):
    """
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbd\xd0\xb8\xd1\x86\xd1\x83 \xd0\xbc\xd0\xb5\xd0\xb6\xd0\xb4\xd1\x83 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
    list1 - new list
    list2 - old list
    return result = {"added":[], "removed":[]}
    """
    result = {'added': [],
     'removed': []}
    for i in list1:
        if i not in list2:
            result['added'].append(i)

    for i in list2:
        if i not in list1:
            result['removed'].append(i)

    return result


def get_funcs_count():
    res = defaultdict(int)
    for obj in gc.get_objects():
        if isinstance(obj, types.FunctionType):
            res[obj.__name__] += 1

    return res


def get_funcs_count_sorted(top = 0, count = 0):
    funcs = [ (k, v) for k, v in get_funcs_count().items() if v > count ]
    return sorted(funcs, key=lambda kv: kv[1])[-top:]


def get_func_count(*func_names):
    """Return a list of funcs objects count, respectively."""
    key = lambda f: f.__name__
    res = [ get_items_count(get_all_funcs(), key=key)[f] for f in func_names ]
    return res


def get_object_by_id(obj_id):
    """Get object by internal Python id."""
    for obj in gc.get_objects():
        if id(obj) == obj_id:
            return obj


def force_unicode(s):
    if isinstance(s, unicode):
        return s
    if isinstance(s, str):
        return s.decode('utf-8')
    raise ValueError()


def force_utf8(s):
    if isinstance(s, str):
        return s
    if isinstance(s, unicode):
        return s.encode('utf-8')
    str(s)


def groupNumber(number, sep = ' '):
    number = str(number)
    prefix = ''
    if number.startswith('-'):
        prefix = '-'
        number = number.lstrip('-')
    aftert = ''
    if '.' in number:
        number, aftert = number.split('.', 1)
    ln = list(number)
    ln.reverse()
    out = []
    for x, n in enumerate(ln):
        out.append(n)
        if x and not (x + 1) % 3 and x + 1 < len(ln):
            out.append(sep)

    out.reverse()
    number = ''.join(out)
    if aftert:
        number += '.' + aftert
    return prefix + number


DUMP_BASE, DUMP_CELL = range(2)

def dump_entity(entity_id, dump_type):
    entity = BigWorld.entities.get(entity_id)
    if not entity:
        return 'Entity not found: ' + str(entity_id)
    if dump_type == DUMP_CELL and not entity.isReal():
        return 'Entity is a ghost: ' + str(entity)

    def attribs_filter(attrib):
        if attrib == 'cellData':
            return False
        if attrib == 'bandwidthPerSecond':
            return False
        if attrib.startswith('__') and attrib.endswith('__'):
            return False
        value = getattr(entity, attrib)
        if str(type(value)) in ("<type 'function'>", "<type 'method-wrapper'>", "<type 'builtin_function_or_method'>", "<type 'instancemethod'>", "<type 'EntityExtraMethod'>"):
            return False
        return True

    if dump_type == DUMP_CELL:
        all_attribs = entity.getDict()
    elif dump_type == DUMP_BASE:
        all_attribs = dir(entity)
    attribs = filter(attribs_filter, all_attribs)
    do_not_align_list = ['complexItemParametresValues',
     'complexItemParametresKeys',
     'AccStandModsKeys',
     'favoriteList',
     'Freez',
     'Failed',
     'Opened',
     'Closed',
     'OnTest',
     'quickSlotBars']

    def represent_value(depth, value):
        value = pyFixedToNativePythonType(value)
        if str(type(value)) in ("<type 'dict'>",):
            if not value:
                return '{}'
            result = '{\n' + '\t' * (depth + 2)
            for i, (key, v) in enumerate(value.items()):
                if key not in do_not_align_list:
                    v = represent_value(depth + 1, v)
                if i != 0:
                    result += ',\n' + '\t' * (depth + 2)
                result += '{{{0} : {1}}}'.format(key, v)

            result += '\n' + '\t' * (depth + 1) + '}'
            return result
        if str(type(value)) in ("<type 'list'>",):
            if not value:
                return '[]'
            result = '[\n' + '\t' * (depth + 2)
            for i, v in enumerate(value):
                v = represent_value(depth + 1, v)
                if i != 0:
                    result += ',\n' + '\t' * (depth + 2)
                result += str(v)

            result += '\n' + '\t' * (depth + 1) + ']'
            return result
        if isinstance(value, unicode):
            value = value.encode('utf-8')
        return str(value)

    if dump_type == DUMP_BASE:
        file_path = '../var/log/bigworld/dump_entity_base_' + str(entity_id) + '.txt'
    elif dump_type == DUMP_CELL:
        file_path = '../var/log/bigworld/dump_entity_cell_' + str(entity_id) + '.txt'
    file = open(file_path, 'w')
    file.write('{')
    for index, attribute in enumerate(attribs):
        value = getattr(entity, attribute)
        if attribute not in do_not_align_list:
            value = represent_value(0, value)
        if index != 0:
            file.write(',')
        to_write = '\n\t{0} : {1}'.format(attribute, value)
        file.write(to_write)

    file.write('\n}')
    file.close()
    return 'Entity dumped: ' + str(entity)


def time_struct_to_seconds(time_struct):
    return time_struct.tm_hour * 3600 + time_struct.tm_min * 60 + time_struct.tm_sec


def time_ms_to_string(time_ms):
    minutes = int(time_ms) / 60
    hours = minutes / 60 % 24
    minutes = minutes % 60
    return '{0:02d}:{1:02d}'.format(hours, minutes)


__MATERIAL_NAME_BY_ID = {}

def get_material_name_by_id(material_id):
    if not __MATERIAL_NAME_BY_ID:
        for material_desc in BigWorld.getMaterialKinds():
            mat_id = material_desc[1]['id'].asInt
            mat_name = material_desc[1]['sound'].asString
            __MATERIAL_NAME_BY_ID[mat_id] = mat_name

        __MATERIAL_NAME_BY_ID['default'] = 'Default'
    return __MATERIAL_NAME_BY_ID.get(material_id)


__MATERIAL_ID_BY_NAME = {}

def get_material_id_by_name(material_name):
    if not __MATERIAL_ID_BY_NAME:
        for material_desc in BigWorld.getMaterialKinds():
            mat_id = material_desc[1]['id'].asInt
            mat_name = material_desc[1]['sound'].asString
            __MATERIAL_ID_BY_NAME[mat_name] = mat_id

        __MATERIAL_ID_BY_NAME['Default'] = 'default'
    return __MATERIAL_ID_BY_NAME.get(material_name)