    \xd1\x82\xd0\xb8\xd0\xbf \xd0\xb2 \xd0\xbd\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb9 Python \xd1\x82\xd0\xb8\xd0\xbf.
    """

    def check_type(value):
        if value.__class__.__name__ in ('PyArrayDataInstance', 'list', 'tuple'):
            value = convert_py_array(value)
        elif value.__class__.__name__ in ('PyFixedDictDataInstance', 'dict'):
            value = convert_py_fixed_dict(value)
        return value

    def convert_py_array(py_array):
        lst = []
        for elem in py_array:
            elem = check_type(elem)
            lst.append(elem)

        return lst

    def convert_py_fixed_dict(fix_dict):
        dct = {}
        for key, value in fix_dict.items():
            value = check_type(value)
            dct[key] = value

        return dct

    py_value = check_type(py_fixed)
    return py_value


