                questRules['mobs']['creatureType'] = 0 if not questRulesNode['mobs'].has_key('mobType') else questRulesNode['mobs']['mobType'].asInt
                questRules['mobs']['level'] = '0' if not questRulesNode['mobs'].has_key('level') else questRulesNode['mobs']['level'].asString
                questRules['mobs']['count'] = 0 if not questRulesNode['mobs'].has_key('count') else questRulesNode['mobs']['count'].asInt
                questRules['mobs']['scenType'] = 0 if not questRulesNode['mobs'].has_key('scenType') else questRulesNode['mobs']['scenType'].asInt
                questRules['mobs']['way'] = '' if not questRulesNode['mobs'].has_key('way') else questRulesNode['mobs']['way'].asString
                questRules['mobs']['invulnerable'] = 0 if not questRulesNode['mobs'].has_key('invulnerable') else questRulesNode['mobs']['invulnerable'].asInt
