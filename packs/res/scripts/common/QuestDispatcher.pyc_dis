        teleportTo.readonly()
        questRules.readonly()
        reward = ReadOnlyDict()
        rewardNode = item['Reward'] if item['Reward'] else {}
        reward['Expirience'] = get_int_array(rewardNode, 'Experience')
        reward['TypeOfItems'] = get_int_array(rewardNode, 'TypeOfItems')
        reward['NumOfItems'] = get_int_array(rewardNode, 'NumOfItems')
        reward['AttrOfItems'] = get_int_array(rewardNode, 'AttrOfItems')
        reward['Credits'] = get_int(rewardNode, 'Credits')
        reward['Difficulty'] = get_int(rewardNode, 'Difficulty')
        reward['Reputation'] = _parseReputation(get_string(rewardNode, 'Reputation'))
        reward['KarmaPK'] = get_int(rewardNode, 'KarmaPK')
        reward['Effects'] = getEffectsInf(rewardNode)
        reward['RewardWindow'] = get_int(rewardNode, 'RewardWindow')
        if rewardNode.has_key('ChangeQuests'):
            reward['ChangeQuests'] = parse_change_quests(rewardNode['ChangeQuests'])
            if rewardNode.has_key('randomQuest'):
                reward['randomQuest'] = True
        quest['Reward'] = reward
        reward.readonly()
        target = ReadOnlyDict()
        targetNode = item['Target']
        target['onFin'] = get_int(targetNode, 'onFin')
        target['QuestType'] = get_int(targetNode, 'QuestType')
        target['ObjectType'] = get_int(targetNode, 'ObjectType')
        target['NumOfObjects'] = get_int(targetNode, 'NumOfObjects')
        target['ObjectName'] = get_string(targetNode, 'ObjectName')
        target['IsClan'] = get_int(targetNode, 'IsClan')
        target['AObjectAttrs'] = get_int_array(targetNode, 'AObjectAttrs')
        target['Time'] = get_float(targetNode, 'Time')
        target['ObjectAttr'] = get_int(targetNode, 'ObjectAttr')
        target['IsGroup'] = get_int(targetNode, 'IsGroup')
        target['AreaName'] = get_string(targetNode, 'AreaName')
        if targetNode.has_key('percent'):
            target['kill_ratio'] = targetNode['percent'].asFloat
        if targetNode.has_key('additional'):
            target['additional'] = targetNode['additional'].asInt
        quest['Target'] = target
        penalty = ReadOnlyDict()
        penaltyNode = item['Penalty']
        penalty['Credits'] = get_float(penaltyNode, 'Credits')
        penalty['Expirience'] = get_int_array(penaltyNode, 'Experience')
        penalty['KarmaPK'] = get_int(penaltyNode, 'KarmaPK')
        penalty['Reputation'] = _parseReputation(get_string(penaltyNode, 'Reputation'))
        if penaltyNode and penaltyNode.has_key('ChangeQuests'):
            penalty['ChangeQuests'] = parse_change_quests(penaltyNode['ChangeQuests'])
            if penaltyNode.has_key('randomQuest'):
                penalty['randomQuest'] = True
        quest['Penalty'] = penalty
        penalty.readonly()
        precondition = ReadOnlyDict()
        preconditionNode = item['Precondition']
        precondition['TakenPeriod'] = get_float(preconditionNode, 'TakenPeriod') * 3600.0
        precondition['Repeat'] = get_int(preconditionNode, 'Repeat')
        if preconditionNode and preconditionNode.has_key('OmniCounter'):
            precondition['OmniCounter'] = preconditionNode['OmniCounter'].asInt
        quest['Precondition'] = precondition
        precondition.readonly()
        if quest['Target']['QuestType'] in [Quest.TYPE_KILLMOBS, Quest.TYPE_KILLMOBS_WITH_ONTEST] and quest['Target']['ObjectAttr']:
            new_attr = Creatures.get_subtype_index(quest['Target']['ObjectType'], str(quest['Target']['ObjectAttr']))
            quest['Target']['ObjectAttr'] = new_attr
        target.readonly()
        quest.readonly()
        Quests[id] = quest

    if BigWorld.component == 'base':
        parse_deprecated_quests(QuestsToRemove.DEPRECATED_QUESTS_REMOVE)
        parse_deprecated_quests(QuestsToRemove.DEPRECATED_QUESTS_REWARD)
    return


def parse_deprecated_quests(quests_list):
    """ \xd0\xb2 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb5 \xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb2\xd1\x88\xd0\xb8\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xbb\xd0\xb5\xd0\xb6\xd0\xb0\xd1\x82 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd1\x8b
            \xd0\x9d\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xb8\xd1\x85 \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb5\xd1\x89\xd1\x91 \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8
    """
    child_quests = set()
    for quest_id in quests_list:
        if quest_id in Quests:
            child_quests.update(Quests[quest_id]['Additional']['ListOfSubQuest'])

    if child_quests:
        parse_deprecated_quests(child_quests)
        quests_list.update(child_quests)


def parseScenariosInf():
    filePath = RES_PATH_SCENARIO + SCENARIO_FILE
    resXML = ResMgr.openSection(filePath)
    for item in resXML.values():
        if item['id'] not in Scenarios.keys():
            scenario = {'id': item['id'].asInt,
             'type': item['type'].asInt,
             'winif': [ int(subitem) for subitem in item['winif'].asString.split(',') if subitem != '' ],
             'mobs': [ {'type': mob['type'].asInt,
                      'goto': mob['goto'].asInt,
                      'count': mob['count'].asInt,
                      'level': mob['level'].asInt,
                      'update': mob['update'].asInt,
                      'wayName': mob['wayName'].asString} for mob in item['mobs'].values() ],
             'npcs': [ {'type': npc['type'].asInt,
                      'npcName': npc['npcName'].asString,
                      'wayName': npc['wayName'].asString,
                      'id': npc['id'].asInt,
                      'fractionID': npc['fractionID'].asInt} for npc in item['npcs'].values() ],
             'time': item['time'].asFloat}
            Scenarios[scenario['id']] = scenario


def fillScenarioQuests():
    for quest in Quests.values():
        for sID in quest['QuestRules']['Scenarios']:
            scenario = getScenarioOnID(sID)
            if scenario:
                npcs = [ dict(id=e['id'], name=u'') for e in scenario['npcs'] ]
                quest['Information']['NPCs'] += npcs


merged_times = 0

def merge_rus_to_eng(callback):
    """ \xd0\xb2\xd0\xbb\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x80\xd1\x83\xd1\x81\xd1\x81\xd0\xba\xd1\x83\xd1\x8e \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb2 \xd0\xb0\xd0\xbd\xd0\xb3\xd0\xbb\xd0\xb8\xd0\xb9\xd1\x81\xd0\xba\xd1\x83\xd1\x8e """
    global merged_times
    if merged_times > 0:
        raise RuntimeError
        return
    merged_times += 1
    rus_localized_data = parse_localized_data(RES_PATH_QUESTSTEXT_FILE_RUS)
    for quest_id, quest in Quests.iteritems():
        if quest['Information']['Title'] or quest['Information']['Description']:
            continue
        information = ReadOnlyDict()
        localized_data = rus_localized_data[quest_id]
        information['Description'] = parse_description(localized_data['Description'], quest)
        information['Title'] = localized_data['Title']
        information['onFailed'] = localized_data['onFailed']
        information['onWin'] = localized_data['onWin']
        information['onGet'] = localized_data['onGet']
        information['Items'] = localized_data['Items']
        information['NPCs'] = []
        quest['Information'] = information

    BigWorld.callback(0, callback)


def getQuestsOnID(quest_id):
    ret = []
    quest = Quests.get(quest_id)
    if quest:
        ret.append(quest)
        for subquest_id in quest['Additional']['ListOfSubQuest']:
            ret += getQuestsOnID(subquest_id)

    return ret


def getQuestOnID(quest_id):
    quest = Quests.get(quest_id)
    return quest


def getQuests(quests_ids):
    quests = []
    for quest_id in quests_ids:
        quest = getQuestOnID(quest_id)
        if quest:
            quests.append(quest)

    return quests


def getScenarioOnID(scenario_id):
    scenario = Scenarios.get(scenario_id)
    return scenario


def get_type(quest):
    return quest['Target'].get('QuestType', 0)


def get_type_by_id(quest_id):
    return get_type(getQuestOnID(quest_id))


def getRootID(quest_id):
    quest = Quests.get(quest_id)
    if quest:
        sub_quest = quest['Additional']['IsSubQuest']
        if sub_quest:
            return getRootID(sub_quest)
        return quest_id
    return 0


def getQuestTitle(quest):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xba \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 \xd0\xbb\xd0\xb8\xd0\xb1\xd0\xbe, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82, \xd1\x82\xd0\xbe
            \xd0\xb7\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xba \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 (\xd1\x81 F2 \xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x91\xd1\x82 \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd1\x87\xd0\xbd\xd1\x83\xd1\x8e \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e)
    """
    parent_quest = quest['Additional']['IsSubQuest']
    if parent_quest:
        return getQuestTitleByID(parent_quest)
    if BigWorld.component != 'client':
        return quest['Information']['Title']
    if not BigWorld.isKeyDown(BigWorld.stringToKey('F2')) or not BigWorld.player().isAdminAccess():
        return quest['Information']['Title']
    return u'{0} [ID {1}]'.format(quest['Information']['Title'], quest['QuestID'])


def getQuestTitleByID(quest_id):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xba \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 \xd0\xbb\xd0\xb8\xd0\xb1\xd0\xbe, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82, \xd1\x82\xd0\xbe
            \xd0\xb7\xd0\xb0\xd0\xb3\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xba \xd1\x80\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 (\xd1\x81 F2 \xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x91\xd1\x82 \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd1\x87\xd0\xbd\xd1\x83\xd1\x8e \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e)
    """
    quest = getQuestOnID(quest_id)
    return getQuestTitle(quest)


def get_description_by_id(quest_id):
    quest = getQuestOnID(quest_id)
    return getQuestDescription(quest)


def getQuestDescription(quest):
    if BigWorld.component != 'client':
        return quest['Information']['Description']
    if not BigWorld.isKeyDown(BigWorld.stringToKey('F2')) or not BigWorld.player().isAdminAccess():
        return quest['Information']['Description']
    return u'{0} [ID {1}]'.format(quest['Information']['Description'], quest['QuestID'])


def getQuestTreeIDs(quest_id):
    tree = []
    quest = Quests.get(quest_id)
    if quest:
        tree.append(quest_id)
        for subquest_id in quest['Additional']['ListOfSubQuest']:
            tree += getQuestTreeIDs(subquest_id)

    return tree


def get_parent_by_id(quest_id):
    quest = getQuestOnID(quest_id)
    if not quest:
        print "QuestDispatcher (ERROR): can't qet parent from quest", quest_id
        traceback.print_stack()
        return quest_id
    else:
        parent_quest_id = quest['Additional']['IsSubQuest']
        if parent_quest_id:
            return get_parent_by_id(parent_quest_id)
        return quest_id


def get_siblings_by_id(quest_id):
    quest = getQuestOnID(quest_id)
    parent_quest_id = quest['Additional']['IsSubQuest']
    if parent_quest_id:
        siblings = list(getQuestOnID(parent_quest_id)['Additional']['ListOfSubQuest'])
        siblings.remove(quest['QuestID'])
        return siblings
    else:
        return []


def getScenario(scenario_id):
    scenario = Scenarios.get(scenario_id)
    return scenario


def is_subquest(quest_id):
    quest = Quests[quest_id]
    return quest['Additional']['IsSubQuest']


def get_subquests(quest_id):
    quest = Quests[quest_id]
    return quest['Additional']['ListOfSubQuest']


def show_progress(quest_id):
    quest = Quests[quest_id]
    return quest['Additional']['ShowProgress']


def show_in_journal(quest_id):
    quest = Quests[quest_id]
    return quest['Additional']['ShowProgress'] & Quest.SHOW_JOURNAL


def show_tutorial(quest_id):
    quest = Quests[quest_id]
    return quest['Additional']['ShowProgress'] & Quest.SHOW_TUTORIAL


def get_base_share(quest):
    """ \xd0\xb4\xd0\xbe\xd0\xbb\xd1\x8f, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x83\xd1\x8e \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd1\x82\xd1\x8c \xd1\x85\xd0\xbe\xd0\xb7\xd1\x8f\xd0\xb8\xd0\xbd\xd1\x83 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 """
    return quest['QuestRules'].get('baseToCapturePercent')


def get_mass_quest(quest):
    """ \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 """
    return quest['QuestRules'].get('MassQuests')


def has_quest(quest_id):
    """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd1\x81\xd1\x83\xd1\x89\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0 """
    return quest_id in Quests


def is_empty(quest):
    return quest['Additional'].get('isEmpty', False)


def has_omnicounter(quest):
    return quest['Precondition'].get('OmniCounter')


def get_debug_data(quest):
    """ \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 """
    return quest['Additional'].get('DebugData')


def is_repeatable(quest):
    return quest['Precondition'].get('Repeat')


def is_repeatable_by_id(quest_id):
    quest = Quests[quest_id]
    return is_repeatable(quest)


def get_taken_period_by_id(quest_id):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2 \xd1\x81\xd0\xb5\xd0\xba\xd1\x83\xd0\xbd\xd0\xb4\xd0\xb0\xd1\x85 """
    quest = Quests[quest_id]
    return get_taken_period(quest)


def get_taken_period(quest):
    """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2 \xd1\x81\xd0\xb5\xd0\xba\xd1\x83\xd0\xbd\xd0\xb4\xd0\xb0\xd1\x85 """
    return quest['Precondition'].get('TakenPeriod')


def get_needed_items_by_id(quest_id):
    quest = Quests[quest_id]
    return get_needed_items(quest)


def get_needed_items(quest):
    item_type = quest['Target']['ObjectType']
    item_count = quest['Target']['NumOfObjects']
    return (item_type, item_count)


def cancel_fail_mode(quest):
    return not quest['Additional'].get('CantFail', False)


def show_reward_window(quest):
    return bool(quest['Reward'].get('RewardWindow'))


def get_kill_ratio(quest):
    """ \xd0\xba\xd0\xbe\xd0\xbb\xd0\xb8\xd1\x87\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd0\xbe \xd1\x83\xd1\x80\xd0\xbe\xd0\xbd\xd0\xb0 \xd0\xbc\xd0\xbe\xd0\xb1\xd1\x83 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x87\xd1\x91\xd1\x82\xd0\xb0 \xd1\x83\xd0\xb1\xd0\xb8\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb0
            None - \xd0\xb7\xd0\xb0\xd1\x87\xd1\x91\xd1\x82 \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb8\xd0\xb2\xd1\x88\xd0\xb5\xd0\xbc\xd1\x83
    """
    return quest['Target'].get('kill_ratio', None)


def does_farm_need_items(quest):
    """ \xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb5\xd0\xbd \xd0\xbb\xd0\xb8 \xd1\x84\xd0\xb0\xd1\x80\xd0\xbc\xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xb1\xd1\x80\xd0\xb0\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b """
    return not quest['Target'].get('additional', False)


def get_quests():
    """" \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 """
    return Quests


def get_penalty(quest):
    return quest['Penalty']


def get_mob_kill_type(quest):
    return quest['Target']['ObjectType']


def get_time(quest_id):
    return Quests[quest_id]['Target']['Time']


def get_change_quest_reward(quest_id):
    """ \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xbd\xd0\xb0\xd0\xb3\xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2
    """
    reward = Quests[quest_id]['Reward']
    if 'ChangeQuests' not in reward:
        return []
    if reward.get('randomQuest', False):
        return [random.choice(reward['ChangeQuests'])]
    return reward['ChangeQuests']


def get_change_quest_penalty(quest_id):
    """ \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x88\xd1\x82\xd1\x80\xd0\xb0\xd1\x84\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
    penalty = Quests[quest_id]['Penalty']
    if 'ChangeQuests' not in penalty:
        return []
    if penalty.get('randomQuest', False):
        return [random.choice(penalty['ChangeQuests'])]
    return penalty['ChangeQuests']


def is_board_quest(quest_id):
    """ \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f Base """
    return quest_id in BoardQuestsSet


class SHOW_SCREEN_TYPE:
    CLOSE, FAIL, OPEN = range(3)


def need_show_screen_message(quest, show_type):
    if show_type == SHOW_SCREEN_TYPE.CLOSE:
        return quest['Additional'].get('screenMessageOnWin')
    if show_type == SHOW_SCREEN_TYPE.FAIL:
        return quest['Additional'].get('screenMessageOnFailed')
    if show_type == SHOW_SCREEN_TYPE.OPEN:
        return quest['Additional'].get('screenMessageOnGet')
    raise RuntimeError()


def get_penalty_string(quest_id):

    def get_exp_string(exp):
        result = lc('Quests.CancelQuest.Expirience')
        if exp[0]:
            result += u' {0} {expa:+},'.format(lc('Quests.CancelQuest.COMBAT_EXP'), expa=-exp[0])
        if exp[1]:
            result += u' {0} {expa:+},'.format(lc('Quests.CancelQuest.SURVIVAL_EXP'), expa=-exp[1])
        if exp[2]:
            result += u' {0} {expa:+}'.format(lc('Quests.CancelQuest.OTHER_EXP'), expa=-exp[2])
        if result[-1] == u',':
            result = result[:-1]
        return result + u'\n'

    def get_rep_string(rep):
        result = lc('Quests.CancelQuest.Reputation')
        for fraction_id, value in rep.items():
            fraction_name = lc(Fractions.FractionNames[fraction_id])
            result += u' {0} {repa},'.format(fraction_name, repa=-value)

        return result[:-1]

    penalty = Quests[quest_id]['Penalty']
    result = u''
    if penalty['Credits']:
        result += u'{0} {1}\n'.format(lc('Quests.CancelQuest.Money'), penalty['Credits'])
    if penalty['Expirience']:
        result += get_exp_string(penalty['Expirience'])
    if penalty['KarmaPK']:
        result += u'{0} {karmas:+}\n'.format(lc('Quests.CancelQuest.Karma'), karmas=-penalty['KarmaPK'])
    if penalty['Reputation']:
        result += get_rep_string(penalty['Reputation'])
    if not result:
        result = lc('Quests.CancelQuest.Nothing')
    return result


parseAll()