def reload_quests():
    """ \xd0\xb7\xd0\xb0\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe \xd0\xbf\xd0\xb0\xd1\x80\xd1\x81\xd0\xb8\xd1\x82 \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd1\x8b
            \xd0\xbd\xd0\xb8\xd1\x87\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbd\xd0\xb5 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2 \xd1\x81\xd1\x86\xd0\xb5\xd0\xbd\xd0\xb0\xd1\x80\xd0\xb8\xd1\x8f\xd1\x85
            \xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5
    """
    ResMgr.purge(SCENARIO_FILE)
    ResMgr.purge(RES_PATH_QUESTSDATA_FILE)
    ResMgr.purge(RES_PATH_QUESTSTEXT_FILE_RUS)
    ResMgr.purge(RES_PATH_QUESTSTEXT_FILE_ENG)
    ResMgr.purge(RES_PATH_SCENARIO)
    if BigWorld.component != 'client':
        parseAll()
    print 'QuestDispatcher: all the quests are reloaded!'


def get_int(node, field_name, default_value = 0):
    if not node:
        return default_value
    elif node.has_key(field_name):
        return node[field_name].asInt
    else:
        return default_value


def get_float(node, field_name, default_value = 0.0):
    if not node:
        return default_value
    elif node.has_key(field_name):
        return node[field_name].asFloat
    else:
        return default_value


def get_string(node, field_name, default_value = ''):
    if not node:
        return default_value
    elif node.has_key(field_name):
        return node[field_name].asString
    else:
        return default_value


def get_widestring(node, field_name, default_value = ''):
    if not node:
        return default_value
    elif node.has_key(field_name):
        return node[field_name].asWideString
    else:
        return default_value


def get_float_array(node, field_name, default_value = None):
    if not default_value:
        default_value = []
    if not node:
        return default_value
    elif node.has_key(field_name):
        return [ float(subitem) for subitem in node[field_name].asString.split(',') if subitem != '' ]
    else:
        return default_value


def get_int_array(node, field_name, default_value = None):
    if not default_value:
        default_value = []
    if not node:
        return default_value
    elif node.has_key(field_name):
        text = node[field_name].asString
        if '&' in text:
            text = text.replace('&', ',')
        return [ int(subitem) for subitem in text.split(',') if subitem != '' ]
    else:
        return default_value


def get_boolean_int_array(node, field_name, default_value = None):
    if not node:
        return default_value
    elif node.has_key(field_name):
        text = node[field_name].asString
        predicate = all
        if '|' in text:
            text = text.replace('|', ',')
            predicate = any
        if '&' in text:
            text = text.replace('&', ',')
        result = {'ids': [ int(subitem) for subitem in text.split(',') if subitem != '' ],
         'predicate': predicate}
        return result
    else:
        return default_value


def parseAll():
    global BoardQuestsSet
    global Quests
    Quests = ReadOnlyDict()
    parseQuestsInf()
    Quests.readonly()
    if not Scenarios:
        parseScenariosInf()
        if BigWorld.component == 'client':
            fillScenarioQuests()
    if BigWorld.component == 'base':
        BoardQuestsSet = set(map(int, json.load(open(BOARD_QUESTS_CONFIG_PATH)).keys()))


def _parseReputation(input_string):
    ret = {}
    if input_string:
        fractions = input_string.split(';')
        for f in fractions:
            fraction_info = f.split(':')
            if fraction_info[1] == 'Infinity':
                fraction_info[1] = 2147483647
            if fraction_info[1] == '-Infinity':
                fraction_info[1] = -2147483647
            ret[int(fraction_info[0])] = int(fraction_info[1])

    return ret


def parse_localized_data(filePath):

    def getItemsInf(xmlObject):
        ret = []
        if not xmlObject:
            return ret
        for e in xmlObject.values():
            ret.append(dict(title=e['title'].asWideString, description=GUITextUtils.encode(e['description'].asWideString), itemID=e['itemID'].asInt, activation=e['activation'].asWideString))

        return ret

    resXML = ResMgr.openSection(filePath)
    result = {}
    for item in resXML.values():
        data = {}
        data['Title'] = get_widestring(item, 'Title')
        data['Description'] = GUITextUtils.encode(get_widestring(item, 'Description'))
        data['onFailed'] = get_widestring(item, 'onFailed')
        data['onWin'] = get_widestring(item, 'onWin')
        data['onGet'] = get_widestring(item, 'onGet')
        data['Items'] = getItemsInf(item['Items'])
        result[item['ID'].asInt] = data

    return result


def parse_description(description, root_node):

    def get_int(node):
        if isinstance(node, int):
            return node
        return node.asInt

    if description:
        if '%I%' in description:
            item_type = get_int(root_node['Target']['ObjectType'])
            description = description.replace('%I%', ItemsUtils.GetItemNameCached(item_type))
        if '%X%' in description:
            item_quantity = get_int(root_node['Target']['NumOfObjects'])
            description = description.replace('%X%', unicode(item_quantity))
    return description


def parse_change_quests(node):
    result = []
    splits = node.asString.split(';')
    for split in splits:
        quest_id, action_type = split.split(':')
        result.append((int(quest_id), int(action_type)))

    return result


def parseQuestsInf():

    def parseReputation(input_string):
        ret = []
        if input_string:
            fractions = input_string.split(',')
            for f in fractions:
                fraction_info = f.split(':')
                ret.append(dict(fractionID=int(fraction_info[0]), status=int(fraction_info[1]) if fraction_info[0] else 0))

        return ret

    def getEffectsInf(node):
        if not node:
            return []
        xmlObject = node['Effects']
        if not xmlObject:
            return []
        ret = []
        for e in xmlObject.values():
            ret.append(dict(id=e['id'].asInt, stack=e['stack'].asInt))

        return ret

    if BigWorld.component == 'client':
        if Localization.Localization.globalLanguage == 'russian':
            questTextsLocalizedData = parse_localized_data(RES_PATH_QUESTSTEXT_FILE_RUS)
        else:
            questTextsLocalizedData = parse_localized_data(RES_PATH_QUESTSTEXT_FILE_ENG)
    filePath = RES_PATH_QUESTSDATA_FILE
    resXML = ResMgr.openSection(filePath)
    for item in resXML.values():
        quest = ReadOnlyDict()
        id = item['ID'].asInt
        quest['QuestID'] = id
        if BigWorld.component == 'client':
            if id not in questTextsLocalizedData:
                localizedData = {'Description': None,
                 'Title': None,
                 'onFailed': None,
                 'onWin': None,
                 'Items': None}
                print 'QuestsDispatcher (ERROR): quest with id {0} not translated'.format(id)
            else:
                localizedData = questTextsLocalizedData[id]
            information = ReadOnlyDict()
            information['Description'] = parse_description(localizedData['Description'], item)
            information['Title'] = localizedData['Title']
            information['onFailed'] = localizedData['onFailed']
            information['onWin'] = localizedData['onWin']
            information['onGet'] = localizedData['onGet']
            information['Items'] = localizedData['Items']
            information['NPCs'] = []
            quest['Information'] = information
            information.readonly()
        additional = ReadOnlyDict()
        additionalNode = item['Additional']
        additional['IsSubQuest'] = get_int(additionalNode, 'IsSubQuest')
        additional['ListOfSubQuest'] = get_int_array(additionalNode, 'ListOfSubQuest')
        additional['ShowProgress'] = get_int(additionalNode, 'ShowProgress')
        additional['Holder'] = additionalNode['Holder'].asString
        additional['CantCancel'] = get_int(additionalNode, 'CantCancel')
        quest['Additional'] = additional
        if additionalNode.has_key('CantFail'):
            additional['CantFail'] = bool(additionalNode['CantFail'].asInt)
        if additionalNode.has_key('DebugData'):
            additional['DebugData'] = additionalNode['DebugData'].asString
        if additionalNode.has_key('isEmpty'):
            additional['isEmpty'] = bool(additionalNode['isEmpty'].asInt)
        if additionalNode.has_key('screenMessageOnWin'):
            additional['screenMessageOnWin'] = bool(additionalNode['screenMessageOnWin'].asInt)
        if additionalNode.has_key('screenMessageOnFailed'):
            additional['screenMessageOnFailed'] = bool(additionalNode['screenMessageOnFailed'].asInt)
        if additionalNode.has_key('screenMessageOnGet'):
            additional['screenMessageOnGet'] = bool(additionalNode['screenMessageOnGet'].asInt)
        additional.readonly()
        questRulesNode = item['QuestRules']
        questRules = ReadOnlyDict()
        if questRulesNode:
            if questRulesNode.has_key('MassQuests'):
                questRules['MassQuests'] = questRulesNode['MassQuests'].asInt
            if questRulesNode.has_key('baseToCapturePercent'):
                questRules['baseToCapturePercent'] = questRulesNode['baseToCapturePercent'].asFloat
            if questRulesNode.has_key('npc'):
                questRules['npc'] = {}
                questRules['npc']['name'] = '' if not questRulesNode['npc'].has_key('name') else questRulesNode['npc']['name'].asString
                questRules['npc']['displayName'] = '' if not questRulesNode['npc'].has_key('displayName') else questRulesNode['npc']['displayName'].asString
                questRules['npc']['way'] = '' if not questRulesNode['npc'].has_key('way') else questRulesNode['npc']['way'].asString
                questRules['npc']['fractionID'] = 0 if not questRulesNode['npc'].has_key('fraction') else questRulesNode['npc']['fraction'].asInt
                questRules['npc']['reputation'] = 0 if not questRulesNode['npc'].has_key('reputation') else questRulesNode['npc']['reputation'].asInt
                questRules['npc']['npcActions'] = '' if not questRulesNode['npc'].has_key('animation') else questRulesNode['npc']['animation'].asString
                questRules['npc']['invulnerable'] = questRulesNode['npc'].has_key('invulnerable')
                questRules['npc']['mobNoAggr'] = questRulesNode['npc'].has_key('mobNoAggr')
                questRules['npc']['ignoreWAR'] = 0 if not questRulesNode['npc'].has_key('ignoreWAR') else questRulesNode['npc']['ignoreWAR'].asInt
                questRules['npc']['npcWeapon'] = 0 if not questRulesNode['npc'].has_key('weapon') else questRulesNode['npc']['weapon'].asInt
                questRules['npc']['npcHands'] = 0 if not questRulesNode['npc'].has_key('hand') else questRulesNode['npc']['hand'].asInt
                questRules['npc']['npcBoots'] = 0 if not questRulesNode['npc'].has_key('boots') else questRulesNode['npc']['boots'].asInt
                questRules['npc']['npcBody'] = 0 if not questRulesNode['npc'].has_key('body') else questRulesNode['npc']['body'].asInt
                questRules['npc']['npcArmor'] = 0 if not questRulesNode['npc'].has_key('armor') else questRulesNode['npc']['armor'].asInt
                questRules['npc']['npcLegs'] = 0 if not questRulesNode['npc'].has_key('legs') else questRulesNode['npc']['legs'].asInt
                questRules['npc']['npcCap'] = 0 if not questRulesNode['npc'].has_key('cap') else questRulesNode['npc']['cap'].asInt
                questRules['npc']['npcMask'] = 0 if not questRulesNode['npc'].has_key('mask') else questRulesNode['npc']['mask'].asInt
                questRules['npc']['npcBackpack'] = 0 if not questRulesNode['npc'].has_key('back') else questRulesNode['npc']['back'].asInt
