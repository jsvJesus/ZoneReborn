    \xd1\x83\xd0\xb6\xd0\xb5 \xd0\xb8\xd0\xbc\xd0\xb5\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe\xd1\x81\xd1\x8f \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb3\xd0\xbe\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0, \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b \xd0\xb2 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb5.
    """

    def __init__(self, *args, **kws):
        """\xd0\x9a\xd0\xbe\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x82\xd0\xbe\xd1\x80."""
        self.__items_counter = collections.defaultdict(int)
        super(BaseItemContainer, self).__init__(self, *args, **kws)

    def __add_item(self, item, number = 1):
        """\xd0\xa1\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8.
        
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbe \xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xb2 \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xb5 \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbb\xd0\xb8\xd1\x89\xd0\xb5.
        """
        item_type = item['complexItemType']
        if item_type in self.__items_counter:
            self.__items_counter[item_type] += number
            item = self.__search_item(item_type)
            do_add = False
        else:
            self.__items_counter[item_type] = number
            do_add = True
        self.__create_stack_item(item)
        return do_add

    def __del_item(self, item, number = 1):
        """\xd0\xa3\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b \xd0\xbf\xd1\x80\xd0\xb8 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb8.
        
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbe \xd0\xbb\xd0\xb8 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xb2 \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd0\xbe\xd0\xbc \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbb\xd0\xb8\xd1\x89\xd0\xb5.
        """
        item_type = item['complexItemType']
        try:
            if item_type not in self.__items_counter:
                raise ChoiceException(True)
            self.__items_counter[item_type] -= number
            if self.__items_counter[item_type] <= 0:
                del self.__items_counter[item_type]
                raise ChoiceException(True)
            changing_key = self.__changing_key(item_type)
            index = item['complexItemParametresKeys'].index(changing_key)
            item['complexItemParametresValues'][index] -= number
            if self.__items_counter[item_type] >= 1:
                raise ChoiceException(False)
        except ChoiceException as choice:
            do_del = choice.value

        return do_del

    def __create_non_stack_item(self, item):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0 \xd0\xbd\xd0\xb5 \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82."""
        item_type = item['complexItemType']
        changing_key = self.__changing_key(item_type)
        index = item['complexItemParametresKeys'].index(changing_key)
        del item['complexItemParametresKeys'][index]
        del item['complexItemParametresValues'][index]
        item['complexItemID'] = 0
        return item

    def __create_stack_item(self, item):
        """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0 \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82."""
        item_type = item['complexItemType']
        changing_key = self.__changing_key(item_type)
        item['complexItemParametresKeys'] = [changing_key]
        item['complexItemParametresValues'] = [self.__items_counter[item_type]]
        if item['complexItemID'] == 0:
            item['complexItemID'] = fake_items()
        return item

    def __changing_key(self, item_type):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87-id \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb9 \xd0\xb7\xd0\xb0 \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd1\x8b\xd0\xba\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2."""
        item_class = ItemsCatalog.GetItemClass(item_type)
        if item_class in [ItemsCatalog.AMMO, ItemsCatalog.EXPLOSION]:
            changing_key = ItemsCatalog.INC_ROUND_NUMBER
        elif item_class in [ItemsCatalog.LOOT]:
            changing_key = ItemsCatalog.INC_WARE_NUMBER
        else:
            raise
        return changing_key

    def __search_item(self, item_type):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xbc\xd1\x83 item_type."""
        for item in self:
            if item_type == item['complexItemType']:
                break
        else:
            print '\xd0\x9d\xd0\xb5 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbd\xd0\xb0\xd0\xb9\xd1\x82\xd0\xb8 item_type %s' % item_type
            print [ item['complexItemType'] for item in self ]

        return item

    def clear(self):
        """\xd0\x9e\xd1\x87\xd0\xb8\xd1\x81\xd1\x82\xd0\xb8\xd1\x82\xd1\x8c \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbb\xd0\xb8\xd1\x89\xd0\xb5 \xd0\xbe\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2."""
        super(BaseItemContainer, self).__delslice__(0, len(self))
        self.__items_counter.clear()

    def append(self, item, number = 1):
        item_type = item['complexItemType']
        if not ItemsUtils.isStackedItemType(item_type):
            for x in range(number):
                super(BaseItemContainer, self).append(item)

            return
        do_add = self.__add_item(item, number=number)
        if do_add:
            super(BaseItemContainer, self).append(item)

    def extend(self, iterable):
        for item in iterable:
            self.append(item)

    def index(self, item, start = 0, stop = None):
        item_type = item['complexItemType']
        for i, internal_item in enumerate(self[start:stop]):
            if internal_item['complexItemType'] == item_type:
                break
        else:
            raise ValueError('{0} is not in list'.format(item))

        return i

    def insert(self, index, item):
        item_type = item['complexItemType']
        if not ItemsUtils.isStackedItemType(item_type) or self.__add_item(item):
            super(BaseItemContainer, self).insert(index, item)

    def count(self, item):
        item_type = item['complexItemType']
        if item_type in self.__items_counter:
            count = self.__items_counter[item_type]
        else:
            count = super(BaseItemContainer, self).count(item)
        return count

    def pop(self, index = None, default = None):
        if index is None:
            index = -1
        item = self[index]
        item_type = item['complexItemType']
        if ItemsUtils.isStackedItemType(item_type):
            if self.__del_item(item):
                return super(BaseItemContainer, self).pop(index)
            else:
                item_copy = copy.deepcopy(self.__search_item(item_type))
                item = self.__create_non_stack_item(item_copy)
                return item
        else:
            return super(BaseItemContainer, self).pop(index)
        return

    def remove(self, item, number = 1):
        item_type = item['complexItemType']
        if not ItemsUtils.isStackedItemType(item_type):
            return super(BaseItemContainer, self).remove(item)
        if self.__del_item(item, number=number):
            return super(BaseItemContainer, self).remove(item)

    def clearItem(self, item):
        """\xd0\xa3\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb2\xd1\x81\xd0\xb5 \xd1\x81\xd1\x82\xd0\xb0\xd0\xba\xd0\xb8 \xd0\xb8\xd0\xb7 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb0"""
        item_type = item['complexItemType']
        if not ItemsUtils.isStackedItemType(item_type):
            for item in list(self):
                if item['complexItemType'] == item_type:
                    super(BaseItemContainer, self).remove(item)

            return
        if item_type in self.__items_counter:
            del self.__items_counter[item_type]
        return super(BaseItemContainer, self).remove(item)

    def __removeNumberStacked(self, item, number):
        if self.__del_item(item, number=number):
            return super(BaseItemContainer, self).remove(item)

    def removeNumber(self, item, number):
        item_type = item['complexItemType']
        if ItemsUtils.isStackedItemType(item_type):
            return self.__removeNumberStacked(item, number)
        for item in list(self):
            if number < 1:
                return
            if item['complexItemType'] == item_type:
                super(BaseItemContainer, self).remove(item)
                number -= 1

    def __contains__(self, item):
        try:
            item_type = item['complexItemType']
        except (KeyError, TypeError):
            return False

        if ItemsUtils.isStackedItemType(item_type):
            return item_type in self.__items_counter
        else:
            return super(BaseItemContainer, self).__contains__(item)

    def __delitem__(self, index):
        item = self[index]
        item_type = item['complexItemType']
        if not ItemsUtils.isStackedItemType(item_type) or self.__del_item(item):
            super(BaseItemContainer, self).__delitem__(index)

    def __delslice__(self, i = None, j = None):
        raise NotImplementedError

    def __setslice__(self, i = None, j = None, items = None):
        raise NotImplementedError


class StackingFakeItemContainer(BaseItemContainer):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xb1\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xb8\xd0\xbd\xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd1\x85 \xd0\xb2\xd0\xbd\xd1\x83\xd1\x82\xd1\x80\xd0\xb8 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb0."""

    def total_cost(self, trader_entity):
        """
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd0\xbe\xd0\xb8\xd0\xbc\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c (\xd0\xb2 \xd1\x80\xd1\x83\xd0\xb1\xd0\xbb\xd1\x8f\xd1\x85 \xd0\xb8 \xd0\xb7\xd0\xbe\xd0\xbb\xd0\xbe\xd1\x82\xd0\xb5) \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb5.
        """
        buying_items = self.extract_data()
        buying_items = ItemsUtils.add_costs_to_buying_items(buying_items, trader_entity.selling_assortment)
        return ItemsUtils.total_buying_items_cost(buying_items)

    def extract_data(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd0\xbf\xd0\xb0\xd0\xba\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd1\x85.
        
        \xd0\x94\xd0\xbb\xd1\x8f \xd0\xba\xd0\xb0\xd0\xb6\xd0\xb4\xd0\xbe\xd0\xb3\xd0\xbe TypeID \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2 \xd0\xb8
        \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3 \xd0\xb7\xd0\xb0 \xd0\xba\xd0\xb0\xd0\xba\xd1\x83\xd1\x8e \xd0\xb2\xd0\xb0\xd0\xbb\xd1\x8e\xd1\x82\xd1\x83 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82\xd1\x81\xd1\x8f.
        """
        dct = {}
        for item in self:
            item_type = item['complexItemType']
            items_number = ItemsUtils.GetItemNumber(item)
            number = items_number
            is_gold_price = item.get('forGold', 0)
            if (item_type, is_gold_price) in dct:
                dct[item_type, is_gold_price]['number'] += number
                continue
            dct[item_type, is_gold_price] = {'type_id': item_type,
             'number': number,
             'is_gold_price': item.get('forGold', 0)}

        return dct.values()