class FakeComplexIDFactory(object):
    """\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd1\x91\xd1\x82 \xd1\x84\xd1\x8d\xd0\xb9\xd0\xba\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb5 complexID."""

