# Embedded file name: ./scripts/client/SitInterface.py
import RestrictionsUtils
import sitting_settings
from sitting_settings import animations
import Constants

class SitInterface(object):

    def __init__(self):
        pass

    def set_avatar_model(self):
        if not hasattr(self, '_sit_inited'):
            self._sit_inited = True
            self._armed_before_sitting = None
            self._idlesit = None
            if self.sitId:
                loopAnimation = animations[self.sitId]['loop']
                getattr(self.model, loopAnimation)()
                self._sit_completed()
                self.setControlLock(Constants.ControlLockTypes.SITTING, True)
            else:
                self.model.IdleForever()
        elif getattr(self, 'wait_holstering', False):
            self.wait_holstering = False
            self._holster_comleted()
        self._unholstering = False
        return

    def return_model_to_defaul(self):
        """ \xd0\xb2\xd1\x8b\xd0\xb7\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb8 \xd0\xb0\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 \xd1\x83\xd0\xb1\xd0\xb8\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x82\xd1\x8b """
        if getattr(self, 'wait_holstering', False):
            self.wait_holstering = False
            self._holster_comleted()

    def unholster_grenade_ended(self):
        self._unholstering = False

    def try_sit(self, sitId):
        if self.control_locked and not self._idlesit:
            return
        if self.dead or self.sniping or self.binoculing or self.crouching or self.is_hoist_flag or self.is_throwing or self._unholstering or not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        if self.sitId == sitting_settings.Stand:
            self.cell.sit(sitId)
            self.setControlLock(Constants.ControlLockTypes.SITTING, True)
        else:
            self.cell.sit(sitting_settings.Stand)

    def set_sitId(self, old_sitId):
        if self.sitId == sitting_settings.Stand:
            self._start_stand(old_sitId)
        else:
            if self.ActiveItemID == 0 and self.ActiveThrowID == 0:
                self._armed_before_sitting = False
                self._start_sit()
            else:
                self._armed_before_sitting = True
                self.setControlLock(Constants.ControlLockTypes.SITTING, False)
                self._start_holster()
            self.setControlLock(Constants.ControlLockTypes.SITTING, True)
        if self.__class__.__name__ == 'Avatar':
            return
        self.checkCamera()

    def sit_off_on_death(self):
        if self.sitId:
            self.cell.sit(sitting_settings.Stand)

    def _start_holster(self):
        self.HolsterWeapon()
        self.wait_holstering = True

    def _holster_comleted(self):
        self._start_sit()

    def _start_unholster(self):
        self.setControlLock(Constants.ControlLockTypes.SITTING, False)
        self._unholstering = True
        self.HolsterWeapon()

    def _start_sit(self):
        if self.dead:
            return
        if self.sitId not in animations:
            return
        inAnimation = animations[self.sitId]['in']
        loopAnimation = animations[self.sitId]['loop']
        queue = getattr(self.model, inAnimation)(0, self._sit_completed)
        getattr(queue, loopAnimation)()

    def _sit_completed(self):
        self._idlesit = True

    def _start_stand(self, old_sitId):
        if not self.dead:
            standAnimation = animations[old_sitId]['out']
            getattr(self.model, standAnimation)(0, self._stand_completed, 1)
        else:
            self._stand_completed()
            self._break_sit_animatin(old_sitId)
        self._idlesit = False

    def _stand_completed(self):
        if hasattr(self, '_armed_before_sitting') and self._armed_before_sitting:
            self._start_unholster()
        else:
            self.setControlLock(Constants.ControlLockTypes.SITTING, False)

    def _break_sit_animatin(self, old_sitId):
        if old_sitId not in animations:
            return
        getattr(self.model, animations[old_sitId]['in']).stop()
        getattr(self.model, animations[old_sitId]['loop']).stop()
        getattr(self.model, animations[old_sitId]['out']).stop()