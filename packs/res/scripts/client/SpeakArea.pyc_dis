    def on_dialog_started(self, interlocutor_id, dialog_id):
        """ \xd1\x83\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xbe\xd0\xbc\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5 \xd0\xb4\xd0\xb8\xd0\xb0\xd0\xbb\xd0\xbe\xd0\xb3\xd0\xb0 """
        player = BigWorld.player()
        interlocutor = BigWorld.entities.get(interlocutor_id)
        if interlocutor:
            player.initializeTalk(interlocutor)
            dialog = dd.get_dialog_by_id(dialog_id)
            if player.request_quests_from_dialog(dialog):
                pass
            elif dialog['Actions']['CompleteQuest']:
                player.questerRequestCompleted(dialog)

