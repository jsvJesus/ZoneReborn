# Embedded file name: ./scripts/client/Monster.py
import BigWorld
from Victim import Victim
from Config import Monsters as Config
from Teleportable import Teleportable
from Colliders import COLLIDER_NODE_NAME, COLLIDER_BOX_NAME, COLLIDER_BODY_ZONE, COLLIDER_MIN_BOUNDS, COLLIDER_MAX_BOUNDS
from Damager import Damager
from AI.Debugger import Debugger
from AI.ComboUser import ComboUser
from Bleeding import Bleeding
from ItemHolder import ItemHolder
from Helpers import Caps
from MonsterCommon import MonsterCommon
import utils_bw
import Constants

class Monster(BigWorld.Entity, Victim, Damager, Teleportable, Bleeding, Debugger, ItemHolder, MonsterCommon, ComboUser):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        Bleeding.__init__(self)
        Debugger.__init__(self)
        self.targetCaps = []

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model(Config.get_model_path(self.type_id))
        self.filter = BigWorld.AvatarDropFilter()
        Victim.add_collider(self)
        for box_cfg in Config.get_colliders(self.type_id):
            self.attach_collider_box(box_cfg[COLLIDER_BOX_NAME], box_cfg[COLLIDER_NODE_NAME], box_cfg[COLLIDER_BODY_ZONE], box_cfg[COLLIDER_MIN_BOUNDS], box_cfg[COLLIDER_MAX_BOUNDS])

        self.model.motors[0].turnModelToEntity = True
        persistent_action = Config.get_persistent_action(self.type_id, self.cur_state_index)
        if persistent_action:
            getattr(self.model, persistent_action)()

    def onLeaveWorld(self):
        self.model = None
        return

    def onTeleportCalled(self, teleport_type, expected_position):
        self.filter = BigWorld.DumbFilter()

    def onTeleportEnded(self, wasSuccessful, direction = None):
        self.filter = BigWorld.AvatarDropFilter()

    def set_cur_state_index(self, old_value):
        """ \xd0\xb2\xd1\x85\xd0\xbe\xd0\xb4 \xd0\xb2 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb5 \xd1\x81\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe\xd1\x8f\xd0\xbd\xd0\xb8\xd0\xb5 """
        Debugger.set_cur_state_index(self, old_value)
        on_exit = Config.get_state_on_exit(self.type_id, old_value)
        if on_exit:
            on_exit(self)
        on_entry = Config.get_state_on_entry(self.type_id, self.cur_state_index)
        if on_entry:
            on_entry(self)
        action_seq = None
        entry_action = Config.get_entry_action(self.type_id, self.cur_state_index)
        if entry_action:
            action_seq = getattr(self.model, entry_action)()
        persistent_action = Config.get_persistent_action(self.type_id, self.cur_state_index)
        if persistent_action:
            if action_seq:
                getattr(action_seq, persistent_action)()
            else:
                getattr(self.model, persistent_action)()
        return

    def set_cur_target(self, old_target):
        Debugger.set_cur_target(self, old_target)

    def on_death(self, source_data, item_type, noSound = False):
        self.targetCaps = [Caps.CAP_CAN_OPEN_AND_EXPLORE]

    def onOpen(self, player):
        pass

    def recompose(self):
        self.targetCaps = []

    @property
    def name(self):
        return Config.get_name(self.type_id)

    def setDefenceStat(self, defence):
        pass

    def set_CarryingItems(self, old_value):
        """ \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb0 """
        if utils_bw.inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE):
            BigWorld.player().NeedToUpdateItemCache()
        if self.CarryingItems:
            if self.dead:
                self.targetCaps = [Caps.CAP_CAN_OPEN_AND_EXPLORE]
        else:
            self.targetCaps = []
            BigWorld.player().NeedToCloseItemCache(self)