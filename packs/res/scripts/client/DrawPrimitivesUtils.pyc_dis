class PlayerPrimitives:

    def __init__(self):
        self.coroutine = None
        self.models = []
        return

    def add_primitive(self, p_type, size):
        if not size.isdigit():
            return False
        if p_type in ('0', 'sphere'):
            model_path = 'models/bolvan/helpers/test_sphere_wire.model'
        elif p_type in ('1', 'box'):
            model_path = 'models/bolvan/helpers/test_box_wire.model'
        else:
            return False
        model = BigWorld.Model(model_path)
        size = int(size)
        model.scale = (size, size, size)
        self.models.append(model)
        BigWorld.addModel(model)
        return True

    def run(self):
        if self.coroutine:
            return
        self.coroutine = self._run_coroutine()
        self.coroutine.run()

    @BWMemberCoroutine
    def _run_coroutine(self):
        while self.coroutine:
            position = BigWorld.player().position
            for m in self.models:
                m.position = position

            yield BWWaitForPeriod(0)

    def stop(self):
        if not self.coroutine:
            return
        else:
            self.coroutine.stop()
            self.coroutine = None
            map(BigWorld.delModel, self.models)
            self.models = []
            return