import BigWorld
from Math import Vector3, Matrix
import math
from Helpers.BWCoroutine import BWMemberCoroutine, BWWaitForPeriod
RED_COLOR = (1, 0, 0, 1)

def draw_circle_xz(position, radius, color = RED_COLOR):
    p = BigWorld.player()
    result = []
    for i in range(8):
        pos1 = position + vertices_xz[i] * radius
        pos2 = position + vertices_xz[i - 1] * radius
        p.model.addLineDraw(pos1, pos2, color, True)
        result.append(pos1)

    return result


def draw_circle_xy(position, radius, color = RED_COLOR):
    p = BigWorld.player()
    result = []
    for i in range(8):
        pos1 = position + vertices_xy[i] * radius
        pos2 = position + vertices_xy[i - 1] * radius
        p.model.addLineDraw(pos1, pos2, color, True)
        result.append(pos1)

    return result


def clear_drawings():
    BigWorld.player().clearLines()


def draw_line(position, position2, color = RED_COLOR):
    BigWorld.player().model.addLineDraw(position, position2, color, True)


def draw_sphere(position, radius, color = RED_COLOR):
    prev_result = None
    p = BigWorld.player()
    for i in range(1, 8):
        internal_radius = vertices_xy16[i].x * radius
        height = vertices_xy16[i].y * radius
        result = draw_circle_xz(position + (0, height, 0), internal_radius, color)
        if prev_result:
            for i in range(len(result)):
                p.model.addLineDraw(result[i], prev_result[i], color, True)

        prev_result = result

    return


def draw_ray(position, direction, color = RED_COLOR):
    d = Vector3(direction)
    d.normalise()
    position2 = position + d * 10.0
    BigWorld.player().model.addLineDraw(position, position2, color, True)


def draw_cone(entity, angle, near_plane, far_plane, disp, direction, color = RED_COLOR):
    entity.model.clearLines()
    scale_matrix = Matrix()
    tan = math.tan(angle * 0.5)
    scale_matrix.setScale((far_plane * tan, far_plane, far_plane * tan))
    near_scale_matrix = Matrix()
    near_scale_matrix.setScale((near_plane * tan, near_plane, near_plane * tan))
    result_matrix = Matrix()
    near_result_matrix = Matrix()
    result_matrix.postMultiply(scale_matrix)
    near_result_matrix.postMultiply(near_scale_matrix)
    rotate_matrix = Matrix()
    rotate_matrix.setRotateYPR((entity.yaw, 0, 0))
    disp = rotate_matrix.applyPoint(Vector3(disp))
    rotate_matrix2 = Matrix()
    rotate_matrix2.setRotateYPR((direction.yaw, direction.pitch + math.pi * 0.5, 0))
    origin_point = entity.position + disp
    translate_matrix = Matrix()
    translate_matrix.setTranslate(origin_point)
    result_matrix.postMultiply(rotate_matrix2)
    near_result_matrix.postMultiply(rotate_matrix2)
    result_matrix.postMultiply(translate_matrix)
    near_result_matrix.postMultiply(translate_matrix)
    vertices = [ result_matrix.applyPoint(vertex) for vertex in vertices_cone[:-8] ]
    vertices.extend([ near_result_matrix.applyPoint(vertex) for vertex in vertices_cone[-8:] ])
    for step in range(0, len(cone_indices), 2):
        p1 = vertices[cone_indices[step]]
        p2 = vertices[cone_indices[step + 1]]
        entity.model.addLineDraw(p1, p2, color, True)


def draw_cilinder(position, radius, height, color = RED_COLOR):
    prev_result = None
    p = BigWorld.player()
    for i in range(5):
        internal_height = height * i / 4.0
        result = draw_circle_xz(position + (0, internal_height, 0), radius, color)
        if prev_result:
            for i in range(len(result)):
                p.model.addLineDraw(result[i], prev_result[i], color, True)

        prev_result = result

    return


vertices_xz = []
vertices_xy = []
vertices_cone = []
vertices_xy16 = []
for i in range(8):
    angle = math.pi / 4.0 * i
    pos_1 = math.sin(angle)
    pos_2 = math.cos(angle)
    vertices_cone.append(Vector3(pos_1, 1.0, pos_2))
    vertices_xz.append(Vector3(pos_1, 0, pos_2))
    vertices_xy.append(Vector3(pos_1, pos_2, 0))

vertices_cone.append(Vector3(0.0, 0.0, 0.0))
vertices_cone.append(Vector3(0.0, 1.0, 0.0))
vertices_cone.extend(vertices_cone[:8])
for i in range(16):
    angle = math.pi / 8.0 * i
    pos_1 = math.sin(angle)
    pos_2 = math.cos(angle)
    vertices_xy16.append(Vector3(pos_1, pos_2, 0))

