# Embedded file name: ./scripts/client/ModelSelector.py
import BigWorld
import ResMgr
DEFAULT_MODEL = 0

class ModelSelector:
    FLAG_MODEL = 50
    FLAGPOLE_MODEL = 51
    FLAGPOLE_AND_FLAG_MODEL = 28
    FLAGPOLE_BUTTON_MODEL = 86
    SIGN_STAR_1 = 29
    SIGN_STAR_2 = 30
    SIGN_STAR_3 = 40
    MODELS = {}
    source = ResMgr.openSection('scripts/client/data/editor.xml')
    for item in source.values():
        MODELS[item['value'].asInt] = item['path'].asString

    def prerequisites(self):
        return [self.MODELS[self.modelSelect]]

    def setObstacleModel(self):
        BigWorld.fetchModelObstacle(self.MODELS[self.modelSelect], self.matrix, 0, self.onLoadModel)

    def setNormalModel(self, prereqs = None):
        if prereqs is None:
            BigWorld.fetchModel(self.MODELS[self.modelSelect], self.onLoadModel)
        else:
            self.onLoadModel(prereqs[self.MODELS[self.modelSelect]])
        return

    def onEnterWorld(self, prereqs):
        self.setNormalModel(prereqs)

    def onLoadModel(self, model):
        if self.isDestroyed:
            return
        self.model = model
        try:
            self.model.no_draw = 'no_draw'
        except:
            pass

    def onLeaveWorld(self):
        self.model = None
        return