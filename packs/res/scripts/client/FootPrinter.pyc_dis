# Embedded file name: ./scripts/client/FootPrinter.py
import BigWorld
import BWPersonality
import time
from Notices import Notices
import SFXer
import Math
import Settings
import sfx
import traceback
import ResMgr
import json
import rainConstant
from utils_bw import if_not_destroyed
import utils_bw
import sounds
from functools import partial
DEBUG_OFF_SOUNDS = False

def _read_footsteps_settings(path):
    try:
        py_data_section = ResMgr.openSection(path)
        raw_configs = json.loads(py_data_section.asBinary)
    except:
        print 'path: ', repr(path)
        raise

    return raw_configs


footsteps_cache = {}

def get_settings(path):
    data = footsteps_cache.get(path)
    if data:
        return data
    data = _read_footsteps_settings(path)
    data['by_marterial_kind'] = dict(((int(mat_id), val) for mat_id, val in data['by_marterial_kind'].items()))
    footsteps_cache[path] = data
    return data


class FootPrinter(object):
    DEBUG_PRINT = False
    DEF_PATH_FOOTSTEPS = 'scripts/client/data/footsteps/avatar.json'
    avatarInWater = 0
    underWaterLevel1 = 0
    underWaterLevel2 = 0
    underWaterLevel3 = 0
    underWaterPathLevel1 = ''
    underWaterPathLevel2 = ''
    underWaterPathLevel3 = ''
    avatarInWaterLevel = 0
    timeEnterWater1 = 0
    timeWaterExplosionDelta = 0.2
    soundfootspeed = 1.0
    soundVolumeFoots = 1.0
    __last_surfaceHeigh = 0.0
    __timer_reatt = 0
    __water_volume_enable = True
    _foot_cue_models = None
    _foot_nodes = None
    _foot_settings_path = None
    _foot_settings = None

    def getFootCueSettingsPath(self):
        if self.active_transform:
            footsteps = self.active_transform.getparam('footsteps_settings_path')
            if footsteps:
                return footsteps
        return self.DEF_PATH_FOOTSTEPS

    @if_not_destroyed
    def createFootTriger(self):
        self.__last_surfaceHeight = 0.0
        self.deleteFootTriger(force_save=True)
        self._foot_settings_path = self.getFootCueSettingsPath()
        self._foot_settings = get_settings(self._foot_settings_path)
        self._foot_nodes = self._foot_settings['cue_to_node']
        self._sound_only_for_me = self._foot_settings.get('sound_only_for_me')
        if self.DEBUG_PRINT:
            print 'createFootTriger', self, self._foot_nodes
        self.__water_volume_enable = True
        hips_path = self._foot_settings['water_node_hips_crouch'] if self.crouching else self._foot_settings['water_node_hips_stay']
        hips_path = str(hips_path)
        head_path = str(self._foot_settings['water_node_head'])
        head_node = self.model.node(head_path)
        matrixAddHead = Math.Matrix()
        matrixAddHead.setTranslate((0, self._foot_settings['add_water_node_head_height'], 0))
        mprod = Math.MatrixProduct()
        mprod.a = head_node
        mprod.b = matrixAddHead
        hips_node = self.model.node(hips_path)
        self.waterListenerHead = BigWorld.addWaterVolumeListener(mprod, self.waterCross3)
        self.waterListenerHips = BigWorld.addWaterVolumeListener(hips_node, self.waterCross2)
        self.waterListener = BigWorld.addWaterVolumeListener(self.matrix, self.waterCross1)
        self._foot_cue_models = {}
        if self._sound_only_for_me and self != BigWorld.player():
            return
        for cue_name, node_name in self._foot_nodes.items():
            node = self.model.node(str(node_name))
            sound_model = BigWorld.Model('')
            self._foot_cue_models[cue_name] = sound_model
            node.attach(sound_model)
            self.model.cue(cue_name, partial(self._cueTrigger, cue_name))

    def _cueTrigger(self, cue_name, event_time):
        if self.isDestroyed:
            return
        elif self._sound_only_for_me and self != BigWorld.player():
            return
        elif not self._foot_cue_models:
            return
        elif not self.__water_volume_enable:
            return
        elif DEBUG_OFF_SOUNDS:
            return
        else:
            node_name = self._foot_nodes[cue_name]
            if self.avatarInWaterLevel:
                self._playSfxStepInWater(cue_name)
                return
            cam_pos = BigWorld.camera().position
            if cam_pos.distTo(self.position) > 20.0:
                return
            sound_model = self._foot_cue_models[cue_name]
            if sound_model.position.distTo(self.model.position) > 3.0:
                sound_model = self.model
            toPos = sound_model.position
            cl = utils_bw.collide(self.spaceID, toPos + (0, 0.1, 0), toPos + (0, -0.5, 0))
            if not cl:
                if self.DEBUG_PRINT:
                    print 'no collide:'
                    m = BigWorld.Model('models/test/xyz.model')
                    self.addModel(m)
                    m.position = toPos
            if cl:
                matID = cl[-1]
                data = self._foot_settings['by_marterial_kind'][matID]
                mat_sound = str(data[cue_name]['sound'])
                mat_sfx = str(data[cue_name]['sfx'])
                if self.DEBUG_PRINT:
                    print 'matKindSound:', matID, mat_sound, mat_sfx
                if mat_sound:
                    sound = None
                    err = None
                    try:
                        sound = sounds.playSound(mat_sound, sound_model)
                    except Exception as err:
                        pass

                    if not sound:
                        print 'not found foot sound:', self, repr(mat_sound), 'by_marterial_kind:', matID, self._foot_settings_path, err
                        return
                    shell_mod = 1.0
                    if BigWorld.isOtside(self.spaceID, toPos) != BigWorld.player().isOutsideShell():
                        shell_mod = rainConstant.foot_volume_in_shell
                    if not sound.isVirtual:
                        sound.volume = Settings.Settings().getSfxVolume() * self.soundVolumeFoots
                        sound.fmod_sound.param('Speed').value = self.soundfootspeed
                if mat_sfx:
                    pass
            return

    def _playSfxStepInWater(self, cue_name):
        if self.avatarInWaterLevel == 1:
            sound_model = self._foot_cue_models[cue_name]
            sfxpath = self._foot_settings['sfx_foot_in_water_lev1']
            sfxpath = str(sfxpath)
            if not sfxpath:
                return
            toPos = sound_model.position
            fromPos = toPos + (0, 10, 0)
            waterpos = BigWorld.waterCollide(0, fromPos, toPos)
            if waterpos:
                waterpos = waterpos[0]
                SFXer.footWaterStep(self, waterpos, sfxpath, alignToVector=None, lifeTime=3.3)
                if self.DEBUG_PRINT:
                    print waterpos, sfxpath
        else:
            if self.avatarInWaterLevel == 2:
                key = 'sfx_foot_in_water_lev2'
            if self.avatarInWaterLevel == 3:
                key = 'sfx_foot_in_water_lev3'
            sfxpath = self._foot_settings[key][cue_name]
            sfxpath = str(sfxpath)
            if not sfxpath:
                return
            if self.DEBUG_PRINT:
                print '_playSfxStepInWater sfxpath:', sfxpath
            sfx.bufferedOneShotSFX(sfxpath, self.model, maxDuration=4.0)
        return

    def deleteFootTriger(self, force_save = False):
        self.__water_volume_enable = False
        if self.DEBUG_PRINT:
            print 'deleteFootTriger', self
        if getattr(self, 'waterListener', False):
            BigWorld.delWaterVolumeListener(self.waterListener)
            self.waterListener = None
        if getattr(self, 'waterListenerHips', False):
            BigWorld.delWaterVolumeListener(self.waterListenerHips)
            self.waterListenerHips = None
        if getattr(self, 'waterListenerHead', False):
            BigWorld.delWaterVolumeListener(self.waterListenerHead)
            self.waterListenerHead = None
        if self._foot_nodes:
            for node_name in self._foot_nodes.values():
                try:
                    self.model.node(node_name).attachments = []
                except:
                    pass

        self.footTriggers = []
        if self.avatarInWaterLevel and not force_save:
            print 'clear water: %s' % self.avatarInWaterLevel
            self.avatarInWaterLevel = 0
            self.underWaterLevel1 = 0
            self.underWaterLevel2 = 0
            self.underWaterLevel3 = 0
            self.updateWaterNotifer()
        return

    @if_not_destroyed
    def waterCross1(self, enterWater, volume):
        self.avatarInWater = int(enterWater)
        self.underWaterLevel1 = int(enterWater)
        self.applyWaterLevel()
        if enterWater:
            self.timeEnterWater1 = time.time()
        elif self.underWaterLevel2 != int(enterWater):
            self.waterCross2(enterWater, volume)
        self.changeWater([Notices.LEAVE_WATER, Notices.ENTER_WATER], enterWater, volume)

    @if_not_destroyed
    def waterCross2(self, enterWater, volume):
        self.underWaterLevel2 = int(enterWater)
        self.applyWaterLevel()
        if enterWater:
            self.checkSplashingWater()
        elif self.underWaterLevel3 != int(enterWater):
            self.waterCross3(enterWater, volume)
        self.changeWater([Notices.LEAVE_WATER_HIPS, Notices.ENTER_WATER_HIPS], enterWater, volume)

    @if_not_destroyed
    def waterCross3(self, enterWater, volume):
        self.underWaterLevel3 = int(enterWater)
        self.applyWaterLevel()
        self.changeWater([Notices.LEAVE_WATER_HEAD, Notices.ENTER_WATER_HEAD], enterWater, volume)

    def applyWaterLevel(self):
        self.avatarInWaterLevel = max([self.underWaterLevel1, self.underWaterLevel2 * 2, self.underWaterLevel3 * 3])

    def checkSplashingWater(self):
        difTime = time.time() - self.timeEnterWater1
        if self.DEBUG_PRINT:
            print 'difTime', difTime
        if difTime < self.timeWaterExplosionDelta:
            sfx_path = str(self._foot_settings['sfx_splashing_water'])
            sfx.bufferedOneShotSFX(sfx_path, self.model)

    def changeWater(self, levels, enterWater, volume):
        if self.DEBUG_PRINT:
            print 'changeWater', self.avatarInWaterLevel, levels, enterWater, volume
        for triger in self.footTriggers:
            triger.underWater = self.avatarInWaterLevel

        if self != BigWorld.player():
            return
        if not self.__water_volume_enable:
            return
        if enterWater:
            ht = str(volume.surfaceHeight)
            self.__last_surfaceHeigh = ht
            self.cell.notify(levels[int(enterWater)], [ht])
        else:
            self.cell.notify(levels[int(enterWater)], [])

    def updateWaterNotifer(self):
        if self != BigWorld.player():
            return
        self.cell.notify([Notices.LEAVE_WATER, Notices.ENTER_WATER][int(self.underWaterLevel1)], [str(self.__last_surfaceHeigh)])
        self.cell.notify([Notices.LEAVE_WATER_HIPS, Notices.ENTER_WATER_HIPS][int(self.underWaterLevel2)], [str(self.__last_surfaceHeigh)])
        self.cell.notify([Notices.LEAVE_WATER_HEAD, Notices.ENTER_WATER_HEAD][int(self.underWaterLevel3)], [str(self.__last_surfaceHeigh)])

    def waterCollide(self, scr, hitPoint):
        try:
            waterpos = BigWorld.waterCollide(0, scr, hitPoint)
        except:
            print [scr, hitPoint]
            raise

        return waterpos

    def drawWaterFire(self, waterpos):
        if waterpos:
            waterpos = waterpos[0]
            waterpos = waterpos + (0, -0.1, 0)
            sfxpath = 'sfx/hits/water.xml'
            self.lastwaterpos = waterpos
            SFXer.waterHit(self, waterpos, sfxpath, alignToVector=None, lifeTime=3.3)
            return True
        else:
            return False

    def tooFootUpdateCrouch(self):
        if self.DEBUG_PRINT:
            print '>tooFootUpdateCrouch', self
        if not self.__water_volume_enable:
            return
        if not self._foot_settings:
            return
        if self._sound_only_for_me and self != BigWorld.player():
            return
        hips_path = self._foot_settings['water_node_hips_crouch'] if self.crouching else self._foot_settings['water_node_hips_stay']
        hips_path = str(hips_path)
        try:
            BigWorld.delWaterVolumeListener(self.waterListenerHips)
        except:
            traceback.print_exc()

        self.waterListenerHips = BigWorld.addWaterVolumeListener(self.model.node(hips_path), self.waterCross2)

    def onHideLoadprogress(self):
        if self.DEBUG_PRINT:
            print '>onHideLoadprogress', self

    def reAtachWaterVolumeDealayed(self, after = 2.0, dont_clear = False):
        if self.isDestroyed:
            return
        if self.DEBUG_PRINT:
            print '>reAtachWaterVolumeDealayed', self
        try:
            if not dont_clear:
                self.deleteFootTriger()
        except:
            traceback.print_exc()

        BigWorld.cancelCallback(self.__timer_reatt)
        if BWPersonality.GUICore.isVisibleLoaderGUI():
            self.__timer_reatt = BigWorld.callback(after, self.reAtachWaterVolumeDealayed)
            return
        if not BigWorld.worldDrawEnabled():
            self.__timer_reatt = BigWorld.callback(after, self.reAtachWaterVolumeDealayed)
            return
        self.__timer_reatt = BigWorld.callback(after, self.createFootTriger)