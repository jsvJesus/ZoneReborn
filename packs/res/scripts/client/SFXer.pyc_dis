def AddPixieToEntity(entity, particle_name, node = None, callBackFn = None):

    def onLoadLensFlare(ps):
        node.attach(ps)
        ps.force()
        if callBackFn:
            callBackFn(ps)

    if node == None:
        node = entity.model.root
    onLoadLensFlare(Pixie.create(particle_name))
    return


def onSandbagDelete(sandbag_entity):
    pass


def playSFX(sfx_path, position, direction = None, delay = 0.0, timeLife = 10.0):
    explosion_model = BigWorld.Model('')
    explosion_model.position = position
    BigWorld.player().addModel(explosion_model)
    if not direction:
        direction = Math.Vector3(0, -1, 0)

    def play():
        sfx.bufferedOneShotSFX(sfx_path, explosion_model, DecalInfo=[position - direction, position + direction], forceDecal=True)
        BigWorld.callback(timeLife, partial(BigWorld.player().delModel, explosion_model))

    BigWorld.callback(delay, play)