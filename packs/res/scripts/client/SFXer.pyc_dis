def get_gun_explosive_gas_sfx_path(sfx_type):
    try:
        sfx_paths = sfx_type[1]
    except Exception:
        sfx_paths = None

    _sfx = None
    if isinstance(sfx_paths, str):
        _sfx = sfx_paths
    elif isinstance(sfx_paths, list):
        _sfx = random.choice(sfx_paths)
    elif isinstance(sfx_paths, dict):
        unwrapped_sfxs = [ itertools.repeat(k, v) for k, v in sfx_paths.iteritems() if v < 10 ]
        _sfx = random.choice(list(itertools.chain(*unwrapped_sfxs)))
    return _sfx


def get_gunfire_sfx_path(sfx_type):
    try:
        sfx_paths = sfx_type[0]
    except:
        sfx_paths = 'sfx/weapons/gun_fire.xml'

    _sfx = None
    if isinstance(sfx_paths, str):
        _sfx = sfx_paths
    elif isinstance(sfx_paths, list):
        _sfx = random.choice(sfx_paths)
    elif isinstance(sfx_paths, dict):
        unwrapped_sfxs = [ itertools.repeat(k, v) for k, v in sfx_paths.iteritems() if v < 10 ]
        _sfx = random.choice(list(itertools.chain(*unwrapped_sfxs)))
    return _sfx


def get_sfx_target(player):
    if player.isDestroyed or not player.autogunModel:
        return
    elif player.hp_barrel is not None and player.hp_barrel_node is not None and player.hp_barrel_node.isActualCoords:
        return player.hp_barrel
    else:
        return player.autogunModel
        return


def GunSmoke(player, sfx_type):
    if not player.autogunModel:
        return
    target = get_sfx_target(player)
    sfx_path = get_gun_explosive_gas_sfx_path(sfx_type)
    if not sfx_path:
        return
    FX.bufferedOneShotEffect(sfx_path, target)


def GunFire(player, sfx_type):
    sfx_path = get_gunfire_sfx_path(sfx_type)
    if not player.autogunModel:
        return
    if not sfx_path:
        return
    target = get_sfx_target(player)
    FX.bufferedOneShotEffect(sfx_path, target)


