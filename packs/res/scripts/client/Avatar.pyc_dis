    def showAutogun(self):
        if self.isDestroyed:
            return
        else:
            self.autogunModelVisible = True
            if self.autogunModel:
                if self.active_transform:
                    if self.active_transform.getparam('hide_weapon'):
                        self.hideAutogun()
                        return
                self.autogunModel.visible = True
                self.autogunModel.visibleAttachments = False
                for nodename in 'barrel launcher shell lights weaponback rib magazine launchnode1'.split():
                    try:
                        node = getattr(self.autogunModel, nodename)
                    except:
                        continue

                    if node:
                        node.visible = True
                        node.visibleAttachments = False

            if self.ActiveThrowID and self.ActiveThrowType:
                throw_param = ItemsCatalog.GetItemParam(self.ActiveThrowType)
                if not self._throw_model:
                    self._throw_model = BigWorld.Model(throw_param['modelName'])
                self.model.ThrowRight = self._throw_model
                self.model.effectorright = None
            return

    def hideAutogun(self):
        self.autogunModelVisible = False
        if self.autogunModel:
            self.autogunModel.visible = False
            if self.active_transform and self.active_transform.getparam('hide_weapon'):
                self.autogunModel.visibleAttachments = False
            else:
                self.autogunModel.visibleAttachments = True
            for nodename in 'barrel launcher shell lights weaponback rib magazine launchnode1'.split():
                try:
                    node = getattr(self.autogunModel, nodename)
                except:
                    continue

                if node:
                    node.visible = False
                    node.visibleAttachments = nodename != 'lights'

        if self.ActiveThrowID and self.ActiveThrowType and self.model:
            self.model.ThrowRight = None
        return

    def showModel(self):
        self.model.visible = True
        self.model.visibleAttachments = False
        for nodename in 'spine1 backpack_noarmor backpack weaponback effectorleft effectorright ThrowRight head Pistol knife'.split():
            node = getattr(self.model, nodename)
            if node:
                node.visible = True

        if self.autogunModel:
            self.showAutogun()
        for model in (self.model.weaponback, self.model.effectorright):
            if model:
                for nodename in 'barrel launcher shell lights weaponback rib magazine launchnode1'.split():
                    try:
                        node = getattr(model, nodename)
                    except:
                        continue

                    if node:
                        node.visible = True
                        node.visibleAttachments = False

    def hideModel(self):
        self.model.visible = False
        self.model.visibleAttachments = True
        for nodename in 'spine1 backpack_noarmor backpack weaponback effectorleft effectorright ThrowRight head Pistol knife'.split():
            node = getattr(self.model, nodename)
            if node:
                node.visible = False

        if self.autogunModel:
            self.hideAutogun()
        for model in (self.model.weaponback, self.model.effectorright):
            if model:
                for nodename in 'barrel launcher shell lights weaponback rib magazine launchnode1'.split():
                    try:
                        node = getattr(model, nodename)
                    except:
                        continue

                    if node:
                        node.visible = False
                        node.visibleAttachments = True

