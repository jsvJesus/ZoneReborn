        self.item_id = ItemsCatalog.MAX_ITEM_NUMBER + 1
        playersdata = BWPersonality.game.playersdata
        if not hasattr(self, 'CarryingItems'):
            self.CarryingItems = []
        self.spawn_new_item(ItemsCatalog.GLASSES_KOBRA_MASK['TypeID'])
