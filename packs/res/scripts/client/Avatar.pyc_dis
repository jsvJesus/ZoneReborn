    def getFractionRelationship(self, fractionID):
        for relation in self.relationsWithFractions:
            if relation['fractionID'] == fractionID:
                return relation['status']

        return Fractions.PlayerStatusDefault.get(fractionID, 0)

    def worldLoadReact(self):
        if not self.model:
            return
        pl = BigWorld.player()
        if self == pl:
            return
        self.model.visible = not pl.hide_all_other_avatar_status

    def set_worldLoad(self, v):
        print 'set_worldLoad', v, self.worldLoad
        self.worldLoadReact()

    def add_collider(self):
        Victim.add_collider(self)
        if self.active_transform and self.active_transform.raw_configs.get('isHelicopter'):
            if not self.vechicle_contorled or not self.vechicle_contorled._model:
                return
        if self.active_transform and self.active_transform.colliders() != 'DEF':
            cld = self.active_transform.colliders()
            if not cld:
                return
            for bbox in cld:
                self.attach_collider_box(bbox[COLLIDER_BOX_NAME], bbox[COLLIDER_NODE_NAME], bbox[COLLIDER_BODY_ZONE], bbox[COLLIDER_MIN_BOUNDS], bbox[COLLIDER_MAX_BOUNDS])

        else:
            for bbox in BigWorld.player().bboxData:
                self.attach_collider_box(bbox['name'], bbox['bone'], bbox['boneid'], bbox['min'], bbox['max'])

    def prerequisites(self):
        model_set, head_attachments, back_pack_attachments, weapon_back_attachments, weapon_pistol_attachments, model_tints_dict, head_tints_dict, backback_tints_dict = StalkerModel.set_model_due_to_inventory(self, self.getDefaultModels())
        res = []
        for ex in (model_set, head_attachments, back_pack_attachments):
            for e in ex:
                if e is not None:
                    res.append(e)

        active_item_models = self.GetEquippedItemModels(ItemsCatalog.ACTIVE)
        for model_collection in (weapon_back_attachments, weapon_pistol_attachments, active_item_models):
            if model_collection:
                for model_list in model_collection.values():
                    if model_list[ItemsUtils.MODEL_LIST_POSITION]:
                        res.append(model_list[ItemsUtils.MODEL_LIST_POSITION])

        return res

    def onEnterWorld(self, pre = None):
        self.filter = BigWorld.AvatarFilter()
        if getattr(self, 'transformationID', 0):
            self.set_transformationID(0)
        self.SetAvatarModel()
        if hasattr(self, 'worldLoad'):
            self.worldLoadReact()
        BigWorld.player().avatarOnEnterWorld(self)
        BurnInterface.onEnterWorld(self, pre)

