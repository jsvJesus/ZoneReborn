        self.spawn_new_item(ItemsCatalog.AMMO_9x19_AP['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_9x19_AP['TypeID'])
        self.spawn_new_item(ItemsCatalog.SIG_751_ASSAULT_RIFLE['TypeID'])
        self.spawn_new_item(ItemsCatalog.SNIPER1_NATO_SCOPE['TypeID'])
        self.spawn_new_item(ItemsCatalog.FLASH2_NATO_LIGHT['TypeID'])
        self.spawn_new_item(ItemsCatalog.ASSAULT_7_SILENCER['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_762x51_FMJ['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_762x51_FMJ['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_762x51_FMJ['TypeID'])
        self.spawn_new_item(ItemsCatalog.VSS_SNIPER_RIFLE['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_9x39_AP_SP6['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_9x39_AP_SP6['TypeID'])
        self.spawn_new_item(ItemsCatalog.AMMO_9x39_AP_SP6['TypeID'])
        self.spawn_new_item(ItemsCatalog.PSO1_USSR_SCOPE['TypeID'])
        self.spawn_new_item(ItemsCatalog.WEAPON_USSR_LIGHT['TypeID'])
        self.spawn_new_item(ItemsCatalog.VAL_MAGAZINE['TypeID'])
        player_name = self.name
        if player_name != u'' and playersdata.get(player_name):
            player_name_print = self.name
            print 'prerequisites: ' + player_name_print.encode('utf-8')
            if playersdata[player_name].get('ActiveItemID'):
                self.ActiveItemID = playersdata[player_name]['ActiveItemID']
            if playersdata[player_name].get('ActiveItemType'):
                self.ActiveItemType = playersdata[player_name]['ActiveItemType']
            for paramname, idx in self.ActiveArmorSet.items():
                if playersdata[player_name].get('ActiveArmorSet'):
                    self.ActiveArmorSet[paramname] = playersdata[player_name]['ActiveArmorSet'][paramname]

            for paramname, idx in self.ActiveWeaponSet.items():
                if playersdata[player_name].get('ActiveWeaponSet'):
                    self.ActiveWeaponSet[paramname] = playersdata[player_name]['ActiveWeaponSet'][paramname]

            for paramname, idx in self.PrimaryWeaponUpgrades.items():
                if playersdata[player_name].get('PrimaryWeaponUpgrades'):
                    self.PrimaryWeaponUpgrades[paramname] = playersdata[player_name]['PrimaryWeaponUpgrades'][paramname]

            for paramname, idx in self.SecondaryWeaponUpgrades.items():
                if playersdata[player_name].get('SecondaryWeaponUpgrades'):
                    self.SecondaryWeaponUpgrades[paramname] = playersdata[player_name]['SecondaryWeaponUpgrades'][paramname]

            for paramname, idx in self.ActiveGadjetSet.items():
                if playersdata[player_name].get('ActiveGadjetSet'):
                    self.ActiveGadjetSet[paramname] = playersdata[player_name]['ActiveGadjetSet'][paramname]

        model_set, head_attachments, back_pack_attachments, weapon_back_attachments, weapon_pistol_attachments, model_tints_dict, head_tints_dict, backback_tints_dict = StalkerModel.set_model_due_to_inventory(self, self.getDefaultModels())
        res = []
        for ex in (model_set, head_attachments, back_pack_attachments):
            for e in ex:
                if e is not None:
                    res.append(e)

        active_item_models = self.GetEquippedItemModels(ItemsCatalog.ACTIVE)
        for model_collection in (weapon_back_attachments, weapon_pistol_attachments, active_item_models):
            if model_collection:
                for model_list in model_collection.values():
                    if model_list[ItemsUtils.MODEL_LIST_POSITION]:
                        res.append(model_list[ItemsUtils.MODEL_LIST_POSITION])

        try:
            for paramname, idx in self.PrimaryWeaponUpgrades.items():
                attachitem = ItemsUtils.GetComplexItemByType(self, idx)
                motherItem = ItemsUtils.GetComplexItemByID(self, self.ActiveWeaponSet['PrimarySlotID'])
                if attachitem and motherItem:
                    ItemsUtils.AttachItem(self, motherItem, attachitem)

            for paramname, idx in self.SecondaryWeaponUpgrades.items():
                attachitem = ItemsUtils.GetComplexItemByType(self, idx)
                motherItem = ItemsUtils.GetComplexItemByID(self, self.ActiveWeaponSet['PrimarySlotID'])
                if attachitem and motherItem:
                    ItemsUtils.AttachItem(self, motherItem, attachitem)

        except:
            pass

        return res

    def onEnterWorld(self, pre = None):
        self.filter = BigWorld.AvatarFilter()
