    def radiometer_beep(self, beep_source, beep_period):
        """ \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80 \xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xbb\xd1\x83\xd1\x88\xd0\xb0\xd0\xbb \xd1\x80\xd0\xb0\xd0\xb4\xd0\xb8\xd0\xbe\xd0\xbc\xd0\xb5\xd1\x82\xd1\x80 \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0 (beep_source) """
        if not BigWorld.entities.get(beep_source) or BigWorld.entities[beep_source].isDestroyed:
            return
        BigWorld.entities[beep_source].radiometer.imitate_working(beep_period)

