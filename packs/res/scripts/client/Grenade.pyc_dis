# Embedded file name: ./scripts/client/Grenade.py
"""
Created on 05.10.2010

@author: muzhig
"""
import random
import BigWorld
from Math import Vector3, Matrix
import FX
import math
import sfx
from Damager import Damager
import SFXer
from Throwable import Throwable
import ItemsUtils
from Victim import Victim
from sfx.SfxCatalog import SFX_HIT_CATALOG
UP_VECTOR = Vector3(0.01, 1, -0.05)
UP_VECTOR.normalise()

class Grenade(BigWorld.Entity, Throwable, Damager):
    SMALL_SPLASH_SFX = 'sfx\\weapons\\grenades\\explode_underwater_surface_3.xml'
    AVARAGE_SPLASH_SFX = 'sfx\\weapons\\grenades\\explode_underwater_surface_2.xml'
    LARGE_SPLASH_SFX = 'sfx\\weapons\\grenades\\explode_underwater_surface_1.xml'
    SMALL_TO_AVARAGE_BORDER = 1.0
    AVARAGE_TO_LARGE_BORDER = 5.0
    BLEED_SFX = 'sfx/hits/body_hit.xml'

    def __init__(self):
        BigWorld.Entity.__init__(self)
        Throwable.__init__(self)
        self.exploded_effect_shown = False
        self.detonated = False
        self.contact_data = None
        self._expl_models = []
        return

    def onLeaveWorld(self):
        if hasattr(self, 'sPersistentSFX'):
            self.sPersistentSFX.stop()
            self.sPersistentSFX.detach()
            del self.sPersistentSFX
        for m in self._expl_models:
            self.delModel(m)

        self._expl_models = None
        return

    def get_max_existence_time(self):
        if self.grenade_type <= 0:
            return
        else:
            explode_time = ItemsUtils.GetExplosionDamage(self.grenade_type)['explodeTime']
            if explode_time is None:
                return
            return explode_time + 3.0

    def set_explode_timer(self):
        if self.controled_by_this_client:
            explode_time = ItemsUtils.GetExplosionDamage(self.grenade_type)['explodeTime']
            if explode_time:
                BigWorld.callback(explode_time, self.detonate)

    def throw(self):
        result = Throwable.throw(self)
        if self.controled_by_this_client:
            self.tick()
        return result

    def onContact(self, pos, direction, vel, tagertId, body_zone, mat_id):
        """ \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd1\x80\xd0\xbe\xd0\xbb\xd0\xb8\xd1\x80\xd1\x83\xd0\xb5\xd0\xbc\xd0\xb0\xd1\x8f \xd1\x8d\xd1\x82\xd0\xb8\xd0\xbc \xd0\xba\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb0 \xd1\x87\xd1\x82\xd0\xbe-\xd1\x82\xd0\xbe \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb0 """
        if self.detonated:
            return
        invincible_time = self.params.get('invincible_time', 0.0)
        if invincible_time and BigWorld.time() - self.spawn_time <= invincible_time:
            return
        self.set_contact_data(pos, direction, vel, tagertId, body_zone, mat_id)
        self.detonate()

    def anomaly_collision_callback(self, anomaly, collision_position):
        """ \xd1\x81\xd1\x82\xd0\xbe\xd0\xbb\xd0\xba\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x81 \xd0\xb0\xd0\xbd\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb5\xd0\xb9 """
        Throwable.anomaly_collision_callback(self, anomaly, collision_position)
        if anomaly.can_destroy_stone():
            self.detonate()

    def set_contact_data(self, pos, direction, vel, target_id, body_zone, mat_id):
        self.contact_data = (pos,
         direction,
         vel,
         target_id,
         body_zone,
         mat_id)

    def get_contact_data(self):
        if self.contact_data:
            return self.contact_data
        else:
            top_pos = self.get_cur_position() + Vector3(0, 0.2, 0)
            bottom_pos = self.get_cur_position() + Vector3(0, -0.2, 0)
            collision = BigWorld.collide(self.spaceID, top_pos, bottom_pos)
            if collision:
                mat_id = collision[2]
            else:
                print 'Grenade (ERROR): out of the map', top_pos, bottom_pos
                mat_id = 0
            return (self.get_cur_position(),
             Vector3(UP_VECTOR),
             None,
             0,
             None,
             mat_id)

    def detonate(self):
        if self.detonated:
            return
        self.detonated = True
        if not self.params.get('explodeInWater', True) and self.under_water:
            return
        pos, direction, vel, target_id, body_zone, mat_id = self.get_contact_data()
        water_collision = BigWorld.waterCollide(self.spaceID, pos, pos - (0, 10, 0))
        water_dist = pos.y - water_collision[0].y if water_collision else 1000
        collision_data = {'target_id': target_id,
         'mat_id': mat_id,
         'position': pos,
         'direction': direction,
         'water_dist': water_dist}
        if self.creature_controlled:
            owner = BigWorld.entity(self.ownerID)
            if owner:
                owner.cell.grenade_exploded(self.originalID, self.skillID, collision_data)
                self.explode_effect(pos, mat_id, direction)
        elif self.npc_controlled:
            owner = BigWorld.entity(self.ownerID)
            if owner:
                owner.cell.grenade_exploded(self.originalID, self.grenade_type, collision_data)
        else:
            player = BigWorld.player()
            if player and player.__class__.__name__ == 'PlayerAvatar':
                player.cell.grenade_exploded(self.id, self.grenade_type, collision_data)
                self.explode_effect(pos, mat_id, direction)

    def play_material_sound(self, mat_id):
        if not self.exploded_effect_shown:
            Throwable.play_material_sound(self, mat_id)

    def explode_effect(self, position, mat_id, direction):
        if self.exploded_effect_shown:
            return
        else:
            self.exploded_effect_shown = True
            self.bouncer = None
            self.model.visible = False
            under_water_sfx = self.params.get('explodeSFX_underwater')
            explode_sfxes = []
            if under_water_sfx and self.under_water:
                explode_sfxes.append(under_water_sfx)
            else:
                hit_category = self.params.get('HitSfxCategory')
                main_explode_sfx = self.params.get('explodeSFX')
                if hit_category:
                    explode_sfxes.append(SFX_HIT_CATALOG[hit_category].get(mat_id) or SFX_HIT_CATALOG[hit_category]['default'])
                if main_explode_sfx:
                    explode_sfxes.append(main_explode_sfx)
            if explode_sfxes:
                explosion_model = BigWorld.Model('')
                m = Matrix()
                m.setRotateYPR(Vector3(direction.yaw, direction.pitch + math.pi * 0.5, 0))
                m_translation = Matrix()
                m_translation.setTranslate(position + direction * 0.1)
                m.postMultiply(m_translation)
                explosion_model.setWorldTransform(m)
                self.addModel(explosion_model)
                self._expl_models.append(explosion_model)
                for explode_sfx in explode_sfxes:
                    sfx.bufferedOneShotSFX(explode_sfx, explosion_model, DecalInfo=[position - direction, position + direction], forceDecal=True)

            if self.under_water:
                depth = self.splash_model.position.y - self.model.position.y
                if depth < Grenade.SMALL_TO_AVARAGE_BORDER:
                    water_sfx = Grenade.LARGE_SPLASH_SFX
                elif depth < Grenade.AVARAGE_TO_LARGE_BORDER:
                    water_sfx = Grenade.AVARAGE_SPLASH_SFX
                else:
                    water_sfx = Grenade.SMALL_SPLASH_SFX
                FX.OneShot(water_sfx).go(self.splash_model)
            radius = self.params.get('DamageRadius')
            if radius:
                draw_ratio = 0.1
                attempts = int(self.params.get('NumPieces', 0) * draw_ratio / 0.5235987755982988)
                attempts = min(attempts, 30)
                if self.ownerID:
                    owner = BigWorld.entity(self.ownerID)
                    if owner and getattr(owner, 'active_transform', None):
                        attempts = 0
                if attempts:
                    player = BigWorld.player()
                    for _ in range(attempts):
                        vec = Vector3(random.uniform(-1, 1), random.uniform(-1, 1), random.uniform(-1, 1))
                        if vec.lengthSquared > 1.0:
                            continue
                        vec.normalise()
                        trace = player.traceBullet(position, vec * radius)
                        hitKind = trace['hitKind']
                        hitPoint = trace['hitPoint']
                        if hitKind == player.traceBullet.HitKindVictim:
                            if not hitPoint:
                                print 'position:', position
                                print 'vec:', vec
                                print 'radius:', radius
                                print 'trace:', trace
                                return
                        if hitKind == player.traceBullet.HitKindVictim:
                            e = trace['entity']
                            if e.canTakeDamage:
                                if hasattr(e, 'pre_bleed'):
                                    e.pre_bleed(hitPoint, trace['bodyZone'], position, hitPoint - direction, self.grenade_type)
                            else:
                                SFXer.ArmorNotBroken(hitPoint, e, reflection=trace['reflection'])
                        elif hitKind == player.traceBullet.HitKindWorld:
                            SFXer.Ricochet(player, position, hitPoint, trace['triangle'], trace['material'], self.grenade_type)

            return

    def explode(self, victims, collision_data):
        self.explode_effect(collision_data['position'], collision_data['mat_id'], collision_data['direction'])
        player = BigWorld.player()
        if player and hasattr(player, 'check_grenade_explode'):
            player.check_grenade_explode(self, self.model.position, victims, collision_data)
        for victimID in victims:
            victim = BigWorld.entities.get(victimID)
            if victim:
                coin = random.random()
                Victim.on_grenaded(victim, self.model.position, collision_data['target_id'], collision_data)
                if victim.__class__.__name__ == 'Avatar':
                    if victim.active_transform and victim.active_transform.raw_configs.get('isHelicopter'):
                        continue
                    normal = victim.position - self.position
                    normal.normalise()
                    normal = victim.position + (0, 0.9, 0) - self.position - (0, 0.1, 0)
                    normal.normalise()
                    SFXer.BodyHit(victim.position + Vector3(0, 0.9 + coin * 0.1, 0), victim, normal, -normal, Grenade.BLEED_SFX)
                    normal = victim.position + (0, 1.2, 0) - self.position - (0, 0.1, 0)
                    normal.normalise()
                    SFXer.BodyHit(victim.position + Vector3(0, 1.1 + coin * 0.2, 0), victim, normal, -normal, Grenade.BLEED_SFX)
                    normal = victim.position + (0, 1.5, 0) - self.position - (0, 0.1, 0)
                    normal.normalise()
                    SFXer.BodyHit(victim.position + Vector3(0, 1.5 + coin * 0.3, 0), victim, normal, -normal, Grenade.BLEED_SFX)
                else:
                    normal = victim.position + (0, 0.2, 0) - self.position
                    normal.normalise()
                    SFXer.BodyHit(victim.position + Vector3(0, 0.1 + coin * 0.1, 0), victim, normal, -normal, Grenade.BLEED_SFX)