# Embedded file name: ./scripts/client/Capsule.py
import BigWorld
import json
import ResMgr
from ItemHolder import ItemHolder
from Helpers.Caps import CAP_CAN_OPEN_AND_EXPLORE
from utils_bw import inRange
from Localization import lc
import Constants
import Math

class Capsule(BigWorld.Entity, ItemHolder):
    """ \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd1\x8b, \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xbe\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xb2 containers_config.json
    """

    @staticmethod
    def reload_config():
        source = ResMgr.openSection('scripts/common/data/containers_config.json')
        Capsule.json_text = json.loads(source.asBinary)
        source = ResMgr.openSection('scripts/common/data/capsule_lock_types.json')
        Capsule.json_lock_text = json.loads(source.asBinary)

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self.targetCaps = [CAP_CAN_OPEN_AND_EXPLORE]
        node = Capsule.json_text[self.capsTypeCell]
        self.name = lc('Container.Names.{0}'.format(node['name']))
        self.model_name = node['model']
        self.model_searched_name = node.get('model_searched')
        self.model_empty_name = node.get('model_empty')
        self.current_model_name = None
        self.LOCK_PUT_ITEM = not Capsule.json_text[self.capsTypeCell].get('insertable', True)
        return

    def _set_model(self, model_name):
        if self.current_model_name == model_name or not model_name:
            return
        self.current_model_name = model_name
        BigWorld.fetchModelObstacle(str(model_name), self.matrix, 0, self.onLoadModel)

    def onLoadModel(self, model):
        if self.isDestroyed:
            return
        self.model = model
        self.height = Math.Matrix(self.model.bounds).get(1, 1) if model else 1.0

    def onEnterWorld(self, prereqs):
        self._set_model(self.model_name)

    def onLeaveWorld(self):
        self.model = None
        return

    def onOpen(self, player):
        self._set_model(self.model_searched_name if self.CarryingItems else self.model_empty_name)

    def set_CarryingItems(self, old_value):
        """ \xd0\xb8\xd0\xb7\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x81\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xb9\xd0\xbd\xd0\xb5\xd1\x80\xd0\xb0 """
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE):
            BigWorld.player().NeedToUpdateItemCache()
        if len(self.CarryingItems) > 0 and len(old_value) == 0:
            self._set_model(self.model_searched_name)
        elif len(self.CarryingItems) == 0 and len(old_value) > 0:
            self._set_model(self.model_empty_name)

    def _get_lock_config(self):
        lock_type = Capsule.json_text[self.capsTypeCell]['lock_types']['type']
        return Capsule.json_lock_text[lock_type]

    def get_unlock_item(self):
        if not self.locked:
            return None
        else:
            return self._get_lock_config()['item']

    def get_unlock_animation(self):
        lock_type = Capsule.json_text[self.capsTypeCell]['lock_types']['type']
        config = Capsule.json_lock_text[lock_type]
        return (config['in_animation'], config['loop_animation'], config['out_animation'])

    def get_time_looting(self, open_type):
        if self.locked:
            return self._get_lock_config()['loot_time']
        return Capsule.json_text[self.capsTypeCell]['loot_time']


Capsule.reload_config()