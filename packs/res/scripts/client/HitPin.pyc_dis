# Embedded file name: ./scripts/client/HitPin.py
import BigWorld
import Math
from random import uniform

class Prickle:
    """ \xd0\xbe\xd1\x82\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb0\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbb\xd1\x8e\xd1\x87\xd0\xba\xd0\xb0 """
    FADE_TIME = 1.0
    UP_DIRECTION = (0, 1, 0)
    matrix = Math.Matrix()

    def __init__(self, parent):
        self._parent = parent
        self._model = BigWorld.Model('models\\bolvan\\hit\\hit.model')
        self._model.alpha_dye = 'alpha_material'
        self._to_point = None
        self._random_disp = None
        return

    def activate(self, to_point):
        self._parent.addModel(self._model)
        self.active = True
        self._to_point = to_point
        self._looped = False
        self._model.alpha_dye.alphaReference = (0, 0, 0, 0)
        self.fade_time = 0
        self._random_disp = (0, uniform(*HitPin.HEIGHT), 0)
        self._align()

        def loop_started():
            self._looped = True

        self._model.in_anim(0, loop_started).loop_anim()

    def _remove(self):
        self._parent.delModel(self._model)
        self.active = False

    def update(self, delta):
        self._align()
        if self._looped:
            self.fade_time += delta
            if self.fade_time >= Prickle.FADE_TIME:
                self._remove()
            else:
                alpha = self.fade_time / Prickle.FADE_TIME
                self._model.alpha_dye.alphaReference = (0,
                 0,
                 alpha,
                 0)

    def _align(self):
        direction = self._parent.position - self._to_point
        pos = self._parent.position + self._random_disp
        if direction[0] == direction[2] == 0:
            return
        Prickle.matrix.lookAt(pos, direction, Prickle.UP_DIRECTION)
        Prickle.matrix.invert()
        self._model.setWorldTransform(Prickle.matrix)


class HitPin:
    """ \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd1\x80\xd0\xbe\xd0\xbb\xd0\xbb\xd0\xb5\xd1\x80 \xd0\xba\xd0\xbe\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb5\xd0\xba, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd1\x82\xd0\xbe\xd1\x80\xd1\x87\xd0\xb0\xd1\x82 \xd0\xb8\xd0\xb7 \xd0\xb0\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb0
            \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd1\x82\xd0\xbe\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd1\x80\xd0\xbe\xd0\xbd
    """
    HEIGHT = (0.5, 1.5)

    def __init__(self, parent):
        self._parent = parent
        self._prev_update_time = BigWorld.time()
        self._active_pricles = []
        self._pool = []
        self._tick_controller_id = None
        return

    def show_pin(self, to_point):
        prickle = self._create_prickle()
        self._active_pricles.append(prickle)
        prickle.activate(to_point)
        if not self._tick_controller_id:
            self._tick_controller_id = BigWorld.callback(0, self._tick)

    def _tick(self):
        cur_time = BigWorld.time()
        delta = cur_time - self._prev_update_time
        self._prev_update_time = cur_time
        for prickle in list(self._active_pricles):
            prickle.update(delta)
            if not prickle.active:
                self._active_pricles.remove(prickle)
                self._pool.append(prickle)

        if self._active_pricles:
            self._tick_controller_id = BigWorld.callback(0, self._tick)
        else:
            BigWorld.cancelCallback(self._tick_controller_id)
            self._tick_controller_id = None
        return

    def _create_prickle(self):
        if not self._pool:
            prickle = Prickle(self._parent)
        else:
            prickle = self._pool[-1]
            del self._pool[-1]
        return prickle