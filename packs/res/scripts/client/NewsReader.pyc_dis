# Embedded file name: ./scripts/client/NewsReader.py
"""\xd0\x9c\xd0\xbe\xd0\xb4\xd1\x83\xd0\xbb\xd1\x8c \xd1\x80\xd0\xb5\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb5\xd1\x81\xd0\xba\xd1\x80\xd0\xb8\xd0\xbf\xd1\x82\xd0\xbe\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f, \xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb8 \xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xbe\xd1\x82\xd0\xba\xd0\xb8 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb5\xd0\xb9 \xd1\x81 \xd1\x81\xd0\xb0\xd0\xb9\xd1\x82\xd0\xb0."""
import os
import cPickle as pickle
import re
import shutil
import Localization
from utils import ConstantDict
import time
import threading
import urllib2

class ProcessingForScaleform(object):
    """\xd0\xa5\xd0\xb0\xd0\xba \xd0\xb8\xd0\xb7-\xd0\xb7\xd0\xb0 \xd0\xbe\xd1\x82\xd1\x81\xd1\x83\xd1\x82\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbb\xd0\xb8\xd1\x87\xd0\xbd\xd0\xbe\xd0\xb9 \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xb2 \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xb2\xd0\xb5\xd1\x80\xd1\x81\xd0\xb8\xd0\xb8 Scaleform."""

    @staticmethod
    def xml_to_scaleform_html(text):
        """\xd0\x9f\xd1\x80\xd0\xb5\xd0\xbe\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x82\xd0\xb5\xd0\xb3\xd0\xbe\xd0\xb2 html \xd0\xb2 \xd0\xbf\xd0\xbe\xd0\xbd\xd1\x8f\xd1\x82\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x84\xd0\xbe\xd1\x80\xd0\xbc\xd0\xb0\xd1\x82 \xd0\xb4\xd0\xbb\xd1\x8f scaleform."""
        div_patt = re.compile('<div[^>]+?>(.*?)</div>')
        text = div_patt.sub('\\1<br/>', text)
        tag_a_patt = re.compile('(<a\\s+href=[\\"\'].+?[\\"\']>.*?</a>)')
        event_patt = re.compile('href=["\'](.+?)["\']')

        def dashrepl(mathobj):
            string = mathobj.group(0)
            new_str = event_patt.sub("href='event:\\1'", string)
            new_str = "<font color='#54bdff'>{0}</font>".format(new_str)
            return new_str

        text = tag_a_patt.sub(dashrepl, text)
        text = text.replace("href='event:#'", "href='event:https://www.stalker.so/'")
        return text


class NewsReader(object):
    """\xd0\x9a\xd0\xbb\xd0\xb0\xd1\x81\xd1\x81 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x87\xd1\x82\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb5\xd0\xb9 \xd1\x81 \xd1\x81\xd0\xb0\xd0\xb9\xd1\x82\xd0\xb0."""

    def __init__(self):
        self._eng_news_url = 'http://en.stalker.so/rss.xml'
        self._rus_news_url = 'http://stalker.so/rss.xml'
        self._eng_all_news_url = 'http://en.stalker.so/news/'
        self._ru_all_news_url = 'http://stalker.so/news/'
        self.cache_dir = 'usercontent\\News'
        self.cache_filename = 'news.cache'
        self.news_is_empty = True
        self.loaded_news = None
        self.tt = time.time()
        threading.Thread(target=self.load_news, args=(self.onLoad,)).start()
        return

    def getNews(self):
        if self.loaded_news:
            news = self.loaded_news
        elif self.cache_exists:
            news = self.get_file_cache()
        else:
            news = self.empty_news
        return ConstantDict(news)

    def localized_news_path(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x83\xd1\x82\xd1\x8c \xd0\xba \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x83 \xd0\xba\xd1\x8d\xd1\x88\xd0\xb0 c \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        game_path = os.path.realpath('.')
        dir_up = '..'
        locale = Localization.language
        locale_dir = locale.capitalize()
        path = '{0}\\{1}\\{2}\\{3}\\{4}'.format(game_path, dir_up, self.cache_dir, locale_dir, self.cache_filename)
        return path

    def onLoad(self, text):
        text, _ = text.split('</item>', 1)
        _, text = text.split('<item>', 1)
        description, _ = text.split('\n]]></description>', 1)
        _, description = description.split('<description><![CDATA[\n', 1)
        title, _ = text.split('</title>', 1)
        _, title = title.split('<title>', 1)
        description = ProcessingForScaleform.xml_to_scaleform_html(description)
        result = {'text': description,
         'title': title,
         'source': self.all_news_url}
        self.news_actual = True
        self.loaded_news = result
        self.news_is_empty = False
        threading.Thread(target=self.write_file_cache).start()

    def load_news(self, callback):
        _news = urllib2.urlopen(self.news_url).read()
        callback(_news)

    @property
    def empty_news(self):
        """\xd0\x9f\xd1\x83\xd1\x81\xd1\x82\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbb\xd1\x83\xd1\x87\xd0\xb0\xd0\xb9, \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd1\x83\xd0\xb4\xd0\xb0\xd0\xbb\xd0\xbe\xd1\x81\xd1\x8c \xd0\xbf\xd1\x80\xd0\xbe\xd1\x87\xd0\xb8\xd1\x82\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb8\xd1\x85 \xd1\x81 \xd1\x81\xd0\xb0\xd0\xb9\xd1\x82\xd0\xb0."""
        result = {'text': Localization.lc('NewsWidget.NewsWindow.news_server_unavailable'),
         'title': '',
         'source': self.all_news_url}
        self.news_is_empty = True
        return result

    @property
    def news_url(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 rss \xd1\x81\xd1\x82\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x86\xd1\x83"""
        locale = Localization.language
        url = None
        if locale == 'russian':
            url = self._rus_news_url
        elif locale == 'english':
            url = self._eng_news_url
        return url

    @property
    def all_news_url(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd1\x82\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x86\xd1\x83 c \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd1\x8f\xd0\xbc\xd0\xb8 \xd0\xb7\xd0\xb0 \xd0\xb2\xd1\x81\xd1\x91 \xd0\xb2\xd1\x80\xd0\xb5\xd0\xbc\xd1\x8f."""
        locale = Localization.language
        url = None
        if locale == 'russian':
            url = self._ru_all_news_url
        elif locale == 'english':
            url = self._eng_all_news_url
        return url

    @property
    def localized_news_path(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x83\xd1\x82\xd1\x8c \xd0\xba \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd1\x83 \xd0\xba\xd1\x8d\xd1\x88\xd0\xb0 c \xd1\x83\xd1\x87\xd1\x91\xd1\x82\xd0\xbe\xd0\xbc \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb5\xd0\xb9 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        game_path = os.path.realpath('.')
        dir_up = '..'
        locale = Localization.language
        locale_dir = locale.capitalize()
        path = '{0}\\{1}\\{2}\\{3}\\{4}'.format(game_path, dir_up, self.cache_dir, locale_dir, self.cache_filename)
        return path

    def get_file_cache(self):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xb8\xd0\xb7 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb0."""
        with open(self.localized_news_path) as fh:
            news = pickle.load(fh)
        return news

    def write_file_cache(self):
        """\xd0\xa1\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd1\x81\xd1\x82\xd0\xb8 \xd0\xb2 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb5."""
        news_dir = os.path.dirname(self.localized_news_path)
        if not os.path.exists(news_dir):
            os.makedirs(news_dir)
        with open(self.localized_news_path, 'w') as fh:
            pickle.dump(self.loaded_news, fh)

    @property
    def cache_exists(self):
        """\xd0\xa1\xd1\x83\xd1\x89\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb \xd1\x81 \xd0\xba\xd1\x8d\xd1\x88\xd0\xb5\xd0\xbc."""
        return os.path.exists(self.localized_news_path)

    def clear(self):
        """\xd0\xa3\xd0\xb4\xd0\xb0\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb0\xd0\xbf\xd0\xba\xd1\x83 \xd1\x81\xd0\xbe \xd1\x81\xd1\x82\xd0\xb0\xd1\x80\xd1\x8b\xd0\xbc \xd0\xba\xd1\x8d\xd1\x88\xd0\xb5\xd0\xbc."""
        news_sub_dir = os.path.dirname(self.localized_news_path)
        news_dir = os.path.dirname(news_sub_dir)
        try:
            shutil.rmtree(news_dir, ignore_errors=True)
        except WindowsError:
            pass