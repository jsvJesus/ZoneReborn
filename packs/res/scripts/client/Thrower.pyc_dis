# Embedded file name: ./scripts/client/Thrower.py
import BigWorld
from Items import ItemsCatalog
import ItemsUtils
from Localization import lc
import BWPersonality
import RestrictionsUtils
import Durations
from Math import Vector3, Matrix
import math_bw
import math
import Math
import utils_bw

class Thrower:
    THROW_DELAY = 0.65
    COLLISION_FACTOR = 0.3
    DEBUG_COLLISIONS = False

    def __init__(self):
        pass

    def throw(self, entity_params, position, velocity, grenade_type, callbackOnThrow = None):
        throwing_params = {'ownerID': self.id,
         'fromServer': False,
         'startPosition': position,
         'velocity': velocity,
         'grenade_type': grenade_type}
        throwing_params.update(entity_params)
        self._callbackOnThrow = callbackOnThrow
        grenade_params = ItemsCatalog.GetItemParam(grenade_type)
        if not grenade_params:
            print 'unknown grenade type', grenade_type
            print self, self.position
            raise ValueError('unknown grenade type %s' % grenade_type)
        class_name = 'Rocket' if grenade_params.get('AmmoType') == ItemsCatalog.AMMO_RPG7_ROCKET or grenade_params.get('AmmoType') == ItemsCatalog.AMMO_M74_ROCKET else 'Grenade'
        entityID = BigWorld.createEntity(grenade_params.get('entityClassName', class_name), self.spaceID, 0, position, (0, self.pitch, self.yaw), throwing_params)
        return entityID

    def onThrowingEntityAppears(self, entity):
        param = entity.throw()
        if self._callbackOnThrow:
            self._callbackOnThrow(param)

    def startThrowGrenade(self):
        self.is_throwing = True
        self.EnableModelPitch(True)
        self.startAnimGrenadeSwnig()
        self.cell.startThrowGrenade()

    def startAnimGrenadeSwnig(self):
        if self.model:
            self.model.Grenade_Swing().Grenade_Swing_Loop()
            self.model.Grenade_swing_hand_fix()

    def stopAnimGrenadeSwnig(self):
        if self.model:
            self.model.Grenade_Swing.stop()
            self.model.Grenade_Swing_Loop.stop()
            self.model.Grenade_swing_hand_fix.stop()

    def throwGrenade(self, isDown, event = None, throw_power = 0, frames = 0):
        if self.dead or self.use_gesture or self.isSitting() or self.inputlock:
            BWPersonality.gpd.sendLowerMessage(lc('PlayerAvatar.client.MSG3'))
            self.is_throwing = False
            return
        self.magnitude = 17.0
        if self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            if self.ActiveThrowID == -1 or self.canThrowGrenade():
                throw_duration = self.grenadeThrow(throw_power, frames)
                self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, throw_duration, lc('Items.GUIStrings.GRENADE'))
                return

    def grenadeThrow(self, throw_power, frames):
        if self.binoculars_animation:
            return
        weight = 0.3
        self.is_throwing = True
        throw_duration = Durations.GetGrenadeThrowDuration(self)
        frames = max(15, frames)
        frames = min(26, frames)
        from_cadr = 50 - frames
        throw_type = self.ActiveThrowType

        def throw():
            self.model.ThrowRight = None
            position, velocity = self.get_throw_params()
            grenade_params = {}
            velocity *= (0.5 + throw_power * self.GetGrenadeThrowModifyer()) / (weight + 1.0)
            uv = BigWorld.player().physics.uncorrectedVelocity.value
            velocity += Math.Vector3(uv[0], uv[1], uv[2])
            position, velocity, mat_id = self.check_throw_collision(position, velocity)

            def callbackOnThrow(param):
                self.is_throwing = False
                if not param:
                    return
                position, velocity, clientGrenadeID, timeBeforeFlyEnd, destPos = param
                self.cell.throwGrenade(position, velocity, clientGrenadeID, throw_type, from_cadr)

            grenade_id = self.throw(grenade_params, position, velocity, throw_type, callbackOnThrow=callbackOnThrow)
            if mat_id:

                def play_hit_sound():
                    BigWorld.entities[grenade_id].play_material_sound(mat_id)

                BigWorld.callback(0, play_hit_sound)
            return

        fly_out_delay = self.model.Grenade_Throw.duration - from_cadr * self.model.Grenade_Throw.duration / 50.0
        BigWorld.callback(fly_out_delay, throw)
        velocity = self.get_throw_params()[1]
        if self.ActiveThrowID != -1 and self.ActiveThrowType != ItemsCatalog.STONE_GRENADE['TypeID']:
            complexItem = ItemsUtils.GetComplexItemByID(self, self.ActiveThrowID)
            if complexItem:
                complexItemType = complexItem['complexItemType']
                complexItemParams = ItemsCatalog.GetItemParam(complexItemType)
                weight = complexItemParams['Weight']
                complexItem_InconstantParam = ItemsUtils.GetComplexItemInconstanParams(complexItem)
                if complexItem_InconstantParam[ItemsCatalog.INC_ROUND_NUMBER] == 1:
                    self.ActiveThrowID = 0
                    self.ActiveThrowType = 0
        self.DrawThrow(throw_duration, velocity, from_cadr)
        return throw_duration

    def keyThrowStone(self, isDown, event = None):
        if self.dead:
            BWPersonality.gpd.sendLowerMessage(lc('PlayerAvatar.client.MSG3'))
            return
        if self.binoculars_animation:
            return
        if isDown:
            mod = self.GetGrenadeThrowModifyer()
            self.magnitude = 17.0 * mod
            if self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                if self.canThrowStone():
                    self.stoneThrow()

    def get_throw_params(self):
        ADD_PITCH = 15
        direction = Vector3(BigWorld.camera().direction)
        if self.lookingaround or self.isSitting():
            direction = Vector3(self.lastdirection)
        y, p = direction.yaw, direction.pitch
        p = max(-1.5, p - math.radians(ADD_PITCH))
        direction.setPitchYaw(p, y)
        direction.normalise()
        velocity = direction * self.magnitude
        position = Matrix(self.throwing_node).translation
        return (position, velocity)

    def check_throw_collision(self, position, velocity):
        """ \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb0 \xd0\xba\xd0\xbe\xd0\xbb\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb8\xd0\xb9, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xbd\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xb7\xd1\x8f \xd0\xb1\xd1\x8b\xd0\xbb\xd0\xbe \xd0\xba\xd0\xb8\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd0\xb3\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb0\xd1\x82\xd1\x83 \xd1\x81\xd0\xba\xd0\xb2\xd0\xbe\xd0\xb7\xd1\x8c \xd1\x81\xd1\x82\xd0\xb5\xd0\xbd\xd1\x83
                http://hz-dev.stalker.so:8090/issues/3299
                \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83\xd1\x8e \xd1\x82\xd0\xbe\xd1\x87\xd0\xba\xd1\x83, \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x83\xd1\x8e \xd1\x81\xd0\xba\xd0\xbe\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd1\x8c \xd0\xb8 \xd0\xbc\xd0\xb0\xd1\x82\xd0\xb5\xd1\x80\xd0\xb8\xd0\xb0\xd0\xbb \xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd1\x82\xd0\xbe\xd0\xbb\xd0\xba\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f (\xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb5\xd1\x81\xd1\x82\xd1\x8c)
        """
        from_position = self.position + (0, self.get_height() * 0.5, 0)
        collision = utils_bw.collide(self.spaceID, from_position, position)
        if not collision:
            return (position, velocity, None)
        else:
            collision_point = collision[0]
            result, normal = math_bw.calculate_reflection(collision_point, collision_point - from_position, collision[1])
            velocity = result * velocity.length * Thrower.COLLISION_FACTOR
            collision_point += normal * 0.1
            if Thrower.DEBUG_COLLISIONS:
                import DrawPrimitivesUtils
                DrawPrimitivesUtils.clear_drawings()
                DrawPrimitivesUtils.draw_ray(collision_point, normal, (1, 1, 1, 1))
                DrawPrimitivesUtils.draw_sphere(collision_point, 0.05)
                DrawPrimitivesUtils.draw_line(position, from_position)
                DrawPrimitivesUtils.draw_ray(collision_point, velocity, (0, 0, 1, 1))
            return (collision_point, velocity, collision[2])
            return