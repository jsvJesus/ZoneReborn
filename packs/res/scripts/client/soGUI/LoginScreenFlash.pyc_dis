    def get_settings(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b."""

        def keybind_value_to_list(keybind_data):
            dct = {}
            for key, value in keybind_data.items():
                dct[key] = [value]

            return dct

        graphic_additional_settings = OrderedDict()
        setttings = BWPersonality.settings.getSetting('settings')
        if setttings is not None:
            for label, value in setttings.items():
                graphic_additional_settings[label] = value

        else:
            graphic_additional_settings = self._default_additional_video_options()
        data = {'video': {'main_settings': {'resolution': BWPersonality.settings.getResolution()['id'],
                                     'quality': BWPersonality.settings.getGraphicsPresetIndex(),
                                     'screen_mode': BWPersonality.settings.screen_mode},
                   'additional_settings': graphic_additional_settings},
         'audio': {'sfx': BWPersonality.settings.getSfxVolume() * 100.0,
                   'music': BWPersonality.settings.getMusicVolume() * 100.0,
                   'all': BWPersonality.settings.getAllVolume() * 100.0},
         'mouse': {'sensivity': BWPersonality.settings.getMouseSensitivity() * 100,
                   'invert': int(BWPersonality.settings.getMouseInvert())},
         'keybinds': keybind_value_to_list(BWPersonality.settings.getKeybindingsDict()),
         'gui': {'inventory_size': BWPersonality.settings.GUISettings.inventory_size,
                 'item_cache_size': BWPersonality.settings.GUISettings.item_cache_size,
                 'map_size': BWPersonality.settings.GUISettings.map_size,
                 'reset_position': 'btn',
                 'dialog_not_close_by_interact_object': BWPersonality.settings.GUISettings.dialog_not_close_by_interact_object}}
        return data

    def keybind_localize_table(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x82\xd0\xb0\xd0\xb1\xd0\xbb\xd0\xb8\xd1\x86\xd1\x83 \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x88 \xd0\xba \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8."""
        keybind_table_path = 'scripts\\client\\data\\actions_display_names.xml'
        py_data_section = ResMgr.openSection(keybind_table_path)
        result = {}
        for action in py_data_section.values():
            internal_name = action.readString('internal_name')
            display_name = action.readString('display_name')
            result[internal_name] = display_name

        return result

    def range_of_settings(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb5\xd0\xba."""
        self.graphic_resolutions = dict(((dct['id'], dct['name']) for dct in BWPersonality.settings.getResolutionList()))
        graphic_additional_settings = collections.defaultdict(dict)
        for label, _index, options, _desc in BigWorld.graphicsSettings():
            if label in self.SETTINGS_LIST:
                for i, opts in enumerate(options):
                    graphic_additional_settings[label][str(i)] = opts[2]

        additionals_settings = collections.defaultdict(dict)
        for key, value in BWPersonality.settings.getAdditionOptionValue().items():
            for name, bool_ in zip(value[1], value[2]):
                additionals_settings[str(key)][str(int(bool_))] = name

        graphic_additional_settings.update(additionals_settings)
        data = {'video': {'main_settings': {'resolution': dict(((str(key), v) for key, v in self.graphic_resolutions.items())),
                                     'quality': dict(((str(key), v) for key, v in self.VIDEO_QUALITIES.items())),
                                     'screen_mode': dict(((str(key), v) for key, v in Settings.SCREEN_MODE_CODE_TO_NAME.items()))},
                   'additional_settings': OrderedDict(sorted(graphic_additional_settings.items()))},
         'audio': {'sfx': [0, 100.0],
                   'music': [0, 100.0],
                   'all': [0, 100.0]},
         'mouse': {'sensivity': [1, 100],
                   'invert': {'1': 'On',
                              '0': 'Off'}},
         'gui': {'inventory_size': dict(((str(key), v) for key, v in BWPersonality.settings.GUISettings.getAllSizes().items())),
                 'item_cache_size': dict(((str(key), v) for key, v in BWPersonality.settings.GUISettings.getAllSizes().items())),
                 'map_size': BWPersonality.settings.GUISettings.getMapSizes(),
                 'reset_position': 'btn',
                 'dialog_not_close_by_interact_object': {'1': 'Off',
                                                         '0': 'On'}}}
        return data

