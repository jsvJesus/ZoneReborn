    def default_options(self, options = None):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb8\xd0\xb3\xd1\x80\xd1\x8b.
        
        options - \xd0\xbf\xd1\x83\xd0\xbd\xd0\xba\xd1\x82, \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd1\x8b \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8,
        \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd, \xd0\xbf\xd1\x80\xd0\xb8\xd1\x88\xd0\xbb\xd1\x91\xd1\x82 \xd0\xb2\xd1\x81\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8.
        """
        if options is not None:
            option = options['option']
            if option.startswith('video'):
                answer = {}
                answer['video'] = {}
                video, sub_opt = option.split('.')
                result = self.default_data_functions[video][sub_opt]()
                answer['video'][sub_opt] = result
            else:
                result = self.default_data_functions[option]()
                answer = {option: result}
        else:
            answer = {}
            for option, function in self.default_data_functions.items():
                if option == 'video':
                    answer['video'] = {}
                    for sub_opt, func in function.items():
                        result = func()
                        answer['video'][sub_opt] = result

                else:
                    result = function()
                    answer[option] = result

        return answer

