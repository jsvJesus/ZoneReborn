class EULAFlash(flash_utils.FlashInteractor):

    @flash_utils.send_to_flashscript
    def getEulaAccepted(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xbb\xd1\x8f \xd1\x84\xd0\xbb\xd1\x8d\xd1\x88"""
        state = Settings.Settings().getSetting(EULA_KEY, False)
        return {'eula': int(state)}

    def setEulaAccepted(self, eula):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xbd\xd0\xb8\xd0\xbc\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xbe \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd1\x83\xd1\x81\xd0\xb5 EULA."""
        eula_accepted_state = eula
        if eula_accepted_state:
            BWPersonality.GUICore.on_eula_accpeted()
            Settings.Settings().setSetting(EULA_KEY, True, flush=True)
        else:
            BWPersonality.game.close()


