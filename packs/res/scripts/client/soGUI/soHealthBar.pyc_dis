    FACTION_MARK_LONERS = 2
    ANOMALY_RADIATION, ANOMALY_ELECTRICITY, ANOMALY_FIRE, ANOMALY_CHEMICAL, ANOMALY_GRAVITY, ANOMALY_PSIONICS = xrange(6)
