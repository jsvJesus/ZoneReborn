        cmp.colour = (175, 166, 112, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.01)
        cmp.text = lc('GUI.Legacy.LOCK_TEXT')
        cmp.visible = 0
        self.component.addChild(cmp, 'lockLabel')
        cmp = GUI.Simple('soGUI/maps/loadingScreen/loadingCircle/loadingCircle.texanim')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (150, 150, 150, 220)
        cmp.materialFX = 'BLEND'
        cmp.height = 20
        cmp.width = 20
        cmp.position = (5, 5, 0.01)
        self.component.generalWnd.darkScreen.addChild(cmp, 'darkScreenLogo')

    def setupMembers(self):
        cmp = GUI.Window()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 792
        cmp.height = 444
        cmp.position = (0, 0, 1.0)
        cmp.textureName = ''
        cmp.visible = False
        cmp.filterType = 'POINT'
        cmp.pixelSnap = False
        self.component.addChild(cmp, 'membersWnd')
        self.membersWnd = cmp
        rows = [{'props': soTableElemPropsStructure(dataStyles=self.memberTable_captionDS),
          'data': [lc('GUI.Legacy.CLANMATE_NAME'), lc('GUI.Legacy.CLANMATE_RANK'), lc('GUI.Legacy.CLANMAE_STATE')]}]
        tbl = ClanTableComponent(GUI.Window(), soGUI.ListPropsStructure(width=786, height=358, isMultiSel=False, leftOffset=4, selectCallBack=None, sorted=False))
        cmp = tbl.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (3, self.verticalIndentForBtn, 0.0)
        self.component.membersWnd.addChild(cmp, 'membersTable')
        tbl.onBound()
        tbl.addRows(rows)
        return

    def _switchToTab(self, tab):
        visMsk = [False,
         False,
         False,
         False]
        visMsk[tab] = True
        self.component.membersBtn.script.buttonActive = visMsk[self.MODE_MEMBERS]
        self.component.membersBtn.script._updateVisualState()
        self.component.rightsBtn.script.buttonActive = visMsk[self.MODE_RANKS]
        self.component.rightsBtn.script._updateVisualState()

    def switchToMode(self, mode):
        self._switchToTab(mode)
        if self.currentMode == mode:
            return
        self.currentMode = mode
        modeMask = [False,
         False,
         False,
         False]
        modeMask[mode] = True
        self.membersWnd.visible = modeMask[self.MODE_MEMBERS]

    def checkLock(self):
        if not BigWorld.player().clanID:
            self.component.lockScreen.visible = 1
            self.component.lockLabel.visible = 1
        else:
            self.component.lockScreen.visible = 0
            self.component.lockLabel.visible = 0

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanScreen')
        self.component.visible = True
        self.loadClanIcon()
        if self.component.inviteToClanBtn and not BigWorld.player().checkClanRights(Clan.FLAG_CAN_INVITE):
            self.component.inviteToClanBtn.script.setDisabledState(True)
        if self.component.wndFrame.nameLabel:
            self.component.wndFrame.nameLabel.text = lc('PlayerAvatarForSoClanScreen.client.CLAN_NAME_CAPTION').format(BigWorld.player().clanName.decode('utf-8'))
        BWPersonality.GUICore.setBestCursor()
        self._updateMemberTable()
        self.checkLock()
        return

    def hide(self):
        self.onMembersClick()
        self.component.visible = False
        if self.component.inviteToClanBtn:
            self.component.inviteToClanBtn.script.setDisabledState(False)
        BWPersonality.GUICore.setBestCursor()

    def _timeToString(self, secs):
        hours = floor(secs / 3600.0)
        minutes = floor((secs - hours * 3600.0) / 60.0)
        seconds = secs - (hours * 3600.0 + minutes * 60.0)
        outH = str(int(hours)) if hours > 9 else u'0' + str(int(hours))
        outM = str(int(minutes)) if minutes > 9 else u'0' + str(int(minutes))
        outS = str(int(seconds)) if seconds > 9 else u'0' + str(int(seconds))
        return u'' + outH + u':' + outM + u':' + outS

    def _updateRightsEditor(self):
        for rightCmp in self.rightsCheckBoxes:
            self.component.generalWnd.rightsWnd.rightsFrame.delChild(rightCmp)
            rightCmp = None

        self.rightsCheckBoxes = []
        for i, right in enumerate(self._rights_clan):
            cb = soCheckBox(GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=right[0]))
            cmp = cb.component
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.position = (18, 12 + i * 25, 0.4)
            self.component.generalWnd.rightsWnd.rightsFrame.addChild(cmp, 'right' + str(right[1]))
            cb.onStateChange = partial(self.rightChecked, right[1])
            cb.onBound()
            self.rightsCheckBoxes.append(cmp)
            cb.disable()

        self._dct_ranks = {}
        self.component.generalWnd.rightsWnd.ranks.script.clear()
        for rank in self._rights_data:
            lc_caption = lc(rank['name'])
            self._dct_ranks[lc_caption] = rank
            self.component.generalWnd.rightsWnd.ranks.script.addElement(lc_caption)

        return

    def setMembers(self, data):
        tbl = self.component.membersWnd.membersTable.script
        for mEntry in data:
            rank = data[mEntry][1]
            status = self.getMemberStrStatus(data[mEntry][2])
            name = mEntry
            rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS),
             'data': [name, rank, status]}
            tbl.rewriteRow(rowData)

        self.update()

    def addMembers(self, data):
        rows = []
        tbl = self.component.membersWnd.membersTable.script
        for mEntry in data:
            rank = data[mEntry][1]
            status = self.getMemberStrStatus(data[mEntry][2])
            name = mEntry
            rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS),
             'data': [name, rank, status]}
            rows.append(rowData)

        if rows:
            tbl.addRows(rows)

    def showOnlyOnlineMembers(self):
        self._updateMemberTable()

    def delMembers(self, data):
        rows = []
        tbl = self.component.membersWnd.membersTable.script
        for mName in data:
            rows.append(mName)

        if rows:
            tbl.removeRows(rows)

    def sortCaptionClick(self, col_indx, no_reverse = False):
        rows = []
        self.members_sort_index = col_indx
        tbl = self.component.membersWnd.membersTable.script
        tbl.clearRowRange(1)

        def sortOfCaption(memb):
            return memb[col_indx]

        if self.sortType[col_indx] == 0 or no_reverse:
            self.members.sort(key=sortOfCaption)
            self.sortType[col_indx] = 1
        else:
            self.members.sort(key=sortOfCaption, reverse=True)
            self.sortType[col_indx] = 0
        for member in self.members:
            rowData = {'props': soTableElemPropsStructure(dataStyles=self.memberTable_dataDS),
             'data': [member[0], member[1], member[2]]}
            rows.append(rowData)

        tbl.addRows(rows)

    def getDurationText(self, duration):
        ret = u''
        if duration:
            day = int(duration / 86400)
            if day > 0:
                ret += u' {0} '.format(day) + lc('Clans.Messages.DAYS')
                duration -= day * 86400
            hours = int(duration / 3600)
            if hours > 0:
                ret += u' {0} '.format(hours) + lc('Clans.Messages.HOURS')
                duration -= hours * 3600
            minutes = int(duration / 60)
            if minutes > 0:
                ret += u' {0} '.format(minutes) + lc('Clans.Messages.MINUTES')
                duration -= minutes * 60
            elif not ret:
                ret += u' ' + lc('Clans.Messages.LESS_THEN_MINUTE')
        else:
            ret += u' ' + lc('Clans.Messages.LESS_THEN_MINUTE')
        return ret

    def getMemberStrStatus(self, lastLogin):
        from time import time
        if lastLogin == 0:
            return lc('Clans.Interface.ONLINE')
        else:
            return lc('Clans.Interface.LAST_TIME').format(self.getDurationText(int(time() - lastLogin)))

    def _updateMemberTable(self):
        if self.__updateMemberTimerID:
            BigWorld.cancelCallback(self.__updateMemberTimerID)
            self.__updateMemberTimerID = None
        if BWPersonality.GUICore.clanDataSection is None:
            return
        else:
            only_online = False
            if self.component.cbShowOnlyOnline and self.component.cbShowOnlyOnline.script.isChecked():
                only_online = True
            if BWPersonality.GUICore.clanDataSection.has_key('members'):
                self.membersData = BWPersonality.GUICore.clanDataSection['members']
                rows = []
                self.members = []
                for member in BWPersonality.GUICore.clanDataSection['members']:
                    if only_online and BWPersonality.GUICore.clanDataSection['members'][member][2] != 0:
                        continue
                    rank = BWPersonality.GUICore.clanDataSection['members'][member][1]
                    name = member
                    status = self.getMemberStrStatus(BWPersonality.GUICore.clanDataSection['members'][member][2])
                    self.members.append((name, rank, status))

                self.sortCaptionClick(self.members_sort_index, True)
            if self.component.membersWnd.membersTable.visible:
                self.__updateMemberTimerID = BigWorld.callback(self.UPDATE_TIME, self._updateMemberTable)
            return

    def update(self):
        if BWPersonality.GUICore.clanDataSection is None:
            return
        else:
            self._updateMemberTable()
            if self.component.wndFrame.nameLabel:
                self.component.wndFrame.nameLabel.text = lc('PlayerAvatarForSoClanScreen.client.CLAN_NAME_CAPTION').format(BigWorld.player().clanName.decode('utf-8'))
            if self.component.inviteToClanBtn:
                if BigWorld.player().checkClanRights(Clan.FLAG_CAN_INVITE):
                    self.component.inviteToClanBtn.script.setDisabledState(False)
                else:
                    self.component.inviteToClanBtn.script.setDisabledState(True)
            if self.component.generalWnd.rightsWnd.btnClear:
                is_owner = bool(BigWorld.player().checkClanRights(Clan.FLAG_CLAN_OWNER))
                self.component.generalWnd.rightsWnd.btnClear.visible = is_owner
            data = BWPersonality.GUICore.clanDataSection
            if self.component.generalWnd.rightsWnd.visible:
                self._updateRightsEditor()
                self.onRightsBtnClick()
            self.checkLock()
            self.loadClanIcon()
            return

    def rightChecked(self, rightID):
        check = None

        def _getBit(num, pos):
            return (num & 1 << pos) >> pos

        def _setBit(num, pos):
            return num ^ 2 ** pos

        if hasattr(self.component.generalWnd.rightsWnd.rightsFrame, 'right' + str(rightID)):
            cmp = getattr(self.component.generalWnd.rightsWnd.rightsFrame, 'right' + str(rightID))
            check = cmp.script.isChecked()
        if check is None:
            print 'ERROR: ClanRights Editor wasnt initialised properly: missing checkbox'
            return
        else:
            sel = self.component.generalWnd.rightsWnd.ranks.script.getSelection()
            if not sel:
                return
            lc_caption = sel[0]
            rank = self._dct_ranks.get(lc_caption, None)
            if not rank:
                return
            if rank['id'] == 1000:
                return
            self._current_clan_rights = _setBit(self._current_clan_rights, rightID)
            self._rights_changed = True
            self.component.generalWnd.rightsWnd.saveBtn.visible = 1
            if self.component.generalWnd.rightsWnd.btnClear.visible:
                self.component.generalWnd.rightsWnd.saveBtn.position.x = 419
            else:
                self.component.generalWnd.rightsWnd.saveBtn.position.x = 260
            return

    def onRankSelect(self):
        if not hasattr(self.component.generalWnd.rightsWnd, 'ranks'):
            return
        else:
            self.component.generalWnd.rightsWnd.saveBtn.visible = 0
            self._rights_changed = False
            sel = self.component.generalWnd.rightsWnd.ranks.script.getSelection()
            access = BigWorld.player().checkClanRights(Clan.FLAG_CAN_EDIT_RIGHTS)
            for rightCmp in self.rightsCheckBoxes:
                if access:
                    rightCmp.script.enable()
                else:
                    rightCmp.script.disable()
                rightCmp.script.setInactive()

            sel = self.component.generalWnd.rightsWnd.ranks.script.getSelection()
            if not sel:
                return
            lc_caption = sel[0]
            rank = self._dct_ranks.get(lc_caption, None)
            if not rank:
                return
            if rank['id'] == 1000:
                for rightCmp in self.rightsCheckBoxes:
                    rightCmp.script.disable()
                    rightCmp.script.setActive()

                return
            self._current_clan_rank = rank['id']
            self._parse_rank_optons(rank['id'], rank['options'])
            self._current_clan_rights = rank['options']
            return

    def onRmb(self, caption):
        if not caption:
            return
        else:
            rank = self._dct_ranks.get(caption, None)
            if not rank:
                return
            BigWorld.player().clanRenameActionsRequest(caption)
            return

    def _parse_rank_optons(self, rankID, rankOptions):

        def _getBit(num, pos):
            return (num & 1 << pos) >> pos

        def _setBit(num, pos):
            return num ^ 2 ** pos

        for i in range(0, len(self._rights_clan)):
            if rankOptions & 1 << self._rights_clan[i][1]:
                self.rightsCheckBoxes[i].script.setActive()

    @PyGUIEvent('membersBtn', 'onClick')
    def onMembersClick(self):
        self.switchToMode(self.MODE_MEMBERS)
        self.component.generalWnd.rightsWnd.visible = False
        self.membersWnd.visible = True
        self.component.generalWnd.rightsWnd.visible = False
        self.component.generalWnd.visible = False

    def setDataPremissions(self, data):
        self.clearDarkScreen()
        self._rights_data = data
        self._updateRightsEditor()

    def onRightsBtnClick(self):
        self.switchToMode(self.MODE_RANKS)
        self.wait()
        BigWorld.player().cell.getClanPremissions()
        self.membersWnd.visible = False
        self.component.generalWnd.rightsWnd.visible = True
        self.component.generalWnd.visible = True

    def onSaveRightsBtnClick(self):

        def _save_check(event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().cell.saveClanPremissions(self._current_clan_rank, self._current_clan_rights)
                self._rights_changed = False
                self.component.generalWnd.rightsWnd.saveBtn.visible = 0

        if self._current_clan_rank is None:
            return
        elif self._current_clan_rights is None:
            return
        else:
            gui_jokes.askUserYesNo(lc('GUI.Legacy.SAVE_RIGHTS_LABEL'), colorCodes.tf3_regular_text_color + lc('GUI.Legacy.SAVE_RIGHTS_TEXT'), _save_check)
            return

    def onInviteClanClick(self):

        def onClanIntive(text):
            BigWorld.player().inviteFriendToClan(text.encode('utf-8'))

        gui_jokes.inputBox(lc('GUI.ClanGUI.INVITE_TO_CLAN_CAPTION'), lc('GUI.ClanGUI.INVITE_TO_CLAN_TEXT'), onClanIntive, active=True)

    @PyGUIEvent('generalWnd.rightsWnd.btnEdit', 'onClick')
    def onEditBtn(self):
        sel = self.component.generalWnd.rightsWnd.ranks.script.getSelection()
        if len(sel) > 0:
            sel = sel[0]
            BWPersonality.GUICore.clanEvent(self.EVENT_EDITRANK, sel)

    @PyGUIEvent('generalWnd.rightsWnd.btnClear', 'onClick')
    def onClearBtn(self):

        def _clear_rights(event):
            if event == gui_jokes.askUserYesNo.YES:
                self._rights_changed = False
                BigWorld.player().cell.resetClanPremissions()

        gui_jokes.askUserYesNo(lc('GUI.Legacy.RESET_RIGHTS_LABEL'), colorCodes.tf3_regular_text_color + lc('GUI.Legacy.RESET_RIGHTS_TEXT'), _clear_rights)

    @PyGUIEvent('membersWnd.membersTable', 'onElementEvent')
    def onMembersElem(self, col, row, event, data):
        tbl = self.component.membersWnd.membersTable.script
        if row == 0:
            self.sortCaptionClick(col)
            return
        if event == 'RIGHTMOUSE':
            playerName = data['name']
            BWPersonality.GUICore.clanMemberActionsRequest(playerName)
        elif event == 'LEFTMOUSE':
            pass

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    def wait(self):
        self.clearDarkScreen()
        self.component.generalWnd.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.generalWnd.darkScreen.visible = False

    def _drawIcon(self, imgID, feedName = '', texture = None):
        if imgID and texture:
            self.component.wndFrame.clanIcon.visible = True
            self.component.wndFrame.clanIcon.texture = texture
            self.component.wndFrame.nameLabel.position = (35, 5, 0.2)
        else:
            self.component.wndFrame.clanIcon.visible = False
            self.component.wndFrame.clanIcon.texture = None
            self.component.wndFrame.nameLabel.position = (5, 5, 0.2)
        return

    def loadClanIcon(self):
        pl = BigWorld.player()
        if pl:
            iconID = pl.clanEmblemID
            if iconID != 0:
                feedNameCur = UCManager.ucmanager.loadImg(iconID, self._drawIcon)
            else:
                self._drawIcon(0)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True