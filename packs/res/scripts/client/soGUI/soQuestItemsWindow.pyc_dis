# Embedded file name: ./scripts/client/soGUI/soQuestItemsWindow.py
import BigWorld
from soGUI.soButton import soButton
import GUI
from Helpers.PyGUI import PyGUIBase
from Helpers.PyGUI.DraggableComponent import DraggableComponent
import soGUI.soItemView as module_soItemView
from soGUI.soItemView import soItemView
from soGUI.BarterWindowGUI import BarterPaySlot
from Localization import lc
import BWPersonality
import ItemsUtils
import QuestDispatcher as qd

class soQuestItemsWindow(PyGUIBase, DraggableComponent):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        component.script = self
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 403
        cmp.height = 255
        cmp.position = (0.0, 0.0, 0.1)
        cmp.textureName = ''
        cmp.visible = False
        cmp.filterType = 'POINT'
        cmp.pixelSnap = False
        cmp.dragFocus = True
        self.component.mouseButtonFocus = 1

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/maps/Controls/inventory/inventoryFrame2.tga')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'wndFrame')
        itemView = soItemView(GUI.Window(), BarterPaySlot, slot_eventsHandler=self.slot_handler, eventsHandler=self.events_handler, rowWidth=3, cols=3, rows=3, vScroll=True, hScroll=False, borderWidth=0)
        comp = itemView.component
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.position = (1, 29, 0.5)
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        self.component.addChild(comp, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/visual_styles/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (395, 6, 0.2)
        btn.onClick = self.onClose
        self.component.wndFrame.addChild(cmp, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.font = 'ruRU_Cyrvetica_Extra_16title.font'
        cmp.colourFormatting = True
        cmp.multiline = False
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (16, 5, 0.2)
        cmp.text = lc('GUI.QuestItems.WINDOW_CAPTION')
        self.component.wndFrame.addChild(cmp, 'caption')

        def create_button(name, caption, x, y, width, height):
            btn = soButton(GUI.Window())
            comp = btn.component
            btn.initVSC('soGUI/visual_styles/defaultBtn.xml')
            comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
            comp.widthMode = comp.heightMode = 'PIXEL'
            comp.horizontalAnchor = 'LEFT'
            comp.verticalAnchor = 'TOP'
            comp.label.font = 'ruRU_calibri_default.font'
            comp.label.text = caption
            comp.colour = (255, 255, 255, 255)
            comp.materialFX = 'BLEND'
            comp.width = width
            comp.height = height
            comp.position = (x, y, 0.5)
            self.component.wndFrame.addChild(comp, name)
            btn.onBound()
            btn.setVisualState('normal')
            return btn

        self.confirm_button = create_button('confirmBtn', lc('GUI.PackageSellGUI.CONFIRM_BUTTON_LABEL'), 300, 222, 101, 29)
        self.confirm_button.onClick = self.onConfirm
        self.clear_button = create_button('clearBtn', lc('GUI.PackageSellGUI.CLEAR_BUTTON_LABEL'), 200, 222, 101, 29)
        self.clear_button.onClick = self.onClear
        auto_button = create_button('autoBtn', lc('GUI.PackageSellGUI.AUTO_BUTTON_LABEL'), 100, 222, 101, 29)
        auto_button.onClick = self.onAuto
        return

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def onClose(self):
        self.hide_and_restore_dialog(False)

    def onClear(self):
        self.confirm_button.setDisabledState(True)
        self.clear_button.setDisabledState(True)
        for item in self.data:
            item['already_added'] = 0
            for item_id in item['complex_ids']:
                BWPersonality.GUICore.inventoryGUI.delTempBlockItem(item_id)

            del item['complex_ids'][:]

        self.component.itemView.script.setItems(self.data)

    def onAuto(self):

        def get_needed_types():
            return [ item['complexItemType'] for item in self.data if item['already_added'] < item['required_number'] ]

        needed_types = get_needed_types()
        complex_ids = set()
        for slot in BWPersonality.GUICore.inventoryGUI.get_filled_slots():
            if slot.itemData['complexItemType'] in needed_types:
                complex_ids.add(slot.itemData['complexItemID'])
                self._append_item(slot.itemData)
                BWPersonality.GUICore.inventoryGUI.addTempBlockItem(slot.itemData, slot)
                needed_types = get_needed_types()
                if not needed_types:
                    break
        else:
            equiped_ids = ItemsUtils.GetEquipListIDs(BigWorld.player())
            for item in BigWorld.player().CarryingItems:
                if item['complexItemType'] in needed_types and item['complexItemID'] not in complex_ids:
                    item['complexItemID'] not in equiped_ids and complex_ids.add(item['complexItemID'])
                    self._append_item(item)
                    BWPersonality.GUICore.inventoryGUI.addTempBlockItem(item, None)
                    needed_types = get_needed_types()
                    if not needed_types:
                        break
            else:
                RuntimeError

        return

    def onConfirm(self):
        selected_items = []
        for item in self.data:
            selected_items.extend(item['complex_ids'])

        BigWorld.player().quest_item_window_commited(self.quest_id, selected_items)
        self.hide_and_restore_dialog(True)

    def slot_handler(self, event, data):
        if event == module_soItemView.EVENT_DROP and self._permit_adding(data):
            inventory_slot = BWPersonality.GUICore.inventoryGUI.drag_data[0]
            inventory_slot.leave_locked = True
            self._append_item(data[1].itemData)
        elif event == module_soItemView.EVENT_DRAGSTOP:
            for item_id in data.itemData['complex_ids']:
                BWPersonality.GUICore.inventoryGUI.delTempBlockItem(item_id)

            self._clear_item(data)
        return True

    def _clear_item(self, item_data):
        self.confirm_button.setDisabledState(True)
        for item in self.data:
            if item_data.itemData['complexItemType'] == item['complexItemType']:
                item['already_added'] = 0
                del item['complex_ids'][:]
                self.component.itemView.script.setItems(self.data)
                break
        else:
            raise RuntimeError

        for item in self.data:
            if item['already_added'] != 0:
                break
        else:
            self.clear_button.setDisabledState(True)

    def _append_item(self, item_data):
        self.clear_button.setDisabledState(False)
        for item in self.data:
            if item['complexItemType'] == item_data['complexItemType']:
                item['already_added'] += ItemsUtils.GetItemNumber(item_data)
                item['complex_ids'].append(item_data['complexItemID'])
                self.component.itemView.script.setItems(self.data)
                break
        else:
            raise RuntimeError

        for item in self.data:
            if item['already_added'] < item['required_number']:
                break
        else:
            self.confirm_button.setDisabledState(False)

    def _permit_adding(self, data):
        slot_item_data = data[0].itemData
        if not slot_item_data:
            return False
        item_data = data[1].itemData
        return slot_item_data['complexItemType'] == item_data['complexItemType']

    def events_handler(self, event, data):
        return True

    def hide(self):
        self.component.visible = False
        for item in self.data:
            for item_id in item['complex_ids']:
                BWPersonality.GUICore.inventoryGUI.delTempBlockItem(item_id)

    def hide_and_restore_dialog(self, next_node):
        self.hide()
        BWPersonality.GUICore.showInventory(False)
        BWPersonality.GUICore.set_dialog_visible(True)
        BWPersonality.GUICore.setBestCursor()
        if not next_node:
            BigWorld.player().ContinueSameDialog()

    def show(self, quest_id = None):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'quesitemsWindow')
        BWPersonality.GUICore.showInventory(True)
        BWPersonality.GUICore.set_dialog_visible(False)
        self.data = []
        self.quest_id = quest_id
        if quest_id:
            item_type, item_count = qd.get_needed_items_by_id(quest_id)
            self.data.append({'complexItemType': item_type,
             'already_added': 0,
             'required_number': item_count,
             'complex_ids': []})
        else:
            item0 = {'complexItemType': 1,
             'already_added': 0,
             'required_number': 3,
             'complex_ids': []}
            item1 = {'complexItemType': 810093,
             'already_added': 0,
             'required_number': 5,
             'complex_ids': []}
            item2 = {'complexItemType': 810006,
             'already_added': 0,
             'required_number': 4,
             'complex_ids': []}
            self.data.extend([item0, item1, item2])
        self.component.itemView.script.setItems(self.data)
        self.confirm_button.setDisabledState(True)
        self.clear_button.setDisabledState(True)
        self.component.visible = True
        return