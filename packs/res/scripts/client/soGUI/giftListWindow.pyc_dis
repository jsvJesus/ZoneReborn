    def _clickGift(self, gift):
        BWPersonality.GUICore.showGiftWindow(gift)
        sounds.playSound('ui/click')

    def _rightClickGift(self, gift):
        player = BigWorld.player()
        actions = {}
        if gift['statusCode'] in (GIFT_STATUS.HAS_BEEN_SENT,):
            actions[1] = lc('GUI.giftwindow.ORDER_RETURN')
        self._selected_gift = gift
        if player.isAdminAccess():
            if BigWorld.isKeyDown(BigWorld.stringToKey('F2')):
                sounds.playSound('ui/click')
                actions.update({11: 'dev show',
                 12: 'dev delete',
                 13: '-24h'})
        if actions:
            BWPersonality.GUICore.addListener('contextMenuEvent', self._ContextMenuEvent)
            BWPersonality.GUICore.showContextMenu(GUI_ID_GIFT, actions)

    def _ContextMenuEvent(self, interface_id, eventid, caption, event, data = None):
        if interface_id != GUI_ID_GIFT:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            giftID = self._selected_gift['giftID']
            if eventid == 1:
                try:
                    self._returnGift(self._selected_gift)
                except:
                    traceback.print_exc()

            if eventid == 11:
                BWPersonality.GUICore.showGiftWindow(self._selected_gift)
            if eventid == 12:

                def callback(e):
                    if e != gui_jokes.GuiHandler.OK:
                        return
                    BigWorld.player().base.deleteGift(self._type_gift, self._selected_gift['giftID'])
                    self.onGiftChange()

                msg = lc('GUI.giftwindow.MSG_DEL')
                msg += '\n' + self._selected_gift['giftID'].decode('utf8')
                gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_DEL'), msg, callback)
            if eventid == 13:

                def callback(e):
                    if e != gui_jokes.GuiHandler.OK:
                        return
                    time_back = 86400
                    BigWorld.player().cell.runCommand(u'/fastGift %s %s' % (giftID.decode('utf8'), time_back))
                    self.onGiftChange()

                gui_jokes.askUserOk('', u'\u043f\u0435\u0440\u0435\u043c\u043e\u0442\u0430\u0442\u044c \u0432\u0440\u0435\u043c\u044f \u043d\u0430 24 \u0447\u0430\u0441\u0430', callback)
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            try:
                BWPersonality.GUICore.removeListener('contextMenuEvent', self._ContextMenuEvent)
            except:
                traceback.print_exc()

    wind_tarif = None

    def _returnGift(self, gift):
        if gift['statusCode'] not in (GIFT_STATUS.HAS_BEEN_SENT,):
            return
        if gift['toAvatar'].strip().lower() == gift['fromAvatar'].strip().lower():
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_ERROR'), lc('GUI.giftwindow.MSG_RETURN_SELF_ERRROR'))
            return
        if time.time() - BWPersonality.gpd.time_diff - gift['timeOfArrival'] < GiftBankUtils.TIME_RETURN_GIFT:
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_ERROR'), lc('GUI.giftwindow.MSG_RETURN_TIME_ERRROR'))
            return
        if not self.wind_tarif:
            self.wind_tarif = giftTariff.GiftTariff(GUI.Window())
            self.wind_tarif.onBound()
        data = {'from_bank': gift['toTrader'],
         'to_bank': gift['toTrader'],
         'to_avatar': gift['toAvatar'],
         'gold': gift['gold'],
         'money': gift['money'],
         'comment': '',
         'items': gift['itms'],
         'return_gift': gift}

        def callback_on_send():
            BWPersonality.GUICore.showGiftWindow(None)
            return

        BWPersonality.GUICore.showGiftWindow(gift)
        self.wind_tarif.show(data, self, callback_on_send)

    def _switchToTab(self, tab_id):
        for gift_type, btn in self._btn_tabs.items():
            btn.buttonActive = tab_id == gift_type
            btn._updateVisualState()

        self.clearData()
        self.wait()
        self.switchTo(tab_id)

    def setupItems(self):
        item_width = 25
        self._entries = []
        for i in range(GiftBankUtils.NUMER_STRING_PAGE + 1):
            item = GiftItem(GUI.Window(), self.component.width - 10, item_width, i)
            self.component.addChild(item.component, 'item_%s' % i)
            item.component.position = (4, i * (item_width + 2) + 30, 0.5)
            if item.isTitle():
                item._cbOnStateChange = self._onCbChangeTitle
                self._entrieTitle = item
            else:
                self._entries.append(item)
                item._cbOnStateChange = self._onCbChangeItem
                item.click = self._clickGift
                item.rightClick = self._rightClickGift

        for x in (27, 137, 225, 395):
            cmp = GUI.Simple('textures/default/white.jpg')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.verticalAnchor = 'TOP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.colour = (255, 255, 255, 80)
            cmp.materialFX = 'BLEND'
            cmp.height = self.component.height - 95
            cmp.width = 1
            cmp.position = (x, 30, 0.4)
            self.component.addChild(cmp, 'line_%s' % x)

    def update(self, gifts, type_gift, page_index, page_count, total_amount):
        self._gifts = gifts
        self._type_gift = type_gift
        self._page_count = page_count
        self._cur_page = page_index
        self.component.number_pages.text = lc('GUI.giftwindow.PAGES').format(page_index, page_count)
        if type_gift == GiftBankUtils.GIFT_TYPE.ACCEPTED_GIFTS:
            self.component.number_gifts.text = lc('GUI.giftwindow.TOTAL').format(total_amount, max(GiftBankUtils.MAX_GIFTS, total_amount))
        else:
            self.component.number_gifts.text = u''
        self.check_locked_nav_button()
        self.component.btn_nav_begining
        self.clearData()
        for index, gift in enumerate(self._gifts):
            self._entries[index].show(gift, self._npcName)

        self.clearDarkScreen()

    def show(self, npcName = '', gift_type = GIFT_TYPE.ACCEPTED_GIFTS):
        if not npcName:
            p = BigWorld.player()
            npcName = p.GetTraderName(p.cacheObjectID)
        self._npcName = npcName
        self.clearDarkScreen()
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('GiftListWindow')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'GiftListWindow')
        self.component.visible = True
        self.doReposition()
        self.wait()
        self._type_gift = gift_type
        self._switchToTab(gift_type)
        return

    def hide(self):
        self.component.visible = False
        self._npcName = ''
        if self._entrieTitle and self._entrieTitle._cb.isChecked():
            self._entrieTitle._cb.setInactive()
        self._gifts = []
        self._cur_page = 1
        self._page_count = 1
        BWPersonality.GUICore.showGiftSendWindow(False)

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        cache_y = 0.33
        if BWPersonality.GUICore.itemCacheGUI:
            cache_x = BWPersonality.GUICore.itemCacheGUI.component.position[0]
            cache_y = BWPersonality.GUICore.itemCacheGUI.component.position[1]
            cache_w = BWPersonality.GUICore.itemCacheGUI.component.width
            self.component.position = (cache_x - float(cache_w) / sW * 2, cache_y, 0.45)
        else:
            self.component.position = (1 - float(581 / sW) * 2, cache_y, 0.49)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def clearData(self):
        for entr in self._entries:
            entr.hide()

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False

    def _onCbChangeTitle(self, value):
        for entr in self._entries:
            if value:
                if entr._cb.isEnabled():
                    entr._cb.setActive()
            else:
                entr._cb.setInactive()

    def _onCbChangeItem(self, value):
        if not value and self._entrieTitle._cb.isChecked():
            self._entrieTitle._cb.setInactive()

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('helpBox', 'onClick')
    def onHelpBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('GUI.giftwindow.hintBox', lc('GUI.giftwindow.MANUAL_TITLE'), colorCodes.tf3_regular_text_color + lc('GUI.giftwindow.MANUAL_TEXT'))

    @PyGUIEvent('button_create', 'onClick')
    def _showCreateGift(self):
        BWPersonality.GUICore.showGiftSendWindow(True)

    @PyGUIEvent('button_delete', 'onClick')
    def _deleteSelectedGift(self):
        lstdelete = []
        need_to_ask = False
        for entr in self._entries:
            if entr.isVisible() and entr._cb.isChecked():
                if entr._gift:
                    lstdelete.append(entr._gift['giftID'])
                    lstdelete.append(entr._gift['giftID'])
                    if entr._gift['statusCode'] not in (GIFT_STATUS.IS_ALREADY_OPEN, GIFT_STATUS.HAS_BEEN_SENT):
                        need_to_ask = True
                    lstdelete.append(entr._gift['giftID'])

        if not lstdelete:
            return

        def callback(e):
            if e == gui_jokes.GuiHandler.OK:
                for giftID in lstdelete:
                    BigWorld.player().base.deleteGift(self._type_gift, giftID)

                self.onGiftChange()
                if self._entrieTitle._cb.isChecked():
                    self._entrieTitle._cb.setInactive()

        if need_to_ask:
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_DEL'), lc('GUI.giftwindow.MSG_DEL'), callback)
        else:
            callback(gui_jokes.GuiHandler.OK)

    @dealyed
    def onGiftChange(self):
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)

    def check_locked_nav_button(self):
        left_limit = self._cur_page <= 1
        right_limit = self._cur_page >= self._page_count
        self.component.btn_nav_begining.script.setDisabledState(left_limit)
        self.component.btn_nav_bw.script.setDisabledState(left_limit)
        self.component.btn_nav_end.script.setDisabledState(right_limit)
        self.component.btn_nav_fw.script.setDisabledState(right_limit)

    @dealyed
    def _navigation_begin(self):
        self._cur_page = 1
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)

    @dealyed
    def _navigation_back(self):
        self._cur_page = max(1, self._cur_page - 1)
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)

    @dealyed
    def _navigation_forward(self):
        self._cur_page = min(self._cur_page + 1, self._page_count)
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)

    @dealyed
    def _navigation_end(self):
        self._cur_page = self._page_count
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)

    @dealyed
    def switchTo(self, gift_type):
        self._cur_page = 1
        self._type_gift = gift_type
        BigWorld.player().base.getListGifts(self._type_gift, self._cur_page)