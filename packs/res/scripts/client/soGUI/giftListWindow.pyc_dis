def timeToDateString(servertime):
    clientitme = servertime + BWPersonality.gpd.time_diff
    return time.strftime('%d/%m/%y %H:%M', time.localtime(clientitme))


def dealyed(foo):

    def call(self, *w, **kw):
        self.wait()
        self.clearData()
        if hasattr(self, 'clb_id_wait'):
            BigWorld.cancelCallback(self.clb_id_wait)
        self.clb_id_wait = BigWorld.callback(0.5, lambda : foo(self, *w, **kw))

    return call


class SimpleLink(PyGUIBase):

    def __init__(self, component, lst_components):
        super(SimpleLink, self).__init__()
        self._lst_components = lst_components
        component.script = self
        self.component = component
        component.crossFocus = True
        component.mouseButtonFocus = True
        component.focus = True
        self.seltextcolour = seltextcolour
        self.textcolour = textcolour

    def handleMouseClickEvent(self, comp):
        self.click()
        return True

    def handleMouseButtonEvent(self, comp, event):
        if event.key == KEY_RIGHTMOUSE and not event.isKeyDown():
            self.rightClick()
        return True

    def handleMouseEnterEvent(self, *e):
        for cmp in self._lst_components:
            cmp.colour = self.seltextcolour

        sounds.playSound('ui/hover')
        return True

    def handleMouseLeaveEvent(self, *e):
        for cmp in self._lst_components:
            cmp.colour = self.textcolour

        return True

    def click(self):
        pass

    def rightClick(self):
        pass


