    def hide(self):
        self.component.visible = False
        self._cb.setInactive()
        self._gift = None
        return

    def show(self, gift, npcName = ''):
        self.component.visible = True
        self._gift = gift
        self._npcName = npcName
        self.component.userFrame.username.text = gift['fromAvatar']
        if not _NPCs.getName(gift['toTrader']):
            self.component.bankFrame.bankname.text = '???'
            self.component.date.text = timeToDateString(gift['timeOfArrival'])
            self.component.status.text = GIFT_STATUS.caption.get(gift['statusCode'], u'????')
            okstatus = (GIFT_STATUS.HAS_BEEN_SENT,
             GIFT_STATUS.WAIT_TO_OPEN,
             GIFT_STATUS.START_OPEN,
             GIFT_STATUS.RETURNED_WAIT_TO_OPEN)
            self._locked_gift = False
            self._cb.enable()
            self._locked_gift = (gift['statusCode'] == GIFT_STATUS.IS_FORWARDED or gift['statusCode'] == GIFT_STATUS.RETURNED or gift['toTrader'] != self._npcName and not gift['statusCode'] == GIFT_STATUS.HAS_BEEN_SENT) and True
            self._cb.disable()
        for cmp in self._selectable_cmp:
            sel_color = goodWHcolourLOCK
            if self._locked_gift:
                cmp.crossFocus = False
                cmp.mouseButtonFocus = True
            else:
                cmp.crossFocus = True
                cmp.mouseButtonFocus = True
            if gift['statusCode'] in okstatus:
                if gift['toTrader'] == self._npcName or gift['statusCode'] == GIFT_STATUS.HAS_BEEN_SENT:
                    color = goodWHcolour
                    sel_color = seltextcolour
                else:
                    color = wrongWHcolour
                    sel_color = seltextcolour
            elif gift['toTrader'] == self._npcName:
                color = goodWHcolourLOCK
                sel_color = seltextcolour
            else:
                color = wrongWHcolourLOCK
                sel_color = seltextcolour
            cmp.colour = color
            cmp.script.textcolour = color
            cmp.script.seltextcolour = sel_color

    def isVisible(self):
        return self.component.visible

    def isTitle(self):
        return not bool(self._index)

    def _cbOnStateChange(self, value):
        pass

    def _click(self, gift):
        if not self._locked_gift:
            self.click(gift)

    def click(self, gift):
        print 'show', gift

    def rightClick(self, gift):
        print 'rightClick', gift


