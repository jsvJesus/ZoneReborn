    def slotHandler(self, *e):
        pass

    def viewHandler(self, *e):
        pass

    def update(self, base_name, data):
        self.clearDarkScreen()
        self.component.iLabel.text = lc('B2CEntitiesInfo.base_management_title') + '   ' + lc('BaseToCaptureNames.%s' % base_name).replace('\n', '')
        if not data:
            return
        level = data['level']
        self.component.llevel.text = lc('B2CEntitiesInfo.base_level').format(level)
        entities_info = map(dict, data['entities_info'])
        bylevel = dict(base_level=level, base_name=base_name, clan_money=data['clan_money'], clan_gold=data['clan_gold'])
        map(lambda x: x.update(bylevel), entities_info)
        entities_info.sort(key=lambda x: (x['level_can_buy'], x['cost_ruble']))
        self.itemView.setItems(entities_info)
        self._money.setValue(data['clan_money'])
        self._gold.setValue(data['clan_gold'])

    def show(self, base_name = ''):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        if not base_name:
            base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
            base_name = base_gui._current_base
        self.base_name = base_name
        if base_name:
            data = BWPersonality.GUICore._base_entities_info.get(base_name, None)

            def update_from_server():
                if self.component.visible:
                    BigWorld.player().cell.show_info_entities_base(base_name)

            BigWorld.callback(0.7, update_from_server)
        self.component.iLabel.text = lc('B2CEntitiesInfo.base_management_title')
        self._money.setValue(0)
        self._gold.setValue(0)
        self.itemView.setItems(None)
        self.component.llevel.text = ''
        self.component.visible = True
        self.doReposition()
        self.wait()
        return

    def hide(self):
        self.component.visible = False

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        self.component.position = (0, 0, 0.49)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def clearData(self):
        pass

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False

    def onBtnShowBank(self):
        BWPersonality.GUICore.showBaseMoneyInfo(True)
        self.hide()

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('helpBox', 'onClick')
    def onHelpBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('GUI.B2CEntitiesInfo.hintBox', lc('B2CEntitiesInfo.base_management_title'), colorCodes.tf3_regular_text_color + lc('B2CEntitiesInfo.base_management_help'))