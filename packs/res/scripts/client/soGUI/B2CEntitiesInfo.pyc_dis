def dealyed(foo):

    def call(self, *w, **kw):
        self.parent_script.wait()
        self.parent_script.clearData()
        if hasattr(self, 'clb_id_wait'):
            BigWorld.cancelCallback(self.clb_id_wait)
        self.clb_id_wait = BigWorld.callback(0.7, lambda : foo(self, *w, **kw))

    return call


