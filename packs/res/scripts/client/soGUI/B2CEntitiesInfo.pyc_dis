    def onBtnBuyClick(self):
        if not self.haveItem():
            return
        base_name = self.itemData['base_name']
        buy_status = not self.itemData['already_spawned']
        guid = self.itemData['guid']
        player = BigWorld.player()
        if not player.checkClanRights(Clan.FLAG_CAN_BASE_BUY_ENTITIES):
            gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.ClanRightsError'))
            return
        if buy_status:
            cost = u''
            cost = lc('B2CEntitiesInfo.for_money').format(self.itemData['cost_ruble'])
            if self.itemData['cost_ruble'] > self.itemData['clan_money']:
                gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_OK'), lc('B2CEntitiesInfo.base_money_error'))
                return
            msg = lc('B2CEntitiesInfo.ask_buy_entity').format(self.itemData['lcname'], cost)
        if not buy_status:
            msg = lc('B2CEntitiesInfo.ask_delete_entity').format(self.itemData['lcname'])

        def listener(event):
            if event == gui_jokes.askUserYesNo.YES:
                self._buy_entity(base_name, guid, buy_status)

        gui_jokes.askUserYesNo(lc('B2CEntitiesInfo.title_msg'), msg, listener)

    @dealyed
    def _buy_entity(self, base_name, guid, buy_status):
        player = BigWorld.player()
        player.cell.buy_attached_entity_base(base_name, guid, buy_status)

    def _applyItemData(self):
        self.component.entity_name.text = u''
        self.component.level.text = u''
        self.component.button_buy.visible = False
        self.component.buying.visible = False
        self._money.component.visible = False
        self._money_pd.component.visible = False
        self._gold_pd.component.visible = False
        self.component.frameCmp.colour = (255, 255, 255, 255)
        self.component.entity_name.colour = (175, 166, 112, 255)
        if self.haveItem():
            self.component.entity_name.text = self.itemData['lcname']
            self.component.level.text = str(self.itemData['level_can_buy'])
            cost_ruble = self.itemData['cost_ruble']
            self._money.setAlpha(255)
            self._money_pd.setAlpha(255)
            self._gold_pd.setAlpha(255)
            self._money.component.visible = True
            self._money.setValue(cost_ruble)
            p_gold = 0
            p_ruble = self.itemData['payment_per_day_rouble']
            if p_gold:
                self._gold_pd.component.visible = True
                self._gold_pd.setValue(p_gold)
            else:
                self._money_pd.component.visible = True
                self._money_pd.setValue(p_ruble)
            self.component.button_buy.visible = True
            self.component.button_buy.script.setDisabledState(False)
            if self.itemData['already_spawned']:
                self.component.button_buy.label.text = lc('B2CEntitiesInfo.remove_entity')
                self.component.buying.visible = True
            else:
                self.component.button_buy.label.text = lc('B2CEntitiesInfo.btn_buy')
                if self.itemData['base_level'] < self.itemData['level_can_buy']:
                    self.component.frameCmp.colour = (255, 255, 255, 200)
                    self.component.button_buy.script.setDisabledState(True)
                    self.component.entity_name.colour = (175, 166, 112, 180)
                    money_alpha = 100
                    self._money.setAlpha(money_alpha)
                    self._money_pd.setAlpha(money_alpha)
                    self._gold_pd.setAlpha(money_alpha)


