class ColorChoiceGui(PyGUIBase):
    factoryString = 'ColorChoiceGuiX'
    MAX_DISTANCE = 50.0
    MIN_DISTANCE = 0.0

    def __init__(self, component):
        self.activeTint = 'clothesColour1'
        PyGUIBase.__init__(self, component)
        component.script = self
        self.setupRoot()
        path = 'soGUI/maps/blood/%s.tga'
        name = 'frame'
        self.createCmp(name, path % name)
        self.component.focus = 1

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = horizontalAnchor = 'TOP'
        cmp.colour = (100, 1, 1, 100)
        cmp.materialFX = 'BLEND'
        sW, sH = BigWorld.screenSize()
        cmp.height = 270
        cmp.width = 270
        cmp.position = (sW * 3 // 4, sH // 2, 0.5)
        cmp.visible = 1
        BWPersonality.GUICore.generalLayer.delChild(self.factoryString)
        BWPersonality.GUICore.generalLayer.addChild(cmp, self.factoryString)
        BWPersonality.GUICore.generalLayer.reSort()

    def show(self):
        self.component.visible = 1

    def hide(self):
        self.component.visible = 0

    def handleAxisEvent(self, component, position):
        print 'handleAxisEvent'

    def handleKeyEvent(self, event):
        if event.key == 256:
            x, y = self.component.screenToLocal(event.cursorPosition)
            print x, y
            if x > 255 and x < 275 and y > 0 and y < 255:
                self.setBlue(y)
                print 'setBlue', y
            if x > 0 and y > 0 and x < 255 and y < 255:
                blue = self.blue / 255.0
                rcolor, gcolor = x / 255.0, y / 255.0
                self.testcolor.colour = (x,
                 y,
                 self.blue,
                 255)
                cmp = getattr(self.component, self.activeTint)
                cmp.colour = (x,
                 y,
                 self.blue,
                 255)
                return True
        return False

    def handleMouseButtonEvent(self, event):
        print 'handleMouseButtonEvent', event

    def handleMouseClickEvent(self, component):
        print 'handleMouseClickEvent', event

    def handleMouseEvent(self, component):
        print 'handleMouseEvent', event

    def createCmp(self, name, path):
