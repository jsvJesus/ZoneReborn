            cmp.width = 20
            cmp.height = 20
            cmp.position = (x * 20 - 20, 275, 0.1)
            cmp.script.onClick = lambda x = x: setattr(self, 'activeTint', 'clothesColour%s' % x)
            cmp.script.setDisabledState(False)
