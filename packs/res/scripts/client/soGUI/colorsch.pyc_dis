    def setBlue(self, blue):
        self.blue = blue
        self.bluemarker.position = (255, self.blue, 0.3)
        for r in range(10):
            rname = r * 25
            for g in range(10):
                gname = g * 25
                gcolor = g * 10
                blue = self.blue
                rcolor = r * 10
                cmp = getattr(self.component, 'rgb%s_%s' % (rname, gname))
                cmp.colour = (blue,
                 rcolor,
                 gcolor,
                 255)