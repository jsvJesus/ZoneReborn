    def up(self):
        self.curIndex -= 1
        self.curIndex = max(0, self.curIndex)
        self.createB()

    def down(self):
        self.curIndex += 1
        maxx = len(self.camera_node) - self.bmax
        if maxx < 0:
            maxx = 0
        self.curIndex = min(maxx, self.curIndex)
        self.createB()

    def hidemodel(self):
        BigWorld.player().model.visible = not BigWorld.player().model.visible
        text = ['unhide model', 'hide model'][int(BigWorld.player().model.visible)]
        self.component.button_hidemodel.script.component.label.text = text

    def clearB(self):
        for name in self.bb:
            self.component.delChild(name)

    def MouseScrollEvent(self, val):
        if not self.isPlay:
            return False
        if not BigWorld.player().isMovie:
            return False
        step = 0.01
        if BigWorld.isKeyDown(BigWorld.stringToKey('KEY_LCONTROL')):
            step = 0.05
        if BigWorld.isKeyDown(BigWorld.stringToKey('LSHIFT')):
            step = 0.01
        if val > 0:
            self.speed += step
        else:
            self.speed -= step
        BigWorld.sFlySpeedM(self.speed)
        self.component.label_speed.text = 'speed: %.2f' % self.speed
        print self.speed
        return True

    def createB(self):
        self.clearB()
        print [self.curIndex]
        indexpos = 0
        for i, cam in enumerate(self.camera_node):
            if i < self.curIndex:
                continue
            if i > self.curIndex + self.bmax:
                return
            btn = soButton(GUI.Window())
            cmp = btn.component
            btn.initVSC('soGUI/visual_styles/defaultBtn.xml')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'BOTTOM'
            cmp.label.font = 'ruRU_calibri_default.font'
            cmp.label.text = u'%s:  %s' % (i, cam)
            cmp.colour = (255, 255, 255, 255)
            cmp.materialFX = 'BLEND'
            cmp.width = 300
            cmp.height = 30
            cmp.position = (50, 70 + 35 * indexpos, 0.5)
            cmp.script.onClick = lambda cam = cam: self.play(cam)
            self.component.addChild(cmp, 'button_play_%s' % i)
            self.bb.append('button_play_%s' % i)
            btn.onBound()
            cmp.label.horizontalAnchor = 'LEFT'
            cmp.label.horizontalPositionMode = cmp.label.verticalPositionMode = 'PIXEL'
            cmp.label.widthMode = cmp.label.heightMode = 'PIXEL'
            cmp.label.position = (5, 15, 0)
            indexpos += 1

    def play(self, path):
        BigWorld.runFlyThrough(path, 1)
        BigWorld.sFlySpeedM(self.speed)
        self.isPlay = 1
        BigWorld.player().isMovie = True
        BigWorld.callback(0.5, self.loop)

    def stop(self):
        BigWorld.cancelFlyThrough()
        self.isPlay = 0
        BigWorld.player().isMovie = False

    def loop(self):
        if not self.isPlay:
            return

    def show(self, item = None, BankName = ''):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'soCamFly')
        self.component.visible = True
        self.showAppGUI(1)
        BWPersonality.GUICore.mouseAltMode = True
        BWPersonality.GUICore.setBestCursor()
        return

    def showAppGUI(self, doShow):
        from BWPersonality import GUICore
        if GUICore.hiddenState and doShow:
            GUICore.show()
        if not GUICore.hiddenState and not doShow:
            GUICore.hide()

    def hide(self):
        self.component.visible = False