    def setupMap(self):
        cmp = GUI.Window('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = self.component.width - 6
        cmp.height = self.component.height - 69
        cmp.position = (3, 30, 0.2)
        cmp.textureName = ''
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'mapHolder')
        for map in self.MAPLIST:
            self.component.mapHolder.addChild(self.MAPLIST[map].component, map)
            self.maps[map] = self.MAPLIST[map].component

    def setupStatusBar(self):
        pass

    def setSize(self, w, h):
        self.component.width = w
        self.component.height = h
        self.component.closeBox.position = (self.component.width - 6, 6, 0.2)
        self.component.wndFrame.width = self.component.width
        self.component.wndFrame.height = self.component.height - 9
        self.component.hintBox.position = (self.component.width - 48, 6, 0.2)
        self.component.zoomIn.position = (self.component.width - 57, 32, 0.1)
        self.component.zoomOut.position = (self.component.width - 32, 32, 0.1)
        self.component.centerOnPlayer.position = (self.component.width - 92, 32, 0.1)
        self.component.panUp.position = ((self.component.width - 4) / 2, 32, 0.1)
        self.component.panRight.position = (self.component.width - 31, (self.component.height - 24) / 2, 0.1)
        self.component.panDown.position = ((self.component.width - 4) / 2, self.component.height - 73, 0.1)
        self.component.panLeft.position = (6, (self.component.height - 24) / 2, 0.1)
        self.component.maps.position = (self.component.width - 102 - self.component.maps.width, 32, 0.1)
        self.component.mapHolder.size = (self.component.width - 6, self.component.height - 69)
        for map, soMap in self.MAPLIST.items():
            soMap.setSize(w, h)

        self.centerOnCenter()

    def doReposition(self):
        w, h = BWPersonality.settings.GUISettings.getMapSize()
        self.setSize(w, h)

    def viewMap(self, space = 'spaces/city_lubech'):
        if not self.maps.has_key(space):
            return False
        for map in self.maps:
            self.maps[map].script.hide()

        self.maps[space].script.show()
        self.currentMap = space
        self.component.maps.script.setSelectionByValue(space, silent=True)
        return True

    def updatePlayer(self, oldData):
        self.maps[oldData['charSpace']].script.removeMark()

    def addWantedMark(self, markname, mappos, map_name):
        if self.wanted_map is not None and self.wanted_data is not None:
            self.maps[self.wanted_map].script.removeMark(self.wanted_data[0:2])
        self.wanted_map = map_name
        self.wanted_data = (MapNotes.TYPE_WANTED, mappos, markname)
        self.maps[map_name].script.addMark(markname, MapNotes.TYPE_WANTED, mappos, 0.0, (255, 255, 255, 255), mappos)
        return

    def update(self):
        data = BWPersonality.GUICore.gpsDataSection
        ID = 0
        TYPE = 0
        COORDS = 1
        DIR = 2
        COL = 3
        POS = 1
        if data.has_key('marks'):
            for map_name in self.maps:
                if not data['marks'].has_key(map_name) and self.maps.has_key(map_name):
                    self.maps[map_name].script.removeAllMarks()
                    if self.markData.has_key(map_name):
                        self.markData[map_name] = []
                        del self.markData[map_name]

            for map_name in self.markData:
                for key, mark in self.markData[map_name].items():
                    if data['marks'].has_key(map_name) and self.maps.has_key(map_name) and key not in data['marks'][map_name]:
                        if key == self.wanted_data:
                            continue
                        self.maps[map_name].script.removeMark(key)
                        self.markData[map_name][key] = ()
                        del self.markData[map_name][key]

            for map_name in data['marks']:
                if not self.MAPLIST.has_key(map_name):
                    continue
                for key, mark in data['marks'][map_name].items():
                    if not self.markData.has_key(map_name):
                        self.markData[map_name] = {}
                    if key not in self.markData[map_name]:
                        self.markData[map_name][key] = mark
                        self.maps[map_name].script.addMark(mark[ID], key[TYPE], mark[COORDS], mark[DIR], mark[COL], key[POS])
                    if key[TYPE] == MapNotes.TYPE_WANTED:
                        print 'key[TYPE] == MapNotes.TYPE_WANTED', self.wanted_map, self.wanted_data
                    if key[TYPE] == MapNotes.TYPE_PLAYER:
                        self.charMap = map_name

        if data.has_key('spaces'):
            maps = []
            for mapID in data['spaces']:
                if not self.MAPLIST.has_key(mapID):
                    continue
                map = [mapID, self.MAPLIST[mapID].getFriendlyName()]
                maps.append(map)

            if maps:
                self.component.maps.script.clear()
                self.component.maps.script.addElements(maps)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('gpsMap')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'gpsMap')
        BWPersonality.GUICore.setBestCursor()
        if BWPersonality.GUICore.gpsDataSection is not None:
            self.viewMap(self.charMap)
        else:
            self.viewMap('spaces/city_lubech')
        self.component.visible = True
        BWPersonality.GUICore.generalGUIEvent(GUIEvents.EVENT_SHOW, GUI_ID.GUI_ID_GPSMAP)
        return

    def hide(self):
        self.component.visible = False
        self.component.maps.script.showList(False)
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.generalGUIEvent(GUIEvents.EVENT_HIDE, GUI_ID.GUI_ID_GPSMAP)

    def panBtnHandler(self, dir = 0):
        if dir == self.DIRECTION_UP:
            self.MAPLIST[self.currentMap].panUp()
        if dir == self.DIRECTION_DOWN:
            self.MAPLIST[self.currentMap].panDown()
        if dir == self.DIRECTION_LEFT:
            self.MAPLIST[self.currentMap].panLeft()
        if dir == self.DIRECTION_RIGHT:
            self.MAPLIST[self.currentMap].panRight()

    def zoomHandler(self, dir = 0):
        """ 0 - in, 1 - out """
        if dir:
            self.MAPLIST[self.currentMap].zoomOut(True)
        else:
            self.MAPLIST[self.currentMap].zoomIn(True)

    def centerOnCoords(self, coords, charMap):
        if not self.MAPLIST.has_key(charMap):
            return
        charMap = self.MAPLIST[charMap]
        if coords[0] <= 0:
            hTScroll = charMap.centeringMinScroll[0] * coords[0]
        else:
            hTScroll = charMap.centeringMaxScroll[0] * coords[0]
            hTScroll *= -1.0
        if coords[1] <= 0:
            vTScroll = charMap.centeringMinScroll[1] * coords[1]
            vTScroll *= -1.0
        else:
            vTScroll = charMap.centeringMaxScroll[1] * coords[1]
        charMap.component.scroll = (hTScroll, -vTScroll)

    def centerOnPlayer(self):
        if self.charMap:
            self.viewMap(self.charMap)
        else:
            return
        charMark = None
        charMap = self.MAPLIST[self.charMap]
        for mark in charMap.marks:
            if charMap.marks[mark].script.isPlayer():
                charMark = charMap.marks[mark].script

        if not charMark:
            return
        else:
            coords = charMark.getCoords()
            if coords[0] <= 0:
                hTScroll = charMap.centeringMinScroll[0] * coords[0]
            else:
                hTScroll = charMap.centeringMaxScroll[0] * coords[0]
                hTScroll *= -1.0
            if coords[1] <= 0:
                vTScroll = charMap.centeringMinScroll[1] * coords[1]
                vTScroll *= -1.0
            else:
                vTScroll = charMap.centeringMaxScroll[1] * coords[1]
            charMap.component.scroll = (hTScroll, -vTScroll)
            return

    def centerOnMouse(self):
        if not self.MAPLIST.has_key(self.currentMap):
            return
        currMap = self.MAPLIST[self.currentMap]
        cmp = currMap.component.spaceMap
        cmp.widthMode = cmp.heightMode = 'CLIP'
        pos = currMap.viewAnchor
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        if pos[0] <= 0:
            hTScroll = currMap.centeringMinScroll[0] * pos[0]
        else:
            hTScroll = currMap.centeringMaxScroll[0] * pos[0]
            hTScroll *= -1.0
        if pos[1] <= 0:
            vTScroll = currMap.centeringMinScroll[1] * pos[1]
            vTScroll *= -1.0
        else:
            vTScroll = currMap.centeringMaxScroll[1] * pos[1]
        currMap.component.scroll = (hTScroll, -vTScroll)

    def centerOnCenter(self):
        if not self.MAPLIST.has_key(self.currentMap):
            return
        currMap = self.MAPLIST[self.currentMap]
        cmp = currMap.component.spaceMap
        cmp.widthMode = cmp.heightMode = 'CLIP'
        pos = currMap.viewAnchor
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        if pos[0] <= 0:
            hTScroll = currMap.centeringMinScroll[0] * pos[0]
        else:
            hTScroll = currMap.centeringMaxScroll[0] * pos[0]
            hTScroll *= -1.0
        if pos[1] <= 0:
            vTScroll = currMap.centeringMinScroll[1] * pos[1]
            vTScroll *= -1.0
        else:
            vTScroll = currMap.centeringMaxScroll[1] * pos[1]
        currMap.component.scroll = (hTScroll, -vTScroll)

    def fini(self):
        soGPSMark.TYPEMAP = None
        for spaceMap in self.MAPLIST:
            self.MAPLIST[spaceMap].fini()

        soGPSMap.MAPLIST = None
        return

    @PyGUIEvent('centerOnPlayer', 'onClick')
    def centerBtnClick(self):
        self.centerOnPlayer()

    @PyGUIEvent('maps', 'onSelectedElement')
    def onSpaceClick(self, mapID):
        self.viewMap(mapID)

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('BarterWindowGUI.hintBox', lc('soGPSMap.soGUI.MANUAL_TITLE'), colorCodes.tf3_regular_text_color + lc('soGPSMap.soGUI.MANUAL_TEXT'))

    def handleDragStartEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        self.component.maps.script.showList(False)
        x, y = BWPersonality.game.mcursor.position
        delta_x = self.component.position[0] - x
        delta_y = self.component.position[1] - y
        self._deltaposition = (delta_x, delta_y)
        self._repeatMoveToCursor()
        return True

    def handleDragStopEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        BigWorld.cancelCallback(self._clbID)
        return True

    def _moveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80\xd0\xb0 \xd0\xbc\xd0\xb8\xd1\x88\xd0\xb8."""
        x, y = BWPersonality.game.mcursor.position
        sW, sH = BigWorld.screenSize()
        x_position = self._deltaposition[0] + x
        x = max(-1 + self.component.width / sW, min(x_position, 1 - self.component.width / sW))
        y_position = self._deltaposition[1] + y
        y = min(1 - self.component.height / sH, max(y_position, -1 + self.component.height / sH))
        self.component.position = (x, y, self.component.position[2])

    def _repeatMoveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb0\xd0\xbb."""
        if not self.component.visible:
            return
        elif self.component.parent is None:
            return
        else:
            self._moveToCursor()
            self._clbID = BigWorld.callback(0.01, self._repeatMoveToCursor)
            return

    @staticmethod
    def _zoomSteps(scale, steps = 0):
        STEPS_COUNT = 7
        GOLD_STEPS = [ round(1.382 ** g, 3) for g in range(STEPS_COUNT - 1, -1, -1) ]
        return [ scale * x for x in GOLD_STEPS[steps:] ]