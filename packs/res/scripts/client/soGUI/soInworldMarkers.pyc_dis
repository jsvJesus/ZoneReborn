# Embedded file name: ./scripts/client/soGUI/soInworldMarkers.py
import BigWorld
import GUI
import BWPersonality
import soGUI
import Helpers.PyGUI as PyGUI
import UCManager
import Math
from Math import Vector3
from math import cos
from math import sqrt
