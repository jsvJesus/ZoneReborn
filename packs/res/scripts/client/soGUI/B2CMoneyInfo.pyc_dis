def dealyed(foo):

    def call(self, *w, **kw):
        self.wait()
        self.clearData()
        if hasattr(self, 'clb_id_wait'):
            BigWorld.cancelCallback(self.clb_id_wait)
        self.clb_id_wait = BigWorld.callback(0.5, lambda : foo(self, *w, **kw))

    return call


def checkRight(flag_right):
    """\xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd1\x83\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2 \xd0\xb8\xd0\xb3\xd1\x80\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8e"""

    def wrapper(foo):

        def call(self, *w, **kw):
            player = BigWorld.player()
            if not player.checkClanRights(flag_right):
                gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.ClanRightsError'))
                return
            return foo(self, *w, **kw)

        return call

    return wrapper


