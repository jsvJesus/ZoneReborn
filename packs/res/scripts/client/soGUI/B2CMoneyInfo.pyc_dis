    def update(self, base_name, data):
        self.clearDarkScreen()
        self.component.iLabel.text = lc('B2CEntitiesInfo.title_money_bank') + '    ' + lc('BaseToCaptureNames.%s' % base_name).replace(chr(10), '')
        self.component.llevel.text = lc('B2CEntitiesInfo.base_level').format(data['level'])
        self.base_name = base_name
        self.base_money = data['clan_money']
        self.base_gold = data['clan_gold']
        self._money.setValue(data['clan_money'])
        self._gold.setValue(data['clan_gold'])
        text = u''
        for e in data['entities_info']:
            text += lc('B2CEntitiesInfo.income').format(e['lcname'], e['income']) + '\n'

        self.ctext.setText(text)

    def show(self, base_name = ''):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.iLabel.text = lc('B2CEntitiesInfo.title_money_bank')
        self.component.llevel.text = ''
        self.ctext.setText(u'')
        self._money.setValue(0)
        self._gold.setValue(0)
        if not base_name:
            base_gui = BWPersonality.GUICore.getBaseToCaptureGUI()
            base_name = base_gui._current_base
        self.base_name = base_name
        if base_name:
            data = BWPersonality.GUICore._base_money_info.get(base_name, None)

            def update_from_server():
                if self.component.visible:
                    BigWorld.player().cell.show_info_money_base(base_name)

            BigWorld.callback(0.7, update_from_server)
        self.component.visible = True
        self.doReposition()
        self.wait()
        return

    def hide(self):
        self.component.visible = False

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        self.component.position = (0, 0, 0.49)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEvent(self, component, event):
        if event.dz:
            if event.dz > 0:
                self.component.ctext.script.scrolledUP()
            elif event.dz < 0:
                self.component.ctext.script.scrolledDOWN()
            return True
        return False

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def clearData(self):
        pass

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self._clbID = BigWorld.callback(5, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False

    def _check_base_money(self, credits, gold):
        if credits < 0 or gold < 0:
            return False
        if credits + gold <= 0:
            return False
        if credits > self.base_money or gold > self.base_gold:
            gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.base_money_error'))
            return False
        return True

    def _check_player_money(self, credits, gold):
        if credits < 0 or gold < 0:
            return False
        if credits + gold <= 0:
            return False
        p_credits, p_gold = ItemsUtils.GetPlayerMoney(BigWorld.player())
        if credits > p_credits or gold > p_gold:
            gui_jokes.askUserOk(u'', lc('B2CEntitiesInfo.player_money_error'))
            return False
        return True

    @checkRight(Clan.FLAG_CAN_BASE_ADD_MONEY)
    def on_add_money(self):

        @dealyed
        def callback(self, text):
            if not text.isdigit():
                return
            if self._check_player_money(int(text), 0):
                BigWorld.player().cell.add_money_to_base(self.base_name, int(text))

        gui_jokes.inputBox(lc('BaseToCaptureNames.%s' % self.base_name), lc('B2CEntitiesInfo.label_add_money'), lambda e: callback(self, e), active=True)

    @checkRight(Clan.FLAG_CAN_BASE_WITHDRAW_MONEY)
    def on_withdraw_money(self):

        @dealyed
        def callback(self, text):
            if not text.isdigit():
                return
            if self._check_base_money(int(text), 0):
                BigWorld.player().cell.withdraw_money_from_base(self.base_name, int(text), 0)

        gui_jokes.inputBox(lc('BaseToCaptureNames.%s' % self.base_name), lc('B2CEntitiesInfo.label_withdraw_money'), lambda e: callback(self, e), active=True)

    @checkRight(Clan.FLAG_CAN_BASE_WITHDRAW_MONEY)
    def on_withdraw_gold(self):

        @dealyed
        def callback(self, text):
            if not text.isdigit():
                return
            if self._check_base_money(0, int(text)):
                BigWorld.player().cell.withdraw_money_from_base(self.base_name, 0, int(text))

        gui_jokes.inputBox(lc('BaseToCaptureNames.%s' % self.base_name), lc('B2CEntitiesInfo.label_withdraw_gold'), lambda e: callback(self, e), active=True)

    def onBtnShowEntInfo(self):
        BWPersonality.GUICore.showBaseEntitiesInfo(True)
        self.hide()

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('helpBox', 'onClick')
    def onHelpBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('GUI.B2CMoneyInfo.hintBox', lc('B2CEntitiesInfo.title_money_bank'), colorCodes.tf3_regular_text_color + lc('B2CEntitiesInfo.money_help'))