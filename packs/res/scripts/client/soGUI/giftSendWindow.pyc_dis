        cmp.textureName = ''
        self.component.mouseButtonFocus = 1
        self.component.dragFocus = 1

    def onSelectedTo(self, attachment):
        self.remoteTraderName = None
        if self.elements and attachment in self.elements:
            self.remoteTraderName = self.elements[attachment][1]
        self.update()
        BWPersonality.GUICore.itemCacheGUI.update()
        return

    def setListWarehouseNames(self):
        ddlTo = self.component.ToWarehouse.script
        ddlTo.clear()
        current_trader_name = self._selected_npc
        if not current_trader_name:
            return
        Out = []
        index = 0
        for Bank in BigWorld.player().StoredItems:
            remore_trader_name = Bank['TraderName']
            current_trader_param = GiftBankUtils.get_send_param(current_trader_name, remore_trader_name)
            if remore_trader_name == 'Return_of_lost':
                continue
            if not current_trader_param.get('can_send', False):
                continue
            bankNameLocalise = _NPCs.getName(remore_trader_name)
            if not bankNameLocalise:
                continue
            element = [index, bankNameLocalise, remore_trader_name]
            Out.append(element)
            index += 1

        self.elements = dict(map(lambda x: (x[0], x[1:]), Out))
        ddlTo.addElements(Out)
        ddlTo.setSelectionByValue(1)

