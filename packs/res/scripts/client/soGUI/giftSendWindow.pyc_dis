    def _tagert_box_change(self, byUser):
        self.update()

    def _tagert_box_check(self, newStr, wholeText, offset):
        full_text = wholeText[0:offset] + newStr + wholeText[offset:]
        if not newStr.strip():
            return False
        if len(full_text) > 40:
            return False
        return True

    def errorNotiferMaxItems(self):
        self.component.iFrame.colour = (255, 200, 200, 255)

        def foo():
            self.component.iFrame.colour = (255, 255, 255, 255)

        BigWorld.callback(0.1, foo)

    def removeGiftSlot(self, item):
        if not item:
            return
        if item in self.itemsGifts:
            self.itemsGifts.remove(item)
        BWPersonality.GUICore.itemCacheGUI.update()
        self.update()

    def addGiftItem(self, item):
        if item and item not in self.itemsGifts:
            if len(self.itemsGifts) < GiftBankUtils.MAX_ITEM_IN_GIFT:
                self.itemsGifts.append(item)
            else:
                self.errorNotiferMaxItems()
        self.update()
        BWPersonality.GUICore.itemCacheGUI.update()

    def updateBank(self, *e):
        self._setItems(self.itemsGifts)
        if BWPersonality.GUICore.itemCacheGUI:
            BWPersonality.GUICore.itemCacheGUI.update()

    def slotHandler(self, event, data):
        if event == module_soItemView.EVENT_DROP:
            if data[1].factoryString == 'soGUI.soItemCacheSlot':
                item_param = ItemsCatalog.GetItemParam(data[1].itemData['complexItemType'])
                if item_param.get('isnotGiftable'):
                    BigWorld.player().putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnotGiftable_msg'))
                    return True
                if ItemsUtils.IsItemMoveable(data[1].itemData):
                    BigWorld.player().putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnotGiftable_msg'))
                    return True
                BWPersonality.GUICore.itemCacheGUI.addBlockedItem(data[1].itemData, data[1])
                self.addGiftItem(data[1].itemData)
                return True
            else:
                return False
        if event == module_soItemView.EVENT_DRAGENTER:
            if data[1].factoryString == 'soGUI.soItemCacheSlot':
                return True
            else:
                return False
        return False

    def itemViewHandler(self, event, data):
        if event == module_soItemView.EVENT_MOUSEMOVE:
            return False
        return True

    def _setItems(self, items):
        self.component.itemView.script.setItems(items)

    def update(self):
        self.updateBank()
        btn = self.component.button_send.script
        if not self.money_edit.getValue():
            itemsnt = self.itemsGifts
            itemsnt and self._tagert_box.rawText.strip() and self.remoteTraderName and btn.setDisabledState(False)
        else:
            btn.setDisabledState(True)
        self.recalculateCost()

    def _setFilterMask(self, filterMask):
        pass

    def filterHandler(self, filter):
        pass

    def _updateFilters(self):
        pass

    def changeSelectedBank(self, selectedNpc):
        self.clearItems()
        self._selected_npc = selectedNpc
        self.setListWarehouseNames()

    def show(self):
        self.clearDarkScreen()
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild('GiftSendWindow')
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'GiftSendWindow')
        if BWPersonality.GUICore.itemCacheGUI is not None:
            self._selected_npc = BWPersonality.GUICore.itemCacheGUI.component.script._selected_npc
        self.itemsGifts = []
        self._msg_box.setValue('')
        self.money_edit.setValue('')
        self.update()
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        self.setListWarehouseNames()
        self.doReposition()
        GUI.reSort()
        return

    def hide(self):
        self.component.visible = False
        self.itemsGifts = []
        self.remoteTraderName = None
        self.update()
        self._tagert_box.activate(False)
        self._msg_box.activate(False)
        self.money_edit.activate(False)
        if hasattr(self.component, 'ToWarehouse'):
            self.component.ToWarehouse.script.showList(False)
        BWPersonality.GUICore.setBestCursor()
        if self.wind:
            self.wind.hide()
        return

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        cmp = self.component
        cmp.position = (sW - 240 - cmp.width - 40, 235, 0.3)

    def handleMouseButtonEvent(self, comp, event):
        if hasattr(self.component, 'ToWarehouse'):
            self.component.ToWarehouse.script.showList(False)
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def recalculateCost(self):
        allCost = 0

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_my_name', 'onClick')
    def setMyName(self):
        self._tagert_box.deselect()
        self._tagert_box.activate(False)
        self._msg_box.activate(False)
        self._tagert_box.setValue(BigWorld.player().name)

    @PyGUIEvent('button_send', 'onClick')
    def onSend(self):
        self._tagert_box.activate(False)
        self._msg_box.activate(False)
        if BWPersonality.GUICore.itemCacheGUI._selected_npc:
            current_trader_name = BWPersonality.GUICore.itemCacheGUI._selected_npc
        else:
            current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', None)
        remoteTraderName = self.remoteTraderName
        if not current_trader_name or not remoteTraderName:
            self.itemsGifts = []
            self.update()
            return
        else:
            avatar_tagert = self._tagert_box.rawText.strip()
            comment = self._msg_box.rawText.strip()

            def send_gift(event):
                if event == gui_jokes.askUserYesNo.YES:
                    if not self.wind:
                        self.wind = giftTariff.GiftTariff(GUI.Window())
                        self.wind.onBound()
                    data = {'from_bank': current_trader_name,
                     'to_bank': remoteTraderName,
                     'to_avatar': avatar_tagert,
                     'gold': 0,
                     'money': self.money_edit.getValue(),
                     'comment': comment,
                     'items': self.itemsGifts}
                    self.wind.show(data, self)

            if avatar_tagert.lower() == BigWorld.player().name.lower() and current_trader_name == remoteTraderName:
                gui_jokes.askUserYesNo(lc('GUI.giftwindow.TITLE_DEL'), lc('GUI.giftwindow.WARNING_NAME'), send_gift)
                return
            if not avatar_tagert:
                print 'not tagert', avatar_tagert
                return
            send_gift(gui_jokes.askUserYesNo.YES)
            return

    def clearData(self):
        self.itemsGifts = []
        self._msg_box.setValue('')
        self.money_edit.setValue('')
        self.update()

    def clearItems(self):
        self.itemsGifts = []
        self.update()

    def wait(self):
        self.clearDarkScreen()
        self.component.darkScreen.visible = True
        self.component.ToWarehouse.visible = False
        self._tagert_box.activate(False)
        self._msg_box.activate(False)
        self._clbID = BigWorld.callback(15, self.clearDarkScreen)

    def clearDarkScreen(self):
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
            self._clbID = 0
        self.component.darkScreen.visible = False
        self.component.ToWarehouse.visible = True