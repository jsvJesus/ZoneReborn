def comment_check(newStr, wholeText, offset):
    full_text = wholeText[0:offset] + newStr + wholeText[offset:]
    if len(full_text) > 42:
        return False
    return True


from soItemCache import soItemCacheSlot

class soItemGiftSlot(soItemCacheSlot):
    factoryString = 'soGUI.soItemGiftSlot'

    def take(self):
        if self.itemData:
            BWPersonality.GUICore.giftSendGUI.removeGiftSlot(self.itemData)

    def onRClick(self):
        if not self.itemData:
            return
        actions = {}
        actions['item_info'] = lc('Inventory.INFO')
        BWPersonality.GUICore.addListener('contextMenuEvent', self.ContextMenuEvent)
        self._interface_id = random.random() + 51
        BWPersonality.GUICore.showContextMenu(self._interface_id, actions)

    def ContextMenuEvent(self, interface_id, action_id, caption, event, data = None):
        if interface_id != self._interface_id:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if action_id == 'item_info' and self.itemData:
                BWPersonality.GUICore.showItemInfo(self.itemData)
        if event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.ContextMenuEvent)

    def checkTransferItem(self):
        pass


