    MIN_DISTANCE = 0.0

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.markers = []
        self.setupRoot()

    def setupRoot(self):
        cmp = self.component
        sW, sH = BigWorld.screenSize()
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = sW
        cmp.height = sH
        cmp.position = (0.0, 0.0, 1.1)
        cmp.visible = True
        BWPersonality.GUICore.worldLayer.delChild('Markers2')
        BWPersonality.GUICore.worldLayer.addChild(cmp, 'Markers2')

    def addm(self, m):
        self.markers.append(m)
        self.component.addChild(m.component)


