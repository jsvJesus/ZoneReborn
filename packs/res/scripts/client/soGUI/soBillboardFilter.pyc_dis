    def reset_button_click(self):
        self.component.background_scroll.checkALL.script.setInactive()
        for checkbox in self.cat_id_to_checkbox.values():
            checkbox.setInactive()

        self.component.keepers_filter.script.reset()
        self.component.insertions_filter.script.setSelectionByValue(0, True)
        self.component.sort_ddl.script.setSelectionByValue(0, True)
        for edit_text in self.all_edit_texts:
            edit_text.script.clear()

        self.edit_changed(None)
        return

    def scrollMoved(self, new_value):
        self.set_scroll_value(new_value)

    def scrollUp(self):
        value = self.scroll_bar.getValue()
        value = max(0, value - 1)
        self.set_scroll_value(value)

    def scrollDown(self):
        value = self.scroll_bar.getValue()
        value = min(value + 1, self.scroll_bar.steps)
        self.set_scroll_value(value)

    def handleMouseEvent(self, comp, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return True

    def get_cat_ids(self):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xb0 (INT64) \xd0\xb1\xd0\xb8\xd1\x82\xd1\x8b \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd1\x85 - \xd1\x8d\xd1\x82\xd0\xbe \xd0\xb2\xd1\x8b\xd0\xb4\xd0\xb5\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd1\x84\xd0\xbb\xd0\xb0\xd0\xb3\xd0\xb8 """
        cat_ids = [ cat_id for cat_id, checkbox in self.cat_id_to_checkbox.items() if checkbox.isChecked() ]
        return math_bw.int_array_to_int64_bool_array(cat_ids)

    def get_sort_index(self):
        return self.component.sort_ddl.script.getSelection()[1]

    def get_text_filter(self):
        return self.component.filter_item_name.script.getRaw().strip().lower()

    def get_repairs_filter(self):
        text_from = self.component.filter_repairs.script.getRaw()
        text_to = self.component.filter_repairs2.script.getRaw()
        value_from = int(text_from) if text_from else 0
        value_to = int(text_to) if text_to else 9999
        return (value_from, value_to)

    def get_condition_filter(self):
        text_from = self.component.filter_item_condition.script.getRaw()
        text_to = self.component.filter_item_condition2.script.getRaw()
        value_from = int(text_from) if text_from else 0
        value_to = int(text_to) if text_to else 100
        return (value_from, value_to)

    def get_items_filter(self):
        text_from = self.component.items_filter.script.getRaw()
        text_to = self.component.items_filter2.script.getRaw()
        value_from = int(text_from) if text_from else 0
        value_to = int(text_to) if text_to else 100
        return (value_from, value_to)

    def get_bank_filter(self):
        """ \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xbe\xd0\xb2\xd1\x89\xd0\xb8\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xb2 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb5 \xd0\xb1\xd0\xb8\xd1\x82\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb0\xd1\x81\xd1\x81\xd0\xb8\xd0\xb2\xd0\xb0 """
        selected_data = self.component.keepers_filter.script.get_selection()
        return math_bw.int_array_to_int64_bool_array(selected_data)

    def get_insertions_filter(self):
        return self.component.insertions_filter.script.getSelection()[1]

    def checkbox_clicked(self, cat_id, checked):
        if cat_id == -1:
            for checkbox in self.cat_id_to_checkbox.values():
                if checked:
                    checkbox.setActive()
                else:
                    checkbox.setInactive()

        else:
            children_cats = ItemCategories.get_children(cat_id, True)
            if ItemCategories.UNDEFINED in children_cats:
                children_cats.remove(ItemCategories.UNDEFINED)
            children_checks = map(lambda x: self.cat_id_to_checkbox[x], children_cats)
            for checkbox in children_checks:
                if checked:
                    checkbox.setActive()
                else:
                    checkbox.setInactive()

        if self.update_callback:
            self.update_callback()

    def radiobutton_clicked(self, sort_id):
        if self.sortindex == sort_id:
            return
        self.sortindex = sort_id
        if self.update_callback:
            self.update_callback()

    def edit_changed(self, value):
        if self.update_callback:
            self.update_callback()

    def set_scroll_value(self, value):
        if self.scroll_bar.getValue() == value:
            return
        self.scroll_bar.setValue(value)
        self.component.background_scroll.scroll.y = value * self.scroll_step

    def handleMouseEnterEvent(self, comp):
        if self.move_corutine:
            self.move_corutine.stop()
        self.move_corutine = self.move_panel_out(self)
        self.move_corutine.run()
        return True

    def handleMouseLeaveEvent(self, comp):
        if self.component.fix_button.script.buttonActive:
            return True

        def is_mouse_outside():
            local_pos = self.component.screenToLocal(GUI.mcursor().position)
            return local_pos[0] < 0 or local_pos[1] < 0

        if is_mouse_outside():
            if self.move_corutine:
                self.move_corutine.stop()
            self.move_corutine = self.move_panel_in(self)
            self.move_corutine.run()
        return True

    def position_from_ratio(self, ratio):
        interpolation = ratio * ratio * (3 - 2 * ratio)
        disp = self.move_disp * interpolation
        return (self.initial_position[0] - disp, self.initial_position[1], self.initial_position[2])

    def ratio_from_position(self, position):
        return (self.initial_position[0] - position[0]) / self.move_disp

    @BWCoroutine
    def move_panel_in(self):
        """ \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbb\xd0\xb8 """
        for dropdown in self.all_dropdowns:
            dropdown.script.showList(False)

        self.set_arrows_direction(ARROW_DIRECTION_LEFT)
        cur_time = BigWorld.time()
        ratio = self.ratio_from_position(self.component.position)
        while ratio > 0:
            yield BWWaitForPeriod(0)
            delta_time = BigWorld.time() - cur_time
            cur_time = BigWorld.time()
            ratio = max(0, ratio - delta_time / self.move_time)
            self.component.position = self.position_from_ratio(ratio)

        self.move_corutine = None
        return

    @BWCoroutine
    def move_panel_out(self):
        """ \xd0\xb2\xd1\x8b\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbf\xd0\xb0\xd0\xbd\xd0\xb5\xd0\xbb\xd0\xb8 """
        cur_time = BigWorld.time()
        self.set_arrows_direction(ARROW_DIRECTION_RIGHT)
        ratio = self.ratio_from_position(self.component.position)
        while ratio < 1:
            yield BWWaitForPeriod(0)
            delta_time = BigWorld.time() - cur_time
            cur_time = BigWorld.time()
            ratio = min(1, ratio + delta_time / self.move_time)
            self.component.position = self.position_from_ratio(ratio)

        self.move_corutine = None
        return

    def set_arrows_direction(self, direction):
        if direction == ARROW_DIRECTION_LEFT:
            for arrow in self.all_arrows:
                arrow.width = -abs(arrow.width)

        elif direction == ARROW_DIRECTION_RIGHT:
            for arrow in self.all_arrows:
                arrow.width = abs(arrow.width)

    def on_board_hide(self):
        for edit_text in self.all_edit_texts:
            edit_text.script.activate(False)


class BillboardCheckBox(soCheckBox):

    def __init__(self, text, klass, callback = None):
        soCheckBox.__init__(self, GUI.Window(), soGUI.CheckBoxPropsStructure(labelText=text, font='ruRU_default.font', labelColour=LABEL_COLOR))
        self.component.horizontalAnchor = 'LEFT'
        self.component.verticalAnchor = 'TOP'
        self.component.horizontalPositionMode = 'PIXEL'
        self.component.verticalPositionMode = 'PIXEL'
        self.component.widthMode = 'PIXEL'
        self.component.heightMode = 'PIXEL'
        self.box.onClick = self.click
        self.klass = klass
        self.callback = callback

    def click(self):
        if self.callback:
            self.callback(self.klass, self.isChecked())


class BillboardRadioButton(soRadioButton2):

    def __init__(self, caption, sort_id, callback = None):
        soRadioButton2.__init__(self, GUI.Window(), btnW=18, btnH=18, radioGroup='radiogr_sortBy', labelText=caption, bvisual_styles='soGUI/visual_styles/radioButton.xml')
        self.sort_id = sort_id
        self.callback = callback

    def onStateChange(self):
        soRadioButton2.onStateChange(self)
        if self.isChecked() and self.callback:
            self.callback(self.sort_id)


class BilboardEditText(soEditBox):

    def __init__(self, width, callback = None):
        soEditBox.__init__(self, GUI.Window(), width=width, height=30, font='ruRU_Cyrvetica_Extra_14i.font', hOffset=3, vOffset=2)
        self.callback = callback
        self.setValidator(self.input_validator)

    def onValueChange(self, by_user):
        if self.callback:
            self.callback(self.getRaw())

    def input_validator(self, newStr, wholeText, offset):
        return offset <= 19


class BilboardEditTextNumber(soGUI.soNumberBox.soNumberBox):

    def __init__(self, callback = None):
        soGUI.soNumberBox.soNumberBox.__init__(self, GUI.Window(), width=50, height=22, font='ruRU_Cyrvetica_Extra_10i.font', hOffset=5, vOffset=5)
        self.callback = callback
        self.setValidator(self.input_validator)

    def input_validator(self, newStr, wholeText, offset):
        return offset <= 2

    def onValueChange(self, by_user):
        if self.callback:
            self.callback(self.getRaw())


class BilboardDropdown(soDropDownList2):

    def __init__(self, field_width, callback = None):
        soDropDownList2.__init__(self, GUI.Window(), width=field_width, height=29)
        self.callback = callback

    def onSelectedElement(self, elemID):
        if self.callback:
            self.callback(elemID)


class BillboardDropdownWindow(DropDownWindow):

    def __init__(self, width, callback = None):
        DropDownWindow.__init__(self, width=width, height=29)
        self.callback = callback

    def check_box_clicked(self, checkbox):
        DropDownWindow.check_box_clicked(self, checkbox)
        if self.callback:
            self.callback(checkbox)

    def reset(self):
        DropDownWindow.reset(self)
        if self.callback:
            self.callback(None)
        return