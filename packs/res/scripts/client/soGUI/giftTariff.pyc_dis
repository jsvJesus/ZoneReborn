    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_cancel', 'onClick')
    def cancel(self):
        self.hide()

    @PyGUIEvent('button_send', 'onClick')
    def send(self):
        if not self.sendData:
            return
        player = BigWorld.player()
        if player.CreditNumber < self._last_all_money:
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_ERROR'), lc('Codes.GiftResponses.ERROR_SEND_CREDIT'))
            return
        if player.GoldCreditNumber < self._last_all_gold:
            gui_jokes.askUserOk(lc('GUI.giftwindow.TITLE_SEND_ERROR'), lc('Codes.GiftResponses.ERROR_SEND_GOLD'))
            return
        if self.sendData.get('return_gift'):
            giftID = self.sendData['return_gift']['giftID']
            BigWorld.player().base.returnGiftUser(giftID, self._selected_index_tariff)
        else:
            to_avatar = self.sendData['to_avatar']
            from_bank = self.sendData['from_bank']
            to_bank = self.sendData['to_bank']
            comment = self.sendData['comment']
            lstIitemID = [ item['complexItemID'] for item in self.sendData['items'] ]
            money = self.sendData['money']
            comment = comment.encode('utf8')
            BigWorld.player().base.sendGift(to_avatar, from_bank, to_bank, lstIitemID, money, comment, self._selected_index_tariff)
        self.hide()
        self._parent.wait()
        if self.callback_on_send:
            self.callback_on_send()