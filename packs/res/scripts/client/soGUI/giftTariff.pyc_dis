    def onRadioBtn(self, index):
        self._selected_index_tariff = index
        script = self._radioGroup[index]
        for rBtn in self._radioGroup.values():
            if rBtn is not script:
                rBtn.setInactive()
            else:
                rBtn.setActive()

        self.recalculate()

    def _updateCaprion(self, data):
        if data.get('return_gift'):
            name = data['return_gift']['toAvatar']
            caption = lc('GUI.itemCache.CAPTION_TRANSFER_PRICES_RETURN')
            caption = caption.format(name=name)
            self.component.iLabel.text = caption
        else:
            self.component.iLabel.text = lc('GUI.itemCache.CAPTION_TRANSFER_PRICES')

    def show(self, data, parent, callback_on_send = None):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.callback_on_send = callback_on_send
        try:
            self._updateCaprion(data)
        except:
            traceback.print_exc()

        self.sendData = data
        self._parent = parent
        self.recalculate()
        return

    def hide(self):
        self.component.visible = False

    def recalculate(self):
        if not self.sendData:
            return
        data = self.sendData
        tariff = self._selected_index_tariff
        bank_param = GiftBankUtils.get_send_param(data['from_bank'], data['to_bank'])
        multiplier_money = bank_param.get('money', 1)
        multiplier_time = bank_param.get('time', 1)
        base_cost = int(math.ceil(GiftBankUtils.COST_TRANSFER[TRANSFER_TYPE_BASE][0] * multiplier_money))
        excpress_cost = int(math.ceil(GiftBankUtils.COST_TRANSFER[TRANSFER_TYPE_EXPRESS][0] * multiplier_money))
        self._elment_cost[TRANSFER_TYPE_BASE].setValue(base_cost)
        self._elment_cost[TRANSFER_TYPE_EXPRESS].setValue(excpress_cost)
        self._cmp_times[TRANSFER_TYPE_BASE].text = ItemsUtils.timeToString(GiftBankUtils.TIME_TRANSFER[TRANSFER_TYPE_BASE] * multiplier_time)
        self._cmp_times[TRANSFER_TYPE_EXPRESS].text = ItemsUtils.timeToString(GiftBankUtils.TIME_TRANSFER[TRANSFER_TYPE_EXPRESS] * multiplier_time)
        self._cmp_times[TRANSFER_TYPE_GOLD].text = ItemsUtils.timeToString(GiftBankUtils.TIME_TRANSFER[TRANSFER_TYPE_GOLD] * multiplier_time)
        money_tax_r, money_tax_g = GiftBankUtils.getMoneyTax(tariff, data['money'])
        gold_tax_r, gold_tax_g = GiftBankUtils.getGoldTax(tariff, data['gold'])
        items_tax_money = 0
        items_tax_gold = 0
        for complexItem in data['items']:
            itemparam = ItemsCatalog.GetItemParam(complexItem['complexItemType'])
            item_cost = max(1, itemparam.get('Cost', 1))
            stack_number = ItemsUtils.GetItemNumber(complexItem)
            item_class = ItemsCatalog.GetItemClass(complexItem['complexItemType'])
            m, g = GiftBankUtils.item_tax(tariff, multiplier_money, complexItem)
            items_tax_money += m
            items_tax_gold += g

        self.all_cost_item_tax.setValue(items_tax_money + money_tax_r + gold_tax_r)
        self.all_cost_gold_item_tax.setValue(items_tax_gold + money_tax_g + gold_tax_g)
        base_money, base_gold = GiftBankUtils.COST_TRANSFER[tariff]
        base_money = base_money * multiplier_money
        self._last_all_money = int(base_money + money_tax_r + gold_tax_r + items_tax_money)
        self._last_all_gold = int(base_gold + money_tax_g + gold_tax_g + items_tax_gold)
        self.money_itog.setValue(self._last_all_money)
        self.gold_itog.setValue(self._last_all_gold)
        money_tax_r, money_tax_g = GiftBankUtils.getMoneyTax(tariff, data['money'], isPremium=True)
        gold_tax_r, gold_tax_g = GiftBankUtils.getGoldTax(tariff, data['gold'], isPremium=True)
        items_tax_money = 0
        items_tax_gold = 0
        for complexItem in data['items']:
            itemparam = ItemsCatalog.GetItemParam(complexItem['complexItemType'])
            item_cost = max(1, itemparam.get('Cost', 1))
            stack_number = ItemsUtils.GetItemNumber(complexItem)
            m, g = GiftBankUtils.item_tax(tariff, multiplier_money, complexItem, isPremium=True)
            items_tax_money += m
            items_tax_gold += g

        last_all_money_prem = int(base_money + money_tax_r + gold_tax_r + items_tax_money)
        last_all_gold_prem = int(base_gold + money_tax_g + gold_tax_g + items_tax_gold)
        self.money_itog_prem.setValue(last_all_money_prem)
        self.gold_itog_prem.setValue(last_all_gold_prem)
        if BigWorld.player().isPremium():
            self._last_all_money = last_all_money_prem
            self._last_all_gold = last_all_gold_prem
            self.component.darkPremium.position = (self.component.width - 2, self.component.height - 80, 0.01)
        else:
            self.component.darkPremium.position = (self.component.width - 2, self.component.height - 60, 0.01)

