def get_rectangle_for_base_gui():
    """
    \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd1\x8f\xd0\xbc\xd0\xbe\xd1\x83\xd0\xb3\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xb8\xd0\xba \xd0\xb2 \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc \xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb5\xd0\xbd \xd0\xb1\xd1\x8b\xd1\x82\xd1\x8c GUI 
    \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0 \xd0\xbf\xd0\xbe \xd1\x83\xd0\xbc\xd0\xbe\xd0\xbb\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8e.
    """
    bottom_cmp = BWPersonality.GUICore.munitionsGUI.component
    top_cmp = BWPersonality.GUICore.systemMenu.component
    top_pos_data = get_coner_in_pixels(top_cmp)
    X, Y = (0, 1)
    x = top_pos_data['corner'][X]
    y = top_pos_data['corner'][Y] + top_cmp.height
    width = top_cmp.width - 10
    bottom_pos_data = get_coner_in_pixels(bottom_cmp)
    height = min(bottom_pos_data['corner'][Y] - y, top_cmp.width * 2)
    return {'corner': [x, y],
     'width': width,
     'height': height}


def set_size_and_position_for_gui_base(component, init_positon = True):
    """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x80\xd0\xb0\xd0\xb7\xd0\xbc\xd0\xb5\xd1\x80\xd1\x8b \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb8\xd1\x86\xd0\xb8\xd1\x8e \xd0\xb4\xd0\xbb\xd1\x8f GUI \xd0\xb1\xd0\xb0\xd0\xb7\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb7\xd0\xb0\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0."""
    pos_data = get_rectangle_for_base_gui()
    x, y = pos_data['corner']
    if not init_positon:
        x = min(x, component.position[0])
        _sW, sH = BigWorld.screenSize()
        if component.position[1] < sH:
            y = component.position[1]
    component.position = (x, y, 0.5)
    component.width = pos_data['width']
    component.height = pos_data['height']


