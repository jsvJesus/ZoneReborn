class ClickScript(PyGUIBase):

    def __init__(self, component, parent_script):
        PyGUIBase.__init__(self, component)
        self.component = component
        self.parent_script = parent_script
        component.mouseButtonFocus = True

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        down = event.isKeyDown()
        key = event.key
        if key == KEY_RIGHTMOUSE:
            if down:
                self.pressed = True
            else:
                if self.pressed:
                    self.pressed = False
                    self.parent_script.onClick()
                return True
        return False


