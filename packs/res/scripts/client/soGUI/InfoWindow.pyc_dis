    def devClick(self):
        from gui_const import MESSAGEBOX

        def spoilCondition(event, data):
            try:
                condition = int(data['add_controls']['condition'])
            except:
                return

            entity.cell.setItemCondition(self._item['complexItemID'], condition)

        def setRepairs(event, data):
            try:
                repairs = int(data['add_controls']['repairs'])
            except:
                return

            entity.cell.setItemRepairsNumber(self._item['complexItemID'], repairs)

        def changeAmount(event, data):
            pass

        def setMunitionAmount(event, data):
            try:
                value = int(data['add_controls']['munition'])
            except:
                return

            entity.cell.setItemMunitionAmount(self._item['complexItemID'], value)

        def setLifeTime(event, data):
            try:
                value = int(data['add_controls']['charge'])
            except:
                return

            timeToLive = item_param['TimeToLive']
            delta = 0
            creation_time = int(value - BWPersonality.gpd.time_diff + time.time() - timeToLive - delta)
            entity.cell.setArtefactTime(self._item['complexItemID'], creation_time)

        def setBatteryLevel(event, data):
            try:
                value = int(data['add_controls']['charge'])
            except:
                return

            entity.cell.setBatteryLevel(self._item['complexItemID'], value)

        def callbackHandler(event, data):
            if event != MESSAGEBOX.EVENT_BTNPRESS:
                return
            if data['btn'] == MESSAGEBOX.BTN_OK:
                for localCallback in localCallbacks:
                    localCallback(event, data)

            item = self._item
            self.destroy()
            BWPersonality.GUICore.infoWindowManger.showInfo(item)

        controls = []
        entity = BigWorld.player()
        localCallbacks = []

        def createLabel(id, caption):
            return {'type': MESSAGEBOX.ADDCONTROL_TEXTFIELD,
             'ID': id,
             'text': caption,
             'hAnchor': MESSAGEBOX.ANCHOR_CENTER}

        def createEdit(id, text = ''):
            return {'type': MESSAGEBOX.ADDCONTROL_EDIT,
             'ID': id,
             'hAnchor': MESSAGEBOX.ANCHOR_CENTER,
             'active': False,
             'default': text}

        item_type = self._item['complexItemType']
        item_param = ItemsCatalog.GetItemParam(item_type)
        item_inconstant_param = ItemsUtils.GetComplexItemInconstanParams(self._item, entity)
        item_class = ItemsCatalog.GetItemClass(item_type)
        try:
            condition = str(item_inconstant_param[ItemsCatalog.INC_CONDITION_VALUE])
        except:
            pass

        try:
            repairs = str(item_inconstant_param[ItemsCatalog.INC_REPAIRS_NUMBER])
        except:
            pass

        condition_caption = lc('Inventory.client.STATE').format('')
        repairs_caption = lc('Inventory.client.REPAIRS_NUMBER').format('')
        if item_class == ItemsCatalog.WEAPON:
            munition = str(item_inconstant_param[ItemsCatalog.INC_MUNITION_NUMBER])
            munition_caption = lc('Inventory.client.NUM_ARMED').format('', '')
            controls.append(createLabel('condition', condition_caption))
            controls.append(createEdit('condition', condition))
            controls.append(createLabel('repairs', repairs_caption))
            controls.append(createEdit('repairs', repairs))
            controls.append(createLabel('munition', munition_caption))
            controls.append(createEdit('munition', munition))
            localCallbacks.append(spoilCondition)
            localCallbacks.append(setRepairs)
            localCallbacks.append(setMunitionAmount)
        elif item_class == ItemsCatalog.CLOTH:
            controls.append(createLabel('condition', condition_caption))
            controls.append(createEdit('condition', condition))
            controls.append(createLabel('repairs', repairs_caption))
            controls.append(createEdit('repairs', repairs))
            localCallbacks.append(spoilCondition)
            localCallbacks.append(setRepairs)
        elif item_class in [ItemsCatalog.AMMO, ItemsCatalog.BUFF]:
            pass
        elif item_class == ItemsCatalog.ARTIFACT:
            charge_caption = lc('Inventory.client.ARTIFACT_CHARGE_REMAINING')
            controls.append(createLabel('charge', charge_caption))
            depletion_time = ItemsUtils.GetArtefactDepleetionTime(self._item, item_param, BWPersonality.gpd.time_diff)
            if depletion_time:
                depletion_time = str(int(depletion_time))
            else:
                depletion_time = u'broken'
            controls.append(createEdit('charge', depletion_time))
            localCallbacks.append(setLifeTime)
        elif item_class == ItemsCatalog.GADGET and item_param['SubType'] == ItemsCatalog.KNIFE:
            controls.append(createLabel('condition', condition_caption))
            controls.append(createEdit('condition', condition))
            localCallbacks.append(spoilCondition)
        if 'ManualFuel' in item_param:
            charge_caption = lc('Inventory.client.BATTERY_LEVEL')
            charge = str(float(ItemsUtils.GetBatteryLevel(self._item)) / ItemsUtils.GetMaxBatteryLevel(self._item) * 100.0)
            controls.append(createLabel('charge', charge_caption))
            controls.append(createEdit('charge', charge))
            controls.append(createLabel('condition', condition_caption))
            controls.append(createEdit('condition', condition))
            localCallbacks.append(setBatteryLevel)
            localCallbacks.append(spoilCondition)
        BWPersonality.GUICore.showMsgBox(id or 'inputBox.default', isModal=False, x=0.0, y=0.0, width=300, caption='cheatbox', forcePos=False, parent_gui_id=None, bind_to_parent=False, btn_set=[{'type': MESSAGEBOX.BTN_OK,
          'width': 80}, {'type': MESSAGEBOX.BTN_CANCEL,
          'width': 80}], timeout=-1, closeBox=True, defaultAction=MESSAGEBOX.BTN_YES, addControls=controls, callback=callbackHandler)
        return

