class soScrollArea(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.onDropItem = lambda item: False
        self.component.dragFocus = True
        self.callbackID = None
        self.component.focus = 1
        self.component.crossFocus = 0
        self.component.moveFocus = 1
        self.component.dropFocus = True
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 20)
        cmp.materialFX = 'BLEND'
        cmp.height = self.component.height
        cmp.width = self.component.width
        cmp.position = (0, 0, 0.9)
        cmp.visible = False
        self.component.addChild(cmp, 'background')
        return

    def setSize(self, w, h):
        self.component.height = h
        self.component.width = w
        self.component.background.height = h
        self.component.background.width = w

    def _has_item(self, dropped):
        if isinstance(dropped.script, soInventorySlot2) and dropped.script.itemData:
            return True

    def handleDragEnterEvent(self, comp, dragged):
        if self._has_item(dragged):
            self.startScrollLoop()
            return True

    def handleDragLeaveEvent(self, comp, dragged):
        self.stopScrollLoop()
        return True

    def startScrollLoop(self):
        self.callbackID = BigWorld.callback(0.5, self.scrolling)
        self.component.background.visible = True

    def stopScrollLoop(self):
        if self.callbackID:
            BigWorld.cancelCallback(self.callbackID)
        self.component.background.visible = False

    def scrolling(self):
        self.onScrollEvent()
        self.callbackID = BigWorld.callback(0.5, self.scrolling)

    def onScrollEvent(self):
        pass

    def handleDropEvent(self, cmp, dropped):
        self.stopScrollLoop()
        if self._has_item(dropped):
            self.onDropItem(dropped.script.draggedData)
            return True
        return False

    def handleMouseLeaveEvent(self, comp):
        self.stopScrollLoop()
        return False


