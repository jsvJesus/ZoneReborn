temporary_blocked_items = {}

def tempBlocked(item):
    if not item:
        return
    return item['complexItemID'] in temporary_blocked_items


class guiKeyEvent(object):

    def __init__(self, key, down, mods = None):
        self.key = key
        self.down = down
        self.modifiers = mods

    def isKeyDown(self):
        return self.down


