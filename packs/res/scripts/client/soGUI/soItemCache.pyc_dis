        cmp.width = 131
        cmp.height = 25
        cmp.position = (self.component.width - 10, self.component.height - 7, 0.1)
        cmp.script.setDisabledState(False)
        self.component.addChild(cmp, 'button_show_gift')
        btn.onBound()
        btn = soButton(GUI.Window())
        cmp = btn.component
        btn.initVSC('soGUI/visual_styles/defaultBtn.xml')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.label.font = 'ruRU_calibri_default.font'
        cmp.label.pixelSnap = False
        cmp.label.text = lc('GUI.itemCache.TAKE_ALL') % BWPersonality.settings.keyBindings.getInteractObjectkey()
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 130
        cmp.height = 24
        cmp.position = (self.component.width - 10, self.component.height - 7, 0.1)
        cmp.script.setDisabledState(False)
        self.component.addChild(cmp, 'button_take_all')
        btn.onBound()

    def onSelectedTo(self, attachment):
        selected_npc = self.elements[attachment][1]
        if selected_npc == self._selected_npc:
            return
        self._selected_npc = selected_npc
        if BWPersonality.GUICore.giftSendGUI:
            BWPersonality.GUICore.giftSendGUI.clearItems()
            BWPersonality.GUICore.giftSendGUI.changeSelectedBank(self._selected_npc)
            BWPersonality.GUICore.giftSendGUI.setListWarehouseNames()
        x, y = self._saved_scrolling.get(self._selected_npc, [0, 0])
        self.component.itemView.script.setScroll(x, y)
        current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', 'None')
        if BWPersonality.GUICore.inventoryGUI:
            lock_invent = self._selected_npc != current_trader_name
            BWPersonality.GUICore.inventoryGUI.lockWindow(lock_invent)
        self.update()

    def setListNPCNames(self):
        npc_name_list = self.component.npc_name_list.script
        npc_name_list.clear()
        if BWPersonality.GUICore.itemCacheDataSection is None:
            return
        else:
            current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', 'None')
            if not _NPCs.getName(current_trader_name):
                current_trader_name_lc = u'---'
                self.component.current_trader_name.text = lc('GUI.itemCache.current_vendor') + u' {0}'.format(current_trader_name_lc)
                data = []
                selected_id = 0
                index = -1
                currenr_found = False
                player = BigWorld.player()
                if not player or player.__class__.__name__ != 'PlayerAvatar':
                    return
                for index, bank in enumerate(player.StoredItems):
                    if not _NPCs.getName(bank['TraderName']):
                        npc_localise = bank['TraderName']
                        if 'Return_of_lost' == bank['TraderName']:
                            continue
                        data.append([index, npc_localise, bank['TraderName']])
                        selected_id = bank['TraderName'] == current_trader_name and index
                        currenr_found = True

                selected_id = currenr_found or index + 1
                data.append([selected_id, current_trader_name_lc, current_trader_name])
            self.elements = dict(map(lambda x: (x[0], x[1:]), data))
            npc_name_list.addElements(data)
            npc_name_list.setSelectionByValue(selected_id)
            return

    def slotHandler(self, event, data):
        from soGUI.soInventorySlot2 import soInventorySlot2
        if event == module_soItemView.EVENT_DRAGENTER:
            if data[1].factoryString == 'soGUI.soInventorySlot2':
                return True
            elif data[1].factoryString == 'soGUI.soTransferItemSlot':
                return True
            elif data[1].factoryString == 'soGUI.soItemGiftSlot':
                return True
            else:
                return False
        if event == module_soItemView.EVENT_DROP:
            if data[1].factoryString == 'soGUI.soTransferItemSlot':
                data[1].take()
                return True
            elif data[1].factoryString == 'soGUI.soItemGiftSlot':
                data[1].take()
                return True
            elif data[1].factoryString == 'soGUI.soInventorySlot2':
                if self.cache_mode not in [ItemsUtils.CACHE_MODE_CONTAIER, ItemsUtils.CACHE_MODE_CAPSULE, ItemsUtils.CACHE_MODE_CREATURE] and self._check_reading_bank():
                    BWPersonality.GUICore.inventoryGUI.addTempBlockItem(data[1].itemData, data)
                BWPersonality.GUICore.itemCacheEvent(ACTION_GIVE, data[1].itemData)
                return True
            else:
                return False
        if event == module_soItemView.SLOTEVENT_MOUSEENTER:
            if data.factoryString == 'soGUI.soItemCacheSlot':
                data.showToolTip()
                return True
        if event == module_soItemView.EVENT_DRAGSTART:
            if data.factoryString == 'soGUI.soItemCacheSlot':
                data.lockSlot(True)
                return True
        if event == module_soItemView.EVENT_DRAGSTOP:
            if data.factoryString == 'soGUI.soItemCacheSlot':
                if data.itemData and data.itemData['complexItemID'] not in self._blocked_items:
                    data.lockSlot(False)
                return True
        return False

    def itemViewHandler(self, event, data):
        from soGUI.soInventorySlot2 import soInventorySlot2
        if event == module_soItemView.EVENT_DRAGENTER:
            if data[1].factoryString == 'soGUI.soInventorySlot2':
                return True
            if data[1].factoryString == 'soGUI.soTransferItemSlot':
                return True
            if data[1].factoryString == 'soGUI.soItemGiftSlot':
                return True
        if event == module_soItemView.EVENT_DROP:
            if data[1].factoryString == 'soGUI.soInventorySlot2':
                return True
            if data[1].factoryString == 'soGUI.soTransferItemSlot':
                return True
            if data[1].factoryString == 'soGUI.soItemGiftSlot':
                return True
        return False

    def _check_reading_bank(self):
        p = BigWorld.player()
        bank_id = p.cacheObjectID
        entity = BigWorld.entities.get(bank_id, None)
        if entity and GiftBankUtils.bank_is_only_read(entity.npcName):
            return False
        else:
            return True

    def _setItems(self, items):
        self.component.itemView.script.setItems(items)

    def onChangeItems(self, item):
        item_id = item['complexItemID']
        if item_id in self._blocked_items:
            self._blocked_items[item_id].lockSlot(False)
            del self._blocked_items[item_id]

    def addBlockedItem(self, item, slot):
        item_id = item['complexItemID']
        slot.lockSlot(True)
        self._blocked_items[item_id] = slot

    def isCurrentTrader(self):
        current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', None)
        return self._selected_npc == current_trader_name

    def update(self, need_redraw_name = False):
        self.component.lockLayer.visible = False
        if self.cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX and need_redraw_name and hasattr(self.component, 'npc_name_list'):
            npc_name_list = self.component.npc_name_list.visible = True
            BigWorld.callback(0.0, self.setListNPCNames)
        if not BWPersonality.GUICore.itemCacheDataSection:
            return
        else:
            current_trader_name = BWPersonality.GUICore.itemCacheDataSection.get('trader_name', None)
            if self._selected_npc and self._selected_npc != current_trader_name:
                data = {}
                bank = ItemsUtils.GetBankEntry(BigWorld.player(), self._selected_npc)
                if bank:
                    data['items'] = bank['Items']
            else:
                data = BWPersonality.GUICore.itemCacheDataSection
                if self.cache_mode != ItemsUtils.CACHE_MODE_SAFEBOX:
                    pass
                if self.cache_mode == ItemsUtils.CACHE_MODE_CREATURE:
                    player = BigWorld.player()
                    self.component.button_take_all.script.setDisabledState(not player.canTakeDamage)
            if not data:
                return
            if data.has_key('items'):
                items = data['items']
                items = list(items)
                self._items = items
                self.redrawItems()
            if data.has_key('slots_string'):
                self.component.slotLabel.text = data['slots_string']
            if data.has_key('caption'):
                self.component.iLabel.text = data['caption']
            return

    def redrawItems(self):
        items = itemFilterFunction(self._items, self.filterMask)
        self._setItems(items)

    def _setFilterMask(self, filterMask):
        self.filterMask = filterMask
        self._updateFilters()

    def filterHandler(self, filter_bit):
        self.filterMask = self.filterMask ^ filter_bit
        self._updateFilters()

    def _updateFilters(self):
        for filter_name, filter_id, filter_visual in filters:
            cmp = getattr(self.component, filter_name)
            cmp.script.buttonActive = bool(self.filterMask & filter_id)
            cmp.script._updateVisualState()

        self.redrawItems()

    def stopDragging(self):
        if self.savedGUIPosition:
            self.savedGUIPosition[self.cache_mode] = tuple(self.component.position)
        else:
            self.savedGUIPosition = {self.cache_mode: tuple(self.component.position)}
        self.saveGUIPositions()
        DraggableComponent.stopDragging(self)

    def handleMouseButtonEvent(self, comp, event):
        if hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.script.showList(False)
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleKeyEvent(self, event):
        key = event.key
        down = event.isKeyDown()
        use_key = BWPersonality.settings.keyBindings.getBindingsForAction('InteractObject')[0][0]

        def checkKey():
            if isinstance(use_key, tuple):
                return key in use_key
            if isinstance(use_key, int):
                return key == use_key

        if down and self.cache_mode in (ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CAPSULE) and checkKey():
            self.onTakeAllItems()
            return True
        return False

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def show(self, cache_mode):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.window_name)
        self.cache_mode = cache_mode
        if not self.savedGUIPosition:
            self.readGUIPostitons()
        self.checkGUIPosition()
        if self.savedGUIPosition:
            self.component.position = self.savedGUIPosition.get(self.cache_mode, self.component.position)
        self.checkNormalPosition()
        self.component.visible = True
        self._selected_npc = None
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.generalGUIEvent(GUIEvents.EVENT_SHOW, self.interfaceID)
        self.component.itemView.script.setCacheMode(cache_mode)
        self.component.itemView.script.resetScroll()
        if BWPersonality.GUICore.inventoryGUI:
            BWPersonality.GUICore.inventoryGUI.lockWindow(False)
        if cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX:
            self.component.button_show_gift.visible = True
        else:
            self.component.button_show_gift.visible = False
        if cache_mode in [ItemsUtils.CACHE_MODE_CREATURE, ItemsUtils.CACHE_MODE_CAPSULE]:
            self.component.button_take_all.visible = True
            self.component.button_take_all.label.text = lc('GUI.itemCache.TAKE_ALL') % BWPersonality.settings.keyBindings.getInteractObjectkey()
        else:
            self.component.button_take_all.visible = False
        return

    def hide(self):
        if self.component.visible:
            if self.savedGUIPosition:
                self.savedGUIPosition[self.cache_mode] = tuple(self.component.position)
            else:
                self.savedGUIPosition = {self.cache_mode: tuple(self.component.position)}
            self.saveGUIPositions()
            BigWorld.player().onCloseItemCache()
            if self.cache_mode == ItemsUtils.CACHE_MODE_SAFEBOX and BigWorld.player().explorePot:
                BigWorld.delPot(BigWorld.player().explorePot)
        self.component.visible = False
        self._selected_npc = None
        self._saved_scrolling = {}
        if hasattr(self.component, 'npc_name_list'):
            self.component.npc_name_list.script.showList(False)
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.generalGUIEvent(GUIEvents.EVENT_HIDE, self.interfaceID)
        BWPersonality.GUICore.showGiftListWindow(False)
        BWPersonality.GUICore.showGiftWindow(False)
        BWPersonality.GUICore.showGiftSendWindow(False)
        if BWPersonality.GUICore.inventoryGUI:
            BWPersonality.GUICore.inventoryGUI.lockWindow(False)
        if self.onHide:
            self.onHide()
            self.onHide = None
        return

    def onHide(self):
        pass

    def doReposition(self):
        if not self.savedGUIPosition:
            sW, sH = BigWorld.screenSize()
            cache_y = 0.33
            if BWPersonality.GUICore.inventoryGUI:
                cache_x = BWPersonality.GUICore.inventoryGUI.component.position[0]
                cache_y = BWPersonality.GUICore.inventoryGUI.component.position[1]
                cache_w = BWPersonality.GUICore.inventoryGUI.component.width
                self.component.position = (cache_x - float(cache_w) / sW * 2, cache_y, 0.45)
            else:
                self.component.position = (1 - float(581 / sW) * 2, cache_y, 0.49)
        else:
            self.component.position = self.savedGUIPosition.get(self.cache_mode, self.component.position)

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_take_all', 'onClick')
    def onTakeAllItems(self):
        BWPersonality.GUICore.itemCacheEvent(ACTION_TAKE_ALL, self._items)

    @PyGUIEvent('button_show_gift', 'onClick')
    def onShowGift(self):
        if not BWPersonality.GUICore.giftListGUI or not BWPersonality.GUICore.giftListGUI.component.visible:
            BWPersonality.GUICore.showGiftListWindow(True)
        else:
            BWPersonality.GUICore.showGiftListWindow(False)

    def onScroll(self):
        if self._selected_npc:
            self._saved_scrolling[self._selected_npc] = self.component.itemView.script.cursor

    def checkGUIPosition(self):

        def check_positions(pos):
            if abs(pos[0]) > 1 or abs(pos[1]) > 1:
                self.resetPosition()

        if isinstance(self.savedGUIPosition, dict):
            pos = self.savedGUIPosition.get(self.cache_mode, None)
            if pos:
                check_positions(pos)
        return

    def setSize(self, rows, cols):
        self.ROWS = rows
        self.COLS = cols
        self.component.height = 134 + self.ROWS * 64
        self.component.width = 24 + self.COLS * 64
        self.component.iFrame.height = self.component.height
        self.component.iFrame.width = self.component.width
        self.component.itemView.script.deleteSlots()
        self.component.itemView.script.rowWidth = self.COLS
        self.component.itemView.script.rows = self.ROWS
        self.component.itemView.script.cols = self.COLS
        self.component.itemView.script.setupSlots()
        self.component.itemView.script.setupScrolls()
        self.component.itemView.script._updateMaxScroll()
        self.component.itemView.script._applyItems()
        self.component.closeBox.position = (self.component.width - 6 - self.component.closeBox.width, 6, 0.3)
        _x = 28
        for fiter_name, _, _ in filters:
            _filter = getattr(self.component, fiter_name, None)
            if _filter:
                _filter.position = (self.component.width - _x, 6, 0.3)
                _x += 18

        self.component.npc_name_list.position = (self.component.width - 5, 62, 0.5)
        self.component.npc_name_list.script.setWidth(self.component.width - 90)
        self.component.lockLayer.height = self.component.height - 127
        self.component.lockLayer.width = self.component.width - 7
        self.component.slotLabel.position = (21, self.component.height - 30, 0.3)
        self.component.button_show_gift.position = (self.component.width - 10, self.component.height - 7, 0.1)
        self.component.button_take_all.position = (self.component.width - 10, self.component.height - 7, 0.1)
        BigWorld.callback(0.1, self.checkNormalPosition)
        return


class soItemLootCacheScreen(soItemCacheScreen):

    @property
    def window_name(self):
        return 'itemLootCache'

    def __init__(self, component):
        self.ROWS = 4
        self.COLS = 4
        self.HEIGTH = 326
        self.WIDTH = 283
        self.cache_mode = 0
        PyGUIBase.__init__(self, component)
        DraggableComponent.__init__(self, True, True, True, xoffset=0, yoffset=0)
        GUIPositions.__init__(self)
        component.script = self
        self._selected_npc = None
        self._saved_scrolling = {}
        self._blocked_items = {}
        self.interfaceID = BWPersonality.GUICore.GUI_ID_ITEMLOOTCACHE
        self.filterMask = INV_CONST.FILT_ALL
        self.component.focus = True
        self.component.dragFocus = True
        self.component.dropFocus = True
        self.component.crossFocus = True
        self.component.moveFocus = True
        self.component.mouseButtonFocus = True
        self.setupRoot()
        self.setupItemView()
        self.setupContent()
        self.component.lockLayer.height = self.component.height - 63
        self.component.lockLayer.position = (5, 30, 0.1)
        return

    def setupItemView(self):
        itemView = soItemView(GUI.Window(), soItemCacheSlot, slot_eventsHandler=self.slotHandler, eventsHandler=self.itemViewHandler, rows=self.ROWS, rowWidth=self.ROWS, cols=self.COLS, hScroll=0, borderWidth=0)
        cmp = itemView.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (5, 30, 0.5)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'itemView')
        itemView.onBound()
        itemView.setRestrictingComponent(None)
        itemView.setItems(None)
        itemView.onScroll = self.onScroll
        itemView.onAddItem = self.onChangeItems
        itemView.onRemoveItem = self.onChangeItems
        return

    def doReposition(self):
        if not self.savedGUIPosition:
            self.component.position = (0.463, 0.33, 0.45)