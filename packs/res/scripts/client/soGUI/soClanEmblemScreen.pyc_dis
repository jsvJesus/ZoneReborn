    def resetModels(self):
        player = BigWorld.player()

        def onLoadModel(model):
            self._renderModel.setModels({'player': model,
             'flag': flag_model})
            self.onLoadModel(model)

        StalkerModel.ComposePlayerModel(player, onLoadModel)
        flag_model = BigWorld.Model(ModelSelector.MODELS[ModelSelector.FLAG_MODEL])

    def updateEmblemList(self, data):
        self.frame_change_image.updateEmblemList(data)

    def _drawIcon(self, imgID, feedName = '', texture = None):
        if not self.component.playerCaption:
            return
        else:
            self.component.playerCaption.script.clanIconID = imgID
            self.component.playerCaption.script.setClanIcon(imgID, feedName, texture)
            self.newEmblemID = imgID
            if texture:
                self.frame_change_image._drawIcon(imgID, feedName, texture)
                StalkerModel.setFeed(self._renderModel._model, None, 'flag_color', feedName)
            else:
                self.frame_change_image._drawIcon(None)
                self.frame_change_image._drawIcon(imgID, feedName, texture)
                StalkerModel.setFeed(self._renderModel._model, None, 'flag_color', 'feed_disabled')
                self.newEmblemID = 0
            return

    def clearEmblem(self):
        self.newEmblemID = self.currentEmblemID

    def onLoadModel(self, model):
        self._renderModel.show()
        self.updateCurrentIcon()

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanEmblemScreen')
        self.component.visible = True
        self.resetModels()
        if not BigWorld.player().checkClanRights(Clan.FLAG_CAN_CHANGE_ICON):
            self.frame_change_image.LockBtn()
        BigWorld.player().base.getMyEmblems()
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        self.component.visible = False
        self._renderModel.hide()
        self.frame_change_image.setStatus(1)
        self.frame_change_image.unLockBtn()
        BWPersonality.GUICore.setBestCursor()

    def updateModel(self):
        self._renderModel.show()

    def onCloseBox(self):
        self.hide()

    def updateCurrentIcon(self):
        pl = BigWorld.player()
        if pl:
            self.currentEmblemID = pl.clanEmblemID
            if self.currentEmblemID:
                feedNameCur = UCManager.ucmanager.loadImg(self.currentEmblemID, self._drawIcon)
            else:
                self._drawIcon(self.currentEmblemID)

    def onSaveIconBtnClick(self):

        def _save_check(event):
            if event == gui_jokes.askUserYesNo.YES:
                if self.newEmblemID is not None:
                    BigWorld.player().cell.saveClanIconID(self.newEmblemID)
                    BigWorld.callback(1, self.updateCurrentIcon)
                    self.frame_change_image.setStatus(1)
            return

        if self.newEmblemID == self.currentEmblemID or self.newEmblemID == -1:
            gui_jokes.askUserOk(lc('GUI.ClanEmblems.BUY_CAPTION'), lc('GUI.ClanEmblems.NOT_SAVE'))
            return
        pl = BigWorld.player()
        if not pl or not pl.__class__.__name__ == 'PlayerAvatar':
            return
        if self.newEmblemID == 0:
            gui_jokes.askUserYesNo(lc('GUI.ClanEmblems.BUY_CAPTION'), colorCodes.tf3_regular_text_color + lc('GUI.ClanEmblems.RESET_EMBLEM'), _save_check)
            return
        if pl.CreditNumber < DyeConstant.COST_CLAN_EMBLEM:
            gui_jokes.askUserOk(lc('colourItemWindow.ERROR'), lc('colourItemWindow.NOT_ENOUGH_MONEY'))
            return
        gui_jokes.askUserYesNo(lc('GUI.ClanEmblems.BUY_CAPTION'), colorCodes.tf3_regular_text_color + lc('GUI.ClanEmblems.SAVE_EMBLEM_TEXT').format(DyeConstant.COST_CLAN_EMBLEM), _save_check)

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True


class TypicalPlayerCaption(PyGUIBase):
    MARKER_PLAYER = 0
    MARKER_ITEM = 1
    MARKER_NPC = 2
    MARKER_PK = 100
    MARKER_WARDECLARED = 101
    MARKER_WARRECIEVED = 102
    MARKER_USE = 200
    MARKER_PICKUP = 201
    MARKER_TALK = 202
    MARKER_TRADE = 203
    MARKER_WANTED = 204
    ICON_SIZE = 16
    FRAME_TEXTURE = BigWorld.PyTextureProvider('soGUI/maps/inworldMarkers/frame.tga')

    def __init__(self, component, ids = (MARKER_PLAYER,), description = u'', alpha = 1.0, clanIcon = None):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.iconIDs = ids
        self.description = description
        self.clanIconID = clanIcon
        self.alpha = alpha * 255.0
        self.colour = (255,
         255,
         255,
         self.alpha)
        self.textLabels = []
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.width = 0
        cmp.height = 0
        cmp.position = (0.0, 0.0, 1.5)
        cmp.textureName = ''

    def setupContent(self):
        cmp = GUI.Simple('')
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.width = self.ICON_SIZE
        cmp.height = self.ICON_SIZE
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.position = (1, 0, 0.5)
        cmp.texture = None
        cmp.visible = False
        self.component.addChild(cmp, 'clanIcon')
        self.setupIcons()
        return

    def setupIcons(self):
        iconHolder = None
        if len(self.iconIDs) > 0:
            cmp = GUI.Window('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'TOP'
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            cmp.materialFX = 'BLEND'
            cmp.width = 0
            cmp.height = 16
            cmp.position = (0.0, 1.0, 1.5)
            cmp.textureName = ''
            iconHolder = cmp
        for i, icon in enumerate(self.iconIDs):
            iconHolder.width += 16
            cmp = GUI.Simple('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.widthMode = cmp.heightMode = 'PIXEL'
            cmp.horizontalAnchor = 'LEFT'
            cmp.verticalAnchor = 'TOP'
            cmp.width = 16
            cmp.height = 16
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            cmp.materialFX = 'BLEND'
            cmp.position = (0 + i * 16, 0, 0.5)
            cmp.texture = soInworldMarkers.ICON_MAP[icon]
            iconHolder.addChild(cmp, 'icon' + str(i))

        if iconHolder:
            self.component.width = iconHolder.width
            self.component.height = iconHolder.height
            self.component.addChild(iconHolder, 'iconHolder')
        self.setupCaption()
        return

    def setupCaption(self):
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.font = 'ruRU_calibri_default.font'
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        if self.MARKER_WANTED in self.iconIDs:
            cmp.colour = (255,
             150,
             150,
             self.alpha)
        cmp.colourFormatting = True
        cmp.multiline = True
        cmp.materialFX = 'BLEND'
        cmp.text = self.description
        calcStr = self.description
        colorCodes = []
        for label in self.textLabels:
            self.component.delChild(label)

        self.textLabels = []
        idx = 0
        w, h = cmp.stringDimensions(calcStr)
        if self.clanIconID:
            w += self.ICON_SIZE
        if w + 4 > self.component.width:
            self.component.width = w + 8
        self.normal_width = w + 8
        self.component.height = self.ICON_SIZE + h + 4
        vis_str = self.description.split('\n')
        for index, vis_part in enumerate(vis_str):
            cmp = GUI.Text('')
            cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
            cmp.horizontalAnchor = 'CENTER'
            cmp.verticalAnchor = 'BOTTOM'
            cmp.font = 'ruRU_calibri_default.font'
            cmp.colour = (255,
             255,
             255,
             self.alpha)
            if self.MARKER_WANTED in self.iconIDs:
                cmp.colour = (255,
                 150,
                 150,
                 self.alpha)
            cmp.colourFormatting = True
            cmp.multiline = True
            cmp.materialFX = 'BLEND'
            cmp.text = vis_part
            _X = self.component.width // 2
            _Y = self.component.height - 2 - (len(vis_str) - (index + 1)) * (h / len(vis_str))
            cmp.position = (_X, int(_Y), 0.5)
            self.textLabels.append(cmp)
            self.component.addChild(cmp, 'description{0}'.format(index))
            if self.component.clanIcon:
                self.component.clanIcon.position = self.textLabels[-1].position - (self.textLabels[-1].width / 2 - self.ICON_SIZE / 2, 0, 0)

        cmp = GUI.Frame2('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.colour = (255,
         255,
         255,
         self.alpha)
        cmp.materialFX = 'BLEND'
        cmp.width = w + 4
        cmp.height = h + 4
        cmp.position = (self.component.width // 2, self.component.height, 1.0)
        cmp.texture = self.FRAME_TEXTURE
        self.component.addChild(cmp, 'backFrame')
        self.fixPosition()

    def fixPosition(self, isNoIcon = False):
        self.component.backFrame.width = self.component.width
        self.component.backFrame.position = (self.component.width / 2, self.component.height, 1.0)
        eps = 0
        if self.clanIconID != 0:
            isNoIcon = True
        labels_count = len(self.textLabels)
        for index in range(0, labels_count):
            if index == labels_count - 1 and isNoIcon:
                eps = self.ICON_SIZE / 2 + 2
            _X = self.component.width / 2 + eps
            _Y = self.textLabels[index].position.y
            self.textLabels[index].position = (_X, _Y, 0.5)

        w, h = self.textLabels[-1].stringDimensions(self.textLabels[-1].text)
        self.component.clanIcon.position = self.textLabels[index].position - (w / 2 + 2, 0, 0)

    def setClanIconByID(self, iconID):
        if self.clanIconID == iconID:
            return
        self.clanIconID = iconID
        if iconID == 0:
            self.setClanIcon(0)
            return
        feedName = UCManager.ucmanager.loadImg(iconID, self.setClanIcon)

    def setClanIcon(self, imgID = 0, feedName = '', textureProvider = None):
        if textureProvider:
            self.component.clanIcon.texture = textureProvider
            self.component.clanIcon.visible = True
            self.component.width = self.normal_width + self.component.clanIcon.width + 4
        else:
            self.component.clanIcon.visible = False
            self.component.clanIcon.texture = None
            self.component.width = self.normal_width
        self.fixPosition()
        return

    def setDescription(self, txt):
        if self.description == txt:
            return
        self.description = txt
        self.setupCaption()

    def setAlpha(self, alph):
        if self.alpha == alph:
            return
        self.alpha = alph
        for i, child in self.component.children:
            child.colour = (255,
             255,
             255,
             self.alpha)

        if not self.component.iconHolder:
            return
        for i, child in self.component.iconHolder.children:
            child.colour = (255,
             255,
             255,
             self.alpha)

    def fini(self):
        self.clearAllChildren(self.component)
        self.component.script = None
        self.component = None
        self.clipMP = None
        return


class ModelWindow(PyGUIBase):

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._x, self._y, self._z = (0.015, 1.48, -0.415)
        self.setupRoot()

    def setupRoot(self):
        W, H = (500, 420)
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = W
        cmp.height = H
        cmp.position = (340, 30, 0.1)
        cmp.colour = (255, 255, 255, 100)
        cmp.materialFX = 'BLEND'
        cmp.visible = True
        cmp.focus = 0
        cmp.crossFocus = 0
        cmp.dragFocus = False
        cmp.moveFocus = 1
        cmp.dropFocus = False
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 19, 17, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 0.1)
        cmp.visible = 0
        self.component.addChild(cmp, 'tmpFON')
        cmp.width = H - 10
        cmp.height = H - 10
        cmp = GUI.Simple('textures/default/blue_dark.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 0.1)
        cmp.visible = 1
        self.component.addChild(cmp, 'renderDummy')
        cmp.width = H - 10
        cmp.height = H - 10
        mr = BigWorld.PyModelRenderer(H, H)
        for zz in range(100):
            mr.delDirectionLight(0)
            mr.delOmniLight(0)

        dir1 = Math.Vector3((1, -1, 0))
        dir1.normalise()
        mr.addOmniLight((1.2, 1.2, 1.2, 1.5), (self._x, self._y, self._z), 0.2, 3)
        c = 0.5
        mr.addAmbientColor(tuple([c] * 4))
        self._model_renderer = mr

    def doReposition(self):
        W, H = BigWorld.screenSize()
        self.component.renderDummy.width = H - 10
        self.component.renderDummy.height = H - 10
        self.component.tmpFON.width = H - 10
        self.component.tmpFON.height = H - 10

    def show(self):
        self._model_renderer.dynamic = True
        self._model_renderer.render()
        self.component.renderDummy.texture = self._model_renderer.texture

    def hide(self):
        self._model_renderer.dynamic = False
        self.component.renderDummy.texture = None
        self.clearModel()
        return

    def getModel(self):
        return self._model

    def clearModel(self):
        self._model_renderer.models = []

    def setModels(self, model):
        self._model = model['flag']
        self._model.zoomExtents(1, 0.25)
        self._model.yaw = 1.9
        self._model.flag_color = 'blue'
        self._model.position = (-0.4, 0.5, -0.5)
        self._model.rotate(0.5, (2, 0, -0.6), (1, 0, 0))
        model['player'].zoomExtents(1, 1.0)
        model['player'].yaw = 2.0
        model['player'].rotate(1.3, (4, 6, 2), (3, 0, 0))
        model['player'].position = (0.15, -0.2, -0.5)
        self._model_renderer.models = [self._model, model['player']]
        try:
            model['player'].IdleUnarmed()
            self._model.Wave()
        except:
            traceback.print_exc()

    def addModel(self, model):
        self._model.append(model)
        self._model_renderer.models = self._model

    def updateImageData(self, imgids, myimgids):
        pass