    def updateClanIcon(self):
        pl = BigWorld.player()
        if pl:
            self.currentEmblemID = pl.clanEmblemID
            if self.currentEmblemID:
                feedNameCur = UCManager.ucmanager.loadImg(self.currentEmblemID, self._drawIcon)
            else:
                self._drawIcon(self.currentEmblemID)

    def _drawIcon(self, imgID, feedName = '', texture = None):
        if texture:
            self.component.clanEmblem.texture = texture
        else:
            self.component.clanEmblem.texture = None
        return

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'clanInfoDetails')
        self.updateClanIcon()
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)