    def setListNPCNames(self):
        npc_name_list = self.component.debug_bank_list.script
        npc_name_list.clear()
        if BWPersonality.GUICore.itemCacheDataSection is None:
            return
        else:
            current_trader_name = self.component.bank.text
            data = []
            selected_id = 0
            index = -1
            currenr_found = False
            for index, bank in enumerate(BigWorld.player().StoredItems):
                if not _NPCs.getName(bank['TraderName']):
                    npc_localise = bank['TraderName']
                    if 'Return_of_lost' == bank['TraderName']:
                        continue
                    data.append([index, npc_localise, bank['TraderName']])
                    selected_id = bank['TraderName'] == current_trader_name and index
                    currenr_found = True

            npc_name_list.addElements(data)
            npc_name_list.setSelectionByValue(selected_id, True)
            self.elements = dict(map(lambda x: (x[0], x[1:]), data))
            return

    def itemViewHandler(self, event, data):
        return False

    def slotHandler(self, event, data):
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    def handleMouseEnterEvent(self, comp):
        return True

    def handleMouseLeaveEvent(self, comp):
        return True

    def show(self, gift = None, npcName = None, npcID = 0):
        if not npcName:
            p = BigWorld.player()
            npcName = p.GetTraderName(p.cacheObjectID)
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.delChild(self.factoryString)
            BWPersonality.GUICore.worldLayer.addChild(self.component, self.factoryString)
        self.component.visible = True
        self.component.position = (0, 0, 0.3)
        self.npcName = npcName
        self.npcID = npcID
        self.gift = gift
        comment = gift['comment'].decode('utf8')
        if len(comment) > 30:
            comment = u'\n'.join((comment[:30], comment[30:]))
        self.component.msg.text = comment
        self.component.date.text = timeToDateString(gift['timeOfArrival'])
        self.component.fromavatar.text = gift['fromAvatar']
        self.component.tagert.text = gift['toAvatar']
        if not _NPCs.getName(gift['toTrader']):
            self.component.bank.text = '???'
            self._money.setValue(gift['money'])
            self._gold.setValue(gift['gold'])
            self.itemView.setItems(gift['itms'])
            self.component.status.text = GIFT_STATUS.caption.get(gift['statusCode'], u'????')
            if gift['statusCode'] in (GIFT_STATUS.WAIT_TO_OPEN, GIFT_STATUS.RETURNED_WAIT_TO_OPEN):
                self.component.button_open.script.setDisabledState(False)
            else:
                self.component.button_open.script.setDisabledState(True)
            self._debug_show_id.component.visible = BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and True
            self._debug_show_id.setValue(gift['giftID'].decode('utf8'))
            self.component.debug_change_btn.visible = True
        return

    def hide(self):
        self.component.visible = False
        self._debug_show_id.component.visible = False
        self._debug_show_id.activate(False)
        self.component.debug_change_btn.visible = False
        self.component.debug_bank_list.visible = False

    def doReposition(self):
        self.component.position = (0, 0, 0.3)

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('button_open', 'onClick')
    def onOpen(self):
        BigWorld.player().base.openGift(self.gift['giftID'], self.npcID)
        self.hide()
        BWPersonality.GUICore.giftListGUI.onGiftChange()

    @PyGUIEvent('debug_change_btn', 'onClick')
    def showChange(self):
        self.component.debug_bank_list.visible = True
        self.setListNPCNames()

    def onSelectedTo(self, attachment):
        selected_npc = self.elements[attachment][1]
        if selected_npc == self.component.bank.text:
            return

        def change_vendor(event):
            if event == gui_jokes.askUserYesNo.YES:
                BigWorld.player().base.changeGiftBank(self.gift['giftID'], selected_npc)

        msg = lc('GUI.itemCache.change_vendor')
        gui_jokes.askUserYesNo(u'TITLE', msg, change_vendor)