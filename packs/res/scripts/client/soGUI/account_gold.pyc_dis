# Embedded file name: ./scripts/client/soGUI/account_gold.py
"""
        hack view Gold in main menu

"""
import BigWorld
import BWPersonality
import GUI
from soGUI.soTextField import soTextField3
import traceback
from Localization import lc
from Helpers.PyGUI.PyGUIBase import PyGUIBase

class AccountGoldComonent(PyGUIBase):
    factoryString = 'soGUI.AccountGoldComonent'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._gold = 0
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.materialFX = 'BLEND'
        sW, sH = BigWorld.screenSize()
        cmp.width = sW
        cmp.height = 50
        cmp.visible = False
        cmp.position = (0, 10, 0.9)

    def setupContent(self):
        sW, sH = BigWorld.screenSize()
        shad = GUI.AlphaShader()
        self._alpha_shad = shad
        shad.mode = 'ALL'
        shad.alpha = 0.0
        shad.speed = 4.0
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (0, 0, 0, 120)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0, 0.2)
        self.component.addChild(cmp, 'tmpFON')
        cmp.width, cmp.height = (20, 34)
        cmp.position = (sW - 160 + 10, 0, 0.2)
        cmp.addShader(shad)
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'ruRU_Verdana_21.font'
        cmp.materialFX = 'BLEND'
        cmp.multiline = False
        cmp.colourFormatting = True
        cmp.position = (sW - 160, 3, 0.0)
        self.component.addChild(cmp, 'gold')
        cmp.addShader(shad)
        shad.reset()

    def update(self, value):
        self._gold = value
        textstr = lc('GUI.accountGold.balance') % self._gold
        self.component.gold.text = textstr
        w, h = self.component.gold.stringDimensions(textstr)
        self.component.tmpFON.width = w + 20

    def doReposition(self):
        sW, sH = BigWorld.screenSize()
        self.component.width = sW
        self.component.tmpFON.position = (sW - 160 + 10, 0, 0.2)
        self.component.gold.position = (sW - 160, 3, 0.0)

    def show(self):
        self.component.visible = True
        if self.component.parent is None:
            BWPersonality.GUICore.generalLayer.addChild(self.component, 'AccountGoldComonent')
        self._alpha_shad.value = 0
        self._alpha_shad.reset()
        self._alpha_shad.alpha = 0.0
        self._alpha_shad.speed = 4.0
        self._alpha_shad.value = 1
        return

    def hide(self):
        self.component.visible = False
        self._alpha_shad.value = 0
        self._alpha_shad.reset()