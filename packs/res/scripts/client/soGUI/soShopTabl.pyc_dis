    def _buy(self):
        self.buyHandler(item=self.itemData, BankName=self.bank, username=self.username, price=self.price)

    def setItem(self, itemData, price = 0, bank = '', username = '', timelost = 0):
        self.itemData = itemData
        self.price = price
        self.bank = bank
        self.username = username
        for subicon in range(self.MAXSUBICONS):
            subframeCmp = getattr(self.component, 'subframeCmp_%s' % subicon)
            subitemIcon = getattr(self.component, 'subitemIcon_%s' % subicon)
            subframeCmp.visible = False
            subitemIcon.visible = False

        if not itemData:
            self.component.itemCount.text = ''
            self.component.itemBigName.text = ''
            self.component.itemprice.text = ''
            self.component.username.text = ''
            self.component.bank.text = ''
            self.component.itemprice_one.text = ''
            self.component.itemprice_one.visible = False
            self.component.itemtime_label.visible = False
            self.component.item_time.visible = False
            self.component.itemBroken.visible = False
            self.component.itemColored.visible = False
            self.component.itemEmblem.visible = False
            self.component.username_label.visible = False
            self.component.bank_label.visible = False
            self._moneyLabel.component.visible = False
            self._moneyLabelPriceOne.component.visible = False
            self.component.item_slot.script.clear()
            self.component.button_buy.visible = False
            return
        else:
            self.component.itemprice_one.text = ''
            self._moneyLabelPriceOne.component.visible = False
            self.component.itemtime_label.visible = True
            self._moneyLabel.component.visible = True
            self.component.button_buy.visible = True
            self.component.username_label.visible = True
            self.component.bank_label.visible = True
            self.component.item_time.visible = True
            self.component.itemprice.text = lc('tmplocal.strings.str23')
            self._moneyLabel.setValue(price)
            number = ItemsUtils.GetItemNumber(itemData)
            if number > 1:
                self.component.itemprice_one.visible = True
                self._moneyLabelPriceOne.component.visible = True
                price_one = float(price) / number
                price_one = int(price_one)
                self._moneyLabelPriceOne.setValue(price_one)
                self.component.itemprice_one.text = '{0} x'.format(number)
            self.component.username.text = username
            if not _NPCs.getName(bank):
                bankName = '???'
                self.component.bank.text = bankName
                self.component.item_time.text = str(timelost) + lc('tmplocal.strings.str25')
                item_type = itemData['complexItemType']
                item_class = ItemsCatalog.GetItemClass(item_type)
                item_params = ItemsCatalog.GetItemParam(item_type)
                self.component.item_slot.script.set_item(self.itemData)
                self.component.button_buy.script.set_item(self.itemData)
                countStr = ItemsUtils.GetDisplayValue(itemData)
                bigName = ItemsUtils.GetItemName(item_type, fGetShortName=False, tintItem=self.itemData)
                self.component.itemCount.text = countStr
                clip_width = self.component.itemprice.position[0] - 120
                self.component.itemBigName.text = client_utils.clip_text(bigName, self.component.itemBigName, clip_width)
                item_state = ItemsUtils.GetItemConditionPercent(BigWorld.player(), itemData)
                if item_state <= 0.5:
                    self.component.itemBroken.visible = True
                else:
                    self.component.itemBroken.visible = False
                emblem = ItemsUtils.getItemEmblem(itemData)
                colorise = ItemsUtils.getItemColorise(itemData)
                if not bool(colorise):
                    self.component.itemColored.visible = bool(ItemsUtils.getTintID(itemData))
                    self.component.itemEmblem.visible = bool(emblem)
                    inconstantParam = ItemsUtils.GetComplexItemInconstanParams(itemData)
                    if item_class == ItemsCatalog.ARTIFACT:
                        depleet_time = ItemsUtils.GetArtefactDepleetionTime(itemData, item_params, BWPersonality.gpd.time_diff)
                        if inconstantParam.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0) or depleet_time < 0.0 or depleet_time is None:
                            self.component.itemBroken.visible = True
                    max_art = item_params.get('IsArtefactContainer') and item_params.get('MaxArtefact', 0)
                    if max_art > 0 and max_art <= self.MAXSUBICONS:
                        for i in range(max_art):
                            subframeCmp = getattr(self.component, 'subframeCmp_%s' % i)
                            subframeCmp.visible = True

                subiconI = 0
                subframeCmp = emblem and getattr(self.component, 'subframeCmp_%s' % subiconI)
                subitemIcon = getattr(self.component, 'subitemIcon_%s' % subiconI)
                subframeCmp.visible = True
                subitemIcon.visible = True
                subitemIcon.textureName = ''

                def setEmblemIcon(imgID, feedName, texture):
                    if texture:
                        subitemIcon.texture = texture

                feedName = UCManager.ucmanager.loadImg(emblem[0], setEmblemIcon)
                subiconI += 1
            itemList = itemData['itemList']
            for subiconI, subitem in enumerate(itemList, subiconI):
                sub_item_type = subitem['itemType']
                sub_itemParam = ItemsCatalog.GetItemParam(sub_item_type)
                subframeCmp = getattr(self.component, 'subframeCmp_%s' % subiconI)
                subitemIcon = getattr(self.component, 'subitemIcon_%s' % subiconI)
                subframeCmp.visible = True
                subitemIcon.visible = True
                iconName = sub_itemParam['IconName']
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        if BWPersonality.GUICore.iconTextures.has_key(iconName):
                            subitemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                        else:
                            subitemIcon.textureName = iconName
                else:
                    subitemIcon.textureName = iconName

            return


class soShopTabl(PyGUIBase):

    def __init__(self, component, w, h, posw, row):
        PyGUIBase.__init__(self, component)
        component.script = self
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = w
        cmp.height = h
        self.filterW = 200
        self.filterH = 552
        self.w = w
        self.h = h
        self.row = row
        self.posw = posw
        self._rows = []
        self._waitserver = False
        self.page_start = 0
        self.last_index_item = 0
        self.old_page_start = 0
        self.old_last_index_item = 0
        self.all_index_item = 0
        self.activeWindowID = None
        self.activeWindowIDMoved = None
        self.vScroll = None
        self.setupContent()
        self.setupFiltersContent()
        self.setupRows()
        self.setupBar()
        self.request_callback = None
        return

