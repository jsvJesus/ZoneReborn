    def setupFiltersContent(self):
        cmp = soBillboardFilter(self.filter_updated)
        self.component.addChild(cmp.component, 'billboardFilter')

    def filter_updated(self):
        self.request_shop_data()

    def really_request_shop_data(self, page_start, forward):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81 \xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85 (\xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9)
        """
        billboard = self.component.billboardFilter.script
        filter_set = {'cat_ids': billboard.get_cat_ids(),
         'text_filter': billboard.get_text_filter(),
         'repairs_filter': billboard.get_repairs_filter(),
         'condition_filter': billboard.get_condition_filter(),
         'items_filter': billboard.get_items_filter(),
         'bank_filter': billboard.get_bank_filter(),
         'insertions_filter': billboard.get_insertions_filter()}
        BigWorld.player().getShopCatalogFiltered(billboard.get_sort_index(), forward, page_start, self.row, filter_set)
        self._editPageBox.activate(False)
        self.request_callback = None
        return

    def request_shop_data(self, page_start = 0, forward = 1):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81 \xd0\xbd\xd0\xb0 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd1\x85
                (\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb9 - \xd0\xbe\xd0\xb6\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xbb \xd1\x81\xd0\xb5\xd0\xba\xd1\x83\xd0\xbd\xd0\xb4\xd1\x8b)
        """
        if self.request_callback:
            BigWorld.cancelCallback(self.request_callback)
        foo = partial(self.really_request_shop_data, page_start, forward)
        self.request_callback = BigWorld.callback(0.5, foo)

    def setupBar(self):
        self.bar_width = self.component.width - self.filterW
        self.bar_posY = 29
        self.wbar = soGUI.soWindowBar.soWindowBar(GUI.Window(), self.bar_width, 27, self)
        cmp = self.wbar.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.position = (1, self.bar_posY, 0.9)
        self.component.addChild(cmp, 'wbar')
        self.wbar.onBound()

    def clearBuyWindows(self):
        if self.wbar:
            self.wbar.clearWindows()

    def setupRows(self):
        rowh = int(self.h / (self.row + 1.0))
        roww = int(self.w - self.component.billboardFilter.script.min_width - self.posw) - 1
        for index in range(self.row):
            position = (int(self.posw), 28 + int(rowh * index), 0.5)
            cb = RowItem(GUI.Window(), roww, rowh, position, self.buyDialog)
            cmp = cb.component
            cb.setItem(None)
            self.component.addChild(cmp, 'sub_row_%s' % index)
            cb.onBound()
            self._rows.append(cb)

        return

    def goto(self):
        newStartPage = self.component.NumberBox.script.rawText
        if newStartPage.isdigit():
            self.request_shop_data(int(newStartPage))

    def updatePage(self):
        self.request_shop_data(self.page_start)

    def buttonRightClick(self):
        startfrom = max(self.page_start, self.last_index_item)
        self.request_shop_data(startfrom)

    def buttonLeftClick(self):
        startfrom = min(self.page_start, self.last_index_item)
        self.request_shop_data(startfrom, 0)

    def checkButtonsPage(self):
        self.component.button_left.script.setDisabledState(False)
        self.component.button_right.script.setDisabledState(False)
        if self.page_start == 0:
            self.component.button_left.script.setDisabledState(True)
        if self.last_index_item + 1 == self.all_index_item:
            self.component.button_right.script.setDisabledState(True)

    def setData(self, data):
        dataitems = data['data']
        self.old_page_start = self.page_start
        self.old_last_index_item = self.last_index_item
        self.page_start = page_start = data['page_start']
        self.last_index_item = last_index_item = data['last_index_item']
        self.all_index_item = all_index_item = data['all_index_item']
        self.component.label_page.text = '%s-%s/%s' % (page_start, last_index_item + 1, all_index_item)
        self.checkButtonsPage()
        for cb, item in map(lambda a, b: (a, b), self._rows, dataitems):
            if item:
                username = item['sellerName']
                complexItem = utils.pyFixedToNativePythonType(item['complexItem'])
                price = item['price']
                bank = item['BankName']
                hoursLeft = item['hoursLeft']
                cb.setItem(complexItem, price, bank, username.decode('utf8'), hoursLeft)
            else:
                cb.setItem(None)

        return

    def buyDialog(self, item = None, BankName = '', username = '', price = 0):
        windowID = str(item['complexItemID']) + str(hash(username))
        tmp_gui = self.wbar.getWindowByID(windowID)
        if not tmp_gui:
            tmp_gui = soGUI.soProofOfPurchaseInShop.soProofOfPurchaseInShop(GUI.Window(), self.callbackEnter, windowID, self.updatePage)
            self.wbar.addWindow(windowID, tmp_gui, username)
        tmp_gui.show(item=item, BankName=BankName, username=username, price=price)
        self.wbar.topWindow(windowID)

    def callbackEnter(self, enter, wid):
        if enter:
            self.activeWindowID = wid
            return
        else:
            if self.activeWindowID == wid:
                self.activeWindowID = None
            return

    def handleKeyEvent(self, event):
        if event.key == 256:
            if event.isKeyDown():
                self.activeWindowIDMoved = self.activeWindowID
                self.wbar.topWindow(self.activeWindowIDMoved)
            else:
                self.activeWindowIDMoved = None
            return True
        else:
            return False

    def scrolledUP(self):
        pass

    def scrolledDOWN(self):
        pass

    def show(self):
        self.component.moveFocus = True
        self.component.crossFocus = True
        self.component.focus = True
        self.request_shop_data()

    def hide(self):
        self._editPageBox.activate(False)

    def on_board_hide(self):
        self.component.billboardFilter.script.on_board_hide()

    def handleMouseEvent(self, cmp, event):
        if self.activeWindowIDMoved:
            dx = event.dx
            dy = event.dy
            window = self.wbar.getWindowByID(self.activeWindowIDMoved)
            if not window:
                return True
            x, y, z = window.component.position
            window.component.position = (x + dx, y + dy, z)
            return False
        return False