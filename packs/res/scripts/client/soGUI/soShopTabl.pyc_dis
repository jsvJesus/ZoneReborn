class BuyButton(soButton):
    INTERFACE_ID = 'ShopTable.BuyButton'
    INFO_ACTION_ID, DETAILS_ACTION_ID = range(2)

    def __init__(self):
        soButton.__init__(self, GUI.Window())
        self.item_data = None
        return

    def handleMouseButtonEvent(self, comp, event):
        if event.key == Keys.KEY_RIGHTMOUSE:
            if event.isKeyDown():
                BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)
                BWPersonality.GUICore.addListener('contextMenuEvent', self.context_menu_event)
                actions = {BuyButton.DETAILS_ACTION_ID: lc('soTradeInterface.shop.DETAILS'),
                 BuyButton.INFO_ACTION_ID: lc('soTradeInterface.shop.INFO')}
                BWPersonality.GUICore.showContextMenu(BuyButton.INTERFACE_ID, actions)
            return True
        return soButton.handleMouseButtonEvent(self, comp, event)

    def context_menu_event(self, interface_id, action_id, caption, event, data = None):
        if BuyButton.INTERFACE_ID != interface_id:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            if action_id == BuyButton.INFO_ACTION_ID:
                if self.item_data:
                    BWPersonality.GUICore.showItemInfo(self.item_data)
            elif action_id == BuyButton.DETAILS_ACTION_ID:
                self.onClick()
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)

    def set_item(self, item_data):
        self.item_data = item_data


