class ItemSlot(PyGUI.Window):
    INTERFACE_ID = 'soSlotExpand.ItemSlot'

    def __init__(self):
        component = GUI.Window()
        PyGUIBase.__init__(self, component)
        component.script = self
        self.item_data = None
        self.tooltip_enabled = False
        self.actions = None
        self.contextmenu_callback = None
        return

    def handleMouseEnterEvent(self, comp):
        if self.item_data and self.tooltip_enabled:
            BWPersonality.GUICore.toolTipEvent(self.item_data, BWPersonality.GUICore.GUI_ID_SHOP, soToolTipComponent.EVENT_SHOW)
        return True

    def handleMouseLeaveEvent(self, comp):
        if self.item_data and self.tooltip_enabled:
            BWPersonality.GUICore.toolTipEvent(self.item_data, BWPersonality.GUICore.GUI_ID_SHOP, soToolTipComponent.EVENT_HIDE)
        return True

    def set_item(self, item_data):
        self.component.visible = True
        item_type = item_data['complexItemType']
        self.item_data = item_data
        iconName = ItemsUtils.getTextureByTint(self.item_data)
        if not iconName:
            iconName = ItemsCatalog.GetItemParam(item_type)['IconName']
        if BWPersonality.GUICore.iconTextures is not None:
            if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                if BWPersonality.GUICore.iconTextures.has_key(iconName):
                    self.component.texture = BWPersonality.GUICore.iconTextures[iconName]
                else:
                    self.component.textureName = iconName
        else:
            self.component.textureName = iconName
        return

    def clear(self):
        self.component.visible = False

    def tooltip_enable(self, enable):
        """ \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd1\x82\xd1\x83\xd0\xbb\xd1\x82\xd0\xb8\xd0\xbf\xd0\xb0 (\xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82 \xd0\xbe\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb5\xd0\xb6\xd0\xb0\xd1\x89\xd0\xb8\xd0\xbc \xd0\xb2\xd0\xbd\xd1\x83\xd1\x82\xd1\x80\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xbc) """
        self.tooltip_enabled = enable
        self.component.crossFocus = enable

    def contextmenu_enable(self, actions, callback):
        """ \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xb0\xd1\x86\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e
                actions - \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8c, \xd0\xb3\xd0\xb4\xd0\xb5 \xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8 - \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b, \xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f - \xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd1\x8b
                callback - \xd1\x84\xd1\x83\xd0\xbd\xd0\xba\xd1\x86\xd0\xb8\xd1\x8f \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xb0\xd1\x8f \xd0\xb4\xd1\x91\xd1\x80\xd0\xb3\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbf\xd1\x80\xd0\xb8 \xd1\x82\xd1\x8b\xd0\xba\xd0\xb5 \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x82\xd0\xb5\xd0\xba\xd1\x81\xd1\x82\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8e \xd1\x81 \xd0\xb0\xd1\x80\xd0\xb3\xd1\x83\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc \xd0\xb8\xd0\xb4\xd0\xb5\xd0\xbd\xd1\x82\xd0\xb8\xd1\x84\xd0\xb8\xd0\xba\xd0\xb0\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd1\x8f
        """
        self.component.mouseButtonFocus = bool(actions)
        self.actions = actions
        self.contextmenu_callback = callback

    def handleMouseButtonEvent(self, comp, event):
        if not self.actions or not self.item_data or not self.contextmenu_callback:
            return True
        if event.key == Keys.KEY_RIGHTMOUSE:
            if event.isKeyDown():
                BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)
                BWPersonality.GUICore.addListener('contextMenuEvent', self.context_menu_event)
                BWPersonality.GUICore.showContextMenu(ItemSlot.INTERFACE_ID, self.actions)
            return True
        return soButton.handleMouseButtonEvent(self, comp, event)

    def context_menu_event(self, interface_id, action_id, caption, event, data = None):
        if ItemSlot.INTERFACE_ID != interface_id:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT:
            self.contextmenu_callback(action_id)
        elif event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.context_menu_event)


