        cmp.colour = (175, 166, 112, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (self.component.width - 5, 5, 0.3)
        self.component.addChild(cmp, 'itemCount')

    def show(self, itemData):
        self.itemData = itemData
        if not itemData:
            self.component.visible = False
            return
        else:
            self.component.visible = True
            self.component.itemBroken.visible = False
            self.component.itemColored.visible = False
            self.component.itemEmblem.visible = False
            item_type = itemData['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            iconName = ItemsUtils.getTextureByTint(self.itemData)
            if not iconName:
                iconName = item_params['IconName']
            self.component.itemIcon.script.set_item(itemData)
            countStr = ItemsUtils.GetDisplayValue(itemData)
            self.component.itemCount.text = countStr
            item_state = ItemsUtils.GetItemConditionPercent(BigWorld.player(), self.itemData)
            if item_state <= 0.5:
                self.component.itemBroken.visible = True
            else:
                self.component.itemBroken.visible = False
            emblem = ItemsUtils.getItemEmblem(itemData)
            colorise = ItemsUtils.getItemColorise(itemData)
            if not bool(colorise):
                self.component.itemColored.visible = bool(ItemsUtils.getTintID(itemData))
                self.component.itemEmblem.visible = bool(emblem)
                inconstantParam = ItemsUtils.GetComplexItemInconstanParams(self.itemData)
                if item_class == ItemsCatalog.ARTIFACT:
                    depleet_time = ItemsUtils.GetArtefactDepleetionTime(itemData, item_params, BWPersonality.gpd.time_diff)
                    self.component.itemBroken.visible = (inconstantParam.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0) or depleet_time < 0.0 or depleet_time is None) and True
            return


class soSlotExpand(PyGUIBase):
    factoryString = 'soGUI.soSlotExpand'

    def __init__(self, component, width, height, dw, dh):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._width = width
        self._height = height
        self.component.width = self._width
        self.component.height = self._height
        self.wheelFocus = False
        self.vScroll = None
        self.component.moveFocus = True
        self.maxScroll = 0
        self.minScroll = 0
        self.cursor = 0
        self.scrollStep = 0.1
        self._dw = dw
        self._dh = dh
        self.setupContent()
        return

    def setupContent(self):
        slot = SlotItemTT2(GUI.Window(), SLOTWIDTH, SLOTHEIGHT)
        cmp = slot.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (0 + self._dw, 0 + self._dh, 0.9)
        cmp.width = 64
        cmp.height = 64
        self.component.addChild(cmp, 'slotItemTT')
        slot.onBound()
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'default_small.font'
        cmp.colour = (175, 166, 112, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (SLOTWIDTH + 5 + self._dw, 0 + self._dh, 0.9)
        self.component.addChild(cmp, 'itemBigName')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        cmp.colour = (125, 126, 102, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (SLOTWIDTH + 5 + self._dw, 17 + self._dh, 0.3)
        self.component.addChild(cmp, 'itemCost')
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        cmp.colour = (145, 146, 102, 255)
        cmp.materialFX = 'BLEND'
        cmp.multiline = 0
        cmp.text = u''
        cmp.position = (SLOTWIDTH + 5 + self._dw, 31 + self._dh, 0.3)
        self.component.addChild(cmp, 'subitemsCaption')
        expand_list = SlotExpandList(GUI.Window(), 270, SUBSLOTHEIGHT * VISIBLE_SUBICONS)
        self.listFrame = expand_list.component
        self.listFrame.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        self.listFrame.widthMode = cmp.heightMode = 'PIXEL'
        self.listFrame.position = (SLOTWIDTH + self._dw, 55 + self._dh, 0.5)
        self.component.addChild(self.listFrame, 'listFrame')
        subicon = 6
        if self.vScroll is None:
            self.vScroll = soScrollBar2(GUI.Window(), width=16, height=SUBSLOTHEIGHT * VISIBLE_SUBICONS)
        self.vScroll.scrollUp = self.scrollUp
        self.vScroll.scrollDown = self.scrollDown
        cmp = self.vScroll.component
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.position = (SLOTWIDTH + self._dw + 250, 55 + self._dh, 0.4)
        cmp.height = SUBSLOTHEIGHT * VISIBLE_SUBICONS
        cmp.visible = False
        self.component.addChild(cmp, 'vScroll')
        self.vScroll.setVisualState('normal')
        self.vScroll.onBound()
        self.vScroll.setSteps(0)
        self.vScroll.setValue(0)
        cmp = GUI.Text('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'BOTTOM'
        cmp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        cmp.colour = (145, 126, 102, 255)
        cmp.materialFX = 'BLEND'
        cmp.text = ' '
        cmp.position = (SLOTWIDTH + self._dw + 3, 55 + self._dh + SUBSLOTHEIGHT * subicon, 0.99)
        self.component.addChild(cmp, 'allcost')
        return

    def applyitem(self, itemData):
        item_type = itemData['complexItemType']
        item_id = itemData['complexItemID']
        item_class = ItemsCatalog.GetItemClass(item_type)
        item_params = ItemsCatalog.GetItemParam(item_type)
        item_level = item_params['Level']
        iconName = ItemsUtils.getTextureByTint(itemData)
        if not iconName:
            iconName = item_params['IconName']
        self.component.slotItemTT.script.show(itemData)
        countStr = ItemsUtils.GetDisplayValue(itemData)
        countInt = int(countStr) if countStr.isdigit() else 0
        friendlyName = ItemsUtils.GetItemName(item_type, fGetShortName=True, tintItem=itemData)
        bigName = ItemsUtils.GetItemName(item_type, fGetShortName=False, tintItem=itemData)
        Cost = int(item_params.get('Cost', 0))
        self.component.itemBigName.text = bigName
        CostStr = lc('tmplocal.strings.str32') % groupNumber(str(Cost), ' ')
        if countInt > 1:
            CostStr += u'  x%s = %s' % (countStr, groupNumber(str(Cost * countInt), ' '))
        CostStr += u'\u0440.'
        self.component.itemCost.text = CostStr
        self.component.subitemsCaption.text = u''
        itemList = itemData['itemList']
        for subicon in range(MAXSUBICONS):
            subframeCmp = getattr(self.component.listFrame, 'subframeCmp_%s' % subicon)
            subitemIcon = getattr(self.component.listFrame, 'subitemIcon_%s' % subicon)
            subname = getattr(self.component.listFrame, 'subname_%s' % subicon)
            subframeCmp.visible = False
            subitemIcon.visible = False
            subname.visible = False

        current_height = len(itemList) * SUBSLOTHEIGHT
        if self.listFrame.height <= current_height:
            self.vScroll.component.visible = True
            screenH = BigWorld.screenHeight()
            steps = (current_height - self.listFrame.height) / screenH
            self.listFrame.maxScroll.y = steps * 2
            steps = math.ceil(self.listFrame.maxScroll.y / self.scrollStep)
            self.vScroll.setSteps(steps)
        else:
            self.vScroll.component.visible = False
            self.vScroll.setSteps(0)
            self.listFrame.maxScroll.y = 0
        for subiconI, subitem in enumerate(itemList):
            sub_item_type = subitem['itemType']
            sub_itemParam = ItemsCatalog.GetItemParam(sub_item_type)
            subcost = int(sub_itemParam.get('Cost', 0))
            if subiconI < MAXSUBICONS:
                subframeCmp = getattr(self.component.listFrame, 'subframeCmp_%s' % subiconI)
                subitemIcon = getattr(self.component.listFrame, 'subitemIcon_%s' % subiconI)
                subname = getattr(self.component.listFrame, 'subname_%s' % subiconI)
                subframeCmp.visible = True
                subitemIcon.visible = True
                subname.visible = True
                power_time = ItemsUtils.GetArtefactInContainerDepleetionTime(subitem)
                subtime = u''
                if power_time:
                    subtime = u' %s  ' % ItemsUtils.timeToString(power_time)
                subname.text = ItemsUtils.GetItemName(sub_item_type, fGetShortName=1) + subtime + '  + %s' % subcost
                iconName = sub_itemParam['IconName']
                if BWPersonality.GUICore.iconTextures is not None:
                    if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                        if BWPersonality.GUICore.iconTextures.has_key(iconName):
                            subitemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                        else:
                            subitemIcon.textureName = iconName
                else:
                    subitemIcon.textureName = iconName
            Cost += subcost

        if itemList:
            sub_item_count = ''
            if len(itemList) >= MAXSUBICONS:
                sub_item_count = '({0})'.format(len(itemList))
            self.component.subitemsCaption.text = lc('tmplocal.strings.str33').format(sub_item_count)
            allsum = lc('tmplocal.strings.str34') % groupNumber(str(Cost), ' ')
            if countInt > 1:
                allsum += u'  x%s = %s' % (countStr, groupNumber(str(Cost * countInt), ' '))
            allsum += u'\u0440.'
            self.component.allcost.text = allsum
        else:
            self.component.allcost.text = u''
        return

    def doReposition(self, sW, sH):
        pass

    def handleMouseEnterEvent(self, comp):
        self.wheelFocus = True
        self.component.focus = True
        return True

    def handleMouseLeaveEvent(self, comp):
        self.wheelFocus = False
        self.component.focus = False
        return True

    def handleMouseEvent(self, comp, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return False

    def scrollUp(self):
        if self.listFrame.scroll.y < self.listFrame.minScroll.y:
            self.listFrame.scroll.y = self.listFrame.minScroll.y
        if self.listFrame.scroll.y > self.listFrame.minScroll.y:
            self.listFrame.scroll.y -= self.scrollStep
            self.vScroll.setValue(self.vScroll.getValue() - 1)

    def scrollDown(self):
        if self.listFrame.scroll.y > self.listFrame.maxScroll.y:
            self.listFrame.scroll.y = self.listFrame.maxScroll.y
        if self.listFrame.scroll.y < self.listFrame.maxScroll.y:
            self.listFrame.scroll.y += self.scrollStep
            self.vScroll.setValue(self.vScroll.getValue() + 1)

    @PyGUIEvent('vScroll', 'scrollUp')
    def scrolledUP(self):
        self.scrollUp()

    @PyGUIEvent('vScroll', 'scrollDown')
    def scrolledDOWN(self):
        self.scrollDown()

    @PyGUIEvent('vScroll', 'scrollMoved')
    def vScrollMoved(self, newVal):
        self.listFrame.scroll.y = newVal * self.scrollStep
        self.vScroll.setValue(newVal)


