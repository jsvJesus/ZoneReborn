class soArtifactPoint(PyGUIBase):
    factoryString = 'soGUI.soArtifactPoint'

    def __init__(self, component, parent = None):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.parent = parent
        self.artifactID = -1
        self.onClick = lambda : None
        self._listen_out_range = False
        self.setupRoot()
        self.setupVisual()
        self.setupAlphaShader()
        self.setupSelector()
        self.blinkLoop().run()
        self.colorLoop().run()

    def setupRoot(self):
        cmp = self.component
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = 25
        cmp.height = 25
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.textureName = ''
        cmp.mouseButtonFocus = True

    def setupVisual(self):
        cmp = GUI.Simple('')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 23
        cmp.height = 23
        cmp.colour = (255, 150, 255, 255)
        cmp.position = (0.0, 0.0, 0.1)
        cmp.materialFX = 'BLEND'
        cmp.textureName = 'soGUI/maps/ArtifactQTE/artifactPoint.dds'
        self.component.addChild(cmp, 'visual')

    def setupSelector(self):
        cmp = GUI.Simple('soGUI/maps/ArtifactQTE/selector.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 25
        cmp.height = 25
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0.0, 0.0, 0.0)
        cmp.materialFX = 'BLEND'
        cmp.visible = False
        self.component.addChild(cmp, 'selector')

    def setupAlphaShader(self):
        shader = GUI.AlphaShader()
        shader.mode = 'ALL'
        shader.speed = 3
        shader.alpha = 1.0
        self.component.visual.addShader(shader, 'fader')

    def setID(self, id):
        self.artifactID = id

    def getID(self):
        return self.artifactID

    def handleMouseButtonEvent(self, comp, event):
        if not event.isMouseButton():
            return False
        down = event.isKeyDown()
        key = event.key
        position = event.cursorPosition
        if key == KEY_LEFTMOUSE:
            if down:
                self.onClick()
                return True
        return False

    def select(self):
        self.component.selector.visible = True

    def deselect(self):
        self.component.selector.visible = False

    def listenOutRange(self, value):
        self._listen_out_range = value

    @BWMemberCoroutine
    def colorLoop(self):
        yield BWWaitForPeriod(0.5)
        while self.component.visible:
            yield BWWaitForPeriod(0.1)
            anomaly = BigWorld.entities.get(self.artifactID, None)
            player = BigWorld.player()
            if not anomaly or not player:
                break
            art_vect = anomaly.position - BigWorld.player().position
            dist = art_vect.length
            if self._listen_out_range:
                if dist > ItemsUtils.EXTRACTION_RANGE:
                    self.parent.onPointOutRange(self.artifactID)
            if dist < ItemsUtils.EXTRACTION_RANGE:
                color = (255, 255, 255, 255)
            else:
                color = (255, 150, 255, 255)
            show_range = ItemsUtils.DETECTOR_RANGE
            player_position = BigWorld.player().position
            matrix = Math.Matrix()
            matrix.setRotateYPR((-player.yaw, 0, 0))
            pos = matrix.applyVector(art_vect) / show_range
            self.component.position = (pos[0], pos[2], 0.0)
            self.component.visual.colour = color

        return

    @BWMemberCoroutine
    def blinkLoop(self):
        yield BWWaitForPeriod(1.8)
        while self.component.visible:
            self.component.visual.fader.alpha = 0
            yield BWWaitForPeriod(2.5)
            self.component.visual.fader.alpha = 1.0
            self.component.visual.fader.reset()


