    def _updateFuelIndicator(self):
        if time.time() - self._last_indicator_time < 1.0:
            return
        else:
            self._last_indicator_time = time.time()
            player = BigWorld.player()
            ae = getattr(player, 'artefactExtractor', None)
            if not ae:
                return
            item_dict = ae.item_dict
            count = ItemsUtils.GetBatteryLevel(item_dict)
            max_count = ItemsUtils.GetMaxBatteryLevel(item_dict)
            off = count <= 0
            if not off and self.component.red_indicator.visible:
                player.cell.append_to_battery_consumers(item_dict['complexItemID'])
            self.component.red_indicator.visible = off
            self.component.dark_fon.visible = off
            self.component.text_fuel.text = '%.1f%%' % (100.0 * count / max_count)
            if off:
                self._red_ind_shad.alpha = 1.0
                self._red_ind_shad.reset()
                self._red_ind_shad.alpha = 0.0
            self.component.button_light1.visible = not off
            self.component.button_light2.visible = not off
            self.component.lamp_bottom.visible = not off
            self._fuel_full = not off
            return

    def renderContents(self, slider = True, points = True, keyBinds = True, select = True, status = True):
        try:
            self._updateFuelIndicator()
        except:
            traceback.print_exc()

        if slider:
            cmp = self.component.sliderHolder.timeSlider
            hPos = self.sliderData * 2.0 - 1.0
            cmp.position = (hPos, 1.0, 0.8)
        if not self._fuel_full and self.points:
            self._clearPoints()
        self.component.radarHolder.spotLine.visible = self._fuel_full
        points = True
        if points:
            for anomaly_id, point_comp in self.points.items():
                if anomaly_id not in self.QTEdata:
                    point_comp.visible = False
                    self.component.radarHolder.delChild(point_comp)
                    del self.points[anomaly_id]

            if self._fuel_full:
                for anomaly_id, anomaly_pos in self.QTEdata.items():
                    if anomaly_id not in self.points:
                        pointObj = soArtifactPoint(GUI.Window(), self)
                        cmp = pointObj.component
                        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
                        self.component.radarHolder.addChild(cmp, 'point' + str(anomaly_id))
                        pointObj.onBound()
                        pointObj.setID(anomaly_id)
                        pointObj.onClick = partial(self.processPoint, anomaly_id)
                        self.points[anomaly_id] = cmp
                        cmp.position = (anomaly_pos[0], anomaly_pos[1], 0.0)

        if keyBinds:
            if len(self.keyData) < 5:
                for i in xrange(5):
                    cmp = self.component.__getattribute__('key' + str(i))
                    cmp.visible = False

            i = 0
            for key_name, key_visible, key_presses in self.keyData:
                cmp = self.component.__getattribute__('key' + str(i))
                cmp.textureName = self.KEYMAP[key_name]
                cmp.visible = key_visible
                cmp.colour[3] = 255 if key_presses else 100
                i += 1

        if select:
            if hasattr(self.component.radarHolder, 'point' + str(self.selectorData)):
                cmp = self.component.radarHolder.__getattribute__('point' + str(self.selectorData))
                cmp.script.select()
        if status:
            self.component.statusMarker.textureName = self.STATUSMAP[self.status]

    def onGameNotify(self, notify_id, data = None):
        if notify_id == self.NOTIFY_ERROR_DIST:
            self.onGameStatus(self.STATUS_FAIL)
        elif notify_id == self.NOTIFY_START_GAME:
            for anomaly_id, point_comp in self.points.items():
                listen_out_range = data == anomaly_id
                point_comp.script.listenOutRange(listen_out_range)

    def onPointOutRange(self, anomaly_id):
        self.points[anomaly_id].script.listenOutRange(False)
        player = BigWorld.player()
        ae = getattr(player, 'artefactExtractor', None)
        if not ae:
            return
        else:
            ae.stopGame()
            self.onGameNotify(self.NOTIFY_ERROR_DIST)
            player.putMessage(CHANNEL_CONSTS.SYSTEM, lc('soArtifactQTE.ERROR_DIST'))
            return

    _to_idle_id = 0

    def onGameStatus(self, status, data = None):
        if self._to_idle_id:
            BigWorld.cancelCallback(self._to_idle_id)
        STATUSMAP_LAMP = {self.STATUS_IDLE: (0, 0, 0, 0),
         self.STATUS_PREPARATION: (255, 255, 0, 255),
         self.STATUS_PLAY: (0, 0, 0, 0),
         self.STATUS_FAIL: (255, 0, 0, 255),
         self.STATUS_WIN: (0, 255, 0, 255)}
        STATUSMAP_BTN = {self.STATUS_IDLE: (255, 0, 0, 0),
         self.STATUS_PREPARATION: (255, 255, 0, 255),
         self.STATUS_PLAY: (255, 0, 0, 0),
         self.STATUS_FAIL: (255, 0, 0, 255),
         self.STATUS_WIN: (0, 255, 0, 255)}
        self.component.button_light1.colour = STATUSMAP_BTN[status]
        self.component.button_light2.colour = STATUSMAP_BTN[status]
        self.component.lamp_bottom.colour = STATUSMAP_LAMP[status]

        def toIdel():
            self._to_idle_id = 0
            self.onGameStatus(self.STATUS_IDLE)
            self._clearPoints()

        if status in (self.STATUS_FAIL, self.STATUS_WIN):
            self._to_idle_id = BigWorld.callback(0.5, toIdel)

    def update(self):
        data = BWPersonality.GUICore.artifactQTEDataSection
        slider, points, keyBinds, select, status = (False,
         False,
         False,
         False,
         False)
        if self.sliderData != data['slider']:
            self.sliderData = data['slider']
            slider = True
        if self.QTEdata != data['QTEdata']:
            self.QTEdata = deepcopy(data['QTEdata'])
            points = True
        if self.keyData != data['keyData']:
            self.keyData = deepcopy(data['keyData'])
            keyBinds = True
        if self.selectorData != data['selector']:
            self.selectorData = data['selector']
            select = True
        if self.status != data['QTEStatus']:
            self.status = data['QTEStatus']
            status = True
        self.renderContents(slider, points, keyBinds, select, status)

    def processPoint(self, point):
        if self.status not in (self.STATUS_PLAY, self.STATUS_PREPARATION):
            BWPersonality.GUICore.artifactQTEEvent(self.EVENT_SELECT, point)

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'artifactQTE')
        self.component.visible = True
        self.spotlineLoop()
        BWPersonality.GUICore.setBestCursor()
        self.component.text_fuel.text = ''
        self._red_ind_shad.alpha = 0.0
        self._red_ind_shad.reset()
        self._red_ind_shad.alpha = 0.0
        return

    def hide(self):
        self.spotlineStop()
        self.component.visible = False
        off = True
        self._fuel_full = not off
        self.component.red_indicator.visible = off
        self.component.dark_fon.visible = off
        self.component.button_light1.visible = not off
        self.component.button_light2.visible = not off
        self.component.lamp_bottom.visible = not off
        self._clearPoints()
        self.QTEdata = {}
        BWPersonality.GUICore.setBestCursor()
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_CLOSED, None)
        return

    def _clearPoints(self):
        for anomaly_id, point_comp in self.points.items():
            point_comp.visible = False
            self.component.radarHolder.delChild(point_comp)

        self.points = {}

    def scanComplete(self):
        BWPersonality.GUICore.artifactQTEEvent(self.EVENT_SCANNED, None)
        return

    def spotlineStop(self):
        if self._spotlineLoop_id:
            BigWorld.cancelCallback(self._spotlineLoop_id)
        self._spotlineLoop_id = 0

    def spotlineLoop(self):
        """ (???) \xd0\xa1\xd0\xbe\xd0\xbf\xd1\x80\xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbc\xd0\xbc\xd0\xb0 \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x87\xd0\xb0\xd1\x8e\xd1\x89\xd0\xb0\xd1\x8f \xd0\xb7\xd0\xb0 \xd1\x86\xd0\xb8\xd0\xba\xd0\xbb \xd0\xbf\xd0\xbe\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0."""
        pixStartPoint = self.component.radarHolder.localToScreen((0, 0))
        startPoint = pixStartPoint[1]
        pixEndPoint = self.component.radarHolder.localToScreen((0, self.component.radarHolder.height + self.component.radarHolder.spotLine.height))
        offset = startPoint - pixEndPoint[1]
        self.spotlineStop()

        def __tick():
            if not self.component.visible:
                return
            self.spotlineMP.translation = (0, 0, 0)
            self.component.radarHolder.spotLine.mover.reset()
            self.scanComplete()
            self._spotlineLoop_id = BigWorld.callback(2.5, __tick)
            self.component.radarHolder.spotLine.mover.eta = 1.2
            self.spotlineMP.translation = (0, -offset, 0)

        __tick()

    def _loop_test_line(self):
        self.component.radarHolder.spotLine.mover

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('soArtifactQTE.hintBox', lc('soArtifactQTE.MANUAL_TITLE'), colorCodes.tf3_regular_text_color + lc('soArtifactQTE.MANUAL_TEXT'))

    @PyGUIEvent('closeBox', 'onClick')
    def oncloseBox(self):
        self.hide()
        BWPersonality.GUICore.setMouseAltState(False)
        BWPersonality.GUICore.setBestCursor()

    def handleDragStartEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        x, y = BWPersonality.game.mcursor.position
        delta_x = self.component.position[0] - x
        delta_y = self.component.position[1] - y
        self._deltaposition = (delta_x, delta_y)
        self._repeatMoveToCursor()
        return True

    def handleDragStopEvent(self, component):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82, \xd0\xba\xd0\xbe\xd0\xb3\xd0\xb4\xd0\xb0 \xd0\xbe\xd1\x82\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x88\xd1\x8c \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82."""
        if self._clbID:
            BigWorld.cancelCallback(self._clbID)
        return True

    def _moveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5\xd0\xbc \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80\xd0\xb0 \xd0\xbc\xd0\xb8\xd1\x88\xd0\xb8."""
        x, y = BWPersonality.game.mcursor.position
        sW, sH = BigWorld.screenSize()
        x_position = self._deltaposition[0] + x
        x = max(-1.2, min(x_position, 1.2 - 2 * self.component.width / sW))
        y_position = self._deltaposition[1] + y
        y = min(1.5 - self.component.height / sH, max(y_position, -1.9 + self.component.height / sH))
        self.component.position = (x, y, self.component.position[2])

    def _repeatMoveToCursor(self):
        """\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xbf\xd0\xbe\xd0\xbd\xd0\xb5\xd0\xbd\xd1\x82 \xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb7 \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb0\xd0\xbb."""
        if not self.component.visible:
            return
        elif self.component.parent is None:
            return
        else:
            self._moveToCursor()
            self._clbID = BigWorld.callback(0.01, self._repeatMoveToCursor)
            return