        value = self.vScroll.getValue()
        value = max(0, value - 1)
        self.set_scroll_value(value)

    def scrollDown(self):
        value = self.vScroll.getValue()
        value = min(value + 1, self.vScroll.steps)
        self.set_scroll_value(value)

    def set_scroll_value(self, value):
        self.vScroll.setValue(value)
        comp = self.getHolderComponent()
        if comp:
            comp.scroll.y = value * 2.0 / (BigWorld.screenHeight() / (self.SKILL_BOX_HEIGHT + self.SKILL_BOX_INTERVAL))

