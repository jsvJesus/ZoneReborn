    def onTextureLoaded(self, resource):
        self.component.skillIcon.texture = resource[self.texture]

    def _applyItemData(self):
        skillGUI = self.component.parent.parent.script
        if self.haveItem():
            self.texture = skillGUI.texturing_callback(self.itemData['id'])
            if self.texture:
                try:
                    BigWorld.loadResourceListBG([self.texture], self.onTextureLoaded)
                except:
                    print 'soSkillScreen::error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

            self.setState(skillGUI.skill_state_callback(self.itemData['id']))
        else:
            self.texture = ''
            self.component.skillIcon.textureName = ''
            self.setState()
        self.dragProxy.texture = self.component.skillIcon.texture

    def onDragStart(self):
        skillGUI = self.component.parent.parent.script
        if self.haveItem():
            if skillGUI.skill_type_callback(self.itemData['id']) == LEVELING.TYPE_ABILITY:
                self.dragProxy.visible = True
                return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

