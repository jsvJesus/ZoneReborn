        comp.position = (7, 92, 0.0)
        comp.visible = False
        self.component.addChild(comp, 'combatWnd')

    def setupSurvWnd(self):
        self.survWnd = GUI.Window()
        comp = self.survWnd
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.width = 532
        comp.height = 250 + self.SHOW_HEIGHT * 2 + 5
        comp.textureName = ''
        comp.position = (7, 92, 0.0)
        comp.visible = False
        self.component.addChild(comp, 'survWnd')

    def setupSupportWnd(self):
        self.supportWnd = GUI.Window()
        comp = self.supportWnd
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.width = 532
        comp.height = 250 + self.SHOW_HEIGHT * 2 + 5
        comp.textureName = ''
        comp.position = (7, 92, 0.0)
        comp.visible = False
        self.component.addChild(comp, 'supportWnd')

    def update(self):
        self.skillsUpdate(None)
        return

    def skillsUpdate(self, skillsData):
        firstTime = False
        if not len(self.combatSkills) and not len(self.survivalSkills) and not len(self.craftSkills):
            firstTime = True
        self.combatSkills = BWPersonality.GUICore.skillsDataSection['Combat']
        self.survivalSkills = BWPersonality.GUICore.skillsDataSection['Survival']
        self.supportSkills = BWPersonality.GUICore.skillsDataSection['Other']
        SKILL, EXP, LEVEL, POINTS, PERKS = range(5)
        SKILL_NUM_TABLE = {'Combat': (self.component.tab0,
                    soSkillScreen2.TAB_COMBAT,
                    self.combatWnd,
                    self.combatSkills),
         'Survival': (self.component.tab1,
                      soSkillScreen2.TAB_SURVIVAL,
                      self.survWnd,
                      self.survivalSkills),
         'Other': (self.component.tab2,
                   soSkillScreen2.TAB_SUPPORT,
                   self.supportWnd,
                   self.supportSkills)}

        def setupSkill(skill_type):
            skill_tab_component, skill_tab_type, skill_window, skills_by_type_list = SKILL_NUM_TABLE[skill_type]
            i = 0
            skills_by_type = skills_by_type_list[SKILL]
            for skill in skills_by_type:
                if skill in CharacterConst.deleted_skills:
                    continue
                skill_value = skills_by_type[skill]['Value']
                SkillTabWindow = SoSkillTab(skill_type, skill, SKILL, POINTS)
                self.skill_tabs.add(SkillTabWindow)
                skillTab = SkillTabWindow.component
                skillTab.horizontalPositionMode = skillTab.verticalPositionMode = 'CLIP'
                skillTab.widthMode = skillTab.heightMode = 'PIXEL'
                skillTab.horizontalAnchor = 'LEFT'
                skillTab.verticalAnchor = 'TOP'
                skillTab.width = skill_window.width - 16
                skillTab.height = self.SKILL_BOX_HEIGHT
                skillTab.crossFocus = True
                skillTab.position = (-1.0, 1.0 - soGUI.getPixelHeight(skill_window) * (self.SKILL_BOX_HEIGHT + self.SKILL_BOX_INTERVAL) * i, 0.0)
                skillTab.mapping = ((0.0, 0.6666666),
                 (0.0, 1.0),
                 (1.0, 1.0),
                 (1.0, 0.6666666))

                def onTextureLoaded(tab, texture_name, resource):
                    tab.texture = resource[texture_name]

                try:
                    BigWorld.loadResourceListBG(['soGUI/maps/Controls/skills/skillBack.tga'], partial(onTextureLoaded, skillTab, 'soGUI/maps/Controls/skills/skillBack.tga'))
                except:
                    print 'soSkillScreen::error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

                skillFriendlyName = lc(CharacterUtils.GetSkillFriendlyName(skill))
                skillName = GUI.Text(skillFriendlyName)
                skillName.verticalPositionMode = skillName.horizontalPositionMode = 'CLIP'
                skillName.horizontalAnchor = 'LEFT'
                skillName.verticalAnchor = 'TOP'
                skillName.colour = (255, 255, 255, 255)
                skillName.materialFX = 'BLEND'
                skillName.font = 'ruRU_calibri_small.font'
                skillName.position = (-1.0 + soGUI.getPixelWidth(skillTab) * 8, 1.0 - soGUI.getPixelHeight(skillTab) * 10, 0.0)
                skillTab.addChild(skillName, 'label')
                plusBtn = soButton(GUI.Window())
                plusBtn.soundControlName = 'PlusMinusBtn'
                plusCmp = plusBtn.component
                plusCmp.horizontalPositionMode = plusCmp.verticalPositionMode = 'CLIP'
                plusCmp.widthMode = plusCmp.heightMode = 'PIXEL'
                plusCmp.horizontalAnchor = 'RIGHT'
                plusCmp.verticalAnchor = 'TOP'
                plusCmp.width = self.SMALL_BTN_SIZE
                plusCmp.height = self.SMALL_BTN_SIZE
                plusCmp.position = (1.0 - soGUI.getPixelWidth(skillTab) * 12, 1.0 - soGUI.getPixelHeight(skillTab) * 12, 0.0)
                plusBtn.initVSC('soGUI/visual_styles/plusBtn.xml')
                plusBtn.onBound()
                plusBtn.setVisualState('normal')
                plusBtn.onClick = partial(self.learnSkill, skill, 1)
                skillTab.addChild(plusCmp, 'plus')
                minusBtn = soButton(GUI.Window())
                minusBtn.soundControlName = 'PlusMinusBtn'
                minusCmp = minusBtn.component
                minusCmp.horizontalPositionMode = minusCmp.verticalPositionMode = 'CLIP'
                minusCmp.widthMode = minusCmp.heightMode = 'PIXEL'
                minusCmp.horizontalAnchor = 'RIGHT'
                minusCmp.verticalAnchor = 'TOP'
                minusCmp.width = self.SMALL_BTN_SIZE
                minusCmp.height = self.SMALL_BTN_SIZE
                minusCmp.position = (1.0 - soGUI.getPixelWidth(skillTab) * 62, 1.0 - soGUI.getPixelHeight(skillTab) * 12, 0.0)
                minusBtn.initVSC('soGUI/visual_styles/minusBtn.xml')
                minusBtn.onBound()
                minusBtn.buttonDisabled = True
                minusBtn.setVisualState('disabled')
                skillTab.addChild(minusCmp, 'minus')
                skillPoints = GUI.Text('')
                skillPoints.verticalPositionMode = skillPoints.horizontalPositionMode = 'CLIP'
                skillPoints.horizontalAnchor = 'CENTER'
                skillPoints.verticalAnchor = 'TOP'
                skillPoints.colour = (255, 255, 255, 255)
                skillPoints.materialFX = 'BLEND'
                skillPoints.font = 'ruRU_calibri_default.font'
                skillPoints.position = (1.0 - soGUI.getPixelWidth(skillTab) * 44, 1.0 - soGUI.getPixelHeight(skillTab) * 10, 0.0)
                skillPoints.text = str(skills_by_type[skill]['Value'])
                skillTab.addChild(skillPoints, 'skillPoints')
                for j in xrange(self.PERKS_PER_SKILL):
                    featSlot = soFeatSlot(GUI.Window(), SkillTabWindow, button_num=j)
                    featCmp = featSlot.component
                    featCmp.horizontalPositionMode = featCmp.verticalPositionMode = 'CLIP'
                    featCmp.widthMode = featCmp.heightMode = 'PIXEL'
                    featCmp.horizontalAnchor = 'LEFT'
                    featCmp.verticalAnchor = 'TOP'
                    featCmp.textureName = 'soGUI/maps/Colours/white.tga'
                    slotWidth = (skillTab.width - 8) / self.PERKS_PER_SKILL
                    featCmp.width = slotWidth
                    featCmp.height = self.FEATSLOT_HEIGHT
                    featCmp.position = (-1.0 + soGUI.getPixelWidth(skillTab) * (slotWidth * j + 4), 1.0 - soGUI.getPixelHeight(skillTab) * 37, 0.2)
                    featCmp.colour = (255, 255, 255, 255)
                    featCmp.materialFX = 'BLEND'
                    featSlot.initVSC('soGUI/visual_styles/featSlot.xml')
                    featSlot.onBound()
                    featSlot.setVisualState('unknown')
                    skillTab.addChild(featCmp, 'featSlot' + str(j))
                    btn = soLearnFeatBtn(GUI.Window(), SkillTabWindow)
                    comp = btn.component
                    comp.verticalPositionMode = comp.horizontalPositionMode = 'CLIP'
                    comp.widthMode = comp.heightMode = 'PIXEL'
                    comp.horizontalAnchor = 'CENTER'
                    comp.verticalAnchor = 'CENTER'
                    comp.width = slotWidth - 4
                    comp.height = self.FEATSLOT_HEIGHT - 4
                    comp.position = (0.0, 0.0, 0.0)
                    btn.onClick = partial(self.learnFeat, skill_type, skill, j, 1)
                    btn.initVSC('soGUI/visual_styles/learnFeatBtn.xml')
                    btn.onBound()
                    btn.buttonDisabled = False
                    btn.setVisualState('normal')
                    featCmp.addChild(btn.component, 'feat' + str(j))

                def createProgressBar(is_relative = False, color = None):
                    progressBar = GUI.Window()
                    progressBar.horizontalPositionMode = 'PIXEL'
                    progressBar.verticalPositionMode = 'CLIP'
                    progressBar.widthMode = progressBar.heightMode = 'PIXEL'
                    progressBar.horizontalAnchor = 'LEFT'
                    progressBar.verticalAnchor = 'TOP'
                    progressBar.width = skillTab.width - 8
                    progressBar.height = self.FEATSLOT_HEIGHT - 3
                    pixels_per_skill_point = progressBar.width / CharacterConst.MAX_SKILL_VALUE_SUPER
                    shift_rel = skill_value * pixels_per_skill_point
                    shift = int(shift_rel) if is_relative else 0
                    progressBar.position = (4 + shift, 1.0 - soGUI.getPixelHeight(skillTab) * 39, 0.1)
                    if color is None:
                        progressBar.colour = (255, 255, 255, 125)
                    else:
                        progressBar.colour = color
                    progressBar.materialFX = 'BLEND'
                    progressClipShader = GUI.ClipShader()
                    progressClipShader.mode = 'RIGHT'
                    progressClipShader.value = skill_value / CharacterConst.MAX_SKILL_VALUE_SUPER if not is_relative else 0.0
                    progressBar.addShader(progressClipShader, 'clipper')
                    if color is None:
                        progressBar.textureName = 'soGUI/maps/Colours/darkGreen.bmp'
                    else:
                        progressBar.textureName = 'soGUI/maps/Colours/white.tga'
                    progressBar.tiled = True
                    progressBar.tileHeight = progressBar.tileWidth = 1
                    return progressBar

                progress_skill_bar = createProgressBar()
                skillTab.addChild(progress_skill_bar, 'skillProgress')
                progress_add_bar = createProgressBar(is_relative=True, color=(255, 240, 0, 125))
                SkillTabWindow.progress_bar = progress_add_bar
                skillTab.addChild(progress_add_bar, 'skillProgressAdd')
                skill_window.addChild(skillTab, str(skill))
                i += 1

            return

        def updateSkill(skill_type):
            skill_tab_component, skill_tab_type, skill_window, skills_by_type_list = SKILL_NUM_TABLE[skill_type]
            avatar_level = BWPersonality.GUICore.skillsDataSection[skill_type][LEVEL]
            skill_tab_component.label.text = self.TAB_LABELS[skill_tab_type] + ' ' + str(avatar_level)
            skills_by_type = skills_by_type_list[0]
            for skill in skills_by_type:
                if skill in CharacterConst.deleted_skills:
                    continue
                comp = skill_window.__getattribute__(skill)
                comp.skillPoints.text = str(skills_by_type[skill]['Value'])
                comp.skillProgress.clipper.value = 1.0 / (120.0 / float(skills_by_type[skill].get('Value', 10)))
                comp.script.updateProgressBarPosition()
                for i in xrange(self.PERKS_PER_SKILL):
                    featSlot = comp.__getattribute__('featSlot' + str(i))
                    featBtn = comp.__getattribute__('featSlot' + str(i)).__getattribute__('feat' + str(i))
                    status = BigWorld.player().GetPerkStatus(skill_type, skill, i)
                    featBtn.script.toolTipID = (skill_type, skill, i)
                    featBtn.script.interfaceID = BWPersonality.GUICore.GUI_ID_SKILLS
                    if status == CharacterConst.PERK_STATUS_LOCKED:
                        featSlot.position.z = 0.2
                        featBtn.script.buttonDisabled = True
                        featBtn.script.setVisualState('disabled')
                        featSlot.script.setVisualState('unknown')
                    elif status == CharacterConst.PERK_STATUS_KNOWN:
                        featSlot.position.z = 0.0
                        featBtn.script.buttonDisabled = True
                        featBtn.script.setVisualState('disabled')
                        featSlot.script.setVisualState('learnt')
                    elif status == CharacterConst.PERK_STATUS_KNOWN_CAN_TAKE:
                        featSlot.position.z = 0.2
                        featBtn.script.buttonDisabled = False
                        featBtn.script.setVisualState('normal')
                        featSlot.script.setVisualState('learning')
                    elif status == CharacterConst.PERK_STATUS_CAN_TAKE:
                        featSlot.position.z = 0.2
                        featBtn.script.buttonDisabled = False
                        featBtn.script.setVisualState('normal')
                        featSlot.script.setVisualState('learning')
                    icon = BigWorld.player().GetPerkIcon(skill_type, skill, i)
                    if icon != '':

                        def __onTextureLoaded(cmp, texture_name, resource):
                            cmp.texture = resource[texture_name]

                        iconCmp = GUI.Simple('')
                        try:
                            BigWorld.loadResourceListBG([icon], partial(__onTextureLoaded, iconCmp, icon))
                        except:
                            print 'soSkillScreen::error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

                        iconCmp.verticalPositionMode = iconCmp.horizontalPositionMode = 'CLIP'
                        iconCmp.widthMode = iconCmp.heightMode = 'PIXEL'
                        iconCmp.horizontalAnchor = iconCmp.verticalAnchor = 'CENTER'
                        iconCmp.width = 38
                        iconCmp.height = 38
                        iconCmp.colour = (255, 255, 255, 255)
                        iconCmp.materialFX = 'BLEND'
                        featSlot.addChild(iconCmp, 'featIcon')

            GUI.reSort()

        if firstTime:
            for skill_type_str in ['Combat', 'Survival', 'Other']:
                setupSkill(skill_type_str)

        for skill_type_str in ['Combat', 'Survival', 'Other']:
            updateSkill(skill_type_str)

        self.updateTreeInfo()
        self.updateScroll()

    def updateTreeInfo(self):
        SKILL, EXP, LEVEL, POINTS, PERKS = range(5)
        tabName = 'Combat'
        prev_level = 0
        level_up_exp = 1
        player = BigWorld.player()
        if self.currentTab == self.TAB_COMBAT:
            tabName = 'Combat'
            prev_level = player.CharacterCombatLevel - 1
            level_up_exp = CharacterUtils.GetLevelUpExp(player.CharacterCombatLevel)
        elif self.currentTab == self.TAB_SURVIVAL:
            tabName = 'Survival'
            prev_level = player.CharacterSurvivalLevel - 1
            level_up_exp = CharacterUtils.GetLevelUpExp(player.CharacterSurvivalLevel)
        elif self.currentTab == self.TAB_SUPPORT:
            tabName = 'Other'
            prev_level = player.CharacterOtherLevel - 1
            level_up_exp = CharacterUtils.GetLevelUpExp(player.CharacterOtherLevel)
        expa = BWPersonality.GUICore.skillsDataSection[tabName][EXP]
        free_sp = BWPersonality.GUICore.skillsDataSection[tabName][POINTS]
        pps = BWPersonality.GUICore.skillsDataSection[tabName][PERKS]
        self.component.expa.text = lc('soSkillScreen.soGUI.STRING_1767_29') % utils.groupNumber(expa, '`')
        self.component.freeSP.text = lc('soSkillScreen.soGUI.STRING_1768_31') % free_sp
        self.component.pps.text = lc('soSkillScreen.soGUI.STRING_1769_28') % pps
        level_prev_exp = CharacterUtils.GetLevelUpExp(prev_level) if prev_level > 0 else 0
        self.component.expa_progress_value.clipper.value = float(expa - level_prev_exp) / (level_up_exp - level_prev_exp)

    def getTabCount(self):
        if self.currentTab == self.TAB_COMBAT:
            if self.combatSkills:
                return len(self.combatSkills[0])
            return 0
        if self.currentTab == self.TAB_SURVIVAL:
            if self.survivalSkills:
                return len(self.survivalSkills[0]) - len(CharacterConst.deleted_skills)
            return 0
        if self.currentTab == self.TAB_SUPPORT:
            if self.supportSkills:
                return len(self.supportSkills[0])
            return 0
        return 0

    def getHolderHeight(self):
        if self.currentTab == self.TAB_COMBAT:
            if self.combatWnd:
                return self.combatWnd.height
            return 0
        if self.currentTab == self.TAB_SURVIVAL:
            if self.survWnd:
                return self.survWnd.height
            return 0
        if self.currentTab == self.TAB_SUPPORT:
            if self.supportWnd:
                return self.supportWnd.height
            return 0
        return 0

    def getHolderComponent(self):
        if self.currentTab == self.TAB_COMBAT:
            return self.combatWnd
        elif self.currentTab == self.TAB_SURVIVAL:
            return self.survWnd
        elif self.currentTab == self.TAB_SUPPORT:
            return self.supportWnd
        else:
            return None

    def updateScroll(self):
        count = self.getTabCount() - 4
        comp = self.getHolderComponent()
        if comp:
            comp.maxScroll = (0, count * 2.0 / (BigWorld.screenHeight() / (self.SKILL_BOX_HEIGHT + self.SKILL_BOX_INTERVAL)))
        self.vScroll.setSteps(count)

    def learnSkill(self, skillName, value = 1):
        BWPersonality.GUICore.skillEvent((skillName, value), self.EVENT_LEARNSKILL)

    def learnFeat(self, treeName, skillName, featNumber, value):
        BWPersonality.GUICore.skillEvent((treeName,
         skillName,
         featNumber,
         value), self.EVENT_LEARNFEAT)
        return True

    def handleMouseEvent(self, comp, event):
        dz = event.dz
        if dz > 0:
            self.scrollUp()
            return True
        if dz < 0:
            self.scrollDown()
            return True
        return False

    def handleMouseButtonEvent(self, comp, event):
        return DraggableComponent.handleMouseButtonEvent(self, comp, event)

    @PyGUIEvent('closeBox', 'onClick')
    def onCloseBox(self):
        self.hide()

    @PyGUIEvent('hintBox', 'onClick')
    def onHintBox(self):
        """\xd0\xa1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb8 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb8 \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb8-\xd0\xbf\xd0\xbe\xd0\xb4\xd1\x81\xd0\xba\xd0\xb0\xd0\xb7\xd0\xba\xd0\xb8."""
        text_and_ok('soSkillScreen.hintBox', lc('soSkillScreen.soGUI.MANUAL_TITLE'), colorCodes.tf3_regular_text_color + lc('soSkillScreen.soGUI.MANUAL_TEXT'))


class soSpecListElem(soList2ElementBase):
    factoryString = 'soGUI.soSpecListElem'
    EVENT_ACTIVATE = 0
    EVENT_DEACTIVATE = 1
    EVENT_INVEST = 2

    def __init__(self, component, id, data):
        soList2ElementBase.__init__(self, component, id, data)
        component.script = self
        self.pressed = False

    def setupRoot(self):
        soList2ElementBase.setupRoot(self)
        comp = self.component
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = 323
        comp.height = 26
        comp.position.x = 0
        comp.position.z = 0.1
        comp.horizontalAnchor = 'LEFT'

    def setupContent(self):
        comp = GUI.Simple('soGUI/maps/Colours/white.tga')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'CLIP'
        comp.widthMode = comp.heightMode = 'CLIP'
        comp.horizontalAnchor = comp.verticalAnchor = 'CENTER'
        comp.colour = (28, 28, 28, 255)
        comp.materialFX = 'BLEND'
        comp.width = comp.height = 2.0
        comp.position = (0.0, 0.0, 0.9)
        comp.script = self
        self.component.addChild(comp, 'backFrame')
        btn = soButtonWTT(GUI.Window(''), 'leveling_gui_invest_experience')
        comp = btn.component
        comp.verticalPositionMode = comp.horizontalPositionMode = 'PIXEL'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.width = 18
        comp.height = 18
        comp.position = (283, 4, 0.4)
        btn.initVSC('soGUI/visual_styles/arrow_up.xml')
        btn.onBound()
        btn._updateVisualState()
        btn.onClick = self._btnHandler
        self.component.addChild(comp, 'btn')
        comp = GUI.Text('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = comp.verticalAnchor = 'CENTER'
        comp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (140, 13, 0.4)
        comp.colourFormatting = False
        comp.multiline = False
        comp.text = self.elemData['spec_name']
        self.component.addChild(comp, 'specName')
        comp = GUI.Text('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'CENTER'
        comp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (10, 13, 0.4)
        comp.colourFormatting = False
        comp.multiline = False
        comp.text = u'x{0}\\{1}'.format(self.elemData['modifier'][0], self.elemData['modifier'][1])
        self.component.addChild(comp, 'modifier')
        comp = GUI.Text('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'RIGHT'
        comp.verticalAnchor = 'CENTER'
        comp.font = 'ruRU_Cyrvetica_Extra_12i.font'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (276, 13, 0.4)
        comp.colourFormatting = False
        comp.multiline = False
        comp.text = str(self.elemData['spec_points']).encode('utf-8')
        self.component.addChild(comp, 'specPoints')

    def _btnHandler(self):
        self.activate(True)
        self.elementEvent(self.EVENT_INVEST, self)

    def enable(self):
        self.component.btn.script.buttonDisabled = False
        self.component.btn.script._updateVisualState()
        return False

    def disable(self):
        self.component.btn.script.buttonDisabled = True
        self.component.btn.script._updateVisualState()
        return False

    def activate(self, byUser = True):
        self.component.backFrame.colour = (45, 45, 30, 255)
        if byUser:
            self.elementEvent(self.EVENT_ACTIVATE, self)
        return False

    def deactivate(self, byUser = True):
        self.component.backFrame.colour = (28, 28, 28, 255)
        if byUser:
            self.elementEvent(self.EVENT_DEACTIVATE, self)
        return False

    def applyElemData(self):
        self.component.specName.text = self.elemData['spec_name']
        self.component.specPoints.text = self.elemData['spec_points']
        self.component.modifier.text = u'x{0}\\{1}'.format(self.elemData['modifier'][0], self.elemData['modifier'][1])

    def onClick(self):
        self.activate(True)

    def handleMouseButtonEvent(self, comp, event):
        if event.key == KEY_LEFTMOUSE:
            if event.isKeyDown() and not self.pressed:
                self.pressed = True
            elif not event.isKeyDown() and self.pressed:
                self.pressed = False
                self.onClick()
        return True


class soBSkillSlot(soItemSlot):
    factoryString = 'soGUI.soBSkillSlot'
    SLOTWIDTH = 64
    SLOTHEIGHT = 64
    normalFrame = BigWorld.PyTextureProvider('soGUI/maps/Controls/inventory/cellFrame2.tga')
    selFrame = BigWorld.PyTextureProvider('soGUI/maps/Controls/skills/20/selFrame.tga')
    canLearn = BigWorld.PyTextureProvider('soGUI/maps/Controls/skills/20/canLearn.tga')
    cantLearn = BigWorld.PyTextureProvider('soGUI/maps/Controls/skills/20/cantLearn.tga')
    unaccessible = BigWorld.PyTextureProvider('soGUI/maps/Controls/skills/20/unaccessible.tga')

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self
        self.texture = ''

    def setupRoot(self):
        comp = self.component
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.dragFocus = False
        comp.dropFocus = False
        comp.crossFocus = True
        comp.moveFocus = False

    def setupContent(self):
        comp = GUI.Frame2('')
        comp.verticalPositionMode = comp.horizontalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.9)
        comp.texture = soBSkillSlot.normalFrame
        self.component.addChild(comp, 'frameCmp')
        comp = GUI.Frame2('')
        comp.verticalPositionMode = comp.horizontalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.1)
        comp.texture = soBSkillSlot.selFrame
        comp.visible = False
        self.component.addChild(comp, 'selFrame')
        comp = GUI.Simple('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.4)
        self.component.addChild(comp, 'skillIcon')
        comp = GUI.Frame2('soGUI/maps/Colours/white.tga')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (255, 255, 255, 255)
        comp.visible = False
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.3)
        self.component.addChild(comp, 'skillState')

    def onTextureLoaded(self, resource):
        self.component.skillIcon.texture = resource[self.texture]

    def _applyItemData(self):
        skillGUI = self.component.parent.parent.script
        if self.haveItem():
            self.texture = skillGUI.texturing_callback(self.itemData['id'])
            if self.texture:
                try:
                    BigWorld.loadResourceListBG([self.texture], self.onTextureLoaded)
                except:
                    print 'soSkillScreen::error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

            self.setState(skillGUI.skill_state_callback(self.itemData['id']))
        else:
            self.texture = ''
            self.component.skillIcon.textureName = ''
            self.setState()

    def select(self, doSel = True):
        self.component.selFrame.visible = doSel

    def setState(self, state = LEVELING.STATE_LEARNED):
        self.component.skillState.visible = False
        if state == LEVELING.STATE_CANTLEARN:
            self.component.skillState.texture = soBSkillSlot.cantLearn
            self.component.skillState.visible = True
        elif state == LEVELING.STATE_CANLEARN:
            self.component.skillState.texture = soBSkillSlot.canLearn
            self.component.skillState.visible = True
        elif state == LEVELING.STATE_UNACCESSIBLE:
            self.component.skillState.texture = soBSkillSlot.unaccessible
            self.component.skillState.visible = True


