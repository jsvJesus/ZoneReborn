class soFeatSlot(PyGUI.PyGUIBase, soVisualStateComponent, soToolTipComponent):
    factoryString = 'soGUI.soFeatSlot'
    visualStateString = 'soGUI.soButtonVisualState'

    def __init__(self, component, parent, button_num):
        PyGUI.PyGUIBase.__init__(self, component)
        soVisualStateComponent.__init__(self, component, soFeatSlot.visualStateString)
        soToolTipComponent.__init__(self, component, None)
        component.script = self
        self.buttonIcon = self.component
        self.interfaceID = BWPersonality.GUICore.GUI_ID_SKILLS
        self.parent = parent
        self.button_num = button_num
        return

    def updateProgressBar(self):
        skill_value = self.parent.skill_value
        skill_points = self.parent.skill_points
        skill_target = (self.button_num + 1) * 10
        skill_increment = max(0, skill_target - skill_value)
        skill_value_add = min(skill_points, skill_increment, CharacterConst.MAX_SKILL_VALUE - skill_value)
        self.parent.skill_add = skill_value_add

    def handleMouseEnterEvent(self, component):
        self.updateProgressBar()
        soToolTipComponent.handleMouseEnterEvent(self, component)
        return True

    def handleMouseLeaveEvent(self, component):
        self.updateProgressBar()
        soToolTipComponent.handleMouseLeaveEvent(self, component)
        return False

    def handleMouseClickEvent(self, component):
        print 'soFeatSlot :: click'
        return False


class soLearnFeatBtn(soButton, soToolTipComponent):
    factoryString = 'soGUI.soLearnFeatBtn'

    def __init__(self, component, gaffer):
        soButton.__init__(self, component)
        soToolTipComponent.__init__(self, component, None)
        component.script = self
        self.interfaceID = BWPersonality.GUICore.GUI_ID_SKILLS
        self.gaffer = gaffer
        return

    def handleMouseEnterEvent(self, component):
        soButton.handleMouseEnterEvent(self, component)
        soToolTipComponent.handleMouseEnterEvent(self, component)
        return True

    def handleMouseLeaveEvent(self, component):
        soButton.handleMouseLeaveEvent(self, component)
        soToolTipComponent.handleMouseLeaveEvent(self, component)
        return True

    def handleMouseClickEvent(self, component):

        def callback(event):
            if event == gui_jokes.GuiHandler.YES:
                SkillsGUI = BWPersonality.GUICore.skillsGUI
                SkillsGUI.learnSkill(self.gaffer.skill, self.gaffer.skill_add)
                self.gaffer.skill_add = 0
                SkillsGUI.update()

        if self.gaffer.skill_add > 0:
            gui_jokes.askUserYesNo(lc('soSkillScreen.soGUI.SKILL_CONSUME_TITLE'), lc('soSkillScreen.soGUI.SKILL_CONSUME_MSG') % self.gaffer.skill_add, callback)
            return True
        else:
            return False


