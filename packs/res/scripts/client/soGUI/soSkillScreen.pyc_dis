        self.component.selFrame.visible = doSel

    def setState(self, state = LEVELING.STATE_LEARNED):
        self.component.skillState.visible = False
        if state == LEVELING.STATE_CANTLEARN:
            self.component.skillState.texture = soAdSkillSlot.cantLearn
            self.component.skillState.visible = True
        elif state == LEVELING.STATE_CANLEARN:
            self.component.skillState.texture = soAdSkillSlot.canLearn
            self.component.skillState.visible = True
        elif state == LEVELING.STATE_UNACCESSIBLE:
            self.component.skillState.texture = soAdSkillSlot.unaccessible
            self.component.skillState.visible = True


class soASkillSlot(soItemSlot):
    factoryString = 'soGUI.soASkillSlot'
    SLOTWIDTH = 64
    SLOTHEIGHT = 80
    normalFrame = BigWorld.PyTextureProvider('soGUI/maps/Controls/inventory/cellFrame2.tga')

    def __init__(self, component, slotIndex, itemData = None):
        soItemSlot.__init__(self, component, slotIndex, itemData, centerDProxy=True)
        component.script = self
        self.dragProxy = self.component.dragProxy
        self.proxyHolder = self.component
        self.proxyName = 'dragProxy'
        self.ticker = None
        self.ttl = 0
        self.totalTime = 0
        self.texture = ''
        self._onDragStart = self.onDragStart
        self._onDragStop = self.onDragStop
        return

    def setupRoot(self):
        comp = self.component
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.dragFocus = True
        comp.dropFocus = True
        comp.crossFocus = True
        comp.moveFocus = True

    def setupContent(self):
        comp = GUI.Frame2('')
        comp.verticalPositionMode = comp.horizontalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = 64
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 16, 0.9)
        comp.texture = soASkillSlot.normalFrame
        self.component.addChild(comp, 'frameCmp')
        comp = GUI.Simple('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = 64
        comp.colour = (255, 255, 255, 128)
        comp.materialFX = 'BLEND'
        comp.position = (0, 16, 0.5)
        comp.visible = False
        self.component.addChild(comp, 'dragProxy')
        comp = GUI.Simple('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = 64
        comp.colour = (255, 255, 255, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 16, 0.4)
        self.component.addChild(comp, 'skillIcon')
        comp = GUI.Simple('soGUI/maps/Colours/white.tga')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = 64
        comp.colour = (70, 70, 70, 128)
        comp.materialFX = 'BLEND'
        comp.position = (0, 16, 0.4)
        self.component.addChild(comp, 'skillProgress')
        shader = GUI.ClipShader()
        shader.value = 0.0
        shader.speed = 0
        comp.addShader(shader, 'clipper')
        comp = GUI.Text('')
        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'CENTER'
        comp.verticalAnchor = 'CENTER'
        comp.font = 'ruRU_Cyrvetica_Extra_10i.font'
        comp.colour = (175, 166, 112, 255)
        comp.materialFX = 'BLEND'
        comp.position = (32, 8, 0.3)
        self.component.addChild(comp, 'timeToLearn')

    def timeToString(self, secs):
        if secs < 0:
            return u''
        hours = floor(secs / 3600.0)
        minutes = floor((secs - hours * 3600.0) / 60.0)
        seconds = secs - (hours * 3600.0 + minutes * 60.0)
        outH = str(int(hours)) + lc('GUI.General.HOURS_SHORTENING')
        outM = str(int(minutes)) + lc('GUI.General.MINUTES_SHORTENING')
        outS = str(int(seconds)) + lc('GUI.General.SECONDS_SHORTENING')
        if hours:
            return outH
        if minutes:
            return outM
        if seconds:
            return outS
        return u''

    def onTextureLoaded(self, resource):
        self.component.skillIcon.texture = resource[self.texture]

    def _applyItemData(self):
        skillGUI = self.component.parent.parent.script
        if self.haveItem():
            self.texture = skillGUI.texturing_callback(self.itemData['id'])
            if self.texture:
                try:
                    BigWorld.loadResourceListBG([self.texture], self.onTextureLoaded)
                except:
                    print 'soSkillScreen::error occured: engine can`t preload 1 recource unit, you must pass at least 2 '

            self.ttl = self.itemData['time_to_learn']
            self.totalTime = self.itemData['total_time']
            self.updateTimer()
            self.runTimer()
            if self.ttl > 0:
                self.component.skillProgress.clipper.value = 1.0 / (self.totalTime / self.ttl)
            else:
                self.component.skillProgress.clipper.value = 0.0
            self.component.skillProgress.clipper.reset()
            self.component.skillProgress.clipper.speed = self.ttl
            self.component.skillProgress.clipper.value = 0.0
        else:
            self.component.skillIcon.textureName = ''
            self.texture = ''
            self.ttl = 0
            self.totalTime = 0
            self.component.skillProgress.clipper.value = 0.0
            self.component.skillProgress.clipper.speed = 0
            self.component.skillProgress.clipper.reset()
            self.stopTimer()
            self.updateTimer()
        self.dragProxy.texture = self.component.skillIcon.texture
        self.dragProxy.texture = self.component.skillIcon.texture

    def runTimer(self):
        if self.ticker is not None:
            self.ticker.stop()
            self.ticker = None
        self.ticker = self.timeTicker()
        self.ticker.run()
        return

    def stopTimer(self):
        if self.ticker is not None:
            self.ticker.stop()
            self.ticker = None
        return

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def updateTimer(self):
        self.component.timeToLearn.text = self.timeToString(self.ttl)

    @BWMemberCoroutine
    def timeTicker(self):
        while self.ttl:
            yield BWWaitForPeriod(1.0)
            self.ttl -= 1
            self.updateTimer()

        self.ticker = None
        return