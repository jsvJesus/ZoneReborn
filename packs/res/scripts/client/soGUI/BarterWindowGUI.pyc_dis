    def _onValueChange(self, count):
        """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xb7\xd0\xbd\xd0\xb0\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xb0 \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd0\xb0\xd1\x85 (\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd1\x82\xd0\xbe \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xba\xd0\xb0\xd1\x80\xd1\x82\xd0\xb8\xd0\xbd\xd0\xba\xd1\x83)."""
        if count in ('', '0'):
            count = 1
        self._multiplier = int(count)
        data = BWPersonality.GUICore.packageSellDataSection
        data.pop('barter_operation_count', None)
        self.update()
        return

    def rewardSlotHandler(self, event, data):
        if event == module_soItemView.SLOTEVENT_MOUSEENTER:
            if isinstance(data, BarterRewardSlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                return True
        if event == module_soItemView.SLOTEVENT_MOUSELEAVE:
            if isinstance(data, BarterRewardSlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                return True
        if event == module_soItemView.SLOTEVENT_RCLICK:
            if isinstance(data, BarterRewardSlot):
                BWPersonality.GUICore.packageSellEvent(PACKAGE_SELL.EVENT_ITEMCONTEXT, [data.itemData, PACKAGE_SELL.REWARD_ITEM])
                return True

    def rewardItemViewHandler(self, event, data):
        return False

    def paySlotHandler(self, event, data):
        from soInventorySlot2 import soInventorySlot2
        if event == module_soItemView.EVENT_DRAGENTER:
            if isinstance(data[1], soInventorySlot2):
                return True
        if event == module_soItemView.EVENT_DROP:
            if isinstance(data[1], soInventorySlot2):
                BWPersonality.GUICore.packageSellEvent(EVENT_ITEMADD, data[1].itemData)
        if event == module_soItemView.SLOTEVENT_MOUSEENTER:
            if isinstance(data, BarterPaySlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_SHOW)
                return True
        if event == module_soItemView.SLOTEVENT_MOUSELEAVE:
            if isinstance(data, BarterPaySlot):
                BWPersonality.GUICore.toolTipEvent(data.itemData, self.interfaceID, soToolTipComponent.EVENT_HIDE)
                return True
        if event == module_soItemView.SLOTEVENT_DBLCLICK:
            if isinstance(data, BarterPaySlot):
                BWPersonality.GUICore.packageSellEvent(EVENT_ITEMREMOVE, data.itemData)
                return True
        if event == module_soItemView.SLOTEVENT_RCLICK:
            if isinstance(data, BarterPaySlot):
                BWPersonality.GUICore.packageSellEvent(PACKAGE_SELL.EVENT_ITEMCONTEXT, [data.itemData, PACKAGE_SELL.PAY_ITEM])
                return True
        return False

    def payItemViewHandler(self, event, data):
        return False

    def _onPackListElem(self):
        selection = self.component.packages.script.getSelection()[-1]
        data = self.component.packages.script.getAttachment(selection)
        BWPersonality.GUICore.packageSellEvent(EVENT_PACKSELECT, data)

    def _alignWnd(self):
        """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd0\xbe\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0."""
        sW, sH = BigWorld.screenSize()
        if BWPersonality.GUICore.inventoryGUI:
            invCmp = BWPersonality.GUICore.inventoryGUI.component
            psX = sW * (invCmp.position.x + 1) / 2
            psY = sH - sH * (invCmp.position.y + 1) / 2
            psW = invCmp.width
            self.component.position = (psX - psW, psY + self.component.height, 0.5)
        else:
            self.component.position = ((self.component.width + sW) / 2, self.component.height + sH / 2, 0.5)

    def _updatePacks(self, pack_names):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xb2 \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0 \xd0\xb2 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb5 \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
        self.component.packages.script.clear()
        if not pack_names:
            return
        last_name = pack_names[-1].list_name
        for pack_data in pack_names:
            isLast = pack_data.list_name == last_name
            self.component.packages.script.addElement(pack_data.list_name, pack_data.index, not isLast)

    def _updateReward(self, data):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd1\x8b \xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8-\xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbd\xd0\xb0\xd0\xb3\xd1\x80\xd0\xb0\xd0\xb6\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f\xd0\xbc\xd0\xb8 \xd0\xb2 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb5 \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
        new_data = copy.deepcopy(data)
        for item in new_data:
            item['reward_quantity'] *= self._multiplier

        self.component.rewardItemView.script.setItems(new_data)

    def _updatePay(self, data):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd1\x8b \xd1\x81 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xb0\xd0\xbc\xd0\xb8, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd0\xbd\xd1\x83\xd0\xb6\xd0\xbd\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd1\x82 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f."""
        new_data = copy.deepcopy(data)
        for item in new_data:
            item['required_number'] *= self._multiplier

        self.component.payItemView.script.setItems(new_data)

    def _update_you_can_get(self, count):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd1\x8c, '\xd0\xb2\xd1\x8b \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x83\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c'."""
        if count is None:
            text = ''
            self.you_can_get_items_count = 0
            self._multiplier = 1
            self.component.NumberBox.script.setValue('0')
        else:
            text = lc('BarterWindowGUI.client.YOU_CAN_GET').format(count)
            self.you_can_get_items_count = count
            self._multiplier = count if count > 0 else 1
            self.component.NumberBox.script.setValue(str(count))
        self.component.you_can_get.text = text
        return

    def update(self):
        """\xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
        data = BWPersonality.GUICore.packageSellDataSection
        if 'barter_operation_count' in data:
            self._update_you_can_get(data['barter_operation_count'])
        if 'packs' in data:
            self._updatePacks(data['packs'])
        if 'rewardItems' in data:
            self._updateReward(data['rewardItems'])
        if 'payItems' in data:
            self._updatePay(data['payItems'])

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'packageSell')
        self._alignWnd()
        self.component.visible = True
        BWPersonality.GUICore.setBestCursor()
        return

    def hide(self):
        sendEvent = self.component.visible
        self.component.hideUnaffordable.script.setInactive()
        self.component.NumberBox.script.setActive(False)
        self.component.visible = False
        if sendEvent:
            BWPersonality.GUICore.packageSellEvent(EVENT_CLOSE, None)
        BWPersonality.GUICore.setBestCursor()
        return

    def get_barter_multiplier(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd0\xbe\xd0\xb1\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbe\xd0\xb2, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd0\xb5 \xd1\x85\xd0\xbe\xd1\x87\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb8\xd0\xb7\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c."""
        return self._multiplier

