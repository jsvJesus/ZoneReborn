        comp.horizontalPositionMode = comp.verticalPositionMode = 'PIXEL'
        comp.horizontalAnchor = 'LEFT'
        comp.verticalAnchor = 'TOP'
        comp.widthMode = comp.heightMode = 'PIXEL'
        comp.width = self.SLOTWIDTH
        comp.height = self.SLOTHEIGHT
        comp.colour = (125, 0, 0, 255)
        comp.materialFX = 'BLEND'
        comp.position = (0, 0, 0.7)
        comp.visible = False
        self.component.addChild(comp, 'ItemsQuantityBg')

    def _applyItemData(self):
        """\xd0\x92\xd1\x8b\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 (\xd0\xba\xd0\xb0\xd1\x80\xd1\x82\xd0\xb8\xd0\xbd\xd0\xba\xd1\x83, \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xbf\xd0\xb8\xd1\x81\xd0\xb8 \xd0\xb8 \xd0\xbf\xd1\x80\xd0\xbe\xd1\x87\xd0\xb5\xd0\xb5) \xd0\xb2 \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82\xd0\xb5."""
        if self.haveItem():
            item_type = self.itemData['complexItemType']
            item_params = ItemsCatalog.GetItemParam(item_type)
            iconName = item_params['IconName']
            if BWPersonality.GUICore.iconTextures is not None:
                if iconName not in BWPersonality.GUICore.iconTextures.failedIDs:
                    if BWPersonality.GUICore.iconTextures.has_key(iconName):
                        self.component.itemIcon.texture = BWPersonality.GUICore.iconTextures[iconName]
                    else:
                        self.component.itemIcon.textureName = iconName
            else:
                self.component.itemIcon.textureName = iconName
            friendlyName = ItemsUtils.GetItemName(item_type, fGetShortName=True, tintItem=self.itemData)
            self.component.itemName.text = friendlyName
            text = self._added_item_text(self.itemData)
            self.component.itemCount.text = text
            self.component.itemCount.size = self._added_item_text_size(text)
            self._set_background(self.itemData)
        else:
            self.component.itemIcon.textureName = ''
            self.component.itemName.text = ''
            self.component.itemCount.text = ''
            self.component.ItemsQuantityBg.visible = False
        self.dragProxy.texture = self.component.itemIcon.texture
        return

    def _set_background(self, data):
        already_added = data.get('already_added', None)
        required_number = data.get('required_number', None)
        if already_added is None or required_number is None:
            self.component.ItemsQuantityBg.visible = False
            return
        else:
            if required_number <= already_added:
                self.component.ItemsQuantityBg.visible = False
            else:
                self.component.ItemsQuantityBg.visible = True
            return

    def _added_item_text(self, data):
        already_added = data['already_added']
        required_number = data['required_number']
        text = '{0} / {1}'.format(already_added, required_number)
        return text

    def _added_item_text_size(self, text):
        x = round(len(text) / 100.0, 2)
        y = 0.06
        return (x, y)

    def onDragStart(self):
        if self.haveItem():
            self.dragProxy.visible = True
            return True
        return False

    def onDragStop(self):
        self.dragProxy.visible = False
        return True

    def cancelTrade(self):
        BWPersonality.GUICore.packageSellEvent(EVENT_ITEMREMOVE, self.itemData)


