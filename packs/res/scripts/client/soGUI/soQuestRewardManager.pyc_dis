# Embedded file name: ./scripts/client/soGUI/soQuestRewardManager.py
import GUI
import QuestDispatcher as qd
from soGUI.soQuestRewardWin import soQuestRewardWin
from collections import defaultdict
import Quest

class soQuestRewardManager:

    def __init__(self):
        self.visible_wins = {}
        self.hidden_wins = []
        self.child_id = 0
        self.bb_id = 0

    def handle_esc(self):
        if self.visible_wins:
            self.visible_wins.values()[0].hide()
            return True
        return False

    def show_quest_reward(self, quest_id):
        quest_reward = qd.getQuestOnID(quest_id)['Reward']
        items = {}
        for i in range(len(quest_reward['TypeOfItems'])):
            item_attrs = quest_reward.get('AttrOfItems')
            if item_attrs and item_attrs[i] != Quest.REWARD_AUTO:
                item_type = quest_reward['TypeOfItems'][i]
                item_count = quest_reward['NumOfItems'][i]
                items[item_type] = item_count

        reward = {'credits': quest_reward['Credits'],
         'exp0': quest_reward['Expirience'][0] if quest_reward['Expirience'] else 0,
         'exp1': quest_reward['Expirience'][1] if quest_reward['Expirience'] else 0,
         'exp2': quest_reward['Expirience'][2] if quest_reward['Expirience'] else 0,
         'reputation': dict(quest_reward['Reputation']),
         'items': items}
        if not any(reward.values()):
            return
        parent_id = qd.get_parent_by_id(quest_id)
        if parent_id in self.visible_wins:
            win = self.visible_wins[parent_id]
        else:
            win = self.get_new_win()
            self.visible_wins[parent_id] = win
        win.show()
        win.append_reward(reward)

    def show_bb_reward(self, items, exp, quest_id):
        items_dict = defaultdict(lambda : 0)
        for item in items:
            items_dict[item['itemID']] += item['itemCount']

        reward = {'exp0': int(exp[0]),
         'exp1': int(exp[1]),
         'exp2': int(exp[2]),
         'items': items_dict}
        if not any(reward.values()):
            return
        if quest_id:
            parent_id = qd.get_parent_by_id(quest_id)
            if parent_id in self.visible_wins:
                win = self.visible_wins[parent_id]
            else:
                win = self.get_new_win()
                self.visible_wins[parent_id] = win
        else:
            win = self.get_new_win()
            self.visible_wins['blackbox', self.bb_id] = win
            self.bb_id += 1
        win.show()
        win.append_reward(reward)

    def is_visible(self):
        return bool(self.visible_wins)

    def get_new_win(self):
        if self.hidden_wins:
            return self.hidden_wins.pop()
        else:
            win = soQuestRewardWin(GUI.Window(), self, self.child_id)
            self.child_id += 1
            return win

    def win_hidden(self, win):
        for key, value in self.visible_wins.items():
            if value is win:
                del self.visible_wins[key]
                break
        else:
            raise RuntimeError

        self.hidden_wins.append(win)
        win.clear_data()