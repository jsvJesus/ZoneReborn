    def getModel(self):
        return self.parent.dummy_window.getModel()

    def setListTints(self, currentTintID, itemTypeID):
        Out = []
        tintsDDL = self.component.frChange.tintsDDL.script
        tintsDDL.clear()
        tint_allow_IDs = DyeConstant.getTintColouriseAllowed(itemTypeID)
        print 'tint_allow_IDs for %s:' % itemTypeID, tint_allow_IDs
        if not tint_allow_IDs:
            return
        i = 0
        for tintID in tint_allow_IDs:
            tintName = DyeConstant.getClothTintnameByID(tintID)
            lc_tint = lc('colourItemWindow.TINT_%s' % tintID)
            element = [i, '[%s] %s' % (tintName, lc_tint), tintID]
            Out.append(element)
            i += 1

        self._elements = dict(map(lambda x: (x[0], x[1:]), Out))
        self._id_dds_by_tint = dict(map(lambda x: (x[-1], x[0]), Out))
        if currentTintID not in tint_allow_IDs:
            currentTintID = tint_allow_IDs[0]
        tintsDDL.addElements(Out)
        val = self._id_dds_by_tint.get(currentTintID, 0)
        tintsDDL.setSelectionByValue(val)

    def getPicker(self):
        return self.colpic

    def _reset(self):
        self.setStatus(1)
        self.colpic.hide()
        if self._itemID in self._modifieds:
            if 'COLOR' in self._modifieds[self._itemID]:
                del self._modifieds[self._itemID]['COLOR']
            if not self._modifieds[self._itemID]:
                del self._modifieds[self._itemID]
        self.parent.resetColorToStock(self._itemID)
        self.parent.updateEmblem()

    def _changeColor(self):
        if self._itemID not in self._modifieds:
            self._modifieds[self._itemID] = {}
        self.validateCurrentModifieds()
        self.setListTints(self._modifieds[self._itemID]['COLOR']['TINTID'], self._itemTypeID)
        self.setColour(self._modifieds[self._itemID]['COLOR']['COLORS4_4'])
        self.setStatus(2)

    def setColour(self, colors4_4):
        self.component.frChange.colorItem_R.script.setColour(colors4_4['R'])
        self.component.frChange.colorItem_G.script.setColour(colors4_4['G'])
        self.component.frChange.colorItem_B.script.setColour(colors4_4['B'])
        self.component.frChange.colorItem_A.script.setColour(colors4_4['A'])

    def getDefaultColour(self):
        colors = {'R': tuple(list(COLORS[0]) + [255]),
         'G': tuple(list(COLORS[0]) + [255]),
         'B': tuple(list(COLORS[0]) + [255]),
         'A': tuple(list(COLORS[0]) + [255])}
        return colors

    def redrawModel(self):
        if not self._modified:
            return
        avatar = BigWorld.player()
        model_stok_param = avatar.emblems_colors.get(self._itemID)

    def setStatus(self, statusID = 0):
        layers = ['frDisable', 'FrAdd', 'frChange']
        for i, layer in enumerate(layers):
            getattr(self.component, layer).visible = statusID == i

        if i != 2:
            self.colpic.hide()

    def onSelectItem(self, itemID, item = None, modifieds = None, model_stok_param = False):
        self.getPicker().forgotCallback()
        self._itemID = itemID
        self._item = item
        self._modifieds = modifieds
        self.model_stok_param = model_stok_param
        if not itemID or not item or not model_stok_param:
            self.setStatus(0)
            return
        else:
            self._itemTypeID = item['complexItemType']
            modified = self._modifieds.get(self._itemID, {}).get('COLOR')
            color_mod = None
            if modified:
                self.setStatus(2)
            elif item['MisColorised']:
                self.setStatus(1)
            else:
                self.setStatus(0)
                return
            if self._itemID in self._modifieds and 'COLOR' in self._modifieds[self._itemID]:
                if self._modifieds[self._itemID]['COLOR']:
                    self.validateCurrentModifieds()
                    self.setListTints(self._modifieds[self._itemID]['COLOR']['TINTID'], self._itemTypeID)
                    self.setColour(self._modifieds[self._itemID]['COLOR']['COLORS4_4'])
            return

    def onChannelSetColor(self, channel, color):
        if not self._itemID:
            return
        elif self._modifieds is None:
            return
        else:
            self.validateCurrentModifieds()
            self._modifieds[self._itemID]['COLOR']['COLORS4_4'][channel] = color
            return

    def validateCurrentModifieds(self):
        if self._itemID not in self._modifieds:
            self._modifieds[self._itemID] = {}
        if 'COLOR' not in self._modifieds[self._itemID]:
            self._modifieds[self._itemID]['COLOR'] = {}
        stok = self.model_stok_param
        if not self._modifieds[self._itemID]['COLOR'].get('COLORS4_4'):
            if stok and stok.get('COLORS4_4'):
                color44 = copy.deepcopy(stok['COLORS4_4'])
                for channel in color44:
                    r, g, b, a = color44[channel]
                    if not isValidColor((r, g, b)):
                        color44[channel] = tuple(list(COLORS[0]) + [255])

            else:
                color44 = self.getDefaultColour()
            self._modifieds[self._itemID]['COLOR']['COLORS4_4'] = color44
        if not self._modifieds[self._itemID]['COLOR'].get('TINTID'):
            if stok and stok.get('TINTID'):
                tintid = stok['TINTID']
            else:
                tint_allow_IDs = DyeConstant.getTintColouriseAllowed(self._itemTypeID)
                if tint_allow_IDs:
                    tintid = tint_allow_IDs[0]
                else:
                    tintid = -1
            self._modifieds[self._itemID]['COLOR']['TINTID'] = tintid

    def onSelectedTint(self, attachment):
        if not self._itemID:
            return
        elif self._modifieds is None:
            return
        elif self._itemID not in self._modifieds:
            return
        else:
            tintID = self._elements[attachment][1]
            self._modifieds[self._itemID]['COLOR']['TINTID'] = tintID
            tintname = DyeConstant.getClothTintnameByID(tintID)
            self.parent.drawTint(self._itemID, tintname)
            self.parent.drawColor(self._itemID, self._modifieds[self._itemID]['COLOR']['COLORS4_4'])
            self.parent.updateEmblem()
            return

    def drawColor(self, channel, color4):
        if self._itemID not in self._modifieds:
            self.colpic.hide()
            return
        color4_4 = copy.deepcopy(self._modifieds[self._itemID]['COLOR']['COLORS4_4'])
        if color4_4:
            color4_4[channel] = color4
            self.parent.drawColor(self._itemID, color4_4)


class ColorItem(PyGUIBase):

    def __init__(self, component, channel, parent):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.parent = parent
        self.channel = channel
        self.color = (90, 90, 90, 255)
        self.setupRoot()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 210)
        cmp.materialFX = 'BLEND'
        cmp = GUI.Simple('textures\\default\\beige.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 0.9)
        self.component.addChild(cmp, 'fon')
        cmp = GUI.Simple('textures\\default\\white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = cmp.verticalAnchor = 'CENTER'
        cmp.colour = self.color
        cmp.materialFX = 'BLEND'
        cmp.width = cmp.height = 1.9
        cmp.position = (0.0, 0.0, 0.0)
        self.component.addChild(cmp, 'Xcolor')
        self.component.mouseButtonFocus = True
        self.component.crossFocus = True

    def handleMouseClickEvent(self, event):
        self.parent.getPicker().show(self.color, self._apply, self._update)
        self.parent.parent.disableApplyBtn(True)
        return True

    def handleMouseEnterEvent(self, comp):
        self.component.fon.colour = (255, 150, 150, 255)
        return False

    def handleMouseLeaveEvent(self, comp):
        self.component.fon.colour = (255, 255, 255, 255)
        return False

    def _apply(self, color):
        if color:
            self.color = color
            self.component.Xcolor.colour = color
            self.parent.onChannelSetColor(self.channel, color)
        else:
            self._update(self.color)
        self.parent.parent.disableApplyBtn(False)

    def _update(self, color):
        self.parent.drawColor(self.channel, color)

    def setColour(self, colour4):
        self.color = tuple(colour4)
        self.component.Xcolor.colour = self.color