        cmp.horizontalAnchor = 'LEFT'
        cmp.position = (30, 0, 0.0)
        cmp.visible = True
        self.component.addChild(cmp, 'fname')
        self.locked = True

    def _applyItemData(self):
        if not self.haveItem():
            self.component.fname.visible = False
            self.component.icon.visible = False
            self.component.fon.colour = self.unselected_color
            return
        if self.itemData.get('selected'):
            self.component.fon.colour = self.selected_color
        else:
            self.component.fon.colour = self.unselected_color
        self.component.fname.text = self.itemData['name']
        self.component.fname.visible = 1
        if self.itemData['isdir']:
            self.component.icon.visible = True
            self.component.fname.colour = (255, 210, 80, 200)
        else:
            self.component.icon.visible = False
            self.component.fname.colour = (255, 255, 255, 200)

    def getPath(self):
        if not self.haveItem():
            return
        return self.itemData['full_path']


