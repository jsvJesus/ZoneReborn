    def selectFile(self, full_path):
        self._last_choose = full_path
        for x in self._current_files:
            x['selected'] = bool(full_path == x['full_path'])

        self.itemView.setItems(self._current_files)

    def chooseFile(self, path):
        if path and os.path.isfile(path):
            self.hide()
            self.callback(path)
            return
        else:
            self._showDirectory(path)
            self._last_choose = None
            return

    def onOkBtn(self):
        self.chooseFile(self._last_choose)

    def onCancelBtn(self):
        self.hide()
        self.callback(None)
        return

    def onBackBtn(self):
        full_path = None
        if self._last_root and os.path.basename(self._last_root):
            full_path = os.path.dirname(self._last_root)
        self._showDirectory(full_path)
        return

    def callback(self, path):
        print '->', [path]

    def _showDirectory(self, path):
        self.component.showpath.text = ''
        if path:
            path = os.path.abspath(path)
            self.component.showpath.text = path
        self._last_root = path
        self._current_files = []
        if not path:
            for drive, caption in self._windows_logical_discs():
                self._current_files.append({'isdir': 1,
                 'name': u'%s      %s' % (drive, caption),
                 'full_path': drive})

        else:
            full_path = os.path.dirname(path)
            if not os.path.basename(path):
                full_path = None
            self._current_files.append({'isdir': 1,
             'name': '..',
             'full_path': full_path})
            dirs = []
            files = []
            for filename in os.listdir(path):
                full_path = os.path.join(path, filename)
                if os.path.isdir(full_path):
                    dirs.append({'isdir': 1,
                     'name': filename,
                     'full_path': full_path})
                elif self._file_filter(filename):
                    files.append({'isdir': 0,
                     'name': filename,
                     'full_path': full_path})

            self._current_files.extend(dirs)
            self._current_files.extend(files)
        self.itemView.setItems(self._current_files)
        return

    def _file_filter(self, filename):
        base, ext = os.path.splitext(filename)
        return not self.filters or ext.lower() in self.filters

    def slotHandler(self, eventID, slot):
        if eventID == 9:
            self.selectFile(slot.getPath())
        if eventID == 10:
            self.chooseFile(slot.getPath())

    def itemViewHandler(self, *e):
        pass

    def show(self, callback = None, init_dir = None, filters = None):
        if callback:
            self.callback = callback
        if filters:
            self.filters = filters
        if init_dir:
            self._last_root = init_dir
        BWPersonality.GUICore.generalLayer.delChild('openFileDialog')
        BWPersonality.GUICore.generalLayer.addChild(self.component, 'openFileDialog')
        self.component.visible = True
        self._showDirectory(self._last_root)

    def hide(self):
        self.component.visible = False

    def _windows_logical_discs(self):
        print 'subprocess+ ofd'
        drivelist_proc = subprocess.Popen('wmic logicaldisk get DeviceID, VolumeName', shell=True, stdout=subprocess.PIPE)
        drivelist, _err = drivelist_proc.communicate()
        drive_lines = drivelist.split('\n')
        logical_discs = []
        for info in drive_lines:
            disk_name = re.search('^\\S\\:', info)
            if disk_name:
                disk_name = unicode(disk_name.group() + u'\\')
                volumeName = info.split(' ', 1)[1].strip()
                try:
                    volumeName = volumeName.decode('cp866')
                except:
                    print 'volumeName:', [volumeName]
                    traceback.print_exc()
                    volumeName = u' '

                logical_discs.append((disk_name, volumeName))

        return logical_discs


