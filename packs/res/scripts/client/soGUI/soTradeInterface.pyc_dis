class TradeSellFingerSlot(soSummarySlot2):
    """ \xd1\x81\xd0\xbb\xd0\xbe\xd1\x82 \xd1\x81 \xd0\xbf\xd0\xb0\xd0\xbb\xd1\x8c\xd1\x86\xd0\xb5\xd0\xbc \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbc\xd0\xb0\xd1\x80\xd0\xb6\xd0\xb8 """
    factoryString = 'soGUI.TradeSellFingerSlot'

    def _applyItemData(self):
        soSummarySlot2._applyItemData(self)
        if not self.haveItem() or 'margin' not in self.itemData:
            self.component.finger.visible = False
            return
        margin = self.itemData['margin']
        if margin >= 0.75:
            color = (222, 138, 0, 255)
        elif margin >= 0.5:
            color = (255, 255, 255, 255)
        elif margin >= 0.25:
            color = (255, 255, 255, 128)
        else:
            self.component.finger.visible = False
            return
        self.component.finger.visible = True
        self.component.finger.colour = color

    def setupContent(self):
        soSummarySlot2.setupContent(self)
        space = 0.2
        finger = GUI.Simple('soGUI/maps/Icons/thumb_up.dds')
        finger.verticalPositionMode = finger.horizontalPositionMode = 'CLIP'
        finger.horizontalAnchor = 'LEFT'
        finger.verticalAnchor = 'TOP'
        finger.widthMode = finger.heightMode = 'PIXEL'
        finger.width = finger.texture.width
        finger.height = finger.texture.height
        finger.colour = (255, 255, 255, 255)
        finger.materialFX = 'BLEND'
        finger.position = (-1 + space, 1 - space, 0.1)
        finger.visible = False
        self.component.addChild(finger, 'finger')


