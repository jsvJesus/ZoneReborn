# Embedded file name: ./scripts/client/soGUI/testScreenForAlex.py
import BWPersonality
import BigWorld
import GUI
import Helpers.PyGUI as PyGUI
import soGUI
from Helpers.PyGUI import PyGUIEvent
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from soGUI.soButton import soButton
from soGUI.soTextField import soTextField3

class ScreenDebug(PyGUIBase):
    factoryString = 'soGUI.ScreenDebug'

    def __init__(self, component):
        PyGUIBase.__init__(self, component)
        component.script = self
        self._timerID = 0
        self.engineStatistic = BigWorld.PyEngineStatistic()
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.width = 300
        cmp.height = 380
        cmp.position = (0.6, 0.99, 0.1)
        cmp.textureName = ''
        cmp.visible = True
        cmp.dragFocus = True
        self.component.mouseButtonFocus = 1

    def setupContent(self):
        cmp = GUI.Frame2('soGUI/maps/Controls/inventory/inventoryFrame2.tga')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.component.width
        cmp.height = self.component.height
        cmp.position = (0, 0, 1.0)
        self.component.addChild(cmp, 'wndFrame')
        btn = soButton(GUI.Window())
        btn.initVSC('soGUI/visual_styles/closeBox.xml')
        cmp = btn.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'RIGHT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = 18
        cmp.height = 18
        cmp.position = (self.component.width - 6, 6, 0.2)
        btn.onClick = self.onCloseBox
        self.component.addChild(cmp, 'closeBox')
        btn.onBound()
        btn._updateVisualState()
        self.txt = GUI.Text('value / value')
        self.txt.horizontalAnchor = 'LEFT'
        self.txt.verticalAnchor = 'TOP'
        self.txt.verticalPositionMode = 'PIXEL'
        self.txt.horizontalPositionMode = 'PIXEL'
        self.txt.position = (20, 40, 0.0)
        self.txt.visible = True
        self.txt.multiline = True
        self.component.addChild(self.txt, 'txt')

    def show(self):
        if self.component.parent is None:
            BWPersonality.GUICore.worldLayer.addChild(self.component, 'ScreenDebug')
        self.component.visible = True
        BigWorld.cancelCallback(self._timerID)
        self._timerID = BigWorld.callback(0.1, self.onUpdate)
        return

    def hide(self):
        self.component.visible = False
        BWPersonality.GUICore.setBestCursor()
        BigWorld.cancelCallback(self._timerID)

    def toK(self, value):
        value = int(value)
        if value < 1024:
            return value
        elif value < 1048576:
            value /= 1024
            return str(value) + ' K'
        else:
            value /= 1048576
            return str(value) + ' M'

    def onCloseBox(self):
        self.hide()

    def reload(self):
        self.hide()
        reload(soGUI.testScreenForAlex)
        BWPersonality.GUICore.soTestScreenForAlex = soGUI.testScreenForAlex.ScreenDebug(GUI.Window())
        BWPersonality.GUICore.soTestScreenForAlex.show()
        print 'Ok'

    def onUpdate(self):
        fps = self.engineStatistic.fps()
        drawCalls = self.engineStatistic.drawCalls()
        sysMem = self.engineStatistic.systemMemory()
        texMem = self.engineStatistic.textureMemory()
        vertBuffSize = self.engineStatistic.vertexBufferSize()
        soundSize = self.engineStatistic.soundSize()
        noneMem = sysMem - texMem - vertBuffSize - soundSize
        nVertInMem = self.engineStatistic.numVerticesInMemory()
        nVertInFrame = self.engineStatistic.numVerticesInFrame()
        nPrimInFrame = self.engineStatistic.numPrimitivesInFrame()
        out = u'\nfps = {0:.1f}\ndrawCalls = {1}\n\nsysMem = {2}b\ntexMem = {3}b\nvertBuffSize = {4}b\nsoundSize = {5}b\nnoneMem = {6}b\nnPrimInFrame = {7}\n\t\t'.format(fps, drawCalls, self.toK(sysMem), self.toK(texMem), self.toK(vertBuffSize), self.toK(soundSize), self.toK(noneMem), self.toK(nPrimInFrame))
        self.txt.text = out
        self._timerID = BigWorld.callback(0.1, self.onUpdate)