"""
        \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xbd\xd0\xb5\xd0\xb2\xd0\xb8\xd0\xb4\xd0\xb8\xd0\xbc\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb9 \xd1\x80\xd0\xb0\xd1\x81\xd1\x82\xd1\x8f\xd0\xb3\xd0\xb8\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbd\xd0\xb0 \xd0\xb2\xd0\xb5\xd1\x81\xd1\x8c \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd \xd0\xbf\xd0\xbe\xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb8 \xd0\xb2\xd1\x81\xd0\xb5\xd1\x85 \xd0\xb3\xd1\x83\xd0\xb8 \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd
        \xd0\xb8 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0\xd0\xb6\xd0\xb0\xd1\x82\xd0\xb8\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbe\xd0\xb9 \xd0\xbc\xd1\x8b\xd1\x88\xd0\xba\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe \xd1\x81\xd1\x83\xd1\x89\xd0\xbd\xd0\xbe\xd1\x81\xd1\x82\xd1\x8f\xd0\xbc \xd0\xb2 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb5 \xd1\x81\xd0\xb2\xd0\xbe\xd0\xb1\xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd1\x83\xd1\x80\xd1\x81\xd0\xbe\xd1\x80\xd0\xb0
"""
from Localization import lc
import BigWorld
import BWPersonality
import GUI
import Helpers.PyGUI as PyGUI
import soGUI
import random
import Constants
import Helpers
import Helpers.Caps
import RestrictionsUtils
from Helpers.PyGUI.PyGUIBase import PyGUIBase
from Keys import KEY_LEFTMOUSE, KEY_RIGHTMOUSE

class EntityPickerLayer(PyGUIBase):
    factoryString = 'soGUI.EntityPickerLayer'

    def __init__(self, component, parent):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.mouse_focus = False
        self.setupRoot()
        parent.delChild('EntityPickerLayer')
        parent.addChild(self.component, 'EntityPickerLayer')

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.width = cmp.height = 2.0
        cmp.position = (0.0, 0.0, 1.0)
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.visible = False
        cmp.focus = True
        cmp.crossFocus = True
        cmp.dragFocus = False
        cmp.moveFocus = True
        cmp.dropFocus = False
        cmp.mouseButtonFocus = True

    def show(self):
        self.component.visible = True

    def hide(self):
        self.component.visible = False

    def handleMouseButtonEvent(self, comp, event):
        key = event.key
        char = event.character
        mods = event.modifiers
        down = event.isKeyDown()
        actions = {}
        if down:
            if key == KEY_RIGHTMOUSE:
                entity = BigWorld.target()
                self.last_entity = entity
                if not entity:
                    return False
                mee = BigWorld.player()
                interaction_distance = Constants.INTERACTION_DISTANCE ** 2
                if self.last_entity and hasattr(self.last_entity, 'get_interaction_dist'):
                    interaction_distance = self.last_entity.get_interaction_dist() ** 2
                if entity.__class__.__name__ == 'Avatar':
                    actions['CHAT|0|@%s ' % entity.name] = lc('GUI.EntContext.PM') + entity.name
                    if entity.clanName and mee.clanName and entity.clanName != mee.clanName:
                        oponent_clan_name = entity.clanName.decode('utf8')
                        if entity.clanName in mee.clanEnemies:
                            actions['CHAT|1|/clanpeace  %s' % oponent_clan_name] = lc('GUI.EntContext.ClanPeace') % oponent_clan_name
                        else:
                            actions['CHAT|1|/clanwar  %s' % oponent_clan_name] = lc('GUI.EntContext.ClanWar') % oponent_clan_name
                    if entity.name not in [ i[0] for i in mee.getFriendList() ]:
                        actions['addFriend|2|%s' % entity.name] = lc('GUI.EntContext.AddToFriend')
                    if entity.name not in mee.getBlackList():
                        actions['addToBlackList|2|%s' % entity.name] = lc('GUI.EntContext.AddToBlackList')
                        if mee.position.distSqrTo(entity.position) < Constants.INTERACTION_DISTANCE ** 2:
                            actions['start_trade|3|%s' % entity.name] = lc('PlayerAvatar.client.INIT_TRADE')
                    if mee.position.distSqrTo(entity.position) < Constants.INTERACTION_DISTANCE ** 2:
                        if entity.dead:
                            actions['manipulateWithDead|4|%s' % entity.name] = lc('PlayerAvatar.client.GIVE_AID_TO_DEAD')
                    if mee.clanID and not entity.clanName:
                        mee_clan_name = mee.clanName.decode('utf8')
                        actions['CHAT|3|/claninvite %s' % entity.name] = lc('GUI.EntContext.ClanInvite') % mee_clan_name
                    actions['CHAT|4|/invite %s' % entity.name] = lc('GUI.EntContext.inviteInGroup')
                    if mee.clientAccessLevel:
                        if hasattr(mee, '_prev_ft_to'):
                            actions['ADMIN|10|FT'] = u'/setFTto [%s] %s   %s min' % (entity.name, mee._prev_ft_to['transformID'], mee._prev_ft_to['minutes'])
                        actions['ADMIN|11|rope'] = u'/rope %s' % entity.name
                        actions['ADMIN|12|copyname'] = u'copy name %s' % entity.name
                if entity.__class__.__name__ == 'NPC':
                    if self.last_entity and mee.position.distSqrTo(self.last_entity.position) < interaction_distance:
                        if Helpers.Caps.CAP_CAN_TALK in entity.targetCaps:
                            actions['Talk|1|0'] = lc('PlayerAvatar.client.TALK_NPC')
                if entity.__class__.__name__ == 'DrawWell':
                    if self.last_entity and mee.position.distSqrTo(self.last_entity.position) <= interaction_distance:
                        actions['Drink|0|0'] = lc('PlayerAvatar.client.DRINK')
                        actions['Fill|1|0'] = lc('PlayerAvatar.client.FILL_WATER')
            if not actions:
                return False
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.ContextMenuEvent)
            BWPersonality.GUICore.addListener('contextMenuEvent', self.ContextMenuEvent)
            self._interface_id = random.random()
            BWPersonality.GUICore.showContextMenu(self._interface_id, actions)
            return True
        return False

    def ContextMenuEvent(self, interface_id, action_id, caption, event, data = None):
        if interface_id != self._interface_id:
            return
        if event == soGUI.soContextMenuComponent.EVENT_SELECT and isinstance(action_id, basestring):
            name = action_id.split('|', 2)[2]
            player = BigWorld.player()
            if action_id.startswith('CHAT|'):
                command = name.strip()
                if command.startswith('@'):
                    BWPersonality.GUICore.putToChat(command)
                elif command.startswith('/'):
                    player.runCommand(command)
            if action_id.startswith('addFriend|'):
                player.addFriend(name.encode('utf8'))
            if action_id.startswith('addToBlackList|'):
                player.addToBlackList(name.encode('utf8'))
            sqr_radius = Constants.INTERACTION_DISTANCE ** 2
            if self.last_entity and self.last_entity.isDestroyed:
                return
            if self.last_entity and hasattr(self.last_entity, 'get_interaction_dist'):
                sqr_radius = self.last_entity.get_interaction_dist() ** 2
            if self.last_entity and player.position.distSqrTo(self.last_entity.position) <= sqr_radius:
                if action_id.startswith('start_trade|'):
                    player.StartExchange(self.last_entity)
                if action_id.startswith('Talk|'):
                    player.startTalkEnt(self.last_entity)
                if action_id.startswith('manipulateWithDead|'):
                    player.manipulateWithDead(self.last_entity)
                if action_id.startswith('Drink|'):
                    if not player.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                        return
                    player.DoAction(RestrictionsUtils.CHANNEL_ITEMS, 4.0, lc('Items.GUIStrings.DRINKWATERSIPS'))
                    player.cell.startDrinkTheWaterDrawWall()
                    player.setControlLockByEffect(Constants.ControlLockTypes.CRAFTING, duration=4.0)
                if action_id.startswith('Fill|'):
                    BWPersonality.GUICore.showInventory()
            if player.clientAccessLevel:
                if action_id == 'ADMIN|10|FT':
                    command = u'/setFT %s %s %s' % (player._prev_ft_to['transformID'], self.last_entity.id, player._prev_ft_to['minutes'])
                    player.runCommand(command)
                if action_id == 'ADMIN|11|rope':
                    command = u'/rope %s' % self.last_entity.name
                    player.runCommand(command)
                if action_id == 'ADMIN|12|copyname':
                    BigWorld.clipboardSetPlainText(self.last_entity.name)
        if event == soGUI.soContextMenuComponent.EVENT_CANCEL:
            BWPersonality.GUICore.removeListener('contextMenuEvent', self.ContextMenuEvent)

    def handleMouseEnterEvent(self, cmp):
        self.mouse_focus = True
        return True

    def handleMouseLeaveEvent(self, cmp):
        self.mouse_focus = False
        return True

    def handleKeyEvent(self, event):
        return False