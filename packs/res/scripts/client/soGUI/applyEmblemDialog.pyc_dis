    def _applyGold(self):
        self._apply(False)

    def _applyEventTicket(self):
        self._apply(True)

    def _apply(self, et = False):
        avatar = BigWorld.player()
        for itemID in self._data.keys():
            modified = self._data[itemID]
            if 'COLOR' in modified:
                tintID = modified['COLOR']['TINTID']
                color = modified['COLOR']['COLORS4_4']
                c1, c2, c3, c4 = ItemsUtils.colors44ToDicts3(color)
                avatar.cell.applyColoriseItem(itemID, tintID, c1, c2, c3, c4, et)
            if 'EMBLEM' in modified:
                emblemID = modified['EMBLEM']
                avatar.base.applyEmblemItem(itemID, emblemID, et)

        self._callbackOnApply()

    def _clear(self):
        for x in range(10):
            cmp = getattr(self.component, 'it_%s' % x, None)
            if cmp:
                self.component.delChild('it_%s' % x)

        self.component.bApplyEventTick.script.setDisabledState(True)
        self.component.bApplyGold.script.setDisabledState(True)
        return

    def _drawData(self, data):
        avatar = BigWorld.player()
        if avatar.__class__.__name__ != 'PlayerAvatar':
            return
        rheight = 60
        addy = 30
        total_gold = 0
        total_et = 0
        for x, (itemID, item_data) in enumerate(data.items()):
            it = RowItem(GUI.Window(), self.width - 20, rheight, itemID, item_data)
            self.component.addChild(it.component, 'it_%s' % x)
            it.component.position = (10, addy, 0.1)
            addy += rheight + 4
            if 'COLOR' in item_data:
                total_gold += DyeConstant.COST_COLOURISE
                total_et += DyeConstant.COST_EVENT_TICKET_COLOURISE
            if 'EMBLEM' in item_data:
                total_gold += DyeConstant.COST_EMBLEM
                total_et += DyeConstant.COST_EVENT_TICKET_EMBLEM

        addy += 4
        self.component.totalCostGold.text = '%sg.' % total_gold
        self.component.totalCostGold.position = (self.width - 100, addy, 0)
        addy += 25
        self.component.totalCostET.text = lc('colourItemWindow.EVENT_TICKETS').format(total_et)
        self.component.totalCostET.position = (self.width - 100, addy, 0)
        user_et = ItemsUtils.getQuanityEventTicketsFromEntity(avatar)
        self.component.userTickets.text = lc('colourItemWindow.PLAYER_EVENT_TICKETS') + str(user_et)
        self.component.userGold.text = lc('colourItemWindow.YOUR_GOLD') + str(avatar.GoldCreditNumber)
        self.component.bApplyEventTick.script.setDisabledState(total_et > user_et)
        self.component.bApplyGold.script.setDisabledState(total_gold > avatar.GoldCreditNumber)

    def show(self, data, callbackOnApply):
        self.component.visible = True
        if not data:
            data = {1763651560L: {'COLOR': {'COLORS4_4': {'A': (90, 90, 90, 255),
                                                   'B': (90, 90, 90, 255),
                                                   'R': (90, 90, 90, 255),
