                                                   'B': (123, 104, 238, 255),
                                                   'R': (128, 128, 0, 255),
                                                   'G': (100, 149, 237, 255)},
                                     'TINTID': 3},
                           'EMBLEM': 7},
             1763651552L: {'COLOR': {'COLORS4_4': {'A': (90, 90, 90, 255),
                                                   'B': (123, 104, 238, 255),
                                                   'R': (128, 128, 0, 255),
                                                   'G': (100, 149, 237, 255)},
                                     'TINTID': 3},
                           'EMBLEM': 7},
             1763651551L: {'COLOR': {'COLORS4_4': {'A': (90, 90, 90, 255),
                                                   'B': (123, 104, 238, 255),
                                                   'R': (128, 128, 0, 255),
                                                   'G': (100, 149, 237, 255)},
                                     'TINTID': 3},
                           'EMBLEM': 7}}
        self._callbackOnApply = callbackOnApply
        self._data = copy.deepcopy(data)
        self._clear()
        self._drawData(self._data)
        GUI.reSort()

    def hide(self):
        self.component.visible = False


class RowItem(PyGUIBase):
    factoryString = 'soGUI.RowItem'

    def __init__(self, component, width, height, itemID, color_emblem):
        PyGUIBase.__init__(self, component)
        component.script = self
        self.width = width
        self.height = height
        self.itemID = itemID
        self.color_emblem = color_emblem
        self.itemData = ItemsUtils.GetComplexItemByID(BigWorld.player(), self.itemID)
        self.setupRoot()
        self.setupContent()
        if 'EMBLEM' in color_emblem and color_emblem['EMBLEM']:
            self.setEmblem(color_emblem['EMBLEM'])
        if 'COLOR' in color_emblem and color_emblem['COLOR']:
            self.setColor(color_emblem['COLOR'])

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height

    def setupContent(self):
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.colour = (30, 30, 17, 60)
        cmp.materialFX = 'BLEND'
        cmp.position = (0, 0.0, 1.0)
        self.component.addChild(cmp, 'tmpFON')
        cmp.width = 20
        cmp.height = 20
        slot = soInventorySlot2(GUI.Window(), 0, None)
        cmp = slot.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.position = (2, 0, 0)
        self.component.addChild(cmp, 'slotitem')
        slot._onDragStart = lambda *e: False
        slot.equipItem = lambda *e: False
        slot.wannaDrop = lambda *e: False
        slot.toActionBar = lambda *e: False
        slot.slotEvent = lambda *e: False
        slot.setContent(self.itemData)
        return

    def setEmblem(self, eblemID):
        cmp = GUI.Simple('textures/default/white.dds')
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.colour = (255, 255, 255, 255)
        cmp.materialFX = 'BLEND'
        cmp.position = (70, 1.0, 0.0)
        self.component.addChild(cmp, 'emblemIcon')
        cmp.width = 30
        cmp.height = 30

        def setEmblemIcon(imgID, feedName, texture):
            self.component.emblemIcon.texture = texture

        feedName = UCManager.ucmanager.loadImg(eblemID, setEmblemIcon)
        cmp = GUI.Text('Emblem %s' % eblemID)
