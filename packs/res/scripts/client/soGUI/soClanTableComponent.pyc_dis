class TableItemElement(PyGUIBase):

    def __init__(self, component, row_parent, width, height, row_index, col_index, props):
        component.script = self
        PyGUIBase.__init__(self, component)
        self.row_parent = row_parent
        self.props = props
        self.row_index = row_index
        self.col_index = col_index
        self.selected = False
        self.mouseHover = False
        self.disabled = False
        self.background = None
        self.width = width
        self.height = height
