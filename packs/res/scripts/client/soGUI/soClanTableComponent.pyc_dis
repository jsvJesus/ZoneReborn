    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = 'PIXEL'
        cmp.verticalPositionMode = 'PIXEL'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.materialFX = 'BLEND'
        cmp.width = self.width
        cmp.height = self.height
        cmp.colour = (255, 255, 255, 255)
        cmp.position = (0, 0, 0)
        cmp.mouseButtonFocus = True

    def setupContent(self):
        cmp = GUI.Text('')
        cmp.font = self.props.dataStyles['font']
        color = (255, 255, 255, 255)
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
        cmp.colour = color
        cmp.multiline = False
        cmp.horizontalPositionMode = 'CLIP'
        cmp.verticalPositionMode = 'CLIP'
        cmp.horizontalAnchor = 'CENTER'
        cmp.verticalAnchor = 'CENTER'
        cmp.position = (0, 0, 0.1)
        cmp.materialFX = 'BLEND'
        self.component.addChild(cmp, 'label')
        cmp = GUI.Simple('soGUI/maps/Colours/white.tga')
        color = (0, 0, 0, 0)
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        cmp.colour = color
        cmp.materialFX = 'BLEND'
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'CLIP'
        cmp.width = cmp.height = 2
        cmp.position = (0, 0, 0.5)
        self.component.addChild(cmp, 'background')

    def handleMouseButtonEvent(self, comp, event):
        down = event.isKeyDown()
        key = event.key
        modifiers = event.modifiers
        if down:
            if key == Keys.KEY_LEFTMOUSE:
                self.row_parent.elementEvent(self.row_index, self.col_index, 'LEFTMOUSE', None)
            elif key == Keys.KEY_RIGHTMOUSE:
                self.row_parent.elementEvent(self.row_index, self.col_index, 'RIGHTMOUSE', None)
        return True

    def handleMouseEnterEvent(self, component):
        return False

    def handleMouseLeaveEvent(self, component):
        return False

    def updateVisual(self):
        color = (0, 0, 0, 0)
        if self.selected or self.mouseHover:
            if self.props.dataStyles.has_key('selectColor'):
                color = self.props.dataStyles['selectColor']
            self.component.background.colour = color
            return
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        self.component.background.colour = color

    def setLabel(self, txt):
        self.component.label.text = txt

    def setProps(self, props):
        self.props = props
        if self.props.dataStyles.has_key('contentColor'):
            color = self.props.dataStyles['contentColor']
            self.component.label.colour = color
        self.updateVisual()

    def select(self):
        self.selected = True
        self.updateVisual()

    def deselect(self):
        self.selected = False
        self.updateVisual()

    def hover(self, mouseIn = True):
        self.mouseHover = mouseIn
        self.updateVisual()


class TableRowElement(PyGUIBase):

    def __init__(self, component, width, height, position, parentTable, parentRowIndex, props = soTableElemPropsStructure(), ratio = None, cols = 3):
        component.script = self
        PyGUIBase.__init__(self, component)
        self.props = props
        self.width = width
        self.height = height
        self.position = position
        self.columns_count = cols
        self.ratio = ratio
        self.parentTable = parentTable
        self.parentRowIndex = parentRowIndex
        if not self.ratio:
            self.ratio = [ 1.0 / self.columns_count for i in range(self.columns_count) ]
        if len(self.ratio) < cols:
            print 'EROR RowItemH'
            traceback.print_stack()
            return
        self.setupRoot()
        self.setupContent()

    def setupRoot(self):
        cmp = self.component
        cmp.horizontalPositionMode = cmp.verticalPositionMode = 'CLIP'
        cmp.widthMode = cmp.heightMode = 'PIXEL'
        cmp.horizontalAnchor = 'LEFT'
        cmp.verticalAnchor = 'TOP'
        cmp.width = self.width
        cmp.height = self.height
        cmp.materialFX = 'BLEND'
        if self.props.dataStyles.has_key('color'):
            color = self.props.dataStyles['color']
        cmp.colour = color
        cmp.position = self.position
        cmp.pixelSnap = False
        cmp.mouseButtonFocus = True
        cmp.crossFocus = True
        cmp.moveFocus = True

    def setupContent(self):
        cur_pos_x = 0
        for i in range(self.columns_count):
            w = min(self.ratio[i] * self.width, self.width - cur_pos_x)
            item = TableItemElement(GUI.Window(), self, w, self.height, self.parentRowIndex, i, self.props)
            cmp = item.component
            cmp.position = (cur_pos_x + w / 2, self.height / 2, 0.1)
            cur_pos_x += self.ratio[i] * self.width
            self.component.addChild(cmp, 'column%s' % i)

    def elementEvent(self, row_index, col_index, event, data):
        data = {'name': self.getName()}
        self.parentTable.elementEvent(row_index, col_index, event, data)

    def delElem(self):
        self.parentTable = None
        return

    def setLabels(self, txt):
        for i in range(len(txt)):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.setLabel(txt[i])

        return

    def setProps(self, props):
        self.props = props
        for i in range(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.setProps(props)

        return

    def getName(self, num = 0):
        col = getattr(self.component, 'column%s' % num, None)
        if col:
            return col.label.text
        else:
            return u''

    def clear(self):
        for i in range(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.label.text = u''

        return

    def handleMouseEnterEvent(self, component):
        for i in range(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.hover(True)

        return False

    def handleMouseLeaveEvent(self, component):
        for i in range(self.columns_count):
            col = getattr(self.component, 'column%s' % i, None)
            if col:
                col.script.hover(False)

        return False


