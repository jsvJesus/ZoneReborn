# Embedded file name: ./scripts/client/Helpers/QuestTester.py
import BigWorld
import ChatChannelConfig
import Constants
import BWPersonality
from functools import partial, wraps
import QuestDispatcher as qd
import ItemsUtils
import utils
import os
import ResMgr
import json
from gui_const import INV_CONST
CHANNEL_CONSTS = ChatChannelConfig.ChannelConsts()
QD_DIALOG_SHOW, QD_RENDER_ANSWER, QD_WIPED, QD_DIALOG_HIDE, QD_TELEPORTED, QD_MONEY_CHANGED, QD_ITEM_ADDED, QD_BLOCK_EVENTS = range(8)
testerInstance = None

def debug_event(event):

    def decorator(func):

        @wraps(func)
        def wrapper(*args, **kwargs):
            global testerInstance
            result = func(*args, **kwargs)
            if testerInstance != None:
                testerInstance.got_event(event, *args, **kwargs)
            return result

        return wrapper

    return decorator


class QuestTester:
    """ \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd1\x87\xd0\xb8\xd0\xba \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2, \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x83\xd1\x81\xd0\xba\xd0\xb0\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xba\xd0\xbe\xd0\xbd\xd1\x81\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe\xd0\xb9 \xd0\xba\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4\xd0\xbe\xd0\xb9 questsdebug
            \xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 \xd1\x87\xd0\xb5\xd1\x80\xd0\xbf\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb8\xd0\xb7 \xd0\xba\xd0\xbe\xd0\xbd\xd1\x84\xd0\xb8\xd0\xb3\xd1\x83\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xbe\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x84\xd0\xb0\xd0\xb9\xd0\xbb\xd0\xb0 data/queststest.json
    """
    last_debug_time = None
    internal_file_name = 'scripts/client/data/questtest.json'

    @staticmethod
    def generate_questsdebugger():
        dir_path = os.path.join(utils.stalker_path(), 'usercontent/debug')
        if not os.path.exists(dir_path):
            os.makedirs(dir_path)
        file_name = 'questtest.json'
        dst_path = os.path.join(dir_path, file_name)
        open(dst_path, 'w').close()

    @staticmethod
    def start_debug(config_name):
        global testerInstance
        import time
        if testerInstance or QuestTester.last_debug_time and QuestTester.last_debug_time + 2.0 > time.time():
            BigWorld.player().putMessage(CHANNEL_CONSTS.SYSTEM, u'\u041f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0430\u044f \u043e\u0442\u043b\u0430\u0434\u043a\u0430 \u0435\u0449\u0451 \u043d\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u0430')
            return
        else:
            QuestTester.last_debug_time = time.time()
            testerInstance = QuestTester(config_name)
            if not testerInstance.inited:
                testerInstance = None
                return
            BigWorld.player().setControlLock(Constants.ControlLockTypes.LOAD_WORLD, True)
            testerInstance.show_message(u'\u041e\u0442\u043b\u0430\u0434\u043a\u0430 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430')
            testerInstance.next_event()
            return

    def __init__(self, config_name):
        self.event_counter = 0
        self.inited = False
        dir_path = os.path.join(utils.stalker_path(), 'usercontent/debug')
        file_name = 'questtest.json'
        dst_path = os.path.join(dir_path, file_name)
        if os.path.exists(dst_path):
            f = open(dst_path)
            try:
                json_text = json.load(f)
            except:
                self.show_error_and_break(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u0430\u0439\u043b \u0432 json')
                return

            f.close()
        else:
            ResMgr.purge(QuestTester.internal_file_name)
            source = ResMgr.openSection(QuestTester.internal_file_name)
            json_text = json.loads(source.asBinary)
        if not json_text.has_key(config_name):
            self.show_error_and_break(u'\u041d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f ' + config_name)
            return
        else:
            self.events_list = json_text[config_name]
            self.teleport_callback_id = None
            self.awaited_events = None
            self.awaited_items = []
            self.snapshot_wealth()
            self.inited = True
            return

    def snapshot_wealth(self):
        p = BigWorld.player()
        self.previous_wealth = {'items': utils.pyFixedToNativePythonType(BigWorld.player().CarryingItems),
         'money': BWPersonality.GUICore.inventoryDataSection['money'][0],
         'combat_exp': p.CombatExperience,
         'survival_exp': p.SurvivalExperience,
         'other_exp': p.OtherExperience}
        self.next_event()

    def got_event(self, event, *args, **kwargs):
        if self.awaited_events and event not in self.awaited_events:
            return
        else:
            self.awaited_events = None
            if event == QD_DIALOG_SHOW:
                self.dialog_shown()
            elif event == QD_RENDER_ANSWER:
                self.answer_rendered()
            elif event == QD_WIPED:
                self.wiped()
            elif event == QD_DIALOG_HIDE:
                self.dialog_hide()
            elif event == QD_TELEPORTED:
                self.teleported(True)
            elif event == QD_MONEY_CHANGED:
                self.money_changed()
            elif event == QD_ITEM_ADDED:
                self.item_added(*args[1:-1])
            return

    def click_dialog_button(self, button_text):
        for btn in BWPersonality.GUICore.dialogueGUI.btns:
            if btn.label.text == button_text:
                btn.script.onClick()
                return

        self.show_error_and_break(u'\u0420\u0435\u043f\u043b\u0438\u043a\u0430 \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0430: ' + button_text)

    def teleported(self, success = False):
        if self.teleport_callback_id:
            BigWorld.cancelCallback(self.teleport_callback_id)
            self.teleport_callback_id = None
        if not success:
            self.show_error_and_break(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0442\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f')
        self.next_event()
        return

    def wipe(self, total):
        if total:
            BWPersonality.GUICore.chatConsole.run_command('wipemeplease')
        else:
            BWPersonality.GUICore.chatConsole.run_command('questswipe')

    def wiped(self):
        self.next_event()

    def wait_events(self, *events):
        self.awaited_events = events

    def next_event(self):
        """ \xd0\xbf\xd0\xb0\xd1\x80\xd1\x81\xd0\xb8\xd0\xbd\xd0\xb3 \xd0\xbe\xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f """
        if self.event_counter < len(self.events_list):
            event = self.events_list[self.event_counter]
            if type(event) in [unicode, str]:
                button_text = self.events_list[self.event_counter]
                self.wait_events(QD_RENDER_ANSWER, QD_DIALOG_HIDE)
                BigWorld.callback(0, partial(self.click_dialog_button, button_text))
            elif type(event) == dict:
                if 'check_quests' in event:
                    self.wait_events(QD_BLOCK_EVENTS)
                    BigWorld.callback(0, partial(self.check_quests, event['check_quests']))
                elif 'start_dialog' in event:
                    self.wait_events(QD_DIALOG_SHOW)
                    BigWorld.callback(0, partial(self.start_dialog, event['start_dialog']))
                elif 'teleport_to' in event:
                    self.wait_events(QD_TELEPORTED)
                    BigWorld.callback(0, partial(self.teleport_to, event['teleport_to']))
                elif 'set_money' in event:
                    self.wait_events(QD_MONEY_CHANGED)
                    BigWorld.callback(0, partial(self.set_money, event['set_money']))
                elif 'assert_no_button' in event:
                    BigWorld.callback(0, partial(self.check_button, event['assert_no_button'], False))
                elif 'get_items' in event:
                    BigWorld.callback(0, partial(self.get_items, event['get_items']))
                elif 'wipe' in event:
                    self.wait_events(QD_WIPED)
                    BigWorld.callback(0, partial(self.wipe, event['wipe']))
                elif 'interact_item' in event:
                    self.wait_events(QD_BLOCK_EVENTS)
                    partial_func = partial(self.interact_item, event['interact_item']['type'], event['interact_item']['act'])
                    BigWorld.callback(0, partial_func)
            elif type(event) == list:
                if 'close_dialog' in event:
                    self.wait_events(QD_BLOCK_EVENTS)
                    BigWorld.callback(0, self.close_dialog)
                elif 'snapshot_wealth' in event:
                    self.wait_events(QD_BLOCK_EVENTS)
                    BigWorld.callback(0, self.snapshot_wealth)
            else:
                self.show_error_and_break(u'\u041e\u0448\u0438\u0431\u043a\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f: ' + str(event))
            self.event_counter += 1
        else:
            self.debug_ended()

    def interact_item(self, item_type, action, wait_seconds = 3.0):
        inventory = BWPersonality.GUICore.inventoryGUI
        if not inventory.component.visible:
            inventory.show()
        for child in inventory.component.itemView.children:
            child_component = child[1]
            if child_component.script.__class__.__name__ == 'soInventorySlot2':
                slot_item = child_component.script.itemData
                if slot_item and slot_item['complexItemType'] == item_type:
                    slot = child_component.script
                    item = slot_item
                    break
        else:
            if wait_seconds > 0:
                wait_time = 0.5
                BigWorld.callback(wait_time, partial(self.interact_item, item_type, action, wait_seconds - wait_time))
            else:
                self.show_error_and_break(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0442\u0438\u043f\u0430: ' + unicode(item_type))
            return

        BWPersonality.GUICore.inventoryEvent(INV_CONST.EVENT_CONTEXT, item, slot)
        for child in BWPersonality.GUICore.contextMenu.component.children:
            child_component = child[1]
            if child_component.script.__class__.__name__ == 'soContextMenuElement':
                if child_component.script.myLabel.text == action:
                    child_component.script.onClick()
                    break
        else:
            self.show_error_and_break(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435: ' + action)
            return

        inventory.hide()
        self.next_event()

    def close_dialog(self):
        BWPersonality.GUICore.dialogueGUI.component.closeBox.script.onClick()
        self.next_event()

    def get_items(self, items_list):
        self.awaited_items = []
        for item_desc in items_list:
            if 'amount' not in item_desc:
                item_desc['amount'] = 1
            BWPersonality.GUICore.chatConsole.run_command('item {0} {1}'.format(item_desc['type'], item_desc['amount']))
            self.awaited_items.append(item_desc)

        if not self.awaited_items:
            self.next_event()

    def item_added(self, item_type, amount):
        if not self.awaited_items:
            return
        for item_desc in list(self.awaited_items):
            if item_desc['type'] == item_type:
                item_desc['amount'] -= amount
                if item_desc['amount'] <= 0:
                    self.awaited_items.remove(item_desc)
            break

        if not self.awaited_items:
            self.next_event()

    def check_button(self, button_text, enable):
        for btn in BWPersonality.GUICore.dialogueGUI.btns:
            if btn.label.text == button_text:
                self.show_error_and_break(u'\u041a\u043d\u043e\u043f\u043a\u0438 \u0441 \u0442\u0435\u043a\u0441\u0442\u043e\u043c {0} \u0431\u044b\u0442\u044c \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e'.format(button_text))
                return

        self.next_event()

    def set_money(self, amount):
        money = BWPersonality.GUICore.inventoryDataSection['money'][0]
        if money == amount:
            self.next_event()
            return
        BWPersonality.GUICore.chatConsole.run_command('money ' + str(amount))

    def money_changed(self):
        self.next_event()

    def teleport_to(self, npc_name):
        for entity in BigWorld.entities.values():
            if getattr(entity, 'npcName', None) == npc_name:
                if BigWorld.player().position.distTo(entity.position) < 3.0:
                    self.teleported(True)
                    return
                break

        self.teleport_callback_id = BigWorld.callback(5.0, self.teleported)
        BWPersonality.GUICore.chatConsole.run_command('tpnpc ' + npc_name)
        return

    def start_dialog(self, npc_name, wait_time = 10):
        for entity in BigWorld.entities.values():
            if getattr(entity, 'npcName', None) == npc_name:
                BigWorld.player().cell.onStartTalk(entity.id, Constants.DEBUG_DIALOG_ID)
                break
        else:
            if wait_time > 0:
                next_wait_period = 2.0
                BigWorld.callback(next_wait_period, partial(self.start_dialog, npc_name, wait_time - next_wait_period))
            else:
                self.show_error_and_break(u'\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c NPC:' + npc_name)

        return

    def check_quests(self, quest_ids, wait_time = 3.0):
        closed = BigWorld.player().client_quests.get_closed()
        for quest_id in quest_ids:
            if quest_id not in closed:
                error = u'\u041a\u0432\u0435\u0441\u0442 {0} \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u043b\u0441\u044f'.format(quest_id)
            else:
                error = self.check_reward(quest_id)
            if error and wait_time > 0.0:
                wait_period = 0.5
                BigWorld.callback(wait_period, partial(self.check_quests, quest_ids, wait_time - wait_period))
                return
            if error:
                self.show_error_and_break(error)
                return

        self.next_event()

    def check_reward(self, quest_id):
        quest_reward = qd.getQuestOnID(quest_id)['Reward']
        item_types = quest_reward['TypeOfItems']
        if item_types:
            items_after = dict.fromkeys(item_types, 0)
            items_before = dict(items_after)
            ItemsUtils.GetItemQuantityExtended(BigWorld.player().CarryingItems, items_after)
            ItemsUtils.GetItemQuantityExtended(self.previous_wealth['items'], items_before)
            for i, item_type in enumerate(item_types):
                reward_amount = quest_reward['NumOfItems'][i]
                if items_after[item_type] - items_before[item_type] != reward_amount:
                    text = u'\u041d\u0435 \u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0441 \u0442\u0438\u043f\u043e\u043c {0} \u043f\u043e \u043a\u0432\u0435\u0441\u0442\u0443 {1}, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043e: {2}, \u043e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f: {3}'.format(item_type, quest_id, items_after[item_type] - items_before[item_type], reward_amount)
                    return text

        reward_money = quest_reward.get('Credits')
        if reward_money:
            cur_money = BWPersonality.GUICore.inventoryDataSection['money'][0]
            prev_money = self.previous_wealth['money']
            if cur_money - prev_money != reward_money:
                text = u'\u041d\u0435 \u0441\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0434\u0435\u043d\u044c\u0433\u0438: \u0431\u044b\u043b\u043e {0}, \u0441\u0442\u0430\u043b\u043e {1}, \u043d\u0430\u0433\u0440\u0430\u0434\u0430 {2}'.format(prev_money, cur_money, reward_money)
                return text
        reward_exp = quest_reward.get('Expirience')
        if reward_exp:
            p = BigWorld.player()
            if p.CombatExperience - self.previous_wealth['combat_exp'] != reward_exp[0] or p.SurvivalExperience - self.previous_wealth['survival_exp'] != reward_exp[1] or p.OtherExperience - self.previous_wealth['other_exp'] != reward_exp[2]:
                text = u'\u041d\u0435 \u0441\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043e\u043f\u044b\u0442: \u0431\u044b\u043b\u043e {0}, \u0441\u0442\u0430\u043b\u043e {1}, \u043d\u0430\u0433\u0440\u0430\u0434\u0430 {3}'.format((self.previous_wealth['combat_exp'], self.previous_wealth['survival_exp'], self.previous_wealth['other_exp']), (p.CombatExperience, p.SurvivalExperience, p.OtherExperience), reward_exp)
                return text

    def answer_rendered(self):
        self.next_event()

    def dialog_shown(self):
        self.next_event()

    def dialog_hide(self):
        self.next_event()

    def debug_ended(self):
        """ \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd0\xbe\xd1\x82\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb8 """
        global testerInstance
        if testerInstance == None:
            return
        else:
            testerInstance = None
            if self.teleport_callback_id:
                BigWorld.cancelCallback(self.teleport_callback_id)
                self.teleport_callback_id = None
            self.awaited_events = None
            BigWorld.player().setControlLock(Constants.ControlLockTypes.LOAD_WORLD, False)
            text = u"<font color='#0000ff'>{0}</font>".format(u'\u041e\u0442\u043b\u0430\u0434\u043a\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430')
            self.show_message(text)
            return

    def show_error_and_break(self, text):
        text = u"<font color='#ff0000'>{0}</font>".format(text)
        self.show_message(text)
        self.debug_ended()

    def show_message(self, text):
        BigWorld.player().putMessage(CHANNEL_CONSTS.SYSTEM, text)