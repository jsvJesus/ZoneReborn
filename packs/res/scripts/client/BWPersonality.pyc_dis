    if desc == 'weather':
        setWeather(data)


def expandMacros(stringIn):
    patt = '\\$([%s])' % ''.join(PYTHON_MACROS.keys())

    def repl(match):
        return PYTHON_MACROS[match.group(1)]

    return re.sub(patt, repl, stringIn)


