    def request_board_quests(self):
        """ \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb8\xd1\x82\xd1\x8c \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
        self.base.request_board_quests()

    def got_board_quests(self, quest_ids):
        """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb0 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd0\xb0\xd0\xba\xd1\x82\xd0\xb8\xd0\xb2\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2 """
        self._quest_board.update_quests(quest_ids)

    def request_quest_from_board(self, quest_id):
        """ \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd1\x8c \xd0\xb2\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82 """
        if quest_id in self.client_quests.get_opened():
            self.questerMessageToConsole(CTQ.get_error_message(CTQ.ERROR_BADSTATE))
            return
        self.base.request_quest_from_board(quest_id)

    def got_requested_quest(self, quest_id, request_result, update_result, quest_ids):
        """ \xd0\xbe\xd1\x82\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xb7\xd0\xb0\xd0\xbf\xd1\x80\xd0\xbe\xd1\x81\xd0\xb0 \xd0\xb2\xd0\xb7\xd1\x8f\xd1\x82\xd0\xb8\xd1\x8f \xd0\xb2\xd1\x8b\xd0\xb1\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xb0
                \xd0\xb4\xd0\xbe \xd0\xba\xd1\x83\xd1\x87\xd0\xb8 \xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd1\x8b\xd0\xbb\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbe\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x91\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb4\xd0\xbe\xd1\x81\xd1\x82\xd1\x83\xd0\xbf\xd0\xbd\xd1\x8b\xd1\x85 \xd0\xba\xd0\xb2\xd0\xb5\xd1\x81\xd1\x82\xd0\xbe\xd0\xb2
        """
        if update_result:
            self._quest_board.update_quests(quest_ids)
        if request_result == CTQ.OK:
            return
        if request_result == CTQ.ERROR_TIMEPOS:
            self._wating_for_time_remain = quest_id
            self.base.get_time_remain(quest_id)
        else:
            self.questerMessageToConsole(CTQ.get_error_message(request_result))

    def got_time_remain(self, time):
        if not hasattr(self, '_wating_for_time_remain'):
            return
        del self._wating_for_time_remain
        from DialogInterface import time_to_string
        time = time_to_string(time)
        message = CTQ.get_error_message(CTQ.ERROR_TIMEPOS).format(time)
        self.questerMessageToConsole(message)

    @property
    def _quest_board(self):
        return BWPersonality.GUICore.soBulletinBoard.quest_board