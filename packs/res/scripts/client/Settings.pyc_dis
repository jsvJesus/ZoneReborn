class GUISettings:
    INVENTORY_SIZES = {0: (4, 4),
     1: (4, 5),
     2: (4, 6),
     3: (4, 8),
     4: (4, 10),
     5: (6, 4),
     6: (6, 5),
     7: (6, 6),
     8: (6, 8),
     9: (6, 10),
     10: (8, 4),
     11: (8, 6),
     12: (8, 8),
     13: (8, 10),
     14: (10, 4),
     15: (10, 6),
     16: (10, 8),
     17: (10, 10)}

    def __init__(self):
        self.inventory_size = 0
        self.item_cache_size = 0
        self.map_size = 1
        self.dialog_not_close_by_interact_object = False

    def getMapSize(self):
        width = int(BigWorld.screenWidth())
        height = int(BigWorld.screenHeight())
        if self.map_size == 0:
            return (width / 2, height / 2)
        if self.map_size == 1:
            return (width / 1.5, height / 1.5)
        if self.map_size == 2:
            return (width / 1.15, height / 1.15)
        return (792, 560)

    def getInventorySize(self):
        return self.INVENTORY_SIZES[self.inventory_size]

    def getStoreSize(self):
        return self.INVENTORY_SIZES[self.item_cache_size]

    def getNumInvSize(self):
        return len(self.INVENTORY_SIZES) - self.inventory_size - 1

    def getNumStoreSize(self):
        return len(self.INVENTORY_SIZES) - self.item_cache_size - 1

    def setDNCBIO(self, value):
        self.dialog_not_close_by_interact_object = value

    def setMapSize(self, value):
        self.map_size = value
        w, h = self.getMapSize()
        BWPersonality.GUICore.setMapSize(w, h)

    def setInventorySize(self, value):
        self.inventory_size = value
        BWPersonality.GUICore.setInventorySize(self.INVENTORY_SIZES[value][0], self.INVENTORY_SIZES[value][1])

    def setStoreSize(self, value):
        self.item_cache_size = value
        BWPersonality.GUICore.setStoreSize(self.INVENTORY_SIZES[value][0], self.INVENTORY_SIZES[value][1])

    def getAllSizes(self):
        result = {}
        for key, item in self.INVENTORY_SIZES.items():
            result[key] = '{0}x{1}'.format(item[0], item[1])

        return result

    def getMapSizes(self):
        return {'0': lc('Settings.client.Little'),
         '1': lc('Settings.client.Medium_1'),
         '2': lc('Settings.client.Large')}


class OptionalSettings:

    def __init__(self):
