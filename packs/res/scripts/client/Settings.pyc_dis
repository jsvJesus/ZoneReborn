class Settings(object):
    instance = None

    def __new__(cls, *dt, **mp):
        if cls.instance is None:
            cls.instance = object.__new__(cls, *dt, **mp)
        return cls.instance

    ratios = {round(5.0 / 4, 2): (5, 4),
     round(4.0 / 3, 2): (4, 3),
     round(3.0 / 2, 2): (3, 2),
     round(16.0 / 10, 2): (16, 10),
     round(5.0 / 3, 2): (5, 3),
     round(16.0 / 9, 2): (16, 9),
     round(17.0 / 9, 2): (17, 9)}
    general_pp_chains = high_setting_ppchain, medium_setting_ppchain, low_setting_ppchain = ('High Graphics Setting', 'Medium Graphics Setting', 'Low Graphics Setting')
    general_pp_chains_by_quality = {VIDEO_QUALITIES.VIDEO_QUALITY_ULTRA: general_pp_chains.index(high_setting_ppchain),
     VIDEO_QUALITIES.VIDEO_QUALITY_HIGH: general_pp_chains.index(high_setting_ppchain),
     VIDEO_QUALITIES.VIDEO_QUALITY_NORMAL: general_pp_chains.index(medium_setting_ppchain),
     VIDEO_QUALITIES.VIDEO_QUALITY_LOW: general_pp_chains.index(low_setting_ppchain)}
    additional_ppchains = ppchain_ssao, ppchain_godrays = ('SSAO', 'god rays')
    additional_pp_chains_by_quality = {VIDEO_QUALITIES.VIDEO_QUALITY_ULTRA: {ppchain_godrays: True,
                                           ppchain_ssao: True},
     VIDEO_QUALITIES.VIDEO_QUALITY_HIGH: {ppchain_godrays: True,
                                          ppchain_ssao: True},
     VIDEO_QUALITIES.VIDEO_QUALITY_NORMAL: {ppchain_godrays: True,
                                            ppchain_ssao: False},
     VIDEO_QUALITIES.VIDEO_QUALITY_LOW: {ppchain_godrays: False,
                                         ppchain_ssao: False}}
    interface_pp_chains = ('Small', 'Normal', 'Big')
    default_pp_chain_index = general_pp_chains.index(high_setting_ppchain)
    min_sensitivity = 0.001
    max_sensitivity = 0.02
    default_sensitivity = 0.004
    default_sensitivity_value = (default_sensitivity - min_sensitivity) / (max_sensitivity - min_sensitivity)

    def __init__(self):
        if not hasattr(self, 'initialized'):
            self.sfx_change_observers = []
            self.keyBindings = None
            self.pendingKeyBinds = None
            self.current_PP_chain = None
            self.customSettingsSata = {}
            self.default_settings = {}
            self.optionalSettings = OptionalSettings()
            self.GUISettings = GUISettings()
            self.additionalsSettings = {self.ppchain_godrays: (0, ('On', 'Off'), (True, False)),
             self.ppchain_ssao: (0, ('On', 'Off'), (True, False))}
            self.initResolutions()
            self.loadSettings()
            self.loadAdditionalSettings()
            self.loadOptionalSettings()
            self.loadGUISettings()
            self.initKeyBindings()
            self.initGraphicPresets()
            self.graphicsSettingsChanged = False
            self.initialized = True
            BigWorld.callback(0, self.initSoundVolume)
            self.last_screen_mode_is_fullwindowed = False
        return

    def initSoundVolume(self):
        volume = self.getSetting('allVolume')
        import _FMOD
        _FMOD.setMasterVolume(volume)
        BWPersonality.music.updateVolume()

    def onInit(self):
        if self.getActualFullscreen():
            self.applyVideoMode()
        elif self.full_windowed_mode:
            BigWorld.callback(0.0, lambda : BigWorld.setWindowedFullScreen(1))

    def onRecreateDevice(self):
        self.setFullscreen(self.getActualFullscreen())
        self.full_windowed_mode = BigWorld.getWindowedFullScreen()
        BWPersonality.GUICore.loginFlash.screen_mode_was_changed(self.screen_mode)
        self.saveSettings()
        self.updateGUI()

    def need_restart(self):
        return self.graphicsSettingsChanged

    @staticmethod
    def getRatio(width, height):
        return Settings.ratios.get(round(float(width) / height, 2), (width, height))

    @staticmethod
    def filterVideoModes(videoMode, ratioExactFit = False):
        if videoMode['width'] < 1024:
            return False
        if videoMode['depth'] < 32:
            return False
        return True

    def getAllResolutionsSorted(self):
        return sorted(self.resolutions, cmp=lambda m1, m2: cmp(m1['width'], m2['width']) or cmp(m1['height'], m2['height']), reverse=True)

    def getMaxScreenSize(self):
        maxResolution = self.getAllResolutionsSorted()[0]
        return (maxResolution['width'], maxResolution['height'])

    @staticmethod
    def convertBoolToInt(boolean):
        if boolean:
            return 1
        return 0

    def onGuiCoreInitialized(self):
        self.updateGUI()
        self.applyPPchainIndex()
        self.applyAdditionalPPchains()
        self.applyMouseSensitivity()
        self.applyMouseInvert()

    def initGraphicPresets(self):
        sect = ResMgr.openSection(PRESETS_FILE)
        self.presets = {}
        self.presetNames = []
        for group in sect.values():
            presetName = group.asString
            if presetName:
                preset = {}
                for entry in group.values():
                    if entry.name == 'entry':
                        pref_name = entry.readString('label')
                        preset[pref_name] = entry.readInt('activeOption')

                self.presets[presetName] = preset
                self.presetNames.append(presetName)

    def loadSettings(self):
        self.default_settings = {'minimapMinimize': False,
         'fullscreen': False,
         'full_windowed_mode': False,
         'language': 'russian',
         'screenWidth': 1280,
         'screenHeight': 720,
         'preset': VIDEO_QUALITIES.VIDEO_QUALITY_ULTRA,
         'musicVolume': 1.0,
         'allVolume': 1.0,
         'sfxVolume': 1.0,
         'mouseSensitivity': self.default_sensitivity_value,
         'mouseInvert': False,
         'aspectRatio': '%s:%s' % self.screenRatio,
         'pp_chain': self.default_pp_chain_index,
         'keybindings': {},
         'inventory_size': 1,
         'item_cache_size': 6,
         'map_size': 1,
         'dialog_not_close_by_interact_object': False}
        self.__settings_dict__ = {}
        self.__settings_dict__.update(self.default_settings)
        self.__readJSON__()

    def loadAdditionalSettings(self):
        if not self.__settings_dict__.get('settings'):
            return
        pe_godrays = self.ppchain_godrays
        pe_ssao = self.ppchain_ssao
        self.additionalsSettings = {pe_godrays: (self.__settings_dict__.get('settings').get(pe_godrays), ('Off', 'On'), (False, True)),
         pe_ssao: (self.__settings_dict__.get('settings').get(pe_ssao), ('Off', 'On'), (False, True))}

    def loadGUISettings(self):
        defaults = self.GUISettings
        for k, v in vars(defaults).items():
            if v is None:
                del self.GUISettings.__dict__[k]

        options_from_saved = self.__settings_dict__
        if options_from_saved:
            defaults_dict = defaults.__dict__
            for k, v in options_from_saved.items():
                if k in defaults_dict and isinstance(v, type(defaults_dict[k])):
                    setattr(defaults, k, v)

        return

    def loadOptionalSettings(self, group_name = None):
        if group_name is None:
            group_name = 'settings_optional'
        defaults = self.optionalSettings
        for k, v in vars(defaults).items():
            if v is None:
                del self.optionalSettings.__dict__[k]

        options_from_saved = self.__settings_dict__.get(group_name)
        if options_from_saved:
            defaults_dict = defaults.__dict__
            for k, v in options_from_saved.items():
                if k in defaults_dict and isinstance(v, type(defaults_dict[k])):
                    setattr(defaults, k, v)

        return

    def setSetting(self, key, value, flush = True):
        value = self.filterSettingValue(key, value)
        self.__settings_dict__[key] = value
        if flush:
            self.saveSettings()
        if key == 'preset':
            self.applyGraphicsPreset()
            self.graphicsSettingsChanged = True

    def getSetting(self, key, default = None):
        if default is None:
            default = self.__settings_dict__.get(key)
        return self.__settings_dict__.get(key, default)

    @staticmethod
    def filterValueInRange(value, a, b, default = None):
        if a <= value <= b:
            return value
        elif default is not None:
            return default
        else:
            return min(max(value, a), b)

    @staticmethod
    def filterValueIsTyped(value, tp, default):
        try:
            return tp(value)
        except ValueError:
            print 'ValueError: value %s casting to %s. Using default %s' % (value, tp.__name__, default)
            return default

    @staticmethod
    def filterValueMatchesRegex(value, pattern, default):
        if not re.match(pattern, value):
            print "ValueError: value %s doesn't match pattern %s. Using default %s" % (value, pattern, default)
            return default
        return value

    def filterSettingValue(self, key, value):
        settings_types = {'musicVolume': float,
         'sfxVolume': float,
         'allVolume': float,
         'mouseSensitivity': float,
         'fullscreen': bool,
         'full_windowed_mode': bool,
         'isNotifyFriendList': bool,
         'mouseInvert': bool,
         'preset': int,
         'resolution': int,
         'pp_chain': int,
         'screenHeight': int,
         'screenWidth': int,
         'aspectRatio': str,
         'login': str,
         'language': str,
         'server_name': str,
         'item_cache_size': int,
         'inventory_size': int,
         'map_size': int,
         'dialog_not_close_by_interact_object': bool}
        settings_ranges = {'musicVolume': (0.0, 1.0),
         'sfxVolume': (0.0, 1.0),
         'allVolume': (0.0, 1.0),
         'mouseSensitivity': (0.0, 1.0),
         'preset': (0, 4),
         'resolution': (-1, len(self.resolutions) - 1),
         'pp_chain': (0, len(self.general_pp_chains) - 1),
         'screenWidth': (1024, self.maxScreenSize[0]),
         'screenHeight': (720, self.maxScreenSize[1])}
        settings_regex_matches = {'aspectRatio': '^\\d{1,2}:\\d{1,2}$'}
        default = self.__settings_dict__.get(key)
        if key in settings_types:
            tp = settings_types[key]
            value = self.filterValueIsTyped(value, tp, default)
        if key in settings_ranges:
            a, b = settings_ranges[key]
            value = self.filterValueInRange(value, a, b, default)
        if key in settings_regex_matches:
            value = self.filterValueMatchesRegex(value, settings_regex_matches[key], default)
        return value

    def saveSettings(self):
        self.__writeJSON__()

    def initResolutions(self):

        def makeResDict(_id, _width, _height, _depth, _name):
            res_dict = {'name': '%sx%s' % (_width, _height),
             'id': _id,
             'width': _width,
             'height': _height,
             'depth': _depth,
             'ratio': self.getRatio(_width, _height)}
            return res_dict

        self.resolutions = [ makeResDict(vid, width, height, depth, name) for vid, width, height, depth, name in BigWorld.listVideoModes() if depth >= 32 and width >= 1024 ]
        self.maxScreenSize = self.getMaxScreenSize()
        self.screenRatio = self.getRatio(*self.maxScreenSize)
        self.resolutions_by_ratio = {}
        self.resolutions_by_id = {}
        for r in self.resolutions:
            if r['ratio'] not in self.resolutions_by_ratio:
                self.resolutions_by_ratio[r['ratio']] = []
            self.resolutions_by_ratio[r['ratio']].append(r)
            self.resolutions_by_id[r['id']] = r

        self.ratios = sorted(self.resolutions_by_ratio.keys(), cmp=lambda w, h: (w, h) == self.screenRatio, reverse=True)

    def getResolutionList(self, aspectRatio = None):
        if aspectRatio is None:
            return self.resolutions
        else:
            return self.resolutions_by_ratio.get(aspectRatio) or list()
            return

    def getFullscreen(self):
        """\xd0\x9f\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd1\x81\xd0\xba\xd0\xb8\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc\xd0\xb0."""
        return self.getSetting('fullscreen')

    def getLanguage(self):
        return self.getSetting('language')

    def setLanguage(self, language):
        self.setSetting('language', language)

    def getNotifyFriendList(self):
        return self.getSetting('isNotifyFriendList')

    @staticmethod
    def getActualFullscreen():
        """\xd0\xaf\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82\xd1\x81\xd1\x8f \xd0\xbb\xd0\xb8 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc."""
        return not BigWorld.isVideoWindowed()

    def setFullscreen(self, fullscreen):
        self.setSetting('fullscreen', fullscreen)

    def setNotifyFriendList(self, isNotifyFriendList):
        return self.setSetting('isNotifyFriendList', isNotifyFriendList)

    def applyFullscreen(self):
        self.applyVideoMode()

    def getResolutionID(self):
        return self.getSetting('resolution')

    def getResolutionByID(self, _id = None):
        if _id is not None and _id in self.resolutions_by_id:
            return self.resolutions_by_id[_id]
        else:
            width = int(BigWorld.screenWidth())
            height = int(BigWorld.screenHeight())
            for r in self.resolutions:
                if width == r['width'] and height == r['height']:
                    return r

            r = {'id': None,
             'width': width,
             'height': height,
             'name': '%sx%s' % (width, height),
             'ratio': self.getRatio(width, height)}
            return r

    def getActualResolution(self):
        """resolution that is currently applied"""
        width = int(BigWorld.screenWidth())
        height = int(BigWorld.screenHeight())
        return self.getResolution(width, height)

    def getResolution(self, width_or_id = None, height = None):
        """returns resolution as dict
        getResolution() currently selected in settings
        getResolution(id) finds it by id, else None
        getResolution(width,height) id is None if this this videomode is not listed in supported videomodes
        :param width_or_id:
        :param height:
        """
        if height is None:
            if width_or_id is None:
                width_or_id, height = self.getSetting('screenWidth'), self.getSetting('screenHeight')
            elif width_or_id in self.resolutions_by_id:
                return self.resolutions_by_id[width_or_id]
            else:
                return

        for r in self.resolutions:
            if width_or_id == r['width'] and height == r['height']:
                return r

        ret_dict = {'id': None,
         'width': width_or_id,
         'height': height,
         'name': '%sx%s' % (width_or_id, height),
         'ratio': self.getRatio(width_or_id, height)}
        return ret_dict

    def setResolution(self, width_or_resolution_or_ID, height = None):
        if height is None:
            if isinstance(width_or_resolution_or_ID, int):
                r = self.getResolution(width_or_resolution_or_ID)
            else:
                r = width_or_resolution_or_ID
            width_or_resolution_or_ID, height = r['width'], r['height']
        self.setSetting('screenWidth', width_or_resolution_or_ID)
        self.setSetting('screenHeight', height)
        self.graphicsSettingsChanged = True
        self.applyVideoMode()
        return

    def setGUISettings(self, setting, value):
        if setting == 'inventory_size':
            self.GUISettings.setInventorySize(value)
        elif setting == 'item_cache_size':
            self.GUISettings.setStoreSize(value)
        elif setting == 'dialog_not_close_by_interact_object':
            self.GUISettings.setDNCBIO(value)
        elif setting == 'map_size':
            self.GUISettings.setMapSize(value)
        self.setSetting(setting, value, flush=True)

    @property
    def full_windowed_mode(self):
        return self.getSetting('full_windowed_mode')

    @full_windowed_mode.setter
    def full_windowed_mode(self, value):
        self.setSetting('full_windowed_mode', value, flush=True)

    @property
    def screen_mode(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x82\xd0\xb5\xd0\xba\xd1\x83\xd1\x89\xd0\xb8\xd0\xb9 \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc."""
        mode = None
        if self.getActualFullscreen():
            mode = SCREEN_MODE_NAME_TO_CODE['fullScreen']
        elif self.full_windowed_mode:
            mode = SCREEN_MODE_NAME_TO_CODE['fullWindowed']
        else:
            mode = SCREEN_MODE_NAME_TO_CODE['windowed']
        return mode

    def set_screen_mode(self, mode):
        """\xd0\xa3\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc.
        :param mode:
        """
        if mode == self.screen_mode:
            return
        mode_name = SCREEN_MODE_CODE_TO_NAME[mode]
        if mode_name == 'fullScreen':
            self.setFullscreen(True)
            if BigWorld.getWindowedFullScreen():
                BigWorld.setWindowedFullScreen(0)
            self.applyVideoMode()
        elif mode_name == 'fullWindowed':
            self.changeWindowedFullScreen()
        elif mode_name == 'windowed':
            if BigWorld.getWindowedFullScreen():
                BigWorld.setWindowedFullScreen(0)
                self.full_windowed_mode = False
            elif self.getActualFullscreen():
                self.setFullscreen(False)
            self.applyVideoMode()

    def changeFullScreen(self):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c / \xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc."""
        if self.getActualFullscreen():
            self.setFullscreen(False)
            self.applyVideoMode()
            if self.last_screen_mode_is_fullwindowed:

                def on_windowed_fullscreen():
                    BigWorld.setWindowedFullScreen(1)
                    self.full_windowed_mode = True

                utils_bw.wait(condition_callable=lambda : not self.getActualFullscreen(), on_success_callable=on_windowed_fullscreen)
        else:
            if self.full_windowed_mode:
                self.last_screen_mode_is_fullwindowed = True
            else:
                self.last_screen_mode_is_fullwindowed = False
            self.setFullscreen(True)
            self.applyVideoMode()

    def changeWindowedFullScreen(self):
        """\xd0\x92\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c / \xd0\xb2\xd1\x8b\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82\xd1\x8c \xd0\xbe\xd0\xba\xd0\xbe\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xbe\xd1\x8d\xd0\xba\xd1\x80\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x80\xd0\xb5\xd0\xb6\xd0\xb8\xd0\xbc."""

        def on_windowed_fullscreen():
            BigWorld.setWindowedFullScreen(1)
            self.full_windowed_mode = True

        if self.getActualFullscreen():
            self.setFullscreen(False)
            self.applyVideoMode()
            utils_bw.wait(condition_callable=lambda : not self.getActualFullscreen(), on_success_callable=on_windowed_fullscreen)
        elif self.full_windowed_mode:
            BigWorld.setWindowedFullScreen(0)
            self.applyVideoMode()
            self.full_windowed_mode = False
        else:
            on_windowed_fullscreen()

    def applyVideoMode(self):
        """
        Applies selected resolution and fullscreen
        Many magic here!
        """
        target_resolution = self.getResolution()
        target_id = target_resolution['id']
        actual_resolution = self.getActualResolution()
        if not not self.getFullscreen():
            must_be_windowed = target_resolution['id'] is None
            is_windowed = not self.getActualFullscreen()
            return is_windowed == must_be_windowed and actual_resolution['width'] == target_resolution['width'] and actual_resolution['height'] == target_resolution['height'] and None
        else:
            if must_be_windowed:
                if not is_windowed:
                    if target_id is None:
                        _id = actual_resolution['id']
                    else:
                        _id = target_id
                    BigWorld.changeVideoMode(_id, True)
                BigWorld.resizeWindow(target_resolution['width'], target_resolution['height'])
            else:
                BigWorld.changeVideoMode(target_id, False)
                ratio = float(target_resolution['width']) / target_resolution['height']
                BigWorld.changeFullScreenAspectRatio(ratio)
            return

    def getGraphicsPresetIndex(self):
        return self.getSetting('preset')

    @staticmethod
    def getActualGraphicsPreferences():
        currentPrefs = {}
        for pref in BigWorld.graphicsSettings():
            currentPrefs[pref[0]] = pref[1]

        return currentPrefs

    def getActualGraphicsPresetIndex(self):
        currentPrefs = self.getActualGraphicsPreferences()
        for preset_index, preset_name in presetNamesIndexes:
            preset = self.presets[preset_name]
            for pref_name, pref_value in preset.items():
                if pref_name in currentPrefs and currentPrefs[pref_name] != pref_value:
                    if DEBUG_PRINTS:
                        print 'NO', pref_name, '=', currentPrefs[pref_name], ', NOT', pref_value
                    break
            else:
                if DEBUG_PRINTS:
                    print 'YES'
                return preset_index

        return VIDEO_QUALITIES.VIDEO_QUALITY_CUSTOM

    def setGraphicsPresetIndex(self, index):
        self.setSetting('preset', index)

    def applyGraphicsPreset(self):
        index = self.getGraphicsPresetIndex()
        if index == VIDEO_QUALITIES.VIDEO_QUALITY_CUSTOM:
            current_prefs = self.getActualGraphicsPreferences()
            if self.customSettingsSata:
                settings = self.customSettingsSata
            else:
                settings = self.__settings_dict__.get('settings')
            for k, v in settings.items():
                if k in self.additionalsSettings.keys():
                    self.changeAdditionalsSettings(k, v)
                elif k in current_prefs and current_prefs[k] != v:
                    BigWorld.setGraphicsSetting(k, v)
                    self.graphicsSettingsChanged = True
                    self.customSettingsSata = None
                BigWorld.setGraphicsSetting('FOOT_PRINTS', 1)

            return
        else:
            current_index = self.getActualGraphicsPresetIndex()
            if index == current_index:
                return
            namesByIndexes = dict(presetNamesIndexes)
            preset_name = namesByIndexes[index]
            preset = self.presets[preset_name]
            settings = self.__settings_dict__.get('settings')
            if DEBUG_PRINTS:
                print 'preset:', preset_name
            current_prefs = self.getActualGraphicsPreferences()
            settings.update(current_prefs)
            postprocess_config = self.additional_pp_chains_by_quality[index]
            postprocess_prefs = dict([ (k, self.convertBoolToInt(v)) for k, v in postprocess_config.items() ])
            settings.update(postprocess_prefs)
            self.loadAdditionalSettings()
            for k, v in preset.items():
                if k in current_prefs and current_prefs[k] != v:
                    try:
                        BigWorld.setGraphicsSetting(k, v)
                        if DEBUG_PRINTS:
                            print k, v, 'OK'
                    except:
                        if DEBUG_PRINTS:
                            print k, v, 'Failed'

                    self.graphicsSettingsChanged = True

            BigWorld.setGraphicsSetting('FOOT_PRINTS', 1)
            if index in self.general_pp_chains_by_quality:
                valid_PPchain_index = self.general_pp_chains_by_quality[index]
                self.setPPchainIndex(valid_PPchain_index)
                self.applyPPchainIndex()
            self.applyAdditionalPPchains()
            return

    def getMusicVolume(self):
        return self.getSetting('musicVolume')

    def getAllVolume(self):
        return self.getSetting('allVolume')

    def setAllVolume(self, volume):
        self.setSetting('allVolume', volume, True)
        import _FMOD
        _FMOD.setMasterVolume(volume)

    def setMusicVolume(self, volume):
        self.setSetting('musicVolume', volume, True)
        for sound in BWPersonality.sounds.Sound.current_sounds:
            if sound.is_music:
                sound.volume = volume

        BWPersonality.music.updateVolume()

    def getSfxVolume(self):
        return self.getSetting('sfxVolume')

    def setSfxVolume(self, volume):
        self.setSetting('sfxVolume', volume, True)
        for sound in BWPersonality.sounds.Sound.current_sounds:
            if not sound.is_music:
                sound.volume = volume

        BWPersonality.gpd.weather.updateSonuds()
        self.notifySfxChangeObservers(volume)

    def addSfxChangeObserver(self, observer):
        if observer not in self.sfx_change_observers:
            self.sfx_change_observers.append(observer)

    def removeSfxChangeObserver(self, observer):
        self.sfx_change_observers.remove(observer)

    def notifySfxChangeObservers(self, volume):
        for observer in self.sfx_change_observers:
            observer.sfxVolumeChanged(volume)

    def playerChangeShell(self, player_outside):
        for observer in self.sfx_change_observers:
            observer.playerChangeShell(player_outside)

    def getMouseSensitivity(self):
        return self.getSetting('mouseSensitivity')

    def setMouseSensitivity(self, volume):
        self.setSetting('mouseSensitivity', volume)

    def applyMouseSensitivity(self):
        BigWorld.dcursor().mouseSensitivity = self.min_sensitivity + (self.max_sensitivity - self.min_sensitivity) * self.getMouseSensitivity()

    def set_and_apply_mouse_sensitive(self, value):
        self.setSetting('mouseSensitivity', value)
        self.applyMouseSensitivity()

    def getAspectRatio(self):
        return tuple(map(int, self.getSetting('aspectRatio').split(':')))

    def setAspectRatio(self, ratio):
        self.setSetting('aspectRatio', '%s:%s' % ratio)

    def applyAspectRatio(self):
        pass

    def getMouseInvert(self):
        return self.getSetting('mouseInvert')

    def setMouseInvert(self, mouseInvert):
        self.setSetting('mouseInvert', mouseInvert)

    def applyMouseInvert(self):
        BigWorld.dcursor().invertVerticalMovement = self.getMouseInvert()

    def set_and_apply_mouse_invert(self, value):
        self.setSetting('mouseInvert', value)
        self.applyMouseInvert()

    def getPPchainIndex(self):
        return self.getSetting('pp_chain')

    def setPPchainIndex(self, pp_chain_index):
        self.setSetting('pp_chain', pp_chain_index)

    def applyPPchainIndex(self):
        valid_pp_chain = self.general_pp_chains[self.getPPchainIndex()]
        if DEBUG_PRINTS:
            print 'PP chain', valid_pp_chain
        if self.current_PP_chain != valid_pp_chain:
            old_PP_chain = self.current_PP_chain
            if self.current_PP_chain:
                if not self.unload_PP_chain(self.current_PP_chain):
                    print 'Cant unload old ppchain(%s), so you cant load new one(%s)' % (self.current_PP_chain, valid_pp_chain)
                    return False
                self.current_PP_chain = None
            if self.load_PP_chain(valid_pp_chain):
                self.current_PP_chain = valid_pp_chain
                return True
            if old_PP_chain and self.load_PP_chain(old_PP_chain):
                self.current_PP_chain = old_PP_chain
            return False
        else:
            return

    def applyAdditionalPPchains(self):
        quality = self.getGraphicsPresetIndex()
        additionals = {}
        if quality == VIDEO_QUALITIES.VIDEO_QUALITY_CUSTOM:
            for k, v in self.additionalsSettings.items():
                if v[0] is None:
                    additionals[k] = v[2][0]
                else:
                    additionals[k] = v[2][v[0]]

        else:
            additionals = self.additional_pp_chains_by_quality[quality]
        for chain, value in additionals.items():
            if value:
                if not self.load_PP_chain(chain):
                    print 'Cant load pp chain:', chain
            elif not self.unload_PP_chain(chain):
                print 'Cant unload pp chain:', chain

        return

    def apply(self):
        self.applyGraphicsPreset()
        self.applyVideoMode()
        self.applyMouseSensitivity()
        self.applyMouseInvert()
        self._applyPendingKeyBindings()

    @staticmethod
    def vmToStr(vm):
        return '{w}x{h} ({r[0]}:{r[1]})'.format(w=vm['width'], h=vm['height'], r=vm['ratio'])

    def writePreferencesDict(self, preferences):
        if DEBUG_PRINTS:
            print 'Write preferences'
        r = self.getResolution()
        devicePreferences = {'devicePreferences/windowed': not self.getFullscreen(),
         'devicePreferences/aspectRatio': float(r['width']) / r['height'],
         'devicePreferences/windowedWidth': r['width'],
         'devicePreferences/windowedHeight': r['height'],
         'devicePreferences/fullscreenWidth': r['width'],
         'devicePreferences/fullscreenHeight': r['height']}
        for setting, value in devicePreferences.items():
            writeDataSectionValue(preferences, setting, value)

        preset_index = self.getGraphicsPresetIndex()
        if preset_index != VIDEO_QUALITIES.VIDEO_QUALITY_CUSTOM:
            preset_name = dict(presetNamesIndexes)[preset_index]
            preset = self.presets[preset_name]
            for sect_name, entry in preferences['graphicsPreferences'].items():
                if sect_name == 'entry':
                    pref_name = entry['label'].asString
                    if pref_name in preset:
                        writeDataSectionValue(entry, 'activeOption', preset[pref_name])

        else:
            settings = self.__settings_dict__.get('settings')
            for sect_name, entry in preferences['graphicsPreferences'].items():
                if sect_name == 'entry':
                    pref_name = entry['label'].asString
                    if pref_name in settings:
                        writeDataSectionValue(entry, 'activeOption', settings[pref_name])

        if DEBUG_PRINTS:
            for k, v in preferences['graphicsPreferences'].items():
                if k == 'entry':
                    print v._label.asString, v._activeOption.asString

            for k, v in preferences['devicePreferences'].items():
                print k, v.asString

    def getAdditionOptionValue(self):
        return self.additionalsSettings

    def applyLanguage(self, language):
        self.setLanguage(language)
        self.saveSettings()

    def apply_additional_video_settings(self, data):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb4\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xb3\xd1\x80\xd0\xb0\xd1\x84\xd0\xb8\xd0\xba\xd0\xb8.
        :param data:
        """
        self.setGraphicsPresetIndex(VIDEO_QUALITIES.VIDEO_QUALITY_CUSTOM)
        self.customSettingsSata = data
        self.applyGraphicsPreset()
        self.graphicsSettingsChanged = True
        self.saveSettings()

    def apply_main_video_settings(self, data):
        """\xd0\x9f\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbe\xd1\x81\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x81\xd1\x82\xd1\x80\xd0\xbe\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xb3\xd1\x80\xd0\xb0\xd1\x84\xd0\xb8\xd0\xba\xd0\xb8.
        :param data:
        """
        functions = {'quality': self.setGraphicsPresetIndex,
         'resolution': self.setResolution,
         'screen_mode': self.set_screen_mode}
        try:
            if data['DYNAMIC_SHADOW'] == 'Off':
                data['SHADOWS_QUALITY'] = 3
                data['SHADOWS_COUNT'] = 7
        except KeyError:
            pass

        for key, value in data.items():
            functions[key](value)

        self.saveSettings()

    @staticmethod
    def unload_PP_chain(pp_chain):
        return pp_chain not in BWPersonality.GUICore.getCurrentSysPPs() or BWPersonality.GUICore.delSysPPEffect(pp_chain)

    @staticmethod
    def load_PP_chain(pp_chain):
        return pp_chain in BWPersonality.GUICore.getCurrentSysPPs() or BWPersonality.GUICore.addSysPPEffect(pp_chain)

    @staticmethod
    def updateGUI():
        BWPersonality.GUICore.loginFlash.doReposition()
        if BWPersonality.GUICore.chatConsole:
            BWPersonality.GUICore.chatConsole.doReposition()

    def changeAdditionalsSettings(self, key, value):
        oldValue = self.additionalsSettings[key]
        if oldValue[0] != value:
            self.graphicsSettingsChanged = True
        self.additionalsSettings[key] = (value, oldValue[1])

    def getKeybindingsDict(self):
        return self.getSetting('keybindings')

    def setKeybindingsDict(self, d):
        self.setSetting('keybindings', d)

    def setKeybinding(self, actionName, value):
        d = dict(self.getKeybindingsDict())
        d[actionName] = value
        self.setKeybindingsDict(d)

    def _setKeyBind(self, action, keyN, keyCodes):
        keyN = 0
        kcCopy = list(keyCodes)
        for index, keyCode in enumerate(kcCopy):
            if keyCode in BWKeyBindings.KEY_ALIAS_CONTROL:
                kcCopy[index] = BWKeyBindings.KEY_ALIAS_CONTROL
            if keyCode in BWKeyBindings.KEY_ALIAS_ALT:
                kcCopy[index] = BWKeyBindings.KEY_ALIAS_ALT
            if keyCode in BWKeyBindings.KEY_ALIAS_SHIFT:
                kcCopy[index] = BWKeyBindings.KEY_ALIAS_SHIFT
            if keyCode in BWKeyBindings.KEY_ALIAS_WINDOWS:
                kcCopy[index] = BWKeyBindings.KEY_ALIAS_WINDOWS

        keyCodes = tuple(kcCopy)
        if action in self.keyBindings.actionsByName:
            if self.pendingKeyBinds is None:
                self.pendingKeyBinds = {}
            pendingKeys = self._getPendingKeys()
            if (keyCodes,) in pendingKeys:
                del self.pendingKeyBinds[pendingKeys[keyCodes]]
            self.pendingKeyBinds[action] = (keyCodes,)
        self._applyPendingKeyBindings()
        self.setKeybindingsDict(self.keyBindings.JSON_getKeyBindingsDict())
        self.saveSettings()
        return

    def _applyPendingKeyBindings(self):
        if self.pendingKeyBinds is None:
            return
        else:
            for action in self.pendingKeyBinds:
                if action in self.keyBindings.actionsByName:
                    binding = self.keyBindings.actionsByName[action]
                    binding.bindings = self.pendingKeyBinds[action]
                    pending_key = self.pendingKeyBinds[action][0]
                    if pending_key in self.keyBindings.actionsByBinding:
                        action_key = self.keyBindings.actionsByBinding[pending_key][0]
                        if action_key not in self.pendingKeyBinds:
                            bindingName = self.keyBindings.actionsByBinding[pending_key][0]
                            if bindingName != action:
                                binding = self.keyBindings.actionsByName[bindingName]
                                binding.bindings = ()

            self.keyBindings.buildBindList()
            self.pendingKeyBinds = None
            return

    def _resetKeyBindings(self):
        self.pendingKeyBinds = None
        defBinds = ResMgr.openSection('scripts/client/data/default_key_bindings.xml')
        userBinds = {}
        self.keyBindings.readInDefaultKeyBindings(defBinds)
        self.keyBindings.buildBindList()
        self.keyBindings.JSON_readInPreferenceKeyBindings(userBinds)
        self.keyBindings.buildBindList()
        self.saveSettings()
        self.updateGUI()
        return

    def _clearKeyBinding(self, actionName):
        if actionName not in self.keyBindings.actionsByName:
            return
        else:
            if self.pendingKeyBinds is None:
                self.pendingKeyBinds = {}
            self.pendingKeyBinds[actionName] = ((),)
            self.updateGUI()
            return

    def _makeKeyBinds(self):
        keyBindings = BWKeyBindings.BWKeyBindings()
        defBinds = ResMgr.openSection('scripts/client/data/default_key_bindings.xml')
        userBinds = self.getKeybindingsDict()
        keyBindings.readInDefaultKeyBindings(defBinds)
        keyBindings.buildBindList()
        keyBindings.JSON_readInPreferenceKeyBindings(userBinds)
        keyBindings.buildBindList()
        return keyBindings

    def _getPendingKeys(self):
        data = {}
        if self.pendingKeyBinds is None:
            return data
        else:
            for action in self.pendingKeyBinds:
                data[self.pendingKeyBinds[action]] = action

            return data

    def _getKeyBindsVisualData(self):
        data = []
        if self.keyBindings is None:
            return data
        else:
            data = [None] * len(self.keyBindings.actionsByName)
            for actionName in self.keyBindings.actionsByName:
                actionBinding = self.keyBindings.actionsByName[actionName]
                if self.pendingKeyBinds is not None:
                    if actionName in self.pendingKeyBinds:
                        keyBinds = self.pendingKeyBinds[actionName]
                        key1Name = u''
                        key2Name = u''
                        if len(keyBinds) > 0:
                            if len(keyBinds[0]) > 0:
                                key1Name = BWKeyBindings._keyToString(keyBinds[0][0])
                            if len(keyBinds[0]) > 1:
                                key1Name = '{0} + {1}'.format(BWKeyBindings._keyToString(keyBinds[0][1]), key1Name)
                        entry = [actionName,
                         key1Name,
                         key2Name,
                         actionBinding.displayName,
                         True]
                        data[actionBinding.number] = entry
                        continue
                key1Name = u''
                key2Name = u''
                if len(actionBinding.bindings) > 0:
                    if len(actionBinding.bindings[0]) > 0:
                        key1Name = BWKeyBindings._keyToString(actionBinding.bindings[0][0])
                    if len(actionBinding.bindings[0]) > 1:
                        key1Name = '{0} + {1}'.format(BWKeyBindings._keyToString(actionBinding.bindings[0][1]), key1Name)
                entry = [actionName,
                 key1Name,
                 key2Name,
                 actionBinding.displayName,
                 False]
                data[actionBinding.number] = entry

            return data

    def get_key_binds(self):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xb0\xd0\xba\xd1\x82\xd1\x83\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd1\x8f\xd0\xb7\xd0\xba\xd0\xb8 \xd0\xb4\xd0\xb5\xd0\xb9\xd1\x81\xd1\x82\xd0\xb2\xd0\xb8\xd0\xb9 \xd0\xba \xd0\xba\xd0\xbd\xd0\xbe\xd0\xbf\xd0\xba\xd0\xb0\xd0\xbc."""
        binding_actions = collections.defaultdict(list)
        for actionName in self.keyBindings.actionsByName:
            actionBinding = self.keyBindings.actionsByName[actionName]
            if actionBinding.bindings:
                for binding in actionBinding.bindings:
                    key_name = BWKeyBindings._keyToString(binding[0])
                    binding_actions[actionName].append(key_name)

            else:
                key_name = ''
                binding_actions[actionName].append(key_name)

        return binding_actions

    def initKeyBindings(self):
        self.keyBindings = self._makeKeyBinds()
        self.keyBindings.addHandler(BWPersonality.BWPersonalityActionHandler())

    def keyBindingsOptionsHandler(self, actionName, keyN, keyCodes):
        self._setKeyBind(actionName, keyN, keyCodes)

    def __readJSON__(self):
        settings_filepath = os.path.join(BWPersonality.GAME_DIR, SETTINGS_FILE)
        if os.path.isfile(settings_filepath):
            try:
                with open(settings_filepath, 'r') as f:
                    d = json.load(f, encoding='utf-8')
                    for k, v in d.items():
                        d[k] = self.filterSettingValue(k, v)

                    self.__settings_dict__.update(d)
            except IOError:
                print 'IOError: ', SETTINGS_FILE
            except ValueError:
                print SETTINGS_FILE, "can't be parsed!"

    def __writeJSON__(self):
        settings_filepath = os.path.join(BWPersonality.GAME_DIR, SETTINGS_FILE)
        names = {}
        for pref in BigWorld.graphicsSettings():
            names[pref[0]] = pref[1]

        for k, v in self.additionalsSettings.items():
            names[k] = v[0]

        newDict = self.__settings_dict__
        newDict['settings'] = names
        newDict['settings_optional'] = self.optionalSettings.__dict__
        with open(settings_filepath, 'w') as f:
            s = json.dumps(newDict, f, sort_keys=True, indent=4, encoding='utf-8')
            f.write(s)
            f.flush()