# Embedded file name: ./scripts/client/SpiderFake.py
from utils_bw import if_not_destroyed
import BigWorld
import SFXer
import Math
import math
import random
import Pixie
import BWPersonality
import traceback
import PlayerAvatar
import utils_bw

class SpiderFake(object):
    S_MAXSTEPS = 3000
    S_MODELHEIGHT = 1.0
    S_STEP_SIZE = 0.02
    S_STEP_TIME = 0.01
    S_DAMAGE = True
    S_SPAWNMINTIME = 0.5
    S_SPAWNMAXTIME = 2.0
    S_SPAWNMIN = 1
    S_SPAWNMAX = 10
    S_CAMUP = Math.Vector3(0.01, 1.0, 0.01)
    _timerFakeDamageID = 0
    _timerSpSpawnID = 0
    _isShosDamage = False
    __isSpiderEffect = False
    _timerSpTickID = None

    def onEnterWorld(self):
        self.spiderModelsDict = {}
        self.fakeDamage()

    def startSpiderHallucianations(self):
        print 'startSpiderHallucianations'
        self.__isSpiderEffect = True
        self.start_stepping()
        self._isShosDamage = True
        if not self._timerSpSpawnID:
            self.spiderHallucianationsSpawnTick()

    def stopSpiderHallucianations(self):
        print 'stopSpiderHallucianations'
        self.__isSpiderEffect = False
        self._isShosDamage = False
        if self._timerSpSpawnID:
            BigWorld.cancelCallback(self._timerSpSpawnID)
        self._timerSpSpawnID = 0
        BigWorld.camera().uprightDirection = (0, 1, 0)

    def spiderHallucianationsSpawnTick(self):
        timeResp = random.randrange(1, 5, int=float)
        self._timerSpSpawnID = BigWorld.callback(timeResp, self.spiderHallucianationsSpawnTick)
        if not self.isInWorld:
            return
        BigWorld.camera().uprightDirection = self.S_CAMUP
        cpos = BigWorld.camera().position
        cdir = BigWorld.camera().direction
        for x in range(random.randrange(self.S_SPAWNMIN, self.S_SPAWNMAX)):
            cdir = Math.Vector3(cdir.x + random.random() / 5 * random.choice([1, -1, 0]), cdir.y + random.random() / 5 * random.choice([1, -1, 0]), cdir.z + random.random() / 5 * random.choice([1, -1, 0]))
            self.add_spider_by_collision(cpos, cdir)

    def cancelSpider(self):
        self._isShosDamage = False
        if self._timerSpTickID:
            BigWorld.cancelCallback(self._timerSpTickID)
            self._timerSpTickID = None
        BigWorld.cancelCallback(self._timerFakeDamageID)
        BigWorld.cancelCallback(self._timerSpSpawnID)
        for model in self.spiderModelsDict:
            self.delModel(model)

        self.spiderModelsDict = {}
        BigWorld.camera().uprightDirection = (0, 1, 0)
        return

    @if_not_destroyed
    def fakeDamage(self):
        self._timerFakeDamageID = BigWorld.callback(random.randrange(1, 5, int=float), self.fakeDamage)
        if not self.isInWorld:
            return
        if self.S_DAMAGE and self._isShosDamage and self.spiderModelsDict:
            if random.random() > 0.6:
                direct = random.randrange(0, 5)
                BWPersonality.GUICore.showDamage(random.randrange(0.5, 3, int=float), direct, 1)
                if direct < 5:
                    BigWorld.camera().shake(0.04, (0.01, 0.01, 0.01))

    def add_spider_by_collision(self, scrFrom, direction, distance = 30.0, scale = 1.0):
        if not self.isInWorld:
            return
        posTo = scrFrom + direction * distance
        col = utils_bw.collide(self.spaceID, scrFrom, posTo)
        if not col:
            return False
        target_normal = SFXer.tri_normal(col[1])
        target_normal.normalise()
        self.add_spider_by_position(col[0], normal=target_normal, distance=distance, scale=scale)

    def add_spider_by_position(self, position, normal = Math.Vector3(0, 1, 0), step_size = None, distance = 30.0, scale = 1.0, model_path = 'characters/creatures/spider/spider.model', tint = None, event_listener = None):
        if not self.isInWorld:
            return
        m = BigWorld.Model(model_path)
        self.addModel(m)
        if tint:
            try:
                m.body = tint
            except:
                print 'SpiderFake (ERROR): not tint named {0} for {1}'.format(tint, model_path)
                traceback.print_exc()

        matr = Math.Matrix(m.matrix)
        modeldir = matr.applyToAxis(1)
        modeldir.normalise()
        m.position = position
        axis = modeldir * normal
        axis.normalise()
        angle = math.acos(modeldir.dot(normal))
        m.rotate(angle, axis, (0, 0, 0))
        matr = Math.Matrix(m.matrix)
        modeldirUp = matr.applyToAxis(1)
        m.rotate(random.random() * 6, modeldirUp, (0, 0, 0))
        rrr = random.random() / 10
        m.scale = (0.1 + rrr, 0.1 + rrr, 0.1 + rrr)
        try:
            m.Spider_DigOut().Spider_walk_fake2()
        except:
            traceback.print_exc()

        def addToDict():
            if self.isDestroyed:
                return
            self.spiderModelsDict[m] = (0, step_size or self.S_STEP_SIZE, event_listener)

        BigWorld.callback(1.0, addToDict)

    def start_stepping(self):
        if self._timerSpTickID:
            BigWorld.cancelCallback(self._timerSpTickID)
            self._timerSpTickID = None
        self.stepSpiders()
        return

    @if_not_destroyed
    def stepSpiders(self):
        if not self.__isSpiderEffect and not self.spiderModelsDict and not getattr(self, 'marked_by_spider_area', False):
            return
        self._timerSpTickID = BigWorld.callback(self.S_STEP_TIME, self.stepSpiders)
        if not hasattr(self, 'spiderModelsDict'):
            return
        for model in self.spiderModelsDict.keys():
            nstep, step_size, event_listener = self.spiderModelsDict[model]
            if nstep > self.S_MAXSTEPS:
                self.killSpider(model)
                continue
            nstep += 1
            matr = Math.Matrix(model.matrix)
            modeldirUp = matr.applyToAxis(1)
            modeldirF = matr.applyToAxis(2)
            modeldirUp.normalise()
            modeldirF.normalise()
            cpos = model.position + modeldirUp * self.S_MODELHEIGHT + modeldirF * step_size
            posto = cpos - modeldirUp * self.S_MODELHEIGHT * 2
            cpos1 = model.position + modeldirUp * self.S_MODELHEIGHT
            col = utils_bw.collide(self.spaceID, cpos1, posto)
            if not col:
                col = utils_bw.collide(self.spaceID, cpos, posto)
            if not col:
                col = utils_bw.collide(self.spaceID, cpos, posto - modeldirF * step_size)
            if col:
                lastpos = model.position
                newpos = col[0]
                if newpos.distTo(lastpos) > step_size * 2:
                    newpos = lastpos + (newpos - lastpos) * step_size * 2
                    nstep += 10
                model.position = newpos
                target_normal = SFXer.tri_normal(col[1])
                target_normal.normalise()
                axis = modeldirUp * target_normal
                axis.normalise()
                cos = modeldirUp.dot(target_normal)
                cos = min(cos, 1.0)
                cos = max(cos, -1.0)
                angle = math.acos(cos)
                if random.random() > 0.6:
                    angle = angle * (1 + random.random() * 0.05)
                angleV = 1 if angle > 0 else -1
                angle = min(abs(angle), 0.07) * angleV
                model.rotate(angle, axis, (0, 0, 0))
            else:
                model.rotate(model.yaw + random.random(), modeldirUp, (0, 0, 0))
                nstep += 100
            self.spiderModelsDict[model] = (nstep, step_size, event_listener)

    def traceBulletSpiders(self, scrFrom, direction):
        for model in self.spiderModelsDict.keys():
            mpos = model.position
            cm = mpos - scrFrom
            distM = cm.length
            cm.normalise()
            d = math.acos(direction.dot(cm))
            d = math.sin(d)
            distBullet = d * distM
            if distBullet < 0.5:
                self.killSpider(model)

    KILL_FAKE_SPIDER_PARTICLE = 'particles/anomaly/zyb_pers.xml'

    def killSpider(self, model):
        event_listener = None
        if model in self.spiderModelsDict:
            event_listener = self.spiderModelsDict[model][2]
            del self.spiderModelsDict[model]
        particl = Pixie.create(self.KILL_FAKE_SPIDER_PARTICLE)
        m2 = BigWorld.Model('')
        m2.position = model.position + (0, 0.2, 0)
        BigWorld.player().addModel(m2)
        m2.root.attach(particl)
        particl.force()

        def scaleMin():
            scale = model.scale * 0.8
            scale_limit = 0.08
            if scale.x < scale_limit or scale.y < scale_limit or scale.z < scale_limit:
                scale = (scale_limit, scale_limit, scale_limit)
            model.scale = scale

        def scaleMax():
            model.scale = model.scale * 1.2

        for x in range(2):
            BigWorld.callback(0.05 * x, scaleMax)

        for x in range(2, 22):
            BigWorld.callback(0.05 * x, scaleMin)

        def delModel():
            if self.isDestroyed:
                return
            self.delModel(model)

        def delM2Model():
            if self.isDestroyed:
                return
            self.delModel(m2)

        BigWorld.callback(2, delModel)
        BigWorld.callback(5, delM2Model)
        if event_listener and not event_listener.isDestroyed:
            event_listener.on_spider_dead()
        return

    def updateDrunkEffect(self, stacks):
        self.__stop_drink_post_poroc()
        pp = POST_PROC_DRUNK.get(stacks, 'drink_2')
        BWPersonality.GUICore.addPPEffect(pp)
        self.drink_stacks = stacks
        self.camera_drink_size = {1: 0.1,
         2: 0.2,
         3: 0.25,
         4: 0.3,
         5: 0.4}.get(self.drink_stacks, 0.4)
        self.__tick_camera()

    def __stop_drink_post_poroc(self):
        for x in POST_PROC_DRUNK.values():
            BWPersonality.GUICore.delPPEffect(x)

        BigWorld.cancelCallback(self.camera_drink_tick_id)

    def removeDrunkEffect(self):
        self.__stop_drink_post_poroc()
        BigWorld.projection().fov = PlayerAvatar.DEFAULT_FOV
        BigWorld.camera().uprightDirection = (0, 1, 0)

    camera_drink_tagert = Math.Vector3(0, 1, 0)
    camera_drink_fov_tagert = 0.78
    camera_drink_tick_id = 0
    drink_stacks = 0
    camera_drink_size = 0.1

    def __tick_camera(self):
        cam = BigWorld.camera()
        dt = self.camera_drink_tagert - cam.uprightDirection
        if dt.length < 0.03:

            def getRandom():
                return self.camera_drink_size * random.random() * random.choice([-1, 1])

            self.camera_drink_tagert = Math.Vector3(getRandom(), 1, getRandom())
            dt = self.camera_drink_tagert - cam.uprightDirection
        fvdt = self.camera_drink_fov_tagert - BigWorld.projection().fov
        if abs(fvdt) < 0.001:
            self.camera_drink_fov_tagert = random.random() * self.camera_drink_size * random.choice([-1, 1]) + PlayerAvatar.DEFAULT_FOV
            fvdt = self.camera_drink_fov_tagert - BigWorld.projection().fov
        BigWorld.projection().fov += fvdt * 0.01
        cam.uprightDirection += dt * 0.02
        self.camera_drink_tick_id = BigWorld.callback(0, self.__tick_camera)


POST_PROC_DRUNK = {1: 'drink_0',
 2: 'drink_0',
 3: 'drink_1',
 4: 'drink_2',
 5: 'drink_3'}
RAND_DRUNK = {1: 0.1,
 2: 0.2,
 3: 0.25,
 4: 0.3,
 5: 0.4}