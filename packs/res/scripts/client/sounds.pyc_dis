if hasattr(BigWorld, 'Entity'):
    import Settings

    class Sound(object, Listenable):

        def __init__(self, fmod_sound, is_music):
            Listenable.__init__(self)
            self.fmod_sound = fmod_sound
            self.fmod_sound.setCallback('EVENTSTARTED', self.onPlayBegin)
            self.fmod_sound.setCallback('SOUNDDEF_END', self.onPlayEnd)
            self.fmod_sound.setCallback('EVENTFINISHED', self.onPlayFinished)
            self.event_started_callback = None
            self.sounddef_end_callback = None
            self.is_music = is_music
            self._loop_sm_id = 0
            return

        def setCallback(self, event, cb):
            if event == 'EVENTSTARTED':
                self.event_started_callback = cb
            elif event == 'SOUNDDEF_END':
                self.sounddef_end_callback = cb
            else:
                self.fmod_sound.setCallback(event, cb)

        def get_duration(self):
            if not self.fmod_sound:
                return
            return self.fmod_sound.duration

        def set_duration(self, value):
            if not self.fmod_sound:
                return
            self.fmod_sound.duration = value

        duration = property(get_duration, set_duration)

        def get_volume(self):
            if not self.fmod_sound:
                return 0
            if not self.muted:
                return self.fmod_sound.volume
            return self._volume

        def set_volume(self, value):
            if not self.fmod_sound:
                return 0
            if self.muted:
                self._volume = value
            elif not self.fmod_sound.isVirtual:
                self.fmod_sound.volume = value

        volume = property(get_volume, set_volume)

        def get_muted(self):
            if not self.fmod_sound:
                return
            return getattr(self, '_muted', False)

        def set_muted(self, value):
            if value:
                self._volume = self.volume
                self.volume = 0
                self._muted = value
            else:
                self._muted = value
                self.volume = self._volume

        muted = property(get_muted, set_muted)

        def smoothMute(self, is_mute, delay = 0.009):
            if not self.fmod_sound:
                return
            self._smooth_to = 0 if is_mute else self._volume

            def __loop_smooth():
                if not self.fmod_sound:
                    return
                cur_volume = self.volume
                if self._smooth_to == 0 and cur_volume < 0.01:
                    self.volume = 0
                    return
                d_sound = self._smooth_to - cur_volume
                if self._smooth_to > 0 and abs(d_sound) < 0.01:
                    self.volume = self._smooth_to
                    return
                self.volume = cur_volume + d_sound * delay
                self._loop_sm_id = BigWorld.callback(0, __loop_smooth)

            __loop_smooth()

        def _stop_smooth_mute(self):
            if self._loop_sm_id:
                BigWorld.cancelCallback(self._loop_sm_id)
                self._loop_sm_id = 0

        def get_paused(self):
            if not self.fmod_sound:
                return True
            return self.fmod_sound.paused

        def set_paused(self, value):
            if not self.fmod_sound:
                return
            self.fmod_sound.paused = value

        paused = property(get_paused, set_paused)

        def get_position(self):
            return self.fmod_sound.position

        def set_position(self, value):
            self.fmod_sound.position = value

        position = property(get_position, set_position)

        def get_isVirtual(self):
            if not self.fmod_sound:
                return True
            return self.fmod_sound.isVirtual

        def set_isVirtual(self, value):
            if not self.fmod_sound:
                return
            self.fmod_sound.isVirtual = value

        isVirtual = property(get_isVirtual, set_isVirtual)

        def get_autoDetach(self):
            return self.fmod_sound.need_detach_on_stop

        def set_autoDetach(self, value):
            if self.fmod_sound:
                self.fmod_sound.need_detach_on_stop = value

        autoDetach = property(get_autoDetach, set_autoDetach, doc=u'\u041f\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044e \u0437\u0432\u0443\u043a\u0430 \u043e\u0442\u0446\u0435\u043f\u0438\u0442\u0441\u044f \u043e\u0442 \u043c\u043e\u0434\u0435\u043b\u0438')

        def detachFromModel(self):
            u"""\u041e\u0442\u0446\u0435\u043f\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u043e\u0442 \u043c\u043e\u0434\u0435\u043b\u0438"""
            self._stop_smooth_mute()
            if self.fmod_sound:
                return self.fmod_sound.remove()

        def releaseSound(self):
            self._stop_smooth_mute()
            if self.fmod_sound:
                self.fmod_sound.remove()
                self.fmod_sound = None
            return

        def get_name(self):
            return self.fmod_sound.name

        name = property(get_name)

        def play(self):
            self.fmod_sound.play()
            if self.muted:
                self.fmod_sound.volume = 0

        def stop(self):
            if self.fmod_sound:
                self.fmod_sound.stop()
            if self in Sound.current_sounds:
                Sound.current_sounds.remove(self)
            self._stop_smooth_mute()

        def get_paused(self):
            return self.fmod_sound.paused

        def set_paused(self, paused):
            self.fmod_sound.paused = paused

        paused = property(get_paused, set_paused)

        def get_looped(self):
            return self.fmod_sound.duration < 0

        looped = property(get_looped)

        def onPlayBegin(self, fmod_snd):
            if self not in Sound.current_sounds:
                Sound.current_sounds.append(self)
                self.listeners.onPlayBegin()
                if callable(self.event_started_callback):
                    self.event_started_callback(self)

        def onPlayEnd(self, fmod_snd):
            self._stop_smooth_mute()
            if self in Sound.current_sounds:
                Sound.current_sounds.remove(self)
            self.listeners.onPlayEnd()
            if callable(self.sounddef_end_callback):
                self.sounddef_end_callback(self)
            if self.fmod_sound and self.fmod_sound.need_detach_on_stop:
                self.fmod_sound.remove()
                self.fmod_sound = None
            return

        def onPlayFinished(self, fmod_snd):
            self._stop_smooth_mute()
            if self in Sound.current_sounds:
                Sound.current_sounds.remove(self)
            if self.fmod_sound and self.fmod_sound.need_detach_on_stop:
                self.fmod_sound.remove()
                self.fmod_sound = None
            return

        current_sounds = []

        @staticmethod
        def playSound(sound = None, obj = None, volume = None, is_music = False):
            test_playSound_notifer(sound, obj)
            e = ''
            played_model = obj
            position_sound = None
            if obj:
                if obj.__class__.__name__ != 'Model':
                    played_model = obj.model
                if not obj.inWorld:
                    return
                position_sound = obj.position
            if not obj:
                player = BigWorld.player()
                if player and player.model:
                    played_model = player.model
                else:
                    played_model = _FMOD
            if volume is None:
                volume = Settings.Settings().getMusicVolume() if is_music else Settings.Settings().getSfxVolume()
                if position_sound:
                    player = BigWorld.player()
                    if player:
                        if BigWorld.isOtside(player.spaceID, position_sound) != player.isOutsideShell():
                            volume = volume * rainConstant.sounds_volume_in_shell
            try:
                fmod_sound = played_model.playSound(sound)
            except ValueError as e:
                fmod_sound = None
            except StandardError as e:
                fmod_sound = None

            if fmod_sound:
                wrapped_sound = Sound(fmod_sound, is_music)
                wrapped_sound.volume = volume
                wrapped_sound._volume = volume
                return wrapped_sound
            else:
                print 'playSound SOUND NOT FOUND:', [sound], 'obj:', obj, 'played_model:', played_model, repr(e)
                return

        @staticmethod
        def getSound(sound = None, volume = None, is_music = False):
            test_getSound_notifer(sound)
            if volume is None:
                volume = Settings.Settings().getMusicVolume() if is_music else Settings.Settings().getSfxVolume()
            try:
                fmod_sound = _FMOD.getSound(sound)
            except ValueError:
                fmod_sound = None

            if fmod_sound:
                wrapped_sound = Sound(fmod_sound, is_music)
                wrapped_sound.volume = volume
                wrapped_sound._volume = volume
                return wrapped_sound
            else:
                print 'getSound SOUND NOT FOUND:', [sound]
                return

        @staticmethod
        def get3DFreeSound(sound = None, volume = None):
            u"""  \u0441\u043e\u0437\u0434\u0430\u0442\u044c 3\u0434 \u0437\u0432\u0443\u043a, \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0442\u044c \u043f\u043e .position
                    *\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043a\u0430\u0440\u0442\u044b
            """
            test_get3DFreeSound_notifer(sound)
            if volume is None:
                volume = Settings.Settings().getSfxVolume()
            try:
                fmod_sound = _FMOD.getSound(sound)
            except ValueError:
                print 'get3DFreeSound SOUND NOT FOUND:', [sound]
                return

            wrapped_sound = Sound(fmod_sound, False)
            wrapped_sound.volume = volume
            wrapped_sound._volume = volume
            return wrapped_sound


    getSound = Sound.getSound
    playSound = Sound.playSound
    get3DFreeSound = Sound.get3DFreeSound

    def getMusic(sound):
        return getSound(sound, volume=Settings.Settings().getMusicVolume(), is_music=True)


    getAmbientMusic = getSound

    def playMusic(sound, obj = None):
        return playSound(sound, obj, Settings.Settings().getMusicVolume(), True)


    playAmbientMusic = playSound