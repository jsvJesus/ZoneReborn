# Embedded file name: ./scripts/client/DialogActions.py
import BigWorld
import BWPersonality
import CameraNode
from AvatarDialogPoint import AvatarDialogPoint
import Math
import StalkerModel
from DialogHideAreaUDO import DialogHideAreaUDO
from functools import partial
import Constants
from Items import ItemsCatalog
import ItemsUtils
import AnimationCaps
MOVE_COEFF = 0.05
ROTATE_COEFF = 0.01
LEFT_HAND, RIGHT_HAND = xrange(1, 3)

class DialogActions:

    def Init_DialogActions(self):
        self.clone_model = None
        self.default_action_name = None
        self._rotate_step = 0
        self._dialog_camera = None
        self._dialog_sound = None
        self._dialog_hide_areas = []
        self._dialog_npc = None
        self._dialog_npc_action = None
        self._need_stop_actions = False
        self._saved_npc_activeItemType = 0
        self.__last_npc_weapon = None
        self.__dialog_callback = None
        return

    def get_init_camera(self):
        self.init_camera_matrix = BigWorld.Camera().invViewProvider

    def onEnterWorld(self):
        self.Init_DialogActions()

    def onLeaveWorld(self):
        if self.clone_model:
            BigWorld.delModel(self.clone_model)
            self.clone_model = None
        self.default_action_name = None
        self._rotate_step = 0
        self._dialog_camera = None
        self._dialog_sound = None
        self._dialog_npc = None
        self._dialog_npc_action = None
        return

    def npc_default_action(self):
        if not self._dialog_npc:
            self._dialog_npc = BigWorld.entities.get(self.dialogEntityID)
        if not self._dialog_npc:
            return
        self._dialog_npc.ActiveItemType = self._saved_npc_activeItemType
        self._dialog_npc.UpdateAvatarModel()
        self._dialog_npc.returnModelToDefault()
        if self._dialog_npc.playedAnimationIndexList:
            self._dialog_npc.playAnimationByIDInList(self._dialog_npc.playedAnimationIndexList)

    def stop_npc_actions(self):
        if self._dialog_npc and self._dialog_npc_action:
            if isinstance(self._dialog_npc_action, list):
                for action in self._dialog_npc_action:
                    action.stop()

            else:
                self._dialog_npc_action.stop()
        self._dialog_npc_action = None
        if self.__dialog_callback:
            BigWorld.cancelCallback(self.__dialog_callback)
            self.__dialog_callback = None
        return

    def stop_dialog_camera(self):
        if not self._need_stop_actions:
            return
        else:
            self.stop_dialog_sound()
            self._need_stop_actions = False
            self.resetCamera()
            self.stop_npc_actions()
            self.removeControlLockByEffect(Constants.ControlLockTypes.ANIMATION)
            if self.clone_model:
                BigWorld.delModel(self.clone_model)
                self.clone_model = None
            self.model.visible = True
            self.default_action_name = None
            self._dialog_camera = None
            self.npc_default_action()
            if self._dialog_npc:
                self._dialog_npc.dialog_actions = False
            self._dialog_npc = None
            self.destroyHideAreas()
            return

    def dialog_event(self, event, data):
        if event == BWPersonality.soGUI.soDialogueGUI2.EVENT_CLOSE:
            self.stop_dialog_camera()

    def createHideAreas(self, areasUDO):
        for udo in areasUDO:
            if not udo or not isinstance(udo, DialogHideAreaUDO):
                continue
            area_params = {'radius': udo.radius,
             'name': udo.name}
            areaID = BigWorld.createEntity('DialogHideArea', self.spaceID, 0, udo.position, (0, 0, 0), area_params)
            area = BigWorld.entities.get(areaID)
            if area:
                self._dialog_hide_areas.append(areaID)
                area.activate()

    def destroyHideAreas(self):
        for areaID in self._dialog_hide_areas:
            area = BigWorld.entities.get(areaID)
            if area:
                area.deactivate()
                BigWorld.destroyEntity(areaID)

        self._dialog_hide_areas = []

    def get_dialog_cameras(self):

        def nodes_gen():
            for cn in BigWorld.userDataObjects.values():
                if isinstance(cn, CameraNode.CameraNode):
                    yield (cn.name, cn)

        return dict(nodes_gen())

    def get_dialog_points(self):

        def nodes_gen():
            for adp in BigWorld.userDataObjects.values():
                if isinstance(adp, AvatarDialogPoint):
                    yield (adp.name, adp)

        return dict(nodes_gen())

    def _get_matrix_from_instance(self, instance):
        roll, pitch, yaw = instance.direction
        m = Math.Matrix()
        m.setRotateYPR((yaw, pitch, roll))
        m.translation = instance.position
        return m

    def _get_matrix_from_node(self, node):
        m = Math.Matrix()
        m.setRotateYPR((node.yaw, node.pitch, node.roll))
        m.translation = node.position
        return m

    def _get_matrix_from_dct(self, dct):
        yaw, pitch, roll = dct['direction']
        m = Math.Matrix()
        m.setRotateYPR((yaw, pitch, roll))
        m.translation = dct['position']
        return m

    def go_to_dialog_point(self, dialog_point_name):
        if not dialog_point_name:
            return
        dialog_points = self.get_dialog_points()
        if not dialog_points.has_key(dialog_point_name):
            return
        self._need_stop_actions = True

        def model_ready_callback(model):
            self.clone_model = model
            point = dialog_points[dialog_point_name]
            self.model.visible = False
            self.clone_model.position = point.position
            self.clone_model.yaw = point.yaw
            BigWorld.addModel(self.clone_model)
            if point.hideAreas:
                self.createHideAreas(point.hideAreas)
            if point.animation:
                action = getattr(self.clone_model, point.animation, None)
                if action:
                    self.default_action_name = point.animation
                    action()
            return

        if self.active_transform and self.active_transform.getModelPath() != 'DEF':
            StalkerModel.ComposePlayerTransformModel(self, self.active_transform, model_ready_callback)
        else:
            StalkerModel.ComposePlayerModel(self, model_ready_callback)

    def play_dialog_sound(self, sound_name):
        if not sound_name:
            return
        self._need_stop_actions = True
        self.stop_dialog_sound()
        if sound_name == 'stop':
            return
        try:
            self._dialog_sound = BigWorld.playSound(sound_name)
            self._dialog_sound.autoDetach = False
        except Exception as e:
            print 'DIALOG_ERROR:: NO PLAY SOUND [%s]' % sound_name
            raise e

    def stop_dialog_sound(self):
        if self._dialog_sound:
            self._dialog_sound.stop()
            self._dialog_sound.releaseSound()
            self._dialog_sound = None
        return

    def play_default_action(self):
        if not self.default_action_name:
            return
        if self.clone_model:
            self.clone_model.action(self.default_action_name)()
        else:
            self.model.action(self.default_action_name)()

    def use_item_NPC(self, item_type):
        if not self._dialog_npc:
            self._dialog_npc = BigWorld.entities.get(self.dialogEntityID)
        item = ItemsCatalog.GetItemParam(item_type)
        if not item or not self._dialog_npc:
            return
        else:
            self._dialog_npc.model.effectorright = None
            self._dialog_npc.model.effectorleft = None
            self._dialog_npc.model.ThrowRight = None
            item_class = ItemsCatalog.GetItemClass(item_type)
            if item_class == ItemsCatalog.WEAPON:
                gun_type = item['GunType']
                gun_priority = ItemsUtils.GetWeaponPriority(gun_type)
                gun_item_type = item_type
                if gun_priority == ItemsCatalog.SECONDARY:
                    if self._dialog_npc.ActiveWeaponSet.SecondarySlotType:
                        gun_item_type = self._dialog_npc.ActiveWeaponSet.SecondarySlotType
                        self._dialog_npc.model.Pistol = None
                elif gun_priority == ItemsCatalog.PRIMARY:
                    if self._dialog_npc.ActiveWeaponSet.PrimarySlotType:
                        gun_item_type = self._dialog_npc.ActiveWeaponSet.PrimarySlotType
                        self._dialog_npc.model.weaponback = None
                self.__last_npc_weapon = gun_item_type
                gun_param = ItemsCatalog.GetItemParam(gun_item_type)
                gun_model = self.getModelByNamesDict(ItemsUtils.GetGunModelDictByType(gun_item_type))
                if gun_model:
                    self._dialog_npc.model.effectorright = gun_model
                    self._dialog_npc.ActiveItemType = gun_item_type
            elif item_class == ItemsCatalog.LOOT:
                hands = itemParam.get('Action_model_in_hands', False)
                if hands:
                    if LEFT_HAND in hands:
                        _model = hands.get(LEFT_HAND, '')
                        self._dialog_npc.model.effectorleft = BigWorld.Model(_model)
                    if RIGHT_HAND in hands:
                        _model = hands.get(RIGHT_HAND, '')
                        self._dialog_npc.model.effectorright = BigWorld.Model(_model)
            elif item_class == ItemsCatalog.EXPLOSION:
                self._dialog_npc.model.ThrowRight = BigWorld.Model(item['modelName'])
                self._dialog_npc.ActiveThrowType = item_type
                self._dialog_npc.ActiveThrowID = 1
            elif item_class == ItemsCatalog.GADGET:
                gun_model = self.getModelByNamesDict(ItemsUtils.GetGunModelDictByType(item_type))
                if gun_model:
                    self._dialog_npc.model.effectorright = gun_model
                    self._dialog_npc.binoculing = True
            else:
                return
            return

    def play_NPC_dialog_anim(self, anim_name, item_type = '', defaultAction = False):
        self._dialog_npc = BigWorld.entities.get(self.dialogEntityID)
        if not self._dialog_npc:
            return
        else:
            anim_name = anim_name.replace(' ', '')
            animations = anim_name.split(',')
            if defaultAction and hasattr(self._dialog_npc, 'ActiveItemType'):
                self.__last_npc_weapon = self._dialog_npc.ActiveItemType
                self._saved_npc_activeItemType = self._dialog_npc.ActiveItemType
            if not anim_name:
                return
            if defaultAction:
                self._dialog_npc.stop_all_animations(True)
            self.stop_npc_actions()
            self._need_stop_actions = True
            self._dialog_npc.dialog_actions = True
            duration = 0
            if len(animations) > 1:
                self._dialog_npc_action = []
                last_action = self._dialog_npc.model
                for anim in animations:
                    action = getattr(self._dialog_npc.model, anim, None)
                    if action:
                        self._dialog_npc_action.append(action)
                        duration += action.duration
                        last_action = getattr(last_action, anim)()

            else:
                anim_name = animations[0]
                self._dialog_npc_action = getattr(self._dialog_npc.model, anim_name, None)
                if self._dialog_npc_action:
                    duration = self._dialog_npc_action.duration
                    self._dialog_npc_action()

            def update_item_hand():
                self._dialog_npc.UpdateAvatarAnimationCaps()
                self._dialog_npc.EnableModelPitch(True)
                self.__dialog_callback = None
                return

            def reset_right_hand():
                self.__dialog_callback = None
                if not self._dialog_npc:
                    return
                else:
                    self._dialog_npc.model.ThrowRight = None
                    self._dialog_npc.model.effectorright = None
                    self._dialog_npc.model.effectorleft = None
                    self._dialog_npc.ActiveItemType = 0
                    self._dialog_npc.ActiveThrowType = 0
                    self._dialog_npc.ActiveThrowID = 0
                    self._dialog_npc.binoculing = False
                    if self.__last_npc_weapon:
                        item = ItemsCatalog.GetItemParam(self.__last_npc_weapon)
                        item_class = ItemsCatalog.GetItemClass(self.__last_npc_weapon)
                        if item_class == ItemsCatalog.WEAPON:
                            gun_model = self.getModelByNamesDict(ItemsUtils.GetGunModelDictByType(self.__last_npc_weapon))
                            gun_priority = ItemsUtils.GetWeaponPriority(self.__last_npc_weapon)
                            if gun_priority == ItemsCatalog.SECONDARY:
                                self._dialog_npc.model.Pistol = gun_model
                            elif gun_priority == ItemsCatalog.PRIMARY:
                                self._dialog_npc.model.weaponback = gun_model
                            self._dialog_npc.ActiveItemType = 0
                        self.__last_npc_weapon = 0
                    self._dialog_npc.UpdateAvatarAnimationCaps()
                    self._dialog_npc.EnableModelPitch(False)
                    return

            if item_type:
                item_type = int(item_type)
                if item_type:
                    self.use_item_NPC(item_type)
                    self.__dialog_callback = BigWorld.callback(duration * 0.9, update_item_hand)
                elif item_type == 0:
                    self.__dialog_callback = BigWorld.callback(duration * 0.9, reset_right_hand)
            return

    def play_player_dialog_anim(self, player_anim_name, default = False):
        if not player_anim_name:
            return
        else:
            if self.clone_model:
                anim_model = self.clone_model
            else:
                anim_model = self.model
            self._need_stop_actions = True
            action = getattr(anim_model, player_anim_name, None)
            if action:
                if default:
                    self.default_action_name = player_anim_name
                if not self.clone_model:
                    self.playAnimation(action, action.duration, self.stopAnimationClear)
                    self.cell.playAnimation(player_anim_name, action.duration)
                elif self.default_action_name:
                    action().action(self.default_action_name)()
                else:
                    action()
            return

    def go_to_dialog_camera(self, camera_name, smoothly = False):
        if not camera_name:
            return
        else:
            self._need_stop_actions = True
            if camera_name == 'default':
                self.stop_dialog_camera()
                return
            self._rotate_step = 0
            camera_nodes = self.get_dialog_cameras()
            camera = camera_nodes.get(camera_name)
            if not camera:
                return

            def _get_camera_matrix(cam):
                try:
                    cam = Math.Matrix(cam)
                except TypeError:
                    if hasattr(cam, 'direction') and hasattr(cam, 'position'):
                        cam = self._get_matrix_from_instance(cam)
                    elif isinstance(end_m, dict) and 'direction' in cam and 'position' in cam:
                        cam = self._get_matrix_from_dct(cam)
                    elif all((hasattr(end_m, attr) for attr in ('yaw', 'pitch', 'roll', 'position'))):
                        cam = self._get_matrix_from_node(cam)
                    else:
                        msg = 'Unsupported type {0} for moving'.format(cam.__class__.__name__)
                        raise TypeError(msg)

                return cam

            camera_matrix = _get_camera_matrix(camera)
            self.setControlLockByEffect(Constants.ControlLockTypes.ANIMATION, None)
            current_camera_matrix = Math.Matrix(BigWorld.camera().invViewMatrix)
            if not self._dialog_camera:
                self._dialog_camera = BigWorld.FreeCamera(BigWorld.camera())
                BigWorld.camera(self._dialog_camera)
            self._dialog_camera.invViewProvider = current_camera_matrix
            if not smoothly:
                self._dialog_camera.invViewProvider = camera_matrix
            else:
                BigWorld.callback(0.1, partial(self.moveCameraLoop, camera_matrix, current_camera_matrix, self._dialog_camera))
            return

    def moveCameraLoop(self, end_camera, init_camera, cam):
        pos_matr = Math.Matrix()
        rot_matr = Math.Matrix()
        new_pos = cam.invViewProvider.translation + (end_camera.translation - cam.invViewProvider.translation) * MOVE_COEFF
        pos_matr.setTranslate(new_pos)
        self._rotate_step = min(1, self._rotate_step + ROTATE_COEFF)
        yaw = cam.invViewProvider.yaw + (end_camera.yaw - cam.invViewProvider.yaw) * self._rotate_step
        pitch = cam.invViewProvider.pitch + (end_camera.pitch - cam.invViewProvider.pitch) * self._rotate_step
        roll = cam.invViewProvider.roll + (end_camera.roll - cam.invViewProvider.roll) * self._rotate_step
        rot_matr.setRotateYPR((yaw, pitch, roll))
        pos_matr.preMultiply(rot_matr)
        cam.invViewProvider = pos_matr
        v1 = Math.Vector3(end_camera.yaw, end_camera.pitch, end_camera.roll)
        v2 = Math.Vector3(pos_matr.yaw, pos_matr.pitch, pos_matr.roll)
        v2.normalise()
        v1.normalise()
        if cam.position.distTo(end_camera.translation) > 0.2 or (v1 - v2).length > 0.1:
            BigWorld.callback(0.0, partial(self.moveCameraLoop, end_camera, init_camera, cam))
        else:
            cam.invViewProvider = end_camera