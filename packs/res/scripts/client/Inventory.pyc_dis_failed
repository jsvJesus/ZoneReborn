                    return True

                msgbox_templates.input_box_ok_cancel('Inventory.add_number_to_buy', lc('GUI.Inventory.BUY_CAPTION_REMOVE'), colorCodes.tf3_regular_text_color + lc('GUI.Inventory.BUY_TEXT_REMOVE'), callback=del_number_buy, default='1', input_validator=number_check)
            elif id == ItemsCatalog.CAN_BUY_REMOVE_ITEM:
                try:
                    self.ToBuyList.clearItem(item)
                except:
                    traceback.print_exc()

                self.UpdateTradeInterface()
            elif id == ItemsCatalog.CAN_SELL_REMOVE_ITEM:
                try:
                    if item in self.ToSellList:
                        self.ToSellList.remove(item)
