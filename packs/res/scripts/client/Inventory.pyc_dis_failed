    def UpdateTradeInterface(self, allow_empty = True):
        """        \xd0\x9e\xd0\xb1\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbb\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xb2\xd0\xbd\xd0\xb5\xd1\x88\xd0\xbd\xd0\xb8\xd0\xb9 \xd0\xb2\xd0\xb8\xd0\xb4 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xb0 \xd1\x82\xd0\xbe\xd1\x80\xd0\xb3\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb8.
                allow_empty - \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 False \xd0\xb8 \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd0\xb0\xd1\x8f \xd0\xb2\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd0\xb0, \xd1\x82\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd0\xb8\xd1\x82 \xd0\xbd\xd0\xb0 \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd1\x83\xd1\x8e \xd0\xb2\xd0\xba\xd0\xbb\xd0\xb0\xd0\xb4\xd0\xba\xd1\x83
        """
        try:
            trader_entity = BigWorld.entities[self.TraderID]
        except KeyError:
            return

        self.tradeFilter = BWPersonality.GUICore.getTradeFilterMask()
        forced_mode = None
        if self.SellMode == NPC_VENDOR.MODE_SELL_FOR_MONEY:
            assortent_to_show = filter(lambda item: item['cost'] > 0, trader_entity.selling_assortment)
            if not assortent_to_show and not allow_empty:
                self.SellMode = NPC_VENDOR.MODE_SELL_FOR_GOLD
                forced_mode = NPC_VENDOR.MODE_SELL_FOR_GOLD
        if self.SellMode == NPC_VENDOR.MODE_SELL_FOR_GOLD:
            assortent_to_show = filter(lambda item: item['goldCost'] > 0, trader_entity.selling_assortment)
            if not assortent_to_show and forced_mode:
                self.SellMode = NPC_VENDOR.MODE_SELL_FOR_MONEY
                forced_mode = None
        assortment = []
        for selling_item_entry in assortent_to_show:
            if self.SellMode == NPC_VENDOR.MODE_SELL_FOR_MONEY:
                cost = selling_item_entry['cost']
                cost_string = utils.groupNumber(cost, '`') + lc('Inventory.client.ROUBLES')
                forGold = 0
            elif self.SellMode == NPC_VENDOR.MODE_SELL_FOR_GOLD:
                cost = selling_item_entry['goldCost']
                cost_string = utils.groupNumber(cost, '`') + lc('Inventory.client.GOLD')
                forGold = 1
            fake_item = self.CreateFakeItem(selling_item_entry['typeID'], forGold)
            item_in_list = self.itemFilterFunction([fake_item], None, self.tradeFilter)
            if item_in_list:
                item = item_in_list[0]
                assortment.append((item, cost_string))

        if self.TradeMode == NPC_VENDOR.MODE_BUY:
            show_list = map(lambda item: copy(item), self.ToBuyList)
        else:
            permited_item_klasses = {}
            for item_dct in trader_entity.buying_klasses:
                item_klass = item_dct['klass']
                item_buying_margin = item_dct['margin']
                permited_item_klasses[item_klass] = item_buying_margin

            permited_item_specs = {}
            for spec in trader_entity.buying_specs_assortment:
                permited_item_specs[spec['typeID']] = spec['cost']

            show_list = []
            for i, item in enumerate(self.ToSellList):
                item_type = item['complexItemType']
                item_klass = ItemsCatalog.GetItemCategory(item_type)
                if item_klass in permited_item_klasses or item_type in permited_item_specs:
                    show_list.append(copy(item))
                else:
                    del self.ToSellList[i]
                    self.ReportFail(ItemsUtils.FAIL_TRADER_NOT_BUY_IT)

        rouble_sum = 0
        gold_sum = 0
        for item in show_list:
            item_type = item['complexItemType']
            if self.TradeMode == NPC_VENDOR.MODE_BUY:
                rouble_sum, gold_sum = self.ToBuyList.total_cost(trader_entity)
            else:
                rouble_cost = ItemsUtils.GetItemCost(item)
                item_klass = ItemsCatalog.GetItemCategory(item_type)
                item_number = ItemsUtils.GetItemNumber(item)
                param = ItemsCatalog.GetItemParam(item_type)
                is_veksel = param.get('SoldForGold', 0)
                if is_veksel:
                    cost = param['GoldCost']
                    gold_sum += cost * item_number
                    buying_margin = 1.0
                else:
                    if item_type in permited_item_specs:
                        cost = permited_item_specs[item_type] * item_number
                        buying_margin = cost / rouble_cost
                    else:
                        buying_margin = permited_item_klasses[item_klass]
                        cost = rouble_cost * buying_margin
                    rouble_sum += cost
                item['margin'] = round(buying_margin, 3)
                item['cost'] = int(round(cost))

        rouble_cost_string = ''
        gold_cost_string = ''
        if rouble_sum > 0:
            rouble_cost_string = ' '.join([groupNumber(int(rouble_sum), '`'), lc('Inventory.client.ROUBLES_FULL')])
        if gold_sum > 0:
            gold_cost_string = ' '.join([groupNumber(int(gold_sum), '`'), lc('Inventory.client.GOLD_FULL')])
        costs = (rouble_cost_string, gold_cost_string)
        total_cost_string = ' '.join((cost for cost in costs if cost))
        if not total_cost_string:
            total_cost_string = '0'
        trade_data = {'items': assortment,
         'transit': show_list,
         'mode': self.TradeMode,
         'outcome': total_cost_string,
         'force_mode': forced_mode}
        BWPersonality.GUICore.setTradeData(trade_data)
        return

