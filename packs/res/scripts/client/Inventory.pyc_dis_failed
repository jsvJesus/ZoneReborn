                if currentWaterType == DrawWellUtil.WATER_TYPE_CLEAN:
                    returning_list[ItemsCatalog.CAN_POUR_WATER] = lc('Inventory.client.CAN_POUR_WATER')
                elif currentWaterType == DrawWellUtil.WATER_TYPE_DIRTY:
