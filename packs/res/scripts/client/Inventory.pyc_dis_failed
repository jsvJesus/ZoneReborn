    def dumpItemToHDD(self, item, path = None):
        import utils
        import os
        try:
            item = utils.pyFixedToNativePythonType(item)
            if path is None:
                path = '../item_%s__%s.so_item' % (item['complexItemType'], item['complexItemID'])
            with open(path, 'w') as f:
                f.write('time.time = %s\n' % time.time())
                f.write('gpd.time_diff = %s\n' % BWPersonality.gpd.time_diff)
                f.write('item:\n')
                f.write(repr(item))
                f.write('\n')
            self.putMessage(CHANNEL_CONSTS.SYSTEM, u'write ok')
            abs_path = os.path.abspath(path)
            self.putMessage(CHANNEL_CONSTS.SYSTEM, abs_path)
        except:
            traceback.print_exc()
            print (item, path)

        return

