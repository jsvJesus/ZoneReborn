    def _get_barter_pack_names(self, trader):
        """\xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xbe\xd0\xba\xd0\xb0\xd0\xbb\xd0\xb8\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb5 \xd0\xbd\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbe\xd0\xb2 \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0.
        
        \xd0\x95\xd1\x81\xd0\xbb\xd0\xb8 self.NPCbarterHideUnaffordable = = True, \xd0\xbe\xd1\x82\xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xbe\xd0\xb2\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82
        \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb0 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xbe\xd0\xb2, \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd1\x8b\xd1\x85 \xd0\xbe\xd0\xb1\xd0\xbc\xd0\xb5\xd0\xbd \xd0\xbd\xd0\xb5 \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd. 
        """

        def satisfy(barter_list_data, item_quantity):
            """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd1\x83\xd0\xb4\xd0\xbe\xd0\xb2\xd0\xbb\xd0\xb5\xd1\x82\xd0\xb2\xd0\xbe\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd1\x83\xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd1\x8f\xd0\xbc \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
            for type_id, count in barter_list_data['resourceItems']:
                if type_id not in item_quantity or count > item_quantity[type_id]:
                    return False

            return True

        pack_names = []
        if self.NPCbarterHideUnaffordable:
            avatar_item_quantity = ItemsUtils.avatar_item_quantity(self)
        for i, barter_list_data in enumerate(trader.BarterAssortment):
            if self.NPCbarterHideUnaffordable and not satisfy(barter_list_data, avatar_item_quantity):
                continue
            templete = collections.namedtuple('BarterListName', 'index list_name')
            pack_names.append(templete(i, lc(barter_list_data['barterListName'])))

        return pack_names

    def _get_resource_items(self, trader):
        """\xd0\xa2\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd0\xb5\xd0\xbc\xd0\xbe\xd0\xb5 \xd0\xba\xd0\xbe\xd0\xbb-\xd0\xb2\xd0\xbe \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbe\xd0\xb1\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xb0 \xd0\xb8 \xd0\xbd\xd0\xb0 \xd1\x81\xd0\xba\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd0\xbe\xd0\xb1\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbe\xd0\xb2 \xd1\x85\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82.
        
        \xd0\x92\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xba\xd0\xbe\xd1\x80\xd1\x82\xd0\xb5\xd0\xb6, \xd0\xb3\xd0\xb4\xd0\xb5 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd1\x8b\xd0\xb9 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 - \xd1\x8d\xd1\x82\xd0\xbe \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x84\xd0\xb5\xd0\xb9\xd0\xba\xd0\xbe\xd0\xb2\xd1\x8b\xd1\x85 
        \xd1\x82\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd0\xb5\xd0\xbc\xd1\x8b\xd1\x85 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd0\xbe\xd0\xb2, \xd0\xb0 \xd0\xb2\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb9 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 - \xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xbe.
        """
        reward_items = []
        already_added_count = collections.defaultdict(int)
        filter_ = set(self.NPCBarterItemList)
        for complex_item in self.CarryingItems:
            if complex_item['complexItemID'] not in filter_:
                continue
            item_type = complex_item['complexItemType']
            already_added_count[item_type] += ItemsUtils.GetItemNumber(complex_item)

        barter_list = trader.BarterAssortment[self.NPCBarterSelectedList]
        will_get_item_counts = []
        for item_type, required_number in barter_list['resourceItems']:
            fake_item = self.CreateFakeItem(item_type)
            if not fake_item:
                return None
            already_added = already_added_count[item_type]
            fake_item['required_number'] = required_number
            fake_item['already_added'] = already_added
            will_get_item_counts.append(already_added / required_number)
            reward_items.append(fake_item)

        will_get_item_count = min(will_get_item_counts)
        return (reward_items, will_get_item_count)

