                for itm in self.ToBuyList:
                    if itm['complexItemType'] == item['complexItemType']:
                        self.ToBuyList.append(item, number=number)
                        _isAdded = True

            if not _isAdded:
                if BWPersonality.GUICore.tradeGUI:
                    BWPersonality.GUICore.tradeGUI.errFrameShow()
        if self.TradeMode != NPC_VENDOR.MODE_BUY:
            self.TradeMode = NPC_VENDOR.MODE_BUY
            self.ClearSell()

    def itemInSellingList(self, item_id):
        for sell_item in self.ToSellList:
            if item_id == sell_item['complexItemID']:
                return True

        return False

    def MoveToSell(self, item):
        item_id = item['complexItemID']
        item_type_id = item['complexItemType']
        item_param = ItemsCatalog.GetItemParam(item_type_id)
        rouble_cost = item_param.get('Cost', None)
        gold_cost = item_param.get('GoldCost', None)
        BWPersonality.GUICore.tradeGUI.setMode(NPC_VENDOR.MODE_SELL)
        if item_param.get('DisableBuying', 0):
            self.ReportFail(ItemsUtils.FAIL_CANT_SELL)
            return False
        elif ItemsUtils.IsItemMoveable(item, entity=self):
            self.ReportFail(ItemsUtils.FAIL_CANT_SELL)
            return False
        elif item_param.get('isnotSellableToNPC', 0):
            self.ReportFail(ItemsUtils.FAIL_CANT_SELL)
            return False
        elif not rouble_cost and not gold_cost:
            self.ReportFail(ItemsUtils.FAIL_CANT_SELL)
            return False
        else:
            if item not in self.ToSellList:
                if len(self.ToSellList) < ItemsUtils.MAX_ITEMS_TO_TRADE and not self.itemInSellingList(item_id):
                    self.ToSellList.append(item)
                else:
                    BWPersonality.GUICore.tradeGUI.errFrameShow()
            if self.TradeMode != NPC_VENDOR.MODE_SELL:
                self.TradeMode = NPC_VENDOR.MODE_SELL
                self.ClearBuy()
            return True

    def removeToSell(self, item):
        if not item:
            return
        item_id = item['complexItemID']
        if not self.itemInSellingList(item_id):
            return
        for sell_item in self.ToSellList:
            if item_id == sell_item['complexItemID']:
                self.ToSellList.remove(sell_item)
                self.UpdateTradeInterface()
                self.UpdateInventory()
                break

