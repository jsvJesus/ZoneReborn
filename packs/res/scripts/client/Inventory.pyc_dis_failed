            if not inc_item.get(ItemsCatalog.INC_ARTEFACT_DEAD, 0):
                need_show_container = 5
                for cont_item in self.CarryingItems:
                    cont_param = ItemsCatalog.GetItemParam(cont_item['complexItemType'])
                    artcont_id = cont_item['complexItemID']
                    if not cont_param.get('IsArtefactContainer'):
                        continue
                    max_art = cont_param['MaxArtefact']
                    max_uses = cont_param['MaxUseArtefact']
                    cont_inc = ItemsUtils.GetComplexItemInconstanParams(cont_item)
                    num_uses = cont_inc.get(ItemsCatalog.INC_USES_CONTAINER_NUMBER, 0)
                    attached_art = len(cont_item['itemList'])
                    if attached_art >= max_art:
                        continue
                    if num_uses >= max_uses:
                        continue
                    art_count = '{0}/{1}'.format(attached_art, max_art)
                    stab_count = '{0}/{1}'.format(max_uses - num_uses, max_uses)
                    returning_list['attach_art_to', artcont_id] = lc('Inventory.client.ATTACH_TO_ARTCONT').format(art_count, stab_count)
