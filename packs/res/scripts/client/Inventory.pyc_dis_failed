                    traceback.print_exc()

                self.UpdateTradeInterface()
                self.UpdateInventory(0.0)
            elif id == ItemsCatalog.CAN_BUY_TRADE:
                self.MoveToBuy(item)
                self.UpdateTradeInterface()
            elif id == ItemsCatalog.CAN_QUEST:
