    def SwapQuickSlotBar(self, data):
        for slot_number in data:
            if slot_number >= MAX_KEY_BAR_LENGTH:
                return

        self.quickSlotBars[self.quickSlotActiveLineNumber - 1][data[0]], self.quickSlotBars[self.quickSlotActiveLineNumber - 1][data[1]] = self.quickSlotBars[self.quickSlotActiveLineNumber - 1][data[1]], self.quickSlotBars[self.quickSlotActiveLineNumber - 1][data[0]]
        self.cell.SaveQuickBar(self.quickSlotBars, self.quickSlotActiveLineNumber)

