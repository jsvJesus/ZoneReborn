    def tradeEvent(self, action, item):
        if action == NPC_VENDOR.EVENT_WANNASELL:
            if item is not None:
                itemParam = ItemsCatalog.GetItemParam(item['complexItemType'])
                if itemParam.get('IsArtefactContainer', 0) and item['itemList']:
                    if len(self.ToSellList) + len(item['itemList']) > ItemsUtils.MAX_ITEMS_TO_TRADE:
                        BWPersonality.GUICore.tradeGUI.errFrameShow()
                        self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.MAX_ITEMS_TO_TRADE'))
                        return
                    for sub_art in item['itemList']:
                        fake_art = ItemsUtils.ConvertSubItemToItem(sub_art, True)
                        fake_art['parentComplexItemID'] = item['complexItemID']
                        if not self.MoveToSell(fake_art):
                            break

                else:
                    self.MoveToSell(item)
        elif action == NPC_VENDOR.EVENT_WANNABUY:
            self.MoveToBuy(item)
        elif action == NPC_VENDOR.EVENT_ACTION:
            if item[1] == NPC_VENDOR.UPPER_REGION:
                self.MoveToBuy(item[0])
        elif action == NPC_VENDOR.EVENT_FILTER:
            self.SetTradeFilter(item)
        elif action == NPC_VENDOR.EVENT_CANCEL:
            if self.TradeMode == NPC_VENDOR.MODE_BUY:
                self.CancelBuy(item)
            elif self.TradeMode == NPC_VENDOR.MODE_SELL:
                self.CancelSell(item)
        elif action == NPC_VENDOR.EVENT_SELL_MODE:
            self.SellMode = item
        elif action == NPC_VENDOR.EVENT_CLEAR:
            self.ClearTrade()
        elif action == NPC_VENDOR.EVENT_MODE:
            if self.TradeMode != item:
                if self.TradeMode == NPC_VENDOR.MODE_BUY:
                    self.ClearBuy()
                elif self.TradeMode == NPC_VENDOR.MODE_SELL:
                    self.ClearSell()
                self.TradeMode = item
        elif action == NPC_VENDOR.EVENT_APPLY:
            self.DoTrade()
        elif action == NPC_VENDOR.EVENT_CONTEXT:
            if not item:
                return
            self.context_menu_item = item
            actions = {ItemsCatalog.CAN_INFO_TRADE: lc('Inventory.INFO')}
            if self.TradeMode == NPC_VENDOR.MODE_BUY:
                actions[ItemsCatalog.CAN_BUY_TRADE_NUMB] = lc('Inventory.client.ADD_ITEMS')
            self.StartInventoryContextMenu(actions, BWPersonality.GUICore.GUI_ID_NPCTRADE)
        elif action == NPC_VENDOR.EVENT_CONTEXT_SUMMARY:
            if not item:
                return
            self.context_menu_item = item
            actions = {ItemsCatalog.CAN_INFO_TRADE: lc('Inventory.INFO')}
            if self.TradeMode == NPC_VENDOR.MODE_BUY:
                actions[ItemsCatalog.CAN_BUY_RMOVE_TRADE_NUMB] = lc('Inventory.client.REMOVE_ITEMS')
                actions[ItemsCatalog.CAN_BUY_REMOVE_ITEM] = lc('Inventory.client.REMOVE_ALL_ITEMS')
            else:
                actions[ItemsCatalog.CAN_SELL_REMOVE_ITEM] = lc('Inventory.client.REMOVE_ITEM')
            self.StartInventoryContextMenu(actions, BWPersonality.GUICore.GUI_ID_NPCTRADE)
        self.UpdateTradeInterface()
        self.UpdateInventory(0.0)
        return

    def ItemLocked(self, item):
        if item:
            if isinstance(item, int):
                return False
            id = item['complexItemID']
            if item['fromEntityID']:
                return True
            if not hasattr(self, 'ToSellList'):
                return True
            for sell_item in self.ToSellList:
                if id == sell_item['complexItemID']:
                    return True
                if id == sell_item.get('parentComplexItemID'):
                    return True

            if id in self.craftItemList:
                return True
            if id in self.NPCBarterItemList:
                return True
            if id in self.items_to_drop:
                return True
            if id in self.locked_items:
                return True
            for item in self.ExchangeProperties.ItemsToExchange:
                if id == item.complexItemID:
                    return True

            if self.PCTradeItems:
                for item in self.PCTradeItems:
                    if id == item['complexItemID']:
                        return True

        return False

    def ItemLockedByShop(self, item):
        if item:
            if isinstance(item, int):
                return False
            id = item['complexItemID']
            if id in self.StoredItemsInShop:
                return True
        return False

