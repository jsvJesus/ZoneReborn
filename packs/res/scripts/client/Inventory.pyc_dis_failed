    def FillContainerWithResourceIDs(self, resource_dict):
        container = []
        for resource_key in resource_dict:
            resource_type = resource_key
            resource_num = resource_dict[resource_key]
            items_generator = ItemsUtils.GetComplexItemByTypeGenerator(self, resource_type)
            while ItemsUtils.GetItemQuanity([ ItemsUtils.GetComplexItemByID(self, x) for x in container ], resource_type) < resource_num:
                try:
                    item = items_generator.next()
                except StopIteration:
                    break

                if item:
                    item_id = item['complexItemID']
                    item_type = item['complexItemType']
                    item_class = ItemsCatalog.GetItemClass(item_type)
                    if not ItemsUtils.IsItemEquipped(self, item_id):
                        if item_class == ItemsCatalog.BUFF:
                            item_param = ItemsCatalog.GetItemParam(item_type)
                            max_num_items_in_pack = item_param.get('PackageSize')
                            if max_num_items_in_pack is not None:
                                if max_num_items_in_pack > ItemsUtils.GetBuffUsesNumber(item):
                                    continue
                        if item_id not in container:
                            container.append(item_id)
                else:
                    break

        return container

    def NPCBarterEvent(self, event, data):
        """\xd0\x9e\xd0\xb1\xd1\x80\xd0\xb0\xd0\xb1\xd0\xb0\xd1\x82\xd1\x8b\xd0\xb2\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x81\xd0\xbe\xd0\xb1\xd1\x8b\xd1\x82\xd0\xb8\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb8\xd1\x81\xd1\x85\xd0\xbe\xd0\xb4\xd1\x8f\xd1\x89\xd0\xb8\xd0\xb5 \xd1\x81 \xd0\xbe\xd0\xba\xd0\xbd\xd0\xbe\xd0\xbc \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
        if event == soGUI.BarterWindowGUI.EVENT_PACKSELECT:
            self.NPCBarterItemList[:] = []
            self.gotten_barter_item_types.clear()
            self.NPCBarterSelectedList = data
            self.UpdateNPCBarter(upd_slots=True)
        elif event == soGUI.BarterWindowGUI.EVENT_HIDEUNAFFORDABLE:
            self.NPCBarterSelectedList = -1
            self.NPCBarterItemList[:] = []
            self.gotten_barter_item_types.clear()
            self.NPCbarterHideUnaffordable = data
            self.UpdateNPCBarter(upd_pack=True, upd_slots=True)
        elif event == soGUI.BarterWindowGUI.EVENT_BUY:
            custom_desire_quontity = BWPersonality.GUICore.packageGUI.get_barter_multiplier()
            possible_quontity = self.possible_barter_count
            if possible_quontity == 0 or custom_desire_quontity == 0:
                self.ReportFail(ItemsUtils.FAIL_NO_RESOURCE)
                return
            if custom_desire_quontity > possible_quontity:
                custom_desire_quontity = possible_quontity

            def barter_on(event, data):
                if event != MESSAGEBOX.EVENT_BTNPRESS:
                    return
                if data['btn'] != MESSAGEBOX.BTN_YES:
                    return
                self.startNPCBarter(self.TraderID, self.NPCBarterSelectedList, self.NPCBarterItemList, custom_desire_quontity)
                self.NPCBarterItemList[:] = []
                self.gotten_barter_item_types.clear()
                self.UpdateNPCBarter(upd_slots=True)

            ask_yes_no('Inventory.startNPCBarter', lc('Inventory.client.CONFIRM_BARTER_TITLE'), lc('Inventory.client.CONFIRM_BARTER_TEXT').format(custom_desire_quontity, possible_quontity), callback=barter_on)
        elif event == soGUI.BarterWindowGUI.EVENT_CLEAR:
            self.NPCBarterItemList[:] = []
            self.gotten_barter_item_types.clear()
            self.UpdateNPCBarter(upd_slots=True)
        elif event == soGUI.BarterWindowGUI.EVENT_ITEMADD:
            if not data:
                return
            item_type = data['complexItemType']
            if not self._permit_adding_item(item_type):
                return
            if ItemsUtils.IsItemMoveable(data, entity=self):
                self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Inventory.client.PERSONAL_ITEM'))
                return
            trader = BigWorld.entities[self.TraderID]
            good_result = ItemsUtils.QUALITY_GOOD
            if not trader.BarterIgnoreCondition:
                good_result = ItemsUtils.isItemGoodForSale(data)
            if good_result != ItemsUtils.QUALITY_GOOD:
                if good_result == ItemsUtils.QUALITY_BAD_REPAIRS:
                    message = lc('Inventory.client.BAD_CONDITION1')
                else:
                    message = lc('Inventory.client.BAD_CONDITION0')
                BigWorld.player().putMessage(CHANNEL_CONSTS.SYSTEM, message)
                return
            complex_item_id = data['complexItemID']
            self.gotten_barter_item_types[item_type].append(complex_item_id)
            self.NPCBarterItemList.append(complex_item_id)
            self.UpdateNPCBarter(upd_slots=True)
        elif event == soGUI.BarterWindowGUI.EVENT_ITEMREMOVE:
            if not data:
                return
            removing_item_type = data['complexItemType']
            if removing_item_type not in self.gotten_barter_item_types:
                return
            complex_item_ids = self.gotten_barter_item_types.pop(removing_item_type)
            for complex_item_id in complex_item_ids:
                self.NPCBarterItemList.remove(complex_item_id)

            self.UpdateNPCBarter(upd_slots=True)
        elif event == soGUI.BarterWindowGUI.EVENT_ITEMCONTEXT:
            if not data:
                return
            self.context_menu_item = data[0]
            actions = {ItemsCatalog.CAN_INFO: lc('Inventory.INFO')}
            self.StartInventoryContextMenu(actions, BWPersonality.GUICore.GUI_ID_INVENTORY)
        elif event == soGUI.BarterWindowGUI.EVENT_CLOSE:
            self.NPCBarterSelectedList = -1
            self.NPCBarterItemList[:] = []
            self.gotten_barter_item_types.clear()
            self.UpdateNPCBarter(clear=True)
        self.NeedToUpdateInventory()

    def _permit_adding_item(self, checking_item_type):
        """\xd0\x9f\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd1\x8f\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xbe\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd1\x8d\xd1\x82\xd0\xbe\xd1\x82 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82 \xd0\xb1\xd1\x8b\xd1\x82\xd1\x8c \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xbb\xd0\xb5\xd0\xbd \xd0\xb2 \xd1\x82\xd1\x80\xd0\xb5\xd0\xb1\xd1\x83\xd0\xb5\xd0\xbc\xd1\x8b\xd0\xb5 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbc\xd0\xb5\xd1\x82\xd1\x8b \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xb1\xd0\xb0\xd1\x80\xd1\x82\xd0\xb5\xd1\x80\xd0\xb0."""
        if self.NPCBarterSelectedList == -1:
            return False
        try:
            trader = BigWorld.entities[self.TraderID]
        except KeyError:
            return False

        barter_list = trader.BarterAssortment[self.NPCBarterSelectedList]
        for item_type, _item_quantity in barter_list['resourceItems']:
            if item_type == checking_item_type:
                return True

        return False

    def itemFilterFunction(self, item_sequence, item_lambda, filter_integer):
        """\xd0\xa4\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd1\x83\xd0\xb5\xd1\x82 \xd0\xb0\xd1\x81\xd1\x81\xd0\xbe\xd1\x80\xd1\x82\xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbf\xd0\xbe \xd0\xb7\xd0\xb0\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x84\xd0\xb8\xd0\xbb\xd1\x8c\xd1\x82\xd1\x80\xd0\xb0\xd0\xbc.
        item_sequence - \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xbe\xd0\xba \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9 (\xd0\xb2\xd0\xb8\xd0\xb4 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8f \xd1\x81\xd0\xbc\xd0\xbe\xd1\x82\xd1\x80\xd0\xb5\xd1\x82\xd1\x8c \xd0\xb2 ItemsUtils.CreateComplexItem)
        item_lambda - ... \xd1\x85\xd0\xb7
        filter_integer - \xd0\xb1\xd0\xb8\xd1\x82\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x8f \xd0\xbc\xd0\xb0\xd1\x81\xd0\xba\xd0\xb0
        """
        item_list = []
        for item_id in item_sequence:
            item = item_lambda(item_id) if item_lambda else item_id
            item_category = ItemsCatalog.GetItemCategory(item['complexItemType'])
            if ItemsUtils.IsQuestItem(item):
                item_category = 'quest_item_category'
            filter_bit = IC.get_filter(item_category)
            if filter_bit is None or filter_integer & filter_bit:
                item_list.append(item)

        return item_list

