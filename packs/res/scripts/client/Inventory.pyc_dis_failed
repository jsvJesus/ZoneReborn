            item = self.context_menu_item
            if type(id) == tuple and len(id) == 2:
                command, other_item_id = id
                if command == 'extract_art':

                    def continue_exctract():
                        self.DatachItem(item['complexItemID'], other_item_id)

                    if not other_item_id and BWPersonality.GUICore.tradeGUI and BWPersonality.GUICore.tradeGUI.isVisible():

                        def gui_listener(event):
                            if event == gui_jokes.askUserYesNo.YES:
                                continue_exctract()

                        title = lc('Inventory.client.ART_EXTRACT_TITLE')
                        text = lc('Inventory.client.ART_EXTRACT_TEXT')
                        gui_jokes.askUserYesNo(title, text, gui_listener)
                    else:
                        continue_exctract()
                elif command == 'attach_art_to':
                    self.AttachItem(other_item_id, item['complexItemID'])
                elif command == 'stab_cont_fill_me':
                    self.addStabToArtefactContainer(item['complexItemID'], other_item_id)
            elif id == ItemsCatalog.CAN_PUT_ON:
                self.putOnItem(item)
            elif id == ItemsCatalog.CAN_TAKE_IN_HAND:
                self.equipThrowItem(item)
            elif id == ItemsCatalog.CAN_USE:
                self.useItem(item)
            elif id == ItemsCatalog.CAN_DISASSEMBLE:
                self.showDisassembleDialog(item)
            elif id == 'copy_id':
                BigWorld.clipboardSetPlainText(str(item['complexItemID']))
            elif id == 'copy_type':
                BigWorld.clipboardSetPlainText(str(item['complexItemType']))
            elif id == ItemsCatalog.CAN_USE_ON_TARGET:
                self.useItemOnTarget(item['complexItemID'])
            elif id == ItemsCatalog.CAN_DROP:
                self.InventoryDropItem(item)
            elif id == ItemsCatalog.CAN_INFO:
                itemID = item['complexItemID']
                BWPersonality.GUICore.showItemInfo(item)
            elif id == ItemsCatalog.CAN_LOAD_IN_WEAPON:
                self.LoadAmmoInCurrentWeapon(item['complexItemID'])
            elif id == ItemsCatalog.CAN_UNLOAD:
                pass
            elif id == ItemsCatalog.CAN_SPARE:

                def number_check(newStr, wholeText, offset):
                    full_text = wholeText[0:offset] + newStr + wholeText[offset:]
                    if not full_text.isdigit():
                        return False
                    if wholeText:
                        if int(full_text) < ItemsUtils.GetItemNumber(item):
                            return True
                        return False
                    return True

                msgbox_templates.input_box_ok_cancel('Inventory.SpareCalback', lc('Inventory.client.DIVIDE_PROCESS'), colorCodes.tf3_regular_text_color + lc('Inventory.client.HOW_MUCH_ITEMS_DEVIDE'), callback=self.SpareCalback, default='1', input_validator=number_check)
            elif id == ItemsCatalog.CAN_EQUIP:
                self.equipItem(item)
            elif id >= ItemsCatalog.MAX_ITEM_NUMBER:
                self.DatachItem(item['complexItemID'], id)
            elif id == ItemsCatalog.CAN_ADD_MARK:
                self.AddCustomGPSMark(item)
            elif id == ItemsCatalog.CAN_DELETE_MARK:
                self.DeleteCustomGPSMark(item)
            elif id == ItemsCatalog.CAN_REPORT_BUG:
                self.reportBugEvent(item)
            elif id == ItemsCatalog.CAN_TELEPORT:
                position = self.GPSProvider.GetObjectAbsouluteCoords(self.context_menu_item[0][0], self.context_menu_item[0][1], self.context_menu_item[1])
                if self.offline_mode:
                    res = utils_bw.collide(self.spaceID, Math.Vector3(0, 500, 0) + position, position - Math.Vector3(0, 500, 0))
                    if res:
                        position = res[0]
                    self.physics.teleport(position, (self.yaw, 0, 0))
                else:
                    self.cell.teleportFromGPS(Math.Vector2(position[0], position[2]), self.context_menu_item[1])
            elif id == ItemsCatalog.CAN_INFO_TRADE:
                BWPersonality.GUICore.showItemInfo(item)
            elif id == ItemsCatalog.CAN_BUY_TRADE_NUMB:
                if ItemsUtils.isStackedItemType(item['complexItemType']):
                    _max_limit = 10000
                else:
                    _max_limit = ItemsUtils.MAX_ITEMS_TO_TRADE - len(self.ToBuyList)

                def add_number_to_buy(event, data):
                    if event == MESSAGEBOX.EVENT_BTNPRESS:
                        if data['btn'] in (MESSAGEBOX.BTN_OK, MESSAGEBOX.BTN_YES):
                            text = data['add_controls']['edit_box']
                            if text.isdigit():
                                quantity = int(text)
                                if quantity > 0 and quantity <= _max_limit:
                                    self.MoveToBuy(item, quantity)
                                    self.UpdateTradeInterface()
                                elif BWPersonality.GUICore.tradeGUI:
                                    BWPersonality.GUICore.tradeGUI.errFrameShow()

                def number_check(newStr, wholeText, offset):
                    full_text = wholeText[0:offset] + newStr + wholeText[offset:]
                    if not full_text.isdigit():
                        return False
                    if wholeText:
                        quantity = int(full_text)
                        if quantity > 0 and quantity <= _max_limit:
                            return True
                        return False
                    return True

                msgbox_templates.input_box_ok_cancel('Inventory.add_number_to_buy', lc('GUI.Inventory.BUY_CAPTION'), colorCodes.tf3_regular_text_color + lc('GUI.Inventory.BUY_TEXT_ADD'), callback=add_number_to_buy, default='1', input_validator=number_check)
