    def ExchangeEvent(self, event, data):
        from gui_const import PC_TRADE
        if event == PC_TRADE.EVENT_CONTEXT:
            self.exchange_selected_item = data
            if self.exchange_selected_item and self.exchange_selected_item[1]:
                actions = {ItemsCatalog.CAN_INFO: lc('Inventory.client.INFO')}
                BWPersonality.GUICore.addListener('contextMenuEvent', self.ExchangeContextMenuEvent)
                BWPersonality.GUICore.showContextMenu(BWPersonality.GUICore.GUI_ID_PCTRADE, actions)
        if event == PC_TRADE.EVENT_ADDITEM:
            if data:
                if len(self.PCTradeItems) >= Constants.MAX_USER_PCTRADE_ITEMS:
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.MAX_USER_PCTRADE_ITEMS'))
                    return
                if data not in self.PCTradeItems:
                    item_param = ItemsCatalog.GetItemParam(data['complexItemType'])
                    if item_param.get('isnotTradeable'):
                        self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.isnotTradeable_msg'))
                        return
                    if ItemsUtils.IsItemMoveable(data, entity=self):
                        self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Inventory.client.PERSONAL_ITEM'))
                        return
                    self.PCTradeItems.append(data)
                    self.NeedToUpdateExchangeInterface()
                    self.cell.AddItemToTrade(data['complexItemID'])
        if event == PC_TRADE.EVENT_DELITEM:
            if data:
                for item in self.PCTradeItems:
                    if data['complexItemID'] == item['complexItemID']:
                        self.PCTradeItems.remove(item)
                        self.NeedToUpdateExchangeInterface()
                        break

                self.cell.RemoveItemFromTrade(data['complexItemID'])
        if event == PC_TRADE.EVENT_MONEYSET:
            self.PCTradeMoney = data
            self.cell.SetMoneyToTrade(self.PCTradeMoney)
        if event == PC_TRADE.EVENT_OFFER:
            self.cell.SetOffer(1)
        if event == PC_TRADE.EVENT_CONFIRM:
            self.cell.SetConfirm(1)
        if event == PC_TRADE.EVENT_CANCEL:
            self.cell.CancelTrade(0)
            if self.exchange_timer_id:
                BigWorld.cancelCallback(self.exchange_timer_id)
        if event == PC_TRADE.EVENT_ABORT:
            self.cell.CancelTrade(1)
            self.InitPlayerTrade()
            self.NeedToUpdateInventory()
        if event == PC_TRADE.EVENT_CHANGE_TERMS:
            self.cell.CancelTrade(2)
            if self.exchange_timer_id:
                BigWorld.cancelCallback(self.exchange_timer_id)

