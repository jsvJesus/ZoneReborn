    def UseQuickSlot(self, num_slot):
        try:
            current_line = self.quickSlotBars[self.quickSlotActiveLineNumber - 1]
        except IndexError as e:
            print e
            return

        try:
            used_slot = current_line[num_slot]
        except IndexError as e:
            print e
            return

        if used_slot[QUICK_TYPE_POS] == QUICK_BAR_ITEM:
            item_id = used_slot[QUICK_DATA_ID_POS]
            if self.hasControlLockByEffect(EffectNames.Stun):
                self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.PROHIBIT_USE'))
                return
            if item_id:
                item = ItemsUtils.GetComplexItemByID(self, item_id)
            else:
                item = ItemsUtils.GetFirstComplexItemByType(self, used_slot[QUICK_DATA_TYPE_POS])
            self.DoItemDefaultAction(item)

    def UseQuickLine(self, num_slot):
        num_slot += 1
        if len(self.quickSlotBars) >= num_slot:
            self.quickSlotActiveLineNumber = num_slot
            self.cell.SaveQuickBar(self.quickSlotBars, self.quickSlotActiveLineNumber)
        self.UpdateQuickBar()

    def actionBarEvent(self, event, data):
        if event == soGUI.soActionBar.EVENT_REMOVE:
            self.EmptyQuickSlot(data)
        if event == soGUI.soActionBar.EVENT_USE:
            self.UseQuickSlot(data)
        if event == soGUI.soActionBar.EVENT_CONTEXT:
            pass
        if event == soGUI.soActionBar.EVENT_MOVE:
            self.SwapQuickSlotBar(data)
        if event == soGUI.soActionBar.EVENT_BARSCROLL:
            if data > 0:
                if not self.IsHigherQuickBarLinesEmpty(self.quickSlotActiveLineNumber - 1):
                    if self.quickSlotActiveLineNumber < MAX_QUICK_BAR_LINES:
                        self.quickSlotActiveLineNumber += 1
                        self.CheckQuickBarToAppendNewLines()
                        self.cell.SaveQuickBar(self.quickSlotBars, self.quickSlotActiveLineNumber)
            elif data < 0:
                if self.quickSlotActiveLineNumber > 1:
                    if len(self.quickSlotBars) > 1:
                        if sum((x[0] + x[1] for x in self.quickSlotBars[-1])) == 0:
                            del self.quickSlotBars[-1]
                    self.quickSlotActiveLineNumber -= 1
                    self.cell.SaveQuickBar(self.quickSlotBars, self.quickSlotActiveLineNumber)
        self.UpdateQuickBar()

    def IsQuickBarLineEmpty(self, lineNumber):
        try:
            current_line = self.quickSlotBars[lineNumber]
        except IndexError as e:
            print e
            return

        for entry in current_line:
            if entry[QUICK_TYPE_POS] != QUICK_BAR_EMPTY:
                return False

        return True

    def IsHigherQuickBarLinesEmpty(self, lineNumber):
        for index in range(lineNumber, len(self.quickSlotBars)):
            if not self.IsQuickBarLineEmpty(index):
                return False

        return True

    def equipThrowItem(self, item):
        if not self.canUse() or self.is_throwing or not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        if not item:
            return
        if item['complexItemID'] == self.ActiveThrowID:
            return
        if self.usingGesture or self.use_gesture:
            return
        duration = Durations.getThrowUnEquipDuration(self) * CharacterUtils.getEquipThrowModifier(self)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, duration, lc('Items.GUIStrings.EQUIP'))
        self.cell.equipThrow(item['complexItemID'], False)

    def DoItemDefaultAction(self, item):
        if not item or self.ItemLocked(item) or self.clone_model or self.throwColldown() or self.binoculars_animation:
            return
        elif not self.canUse() or self.is_throwing or not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            return
        else:
            item_type = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            if item_class == ItemsCatalog.WEAPON:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
                elif self.ActiveItemID != item['complexItemID']:
                    self.EquipWeaponCommand(item)
                elif self.ActiveItemID == item['complexItemID'] and self.ActiveThrowID and self.ActiveThrowType:
                    self.cell.equipThrow(0, False)
            elif item_class == ItemsCatalog.CLOTH:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
            elif item_class == ItemsCatalog.EXPLOSION:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
                else:
                    self.equipThrowItem(item)
            elif item_class == ItemsCatalog.BUFF:
                item_params = ItemsCatalog.GetItemParam(item_type)
                if item_params.get('CanUse', 1):
                    self.useItem(item)
            elif item_class == ItemsCatalog.AMMO:
                self.LoadAmmoInCurrentWeapon(item['complexItemID'])
            elif item_class == ItemsCatalog.GADGET:
                item_params = ItemsCatalog.GetItemParam(item_type)
                if 'waterNumberOfSips' in item_params:
                    sips = ItemsUtils.getWaterSipsPot(item)
                    if sips < 1:
                        self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Inventory.client.EMPTY_BOOTLE'))
                        return
                    self.useItem(item)
                    return
                if item_params.get('SubType', None) and not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
                if ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    gadget_action = item_params.get('Action', None)
                    if gadget_action:
                        self.startGadgetAction(gadget_action, item_params, item)
            elif item_class == ItemsCatalog.ARTIFACT:
                if not ItemsUtils.IsItemEquipped(self, item['complexItemID']):
                    self.putOnItem(item)
            elif item_class == ItemsCatalog.LOOT:
                if self.canUse() and self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                    item_params = ItemsCatalog.GetItemParam(item_type)
                    if item_params.get('isSandbag', False):
                        self.startCreateSandbag(item['complexItemID'])
                    elif 'CanUse' in item_params and item_params['CanUse']:
                        self.useItem(item)
            return

    def UpdateQuickBar(self, delay = 0.3):

        def update():
            data = {}
            data['line_number'] = str(self.quickSlotActiveLineNumber)
            if len(self.quickSlotBars) < self.quickSlotActiveLineNumber:
                self.quickSlotActiveLineNumber = max(1, len(self.quickSlotBars))
            try:
                current_line = self.quickSlotBars[self.quickSlotActiveLineNumber - 1]
            except IndexError as e:
                print e
                return

            slots = []
            for entry_index in xrange(len(current_line)):
                quick_entry = current_line[entry_index]
                slot_dict = {'icon': '',
                 'abovetext': str(entry_index + 1)[-1],
                 'low_right_number': '',
                 'item': None,
                 'item_id': 0,
                 'item_type': 0,
                 'left_text': ''}
                if quick_entry[QUICK_TYPE_POS] == QUICK_BAR_EMPTY:
                    slots.append(slot_dict)
                    continue
                if quick_entry[QUICK_TYPE_POS] == QUICK_BAR_ITEM:
                    item = None
                    item_id = quick_entry[QUICK_DATA_ID_POS]
                    item_type = quick_entry[QUICK_DATA_TYPE_POS]
                    item_class = ItemsCatalog.GetItemClass(item_type)
                    if item_id:
                        item = ItemsUtils.GetComplexItemByID(self, item_id)
                    if not item and item_class in [ItemsCatalog.WEAPON, ItemsCatalog.CLOTH]:
                        current_line[entry_index] = [0, 0, QUICK_BAR_EMPTY]
                        slots.append(slot_dict)
                        continue
                    if not item:
                        item = ItemsUtils.GetFirstComplexItemByType(self, item_type)
                        item_id = item['complexItemID'] if item else 0
                    low_right_number = ''
                    if item:
                        slot_dict['have_item'] = True
                        if len(item['itemList']):
                            item_param = ItemsCatalog.GetItemParam(item_type)
                            slot_dict['left_text'] = '+'
                            if item_param.get('IsArtefactContainer', 0):
                                slot_dict['left_text'] = str(len(item['itemList']))
                        low_right_number = ItemsUtils.GetDisplayValue(item)
                    try:
                        icon_name = ItemsUtils.GetIconName(item, item_type)
                    except:
                        print item, item_type
                        traceback.print_exc()
                        icon_name = 'texture_not_found.dds'

                    above_text = str(entry_index + 1)[-1]
                    slot_dict['low_right_number'] = low_right_number
                    slot_dict['abovetext'] = above_text
                    slot_dict['item_type'] = item_type
                    slot_dict['icon'] = icon_name
                    slot_dict['item_id'] = item_id
                    slot_dict['item'] = item
                    current_line[entry_index] = [item_id, item_type, QUICK_BAR_ITEM]
                slots.append(slot_dict)

            data['slots'] = slots
            BWPersonality.GUICore.setActionBarData(data)
            return

        if getattr(self, 'updateQuickBarTimer', None):
            BigWorld.cancelCallback(self.updateQuickBarTimer)
        BigWorld.callback(delay, update)
        return

