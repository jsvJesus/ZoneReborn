    def GetItemActions(self, item):
        returning_list = {ItemsCatalog.CAN_INFO: lc('Inventory.client.INFO')}
        item_type = item['complexItemType']
        param = ItemsCatalog.GetItemParam(item_type)
        item_class = ItemsCatalog.GetItemClass(item_type)
        if not ItemsUtils.IsItemMoveable(item):
            returning_list[ItemsCatalog.CAN_DROP] = lc('Inventory.client.DROP')
        if param.get('disassemblesTo', None):
            returning_list[ItemsCatalog.CAN_DISASSEMBLE] = lc('Inventory.client.CAN_DISASSEMBLE')
        if item_class in [ItemsCatalog.WEAPON, ItemsCatalog.CLOTH]:
            returning_list[ItemsCatalog.CAN_PUT_ON] = lc('Inventory.client.EQUIP')
            for sub_item in item['itemList']:
                returning_list[sub_item['itemID']] = lc('Inventory.client.REMOVE') + ': ' + ItemsUtils.GetItemName(sub_item['itemType'], tintItem=item)

        elif item_class == ItemsCatalog.BUFF:
            if param.get('IsArtefactContainer'):
                for sub_item in item['itemList']:
                    returning_list['extract_art', sub_item['itemID']] = lc('Inventory.client.EXTRACT') + ': ' + ItemsUtils.GetItemName(sub_item['itemType'])

                if len(item['itemList']) > 1:
                    returning_list[('extract_art', 0)] = lc('Inventory.client.EXTRACT_ALL')
                max_uses = param['MaxUseArtefact']
                cont_inc = ItemsUtils.GetComplexItemInconstanParams(item)
                num_uses = cont_inc.get(ItemsCatalog.INC_USES_CONTAINER_NUMBER, 0)
                if num_uses >= max_uses:
                    stable_solute = ItemsUtils.GetFirstStableSolute(self)
                    if stable_solute:
                        returning_list['stab_cont_fill_me', stable_solute['complexItemID']] = lc('Inventory.client.FILL_STAB')
            elif param.get('ForArefContainerStable'):
                pass
            else:
                item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
                if item_param.get('CanUse', 1):
                    local = 'Inventory.client.USE'
                    local = item_param.get('Action_use_name_local', local)
                    returning_list[ItemsCatalog.CAN_USE] = lc(local)
        elif item_class == ItemsCatalog.AMMO:
            active_ammo_param = ItemsCatalog.GetItemParam(self.ActiveItemAmmoType)
            if param.get('SubType') != ItemsCatalog.BATTERY and (not active_ammo_param or param.get('AmmoType') == active_ammo_param.get('AmmoType')):
