    def inventoryEvent(self, action, item, slot = None):

        def _repair_check(event):
            if event == gui_jokes.askUserYesNo.YES:
                BWPersonality.GUICore.showRepairMode(False)
                self.ThrowRepairID(item['complexItemID'])

        if action == INV_CONST.EVENT_REPAIR:
            if not item:
                return
            err_code = ItemsUtils.CanItemBeRepaired(self, item, self.last_repair_class)
            if err_code is not None:
                self.ReportFail(err_code)
                return
            text = colorCodes.tf3_regular_text_color + lc('Inventory.client.REPAIR_ANSWER_TEXT')
            if BWPersonality.GUICore._repairModeNPC:
                if self.last_repair_class != None:
                    item_class = ItemsCatalog.GetItemClass(item['complexItemType'])
                    if self.last_repair_class != item_class:
                        self.ReportFail(ItemsUtils.FAIL_NOT_MY_TYPE)
                        return
                trader_entity = BigWorld.entities.get(self.TraderID)
                repair_cost, margin = ItemsUtils.GetRepairCost(item, self, trader_entity)
                repair_cost = groupNumber(repair_cost, '`')
                text += '\n' + lc('Inventory.client.REPAIR_ANSWER_TEXT_MONEY').format(repair_cost)
            gui_jokes.askUserYesNo(lc('Inventory.client.REPAIR_ANSWER_CAPTION'), text, _repair_check)
            return
        elif not self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
            BWPersonality.gpd.sendLowerMessage(lc('PlayerAvatar.client.FAIL_CHECKRESTRICTION'))
            return
        else:
            if action == INV_CONST.EVENT_MOVE_UP:
                self.setFirstItemSlotNumber(item)
            if action == INV_CONST.EVENT_MOVE_DOWN:
                self.setlastItemSlotNumber(item)
            if action == INV_CONST.EVENT_MOVE:
                if self.ItemLocked(item[0]):
                    return
                if self.ItemLocked(item[1]):
                    return
                if item[0] and item[1]:
                    if BigWorld.isKeyDown(Keys.KEY_LSHIFT) or BigWorld.isKeyDown(Keys.KEY_RSHIFT):
                        self.displaceItemSlot(item[1], item[0])
                        return
                    if ItemsUtils.CheckPossibleAttach(self, item[0], item[1]):
                        if self._move_item_to_item(item[0], item[1]):
                            return
                        return
                    self.ChangeItemSlotNumber(item[1], item[0])
                    return
                if item[1]:
                    self.setlastItemSlotNumber(item[1])
                return
            elif action == INV_CONST.EVENT_TOQUICKBAR:
                itemData, slotN, prev_item_id, prev_item_type = item
                if self.ItemLocked(item[0]):
                    return
                if prev_item_id:
                    prev_item = ItemsUtils.GetComplexItemByID(self, prev_item_id)
                    if prev_item:
                        if ItemsUtils.CheckPossibleAttach(self, prev_item, itemData):
                            self._move_item_to_item(prev_item, itemData)
                            return
                self.AddItemToQuickSlot(itemData, slotN)
                self.UpdateQuickBar()
                return
            elif self.ItemLocked(item):
                return
            if action == INV_CONST.EVENT_EQUIP:
                self.DoItemDefaultAction(item)
            elif action == INV_CONST.EVENT_FILTERCHANGE:
                self.SetInventoryFilter(item)
            elif action == INV_CONST.EVENT_CONTEXT:
                if self.ItemLocked(item):
                    return
                self.context_menu_item = item
                self.context_menu_slot = slot
                if self.context_menu_item:
                    actions = self.GetItemActions(self.context_menu_item)
                    if BigWorld.isKeyDown(BigWorld.stringToKey('F2')) and self.isAdminAccess():
                        actions['copy_id'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemID'
                        actions['copy_type'] = u'\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c ItemType'
                    self.StartInventoryContextMenu(actions, BWPersonality.GUICore.GUI_ID_INVENTORY)
            elif action == INV_CONST.EVENT_DROP:
                self.InventoryDropItem(item)
            elif action == INV_CONST.EVENT_DELETE:
                self.InventoryDeleteItem(item)
            elif action == INV_CONST.EVENT_ACTION:
                pass
            else:
                return
            return

    def _move_item_to_item(self, motherItem, attachingItem):
        result, error_code = ItemsUtils.canUseDyeTint(motherItem, attachingItem)
        if result:
            if ItemsUtils.IsItemEquipped(self, motherItem['complexItemID']):
                self.ReportCodedMessage(ItemsUtils.FAIL_CANT_MODIFY_EQUIPPED_ITEM)
                return True
            if not error_code:

                def put_dye_listener(event):
                    if event == gui_jokes.askUserYesNo.YES:
                        self.useDueTintWeapon(motherItem['complexItemID'], attachingItem['complexItemID'])

                msg = lc('Inventory.ASK_USE_TINT').format(ItemsUtils.GetItemName(attachingItem['complexItemType']), ItemsUtils.GetItemName(motherItem['complexItemType']))
                gui_jokes.askUserYesNo('', msg, put_dye_listener)
            else:
                print 'Error canUseDyeTint', error_code
                if ItemsUtils.FAIL_USE_TINT_OLD_TINT == error_code:
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Inventory.FAIL_USE_TINT_OLD_TINT'))
                if ItemsUtils.FAIL_USE_TINT_NO_TINT == error_code:
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('Inventory.FAIL_CANUSEDYETINT'))
            return True
        if ItemsUtils.can_charge_gadget_with_item(self, motherItem, attachingItem):
            self.charge_gadget_with_item(motherItem, attachingItem)
            return True
        result, part_type, error_code = ItemsUtils.CanAttachItem(self, motherItem, attachingItem)
        if result:
            self.AttachItem(motherItem['complexItemID'], attachingItem['complexItemID'])
            return True
        if error_code in (ItemsUtils.FAIL_CANT_MODIFY_EQUIPPED_ITEM, ItemsUtils.FAIL_ARTEFACT_DEAD):
            self.ReportCodedMessage(error_code)
            return True
        if ItemsUtils.CanAddStabToArtefactContainer(self, motherItem, attachingItem):
            self.addStabToArtefactContainer(motherItem['complexItemID'], attachingItem['complexItemID'])
            return True
        if motherItem['complexItemType'] == attachingItem['complexItemType']:
            self.UniteItems(motherItem, attachingItem)
            return True
        return False

    def charge_gadget_with_item(self, item_gadget, item_battery = None):
        """
        \xd0\xb7\xd0\xb0\xd1\x80\xd1\x8f\xd0\xb4\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb3\xd0\xb0\xd0\xb4\xd0\xb6\xd0\xb5\xd1\x82 \xd0\xb1\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9\xd0\xba\xd0\xb0\xd0\xbc\xd0\xb8
        \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb1\xd0\xb0\xd1\x82\xd0\xb0\xd1\x80\xd0\xb5\xd0\xb9\xd0\xba\xd0\xb8 \xd0\xbd\xd0\xb5 \xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd1\x8b, \xd0\xbd\xd0\xb0\xd0\xb9\xd0\xb4\xd1\x91\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc
        \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd1\x80\xd0\xb0\xd1\x89\xd0\xb0\xd0\xb5\xd1\x82 \xd1\x83\xd1\x81\xd0\xbf\xd0\xb5\xd1\x85 (\xd0\xbd\xd0\xb5\xd1\x83\xd1\x81\xd0\xbf\xd0\xb5\xd1\x85)
        """
        gadget_params = ItemsCatalog.GetItemParam(item_gadget['complexItemType'])
        if 'ManualFuel' not in gadget_params:
            return False
        if item_battery:
            battery_param = ItemsCatalog.GetItemParam(item_battery['complexItemType'])
            if battery_param.get('AmmoType') == gadget_params['ManualFuel']:
                if ItemsUtils.GetBatteryLevel(item_gadget) >= ItemsUtils.GetMaxBatteryLevel(item_gadget):
                    self.putMessage(CHANNEL_CONSTS.SYSTEM, lc('ItemHolder.FULL_CHARGED'))
                    return True
                self.cell.chargeBatteryWithItem(item_gadget['complexItemID'], item_battery['complexItemID'])
                return True
            else:
                return False
        else:
            self.cell.charge_item(item_gadget['complexItemID'])
            return True

