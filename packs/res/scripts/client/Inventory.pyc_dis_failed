    def GetReceiptInfo(self, item_param):
        text = u''
        needWorkbenchType = item_param.get('needWorkbenchType', None)
        if needWorkbenchType:
            text += lc('Inventory.client.needWorkbenchType').format(WorkbenchUtil.getName(needWorkbenchType)) + u'\n'
        if item_param.has_key('NeededResourcess'):
            text += u'\n'
            resource_string = u'\n'
            for item_type, number in item_param['NeededResourcess'].items():
                link = u'<hlink=%s;INFO:TYPE:%s;>' % (ItemsUtils.GetItemName(item_type), item_type)
                resource_string += '   ' + link + lc('Inventory.client.CRAFT_ITEM_COUNT').format(str(number)) + u'\n'

            text += lc('Inventory.client.NEEDED_RESOURCES').format(resource_string) + u'\n'
        if item_param.has_key('NeededSkill') and item_param['NeededSkill']:

            def iterable(dct):
                for skill_name, value in dct.items():
                    yield (skill_name, value)

            def temp_func(skill_name, value):
                return (lc(CharacterUtils.GetSkillFriendlyName(skill_name)), str(value))

            needed_skill_string = u'\n' + u';\n'.join((u'   {0}: {1}'.format(*temp_func(skill_name, value)) for skill_name, value in iterable(item_param['NeededSkill'])))
            text += lc('Inventory.client.NEEDED_SKILLS').format(needed_skill_string) + u'\n'
            text += u'\n'
        if item_param.has_key('CraftChance'):
            text += lc('Inventory.client.SUCCES_CHANCE').format(item_param['CraftChance'] * 100) + '%' + u'\n'
        if item_param.has_key('CraftTime'):
            text += lc('Inventory.client.CRAFT_TIME').format(item_param['CraftTime'] / 100.0) + u'\n'
            text += u'\n'
        return text

    def ContextMenuEvent(self, interface_id, id, caption, event, data = None):
        if interface_id not in [BWPersonality.GUICore.GUI_ID_PDAMAP, BWPersonality.GUICore.GUI_ID_INVENTORY, BWPersonality.GUICore.GUI_ID_NPCTRADE]:
            return
        _max_limit = ItemsUtils.MAX_ITEMS_TO_TRADE
