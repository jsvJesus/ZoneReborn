        """\xd0\xa5\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb0\xd0\xb5\xd1\x82 \xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb5\xd0\xb3 \xd1\x83 \xd0\xbf\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xb7\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8f."""
        try:
            trader_entity = BigWorld.entities[self.TraderID]
        except KeyError:
            return False

        check_sum = self.ToBuyList.total_cost(trader_entity)
        aviable_sum = ItemsUtils.GetPlayerMoney(self)
        result = ItemsUtils.CheckMoney(check_sum, aviable_sum)
        return result

    def DoTrade(self):
        if self.TradeMode == NPC_VENDOR.MODE_SELL:
            have_gold_item = False
            selling_items_list = []
            for item in self.ToSellList:
                item_type_id = item['complexItemType']
                item_param = ItemsCatalog.GetItemParam(item_type_id)
                gold_cost = item_param.get('GoldCost', None)
                if item_param.get('SoldForGold', 0):
                    selling_items_list.append(item)
                    continue
                if gold_cost > 0:
                    have_gold_item = True
                selling_items_list.append(item)

            if selling_items_list:
                self._begin_selling(selling_items_list, have_gold_item)
        else:
            if not self._money_check():
                self.ReportFail(ItemsUtils.FAIL_NO_MONEY)
                return
            if not self.can_place_by_weight():
                self.ReportFail(ItemsUtils.FAIL_OVERWEIGHT)
                return
            if not ItemsUtils.CheckMaxItemNumber(self, len(self.ToBuyList)):
                self.ReportFail(ItemsUtils.FAIL_MAX_ITEMS)
                print 'DoTrade::--ReportFail, ItemsUtils.FAIL_MAX_ITEMS', ItemsUtils.FAIL_MAX_ITEMS
                return
            buying_items = self.ToBuyList.extract_data()
            self.buy_item(self.TraderID, buying_items)
        self.ClearTrade()
        return

