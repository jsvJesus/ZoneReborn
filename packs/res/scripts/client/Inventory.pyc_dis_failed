    def CreateFakeItem(self, item_type, forGold = False):
        item_param = ItemsCatalog.GetItemParam(item_type)
        if not item_param:
            return None
        else:
            complexItemParameresKeys = copy(item_param['InconstantPropertiesKeys'])
            complexItemParameresValues = copy(item_param['InconstantPropertiesValues'])
            inconstant_item_param = dict(zip(complexItemParameresKeys, complexItemParameresValues))
            item_class = ItemsCatalog.GetItemClass(item_type)
            if item_class in [ItemsCatalog.WEAPON, ItemsCatalog.CLOTH, ItemsCatalog.GADGET]:
                inconstant_item_param[ItemsCatalog.INC_CONDITION_VALUE] = ItemsUtils.GetItemCurrentMaxCondition(inconstant_item_param[ItemsCatalog.INC_REPAIRS_NUMBER], item_param)
            item = ItemsUtils.CreateComplexItem(0, item_type, inconstant_item_param.keys(), inconstant_item_param.values(), 0)
            item['forGold'] = forGold
            return item

