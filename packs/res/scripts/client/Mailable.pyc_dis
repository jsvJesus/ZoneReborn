    def putMessage(self, channel_id, text, sender = u''):
        """\xd0\x92\xd1\x8b\xd0\xb2\xd0\xbe\xd0\xb4\xd0\xb8\xd1\x82 \xd1\x81\xd0\xbe\xd0\xbe\xd0\xb1\xd1\x89\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd1\x87\xd0\xb0\xd1\x82."""
        if not text:
            return
        else:
            if isinstance(sender, unicode):
                sender = sender.encode('utf-8')
