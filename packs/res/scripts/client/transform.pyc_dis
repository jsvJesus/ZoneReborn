DEBUG_DRAW = 0

def debug_draw(foo):

    def wrapped(self, *e):
        if self.isDestroyed:
            return
        if not DEBUG_DRAW:
            return
        if not self.model:
            return
        return foo(self, *e)

    return wrapped


class Transformation(object):
    active_transform = None
    vechicle_contorled = None

    def onInitTransform(self, transf):
        BigWorld.callback(0.1, self.SetAvatarModel)

    def onResetTransform(self, transf):
        self.autogunModelVisible = True
        BigWorld.callback(0.0, self.SetAvatarModel)
        if self.vechicle_contorled:
            self.vechicle_contorled.onReset()
            self.vechicle_contorled = None
        return

    def getCurrentModel(self):
        if self.vechicle_contorled and self.vechicle_contorled._model:
            return self.vechicle_contorled._model
        return self.model

    def startTransformAction(self, *e):
        return False

    def set_transformationID(self, *e):
        if self.active_transform:
            self.active_transform.resetTransformation()
            self.active_transform = None
        if self.transformationID:
            self.active_transform = FunTransformation(self, self.transformationID)
            self.active_transform.init(self)
            if self.vechicle_contorled:
                self.vechicle_contorled.onReset()
            if self.active_transform.raw_configs.get('isHelicopter'):
                self.vechicle_contorled = helicopter_transform.Helicopter(self)
                self.vechicle_contorled.onInit()
        self.EnableCrosshair()
        return

    def breakBoredTimer(self):
        pass

    def onActionEvent(self, actionName, okayToGo, event):
        return False

    def onFireHelicopterRoket(self, weaponNodeID, position, velocity, clientGrenadeID, grenade_type):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onFireHelicopterRoket(weaponNodeID, position, velocity, clientGrenadeID, grenade_type)

    def onFireHelicopterMachineGun(self, status, weaponType):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onFireHelicopterMachineGun(status, weaponType)

    def onHelicopterBurn(self):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onHelicopterBurn()

    def onHelicopterEvent(self, event_id, event_status, event_value, event_dir):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onHelicopterEvent(event_id, event_status, event_value, event_dir)

    def set_transformationProperty(self, old = None):
        if not self.vechicle_contorled:
            return
        self.vechicle_contorled.onTransformationProperty(old)

    def transformEvent(self, skill_id, status):
        if not self.active_transform:
            return
        skill = self.active_transform.getSkill(skill_id)
        skill.serverEvent(status)

    def startTSAction(self, action_id, action_name, skill):
        if skill.getActionClass() == 'ANIMATION_SEQUENCE':
            self._startTSActionSeqAnim(action_id, action_name, skill)
        else:
            animation = skill.param['animation']
            if animation:
                try:
                    act = self.model.action(animation)
                    act()
                except:
                    traceback.print_exc()

        if self.ActiveItemID and skill.param.get('sfx_start_animation_armed'):
            self.funSfx(skill.param.get('sfx_start_animation_armed'))
        else:
            self.funSfx(skill.param.get('sfx_start_animation'))

    def _startTSActionSeqAnim(self, action_id, action_name, skill):
        try:
            animation_in = skill.param['animation_in']
            animation_loop = skill.param['animation']
            a_in = self.model.action(animation_in)
            getattr(a_in(), animation_loop)()
        except:
            traceback.print_exc()

    def startTSAapply(self, action_id, action_name, skill, dead_also = True):
        action_class = skill.getActionClass()
        targets = None
        if action_class == 'AOE':
            targets = self.applyAOEAttack(action_id, skill, dead_also=dead_also)
        elif action_class == 'SECTOR_MELEE':
            targets = self.applySectorAttack(action_id, skill, dead_also=dead_also)
        elif action_class == 'ANIMATION':
            pass
        elif action_class == 'ANIMATION_SEQUENCE':
            pass
        elif action_class == 'SELF_EFFECT':
            targets = self.applySelfEffectAttack(action_id, skill)
        else:
            print self
            print [action_id, action_name, skill]
            raise ValueError('uncknow FunnSkill action_class %s' % action_class)
        if targets:
            self.funSfx(skill.param.get('sfx_apply_effect_hit'))
            for victim in targets:
                if isinstance(victim, Transformation):
                    victim.onVictimApplyFTSkill(self, action_id, action_name, skill)

        else:
            self.funSfx(skill.param.get('sfx_apply_effect_boner'))
        return

    def onVictimApplyFTSkill(self, damager, action_id, action_name, skill):
        pass

    def endTSAnimation(self, action_id, action_name, skill):
        if skill.getActionClass() == 'ANIMATION_SEQUENCE':
            self._endTSAnimationSeqAnim(action_id, action_name, skill)
        self.funSfx(skill.param.get('sfx_end_animation'))

    def _endTSAnimationSeqAnim(self, action_id, action_name, skill):
        try:
            animation_out = skill.param['animation_out']
            animation = skill.param['animation']
            self.model.action(animation_out)()
            self.model.action(animation).stop()
        except:
            traceback.print_exc()

    def endTSReuseTimer(self, action_id, action_name, skill):
        pass

    def onStopSkill(self, action_id, action_name, skill):
        pass

    def applySectorAttack(self, action_id, skill, dead_also = False):
        angles_sector = skill.param.get('angles_sector')
        if not angles_sector:
            return []
        min_sector_local = math.radians(angles_sector[0])
        max_sector_local = math.radians(angles_sector[1])
        entities = self._getEntitiesInSkillAOE(action_id, skill, dead_also=dead_also)
        targets = []
        my_dir = Math.Vector3()
        my_dir.setPitchYaw(0, self.model.yaw)
        my_pos = self.position
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            my_pos = Math.Matrix(self.model.matrix).applyPoint(offset)
        for ent in entities:
            to_ent = ent.position - my_pos
            to_ent.normalise()
            dot = to_ent.dot(my_dir)
            dot = max(-1, min(1, dot))
            angle = math.acos(dot)
            if (my_dir * to_ent)[1] < 0:
                angle = -angle
            if min_sector_local <= angle <= max_sector_local:
                targets.append(ent)

        self._show_sector(skill, targets)
        return targets

    def applyAOEAttack(self, action_id, skill, dead_also = False):
        targets = self._getEntitiesInSkillAOE(action_id, skill, dead_also=dead_also)
        self._show_aoe(skill, targets)
        return targets

    def applySelfEffectAttack(self, action_id, skill, dead_also = False):
        targets = [self]
        return targets

    def _getEntitiesInSkillAOE(self, action_id, skill, position = None, dead_also = False):
        position = self.position
        radius = skill.param['radius']
        radiusSq = radius ** 2
        from_radiusSq = skill.param.get('from_radius', 0) ** 2
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            position = Math.Matrix(self.model.matrix).applyPoint(offset)
        targets = []
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            min_h, max_h = height_attack_limit
            min_h = min_h + position[1]
            max_h = max_h + position[1]
        for ent in BigWorld.entities.values():
            if ent == self:
                continue
            if not isinstance(ent, Victim):
                continue
            if not dead_also:
                if ent.is_dead():
                    continue
                if not ent.canTakeDamage:
                    continue
            if height_attack_limit:
                if not min_h <= ent.position[1] <= max_h:
                    continue
            distSq = (ent.position - position).lengthSquared
            if distSq > radiusSq:
                continue
            if from_radiusSq and distSq < from_radiusSq:
                continue
            targets.append(ent)

        return targets

    def funSfx(self, path):
        if path:
            sfx.bufferedOneShotSFX(path, self.model)

    def on_damaged_transform(self, source_data, damagetaken_data):
        if self.active_transform:
            animation_on_damage = self.active_transform.getparam('animation_on_damage')
            if animation_on_damage:
                try:
                    anim = self.model.action(animation_on_damage)
                    anim()
                except:
                    traceback.print_exc()

            sfx_on_damage = self.active_transform.getparam('sfx_on_damage')
            try:
                self.funSfx(sfx_on_damage)
            except:
                traceback.print_exc()

    @debug_draw
    def _show_aoe(self, skill, targets):
        self.model.clearLines()
        pos = self.position
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            pos = Math.Matrix(self.model.matrix).applyPoint(offset)
        hh = []
        radius = skill.param.get('radius', 1.0)
        from_radius = skill.param.get('from_radius', 0)
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            hh.append(Math.Vector3(pos[0], pos[1] + height_attack_limit[0], pos[2]))
            hh.append(Math.Vector3(pos[0], pos[1] + height_attack_limit[1], pos[2]))
        else:
            hh.append(Math.Vector3(pos[0], pos[1] + 1.0, pos[2]))
        self.model.addLineDraw(hh[0], hh[-1], (1, 0, 0, 1), 0)
        v = Math.Vector3()

        def drawCircles(radius, colour = (1, 0, 0, 1)):
            vert_lines_list = []
            for centr in hh:
                vert_lines = []
                vert_lines_list.append(vert_lines)
                last = None
                w = 0
                segments = 20
                for x in range(segments + 1):
                    w += 6.28 / segments
                    v.setPitchYaw(0, w)
                    pos1 = centr + v * radius
                    if last:
                        vert_lines.append(pos1)
                        self.model.addLineDraw(last, pos1, colour, 0)
                    last = pos1

            for x in range(len(vert_lines_list[0])):
                self.model.addLineDraw(vert_lines_list[0][x], vert_lines_list[1][x], colour, 0)

            return

        drawCircles(radius)
        if from_radius:
            drawCircles(from_radius, (0, 1, 0, 1))
        self._show_targets(targets)

    @debug_draw
    def _show_sector(self, skill, targets):
        self.model.clearLines()
        pos = self.position
        offset = skill.param.get('offset_position_attack')
        if offset:
            offset = tuple(offset)
            pos = Math.Matrix(self.model.matrix).applyPoint(offset)
        hh = []
        height_attack_limit = skill.param.get('height_attack_limit')
        if height_attack_limit:
            hh.append(Math.Vector3(pos[0], pos[1] + height_attack_limit[0], pos[2]))
            hh.append(Math.Vector3(pos[0], pos[1] + height_attack_limit[1], pos[2]))
        else:
            hh.append(Math.Vector3(pos[0], pos[1] + 1.0, pos[2]))
        radius = skill.param.get('radius', 1.0)
        from_radius = skill.param.get('from_radius', 0)
        self.model.addLineDraw(hh[0], hh[-1], (1, 0.0, 0.0, 1), 0)
        v = Math.Vector3()
        angles_sector = skill.param.get('angles_sector')
        if not angles_sector:
            return
        min_s_local = math.radians(angles_sector[0])
        max_s_local = math.radians(angles_sector[1])
        min_s = min_s_local + self.model.yaw
        max_s = max_s_local + self.model.yaw
        v = Math.Vector3()

        def drawSectors(radius, colour = (1, 0, 0, 1)):
            vert_lines = []
            for centr in hh:
                vert = []
                vert_lines.append(vert)
                last = None
                v.setPitchYaw(0, min_s)
                self.model.addLineDraw(centr, centr + v * radius, colour, 0)
                v.setPitchYaw(0, max_s)
                self.model.addLineDraw(centr, centr + v * radius, colour, 0)
                v.setPitchYaw(0, self.model.yaw)
                self.model.addLineDraw(centr, centr + v * radius, (1, 1, 1, 1), 0)
                w = min_s
                segments = 20
                for x in range(segments + 1):
                    v.setPitchYaw(0, w)
                    w += (max_s - min_s) / segments
                    pos1 = centr + v * radius
                    if last:
                        vert.append(pos1)
                        self.model.addLineDraw(last, pos1, colour, 0)
                    last = pos1

            for x in range(len(vert_lines[0])):
                self.model.addLineDraw(vert_lines[0][x], vert_lines[1][x], colour, 0)

            return

        drawSectors(radius)
        if from_radius:
            drawSectors(from_radius, (0, 1, 0, 1))
        self._show_targets(targets)

    def _show_targets(self, targets):
        for ent in targets:
            self.model.addLineDraw(ent.position, ent.position + (0, 5, 0), (1, 1, 0.0, 1), 0)
            self.model.addLineDraw(ent.position + (0.5, 0.01, 0), ent.position + (-0.5, 0.01, 0), (1, 1, 0.0, 1), 0)
            self.model.addLineDraw(ent.position + (0, 0.01, 0.5), ent.position + (0, 0.01, -0.5), (1, 1, 0.0, 1), 0)