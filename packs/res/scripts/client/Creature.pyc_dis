class EntityFXAction:

    def __init__(self, entity, actions = None, sounds = None, sfxes = None):
        self.entity = entity
        self.actions = actions if actions is not None else []
        self.sounds = sounds if sounds is not None else []
        self.sfxes = sfxes if sfxes is not None else []
        self.active_callbacks = {}
        return

    def run(self, duration = None, callback = None, restart = False):

        def model_action_callback(_index, name):
            del self.active_callbacks[_index]
            if not self.active_callbacks and callback:
                callback()

        if not self.active_callbacks or restart:
            self.active_callbacks = {}
            for index, act_name in enumerate(self.actions):
                self.active_callbacks[index] = None
                handle = self.run_model_action(act_name, duration, partial(model_action_callback, index, act_name))
                if handle:
                    self.active_callbacks[index] = handle

            for sound_path in self.sounds:
                self.run_sound(sound_path)

        return

    def cancel_callbacks(self):
        for callback_handle in self.active_callbacks.values():
            if callback_handle:
                BigWorld.cancelCallback(callback_handle)

        self.active_callbacks = {}

    def stop(self):
        self.cancel_callbacks()
        for action_name in self.actions:
            self.stop_model_action(action_name)

        for sound_path in self.sounds:
            pass

        for sfx_path in self.sfxes:
            pass

    def run_model_action(self, action_name, duration, callback):
        pass

    def run_sound(self, sound_path):
        pass

    def stop_model_action(self, action_name):
        pass


class CompositeFXAction:

    def __init__(self, mob):
        self.mob = mob
        self.actions = []
        self.current_action = None
        self.run_callback = None
        return

    def add_action(self, action_name):
        self.actions.append(CreatureFXAction(self.mob, action_name))

    def run(self, duration = None, callback = None, restart = False):
        if not self.actions:
            return
        else:
            if self.current_action is None or restart:
                self.current_action = -1

                def run_next_action():
                    self.current_action += 1
                    if self.current_action < len(self.actions):
                        self.actions[self.current_action].run(duration, run_next_action, restart)
                    else:
                        self.current_action = None
                        callback()
                    return

                run_next_action()
            return

    def stop(self):
        if self.current_action is not None:
            self.actions[self.current_action].stop()
            self.current_action = None
        return


class CreatureFXAction(EntityFXAction):

    def __init__(self, entity, action_name):
        self.action_name = action_name
        try:
            config = entity.get_config(Cfg.ACTIONS)[self.action_name]
        except KeyError:
            print 'DESIGNER_ERROR: CreatureFXAction: creature({0} {1}) has no action {2}'.format(entity.creatureType, Cfg.get_subtype_name(entity.creatureType, entity.level), repr(action_name))

        actions, sounds, sfxes = multi_get(config, Cfg.ACT_MODEL_ACTIONS, Cfg.ACT_SOUNDS, Cfg.ACT_SFXES)
        EntityFXAction.__init__(self, entity, actions, sounds, sfxes)

    def run_model_action(self, action_name, duration, callback):
        try:
            action = self.entity.model.action(action_name)
        except ValueError:
            print 'DESIGNER_WARNING: creature {0} level {1} has no action {2}'.format(self.entity.creatureType, self.entity.level, action_name)
            return

        return execute_model_action(action, duration, callback)

    def run_sound(self, sound_path):
        self.entity.playSoundM(sound_path, self.entity.model)

    def stop_model_action(self, action_name):
        self.entity.model.action(action_name).stop()


class Creature(BigWorld.Entity, CreatureCommon, Victim, Damager, Skills, Effects, Teleportable, Bleeding, ItemHolder, BurnInterface):

    def __init__(self):
        BigWorld.Entity.__init__(self)
        Skills.__init__(self)
        Effects.__init__(self)
        Bleeding.__init__(self)
        BurnInterface.__init__(self)
        self.LOCK_PUT_ITEM = True
        self.targetCaps = []
        self.name = 'CreatureName'
        self.filter = BigWorld.AvatarDropFilter()
        self.updateFilterParam()
        self.filter.smart_filter = True
        self.posFilterOff()
        self.setAlingToGround(True)
        self.model = None
        self.soundsList = []
        self.state_transition_callback = None
        self.actions = {}
        self.water_listener_id = None
        return

    def posFilterOn(self):
        self.filter.postitionFilter = self.postitionFilter

    def posFilterOff(self):
        if self.model:
            self.model.clearLines()
        self.filter.postitionFilter = None
        return

    def postitionFilter(self, point0, point1, point2, point3, point4, point5, dist_mean, num_points, normal, last_pos):
        if self.model and BigWorld.player().debugEnabled:
            self.model.clearLines()
            self.model.addLineDraw(self.position, self.position + normal, (255, 255, 255, 255), True)
            self.model.addLineDraw(point0, point2, (0, 255, 0, 255), True)
            self.model.addLineDraw(point2, point4, (0, 255, 0, 255), True)
            self.model.addLineDraw(point4, point0, (0, 255, 0, 255), True)
            self.model.addLineDraw(point1, point3, (255, 0, 0, 255), True)
            self.model.addLineDraw(point3, point5, (255, 0, 0, 255), True)
            self.model.addLineDraw(point5, point1, (255, 0, 0, 255), True)
        return dist_mean

    def __str__(self):
        pos = '(%.1f,%.1f,%.1f)' % (self.position.x, self.position.y, self.position.z)
        return 'Creature-id{0} {1} Type: {2}/{3} '.format(self.id, pos, self.creatureType, self.level)

    def updateFilterParam(self):
        if not self.filter or not hasattr(self.filter, 'minRoll'):
            return
        minRoll, maxRoll = self.get_roll_param()
        minPitch, maxPitch = self.get_pitch_param()
        self.setAlingToGround(True)
        self.filter.smart_filter = True
        self.filter.collideDist = self.get_collide_distance()
        self.filter.blendRatio = 0.5
        self.filter.checkRadius = self.get_radius_model()
        self.filter.minRoll = minRoll * pi / 180
        self.filter.minPitch = minPitch * pi / 180
        self.filter.maxRoll = maxRoll * pi / 180
        self.filter.maxPitch = maxPitch * pi / 180

    def prerequisites(self):
        _prereq = [self.get_model_path()]
        return _prereq

    def onEnterWorld(self, prereqs):
        if self.get_model_path() not in prereqs.failedIDs:
            self.model = prereqs[self.get_model_path()]
        else:
            print 'AHTUNG! Creature %s  model in failedIDs' % self.id, self.position, self.get_model_path()
            print 'prereqs.failedIDs:', prereqs.failedIDs
            model = BigWorld.Model('models\\misc\\system\\MobSpawnPoint.model')
            model.position = self.position
            self.addModel(model)
        self.prerequisites = prereqs
        action_matcher = self.model.motors[0]
        action_matcher.entityCollision = 0
        action_matcher.collisionRooted = 0
        action_matcher.collisionHeight = self.get_height()
        action_matcher.collisionRadius = self.get_width() * 0.5
        action_matcher.collisionMoveSpeed = 2.0
        action_matcher.turnModelToEntity = True
        scale = self.get_config(Cfg.MODEL_SCALE)
        self.model.scale = Vector3(scale, scale, scale)
        self.bbRadius = (self.get_height() + self.get_width()) * scale * 1.5
        try:
            if scale > 0:
                self.model.moveScale = 1.0 / scale
                self.model.motors[0].matchModelScale = True
                self.model.motors[0].matchModelScaleInv = True
        except:
            traceback.print_exc()

        tints_cfg = self.get_config(Cfg.TINTS)
        for tint_name, tint_value in tints_cfg[self.tint_id].items():
            try:
                self.model.__setattr__(tint_name, tint_value)
            except:
                print 'Creature.onEnterWorld: wrong tint ({0} = {1}) for self {2}, lv {3}'.format(tint_name, tint_value, self.creatureType, self.level)
                raise

        self.add_collider()
        foot_nodes = self.get_config(Cfg.FOOT_NODES)
        if foot_nodes:
            self.addFootTrigers(foot_nodes[0], foot_nodes[1])
        self.checkDecomposed()
        self._set_current_state(self.state)
        if self.dead and not self.isDecomposed:
            self.model.isCalcBoundBoxFromNodes = 1
            if not self.looted or self.CarryingItems:
                self.targetCaps = [CAP_CAN_OPEN_AND_EXPLORE]
        self.setAlingToGround(True)
        self.checkBleeding()
        Skills.onEnterWorld(self, prereqs)
        BurnInterface.onEnterWorld(self, prereqs)

    def get_model_path(self):
        return Cfg.MODELS_ROOT + self.get_config(Cfg.MODEL)

    def get_looting_types(self):
        return self.get_config(Cfg.LOOTING_TYPES)

    def get_effect_hips_name(self):
        return self.get_config(Cfg.EFFECT_HIPS)

    def get_hips_offset(self):
        return tuple(self.get_config(Cfg.HIPS_OFFSET))

    def get_roll_param(self):
        config = self.get_state_config().get(Cfg.ROLL_PARAM)
        if not config:
            return self.get_config(Cfg.ROLL_PARAM)
        return config

    def get_collide_distance(self):
        return self.get_config(Cfg.COLLIDE_DIST)

    def get_pitch_param(self):
        config = self.get_state_config().get(Cfg.PITCH_PARAM)
        if not config:
            return self.get_config(Cfg.PITCH_PARAM)
        return config

    def get_radius_model(self):
        return self.get_config(Cfg.RADIUS_MODEL) * self.get_config(Cfg.MODEL_SCALE)

    def _set_current_state(self, new_state):
        """Direct state change."""
        new_state_config = self.get_config(Cfg.STATES)[new_state]
        self.model.motors[0].matchCaps = list(new_state_config['caps'])
        for action in new_state_config.get('persistent_actions', []):
            self.do_named_action(action)

        self.current_state = new_state
        self.name = self.get_name()

    def change_state(self, prev_state, new_state):
        """Start state transition."""
        if self.state_transition_callback is not None:
            BigWorld.cancelCallback(self.state_transition_callback)
            self.state_transition_callback = None
        curr_state_config = self.get_state_config(self.current_state)
        new_state_config = self.get_state_config(new_state)
        self.current_state = new_state
        self.updateFilterParam()
        self.model.motors[0].matchCaps = list(new_state_config['caps'])
        entering_data = curr_state_config.get('entering_actions', {})
        for action in entering_data.get('actions', []):
            self.get_action(action).cancel_callbacks()

        for action in curr_state_config.get('persistent_actions', []):
            self.stop_named_action(action)

        trans_data = hierarchy_get(curr_state_config, ['transitions', new_state])
        if trans_data and trans_data['time'] > 0:
            for action in trans_data['actions']:
                self.do_named_action(action, duration=trans_data['time'])

            self.state_transition_callback = BigWorld.callback(trans_data['time'], partial(self._init_new_state, new_state))
        else:
            self._init_new_state(new_state)
        return

    def changeVisibleEffect(self, effect):
        added_new_effect = Effects.changeVisibleEffect(self, effect)
        self.addEffectSFX(effect['id'])

    def setAlingToGround(self, value):
        if self.model:
            self.model.motors[0].useEntityPitchAndRoll = value
        if self.filter:
            self.filter.alignToGround = value

    @if_not_destroyed
    def _init_new_state(self, new_state):
        new_state_config = self.get_state_config(new_state)
        entering_data = new_state_config['entering_actions']
        if entering_data and entering_data['time'] > 0:
            callbacks_needed = len(entering_data['actions'])

            def action_ended():
                if self.isDestroyed:
                    return
                action_ended.callbacks_received += 1
                if action_ended.callbacks_received == callbacks_needed:
                    self._set_current_state(new_state)

            action_ended.callbacks_received = 0
            for action in entering_data['actions']:
                self.do_named_action(action, duration=entering_data['time'], callback=action_ended)

        else:
            self._set_current_state(new_state)

    def get_action(self, action_name):
        try:
            return self.actions[action_name]
        except KeyError:
            self.actions[action_name] = CreatureFXAction(self, action_name)
            return self.actions[action_name]

    def do_named_action(self, action_name, duration = None, callback = None):
        try:
            self.get_action(action_name).run(duration, callback)
        except:
            print self, self.model, 'action=%s' % action_name, self.model.sources
            raise

    def stop_named_action(self, action_name):
        try:
            self.get_action(action_name).stop()
        except:
            print self, self.model, 'action=%s' % action_name, self.model.sources
            raise

    def event_fired(self, event_name):
        for action_name in self.get_config(Cfg.EVENTS).get(event_name, []):
            self.do_named_action(action_name)

    def create_skill(self, skill_id):
        skill_cfg = self.get_skill_config(skill_id)
        skill = Skill(self, skill_cfg.get('ignore_tracking'))
        for action_name in skill_cfg['actions']:
            skill.add_action(action_name)

        if skill_cfg.get('tracker'):
            skill.add_override_tracker(skill_cfg['tracker'])
        waves = skill_cfg.get('waves_damage', [])
        for wave_config in waves:
            wave = {'sfx': wave_config.get('sfx'),
             'direct': wave_config.get('direct'),
             'abilities': wave_config.get('abilities')}
            skill.add_wave(wave)

        return skill

    def add_collider(self):
        Victim.add_collider(self)
        for box_cfg in self.get_config(Cfg.COLLIDERS):
            self.attach_collider_box(box_cfg[COLLIDER_BOX_NAME], box_cfg[COLLIDER_NODE_NAME], box_cfg[COLLIDER_BODY_ZONE], box_cfg[COLLIDER_MIN_BOUNDS], box_cfg[COLLIDER_MAX_BOUNDS])

    def addFootTrigers(self, lFootNodeName, rFootNodeName):
        lfoot = self.model.node(lFootNodeName)
        rfoot = self.model.node(rFootNodeName)
        footSoundPath = self.get_config(Cfg.FOOTSTEPS_SOUND)
        if footSoundPath == '':
            print 'Creature::addFootTrigers: No sound specified for ', self.creatureType
            return
        self.footTriggers = [BigWorld.FootTrigger(0, footSoundPath), BigWorld.FootTrigger(1, footSoundPath)]
        lfoot.attach(self.footTriggers[0])
        rfoot.attach(self.footTriggers[1])
        for footTrigger in self.footTriggers:
            footTrigger.maxLod = 25

        def onLoadDust(dustSource):
            if self.isDestroyed:
                return
            if not self.model:
                return
            self.model.root.attach(dustSource)

        particles.createDustSourceBG(onLoadDust)

    def checkDecomposed(self):
        if self.isDecomposed:
            BigWorld.delShadowEntity(self)
            self.model.visible = False
            BigWorld.player().NeedToCloseItemCache(self)
            self.targetCaps = []
            self.model.isCalcBoundBoxFromNodes = 0
            if self.dead:
                self.targetCaps = [CAP_EXCLUDE]
        else:
            self.model.visible = True
            BigWorld.addShadowEntity(self)

    def onLeaveWorld(self):
        self.stopSounds()
        BurnInterface.stopBurn(self)
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE ** 2):
            BigWorld.player().NeedToUpdateItemCache()
        self.model = None
        return

    def set_isDecomposed(self, b):
        self.checkDecomposed()

    def on_death(self, source_data, item_type, noSound = False):
        Victim.on_death(self, source_data, item_type)
        Bleeding.on_death(self)
        self.stopSounds()

    def on_damaged(self, source_data, damagetaken_data):
        Victim.on_damaged(self, source_data, damagetaken_data)
        if source_data['type'] == SourceTypes.EFFECT and EffectNames.Bleed in source_data['subtype']:
            return
        self.bleed_on_damage(source_data, damagetaken_data)
        if not self.is_dead():
            self.event_fired(Cfg.EV_ON_TAKE_DAMAGE)

    def blood_sfx_on_damage(self, damage_source, damagetaken_data):
        if damagetaken_data.has_key('ammo_type'):
            ammo_type = damagetaken_data['ammo_type']
        else:
            ammo_type = None
            damager = BigWorld.entities.get(damage_source['entity_id'])
            if damager:
                ammo_type = getattr(damager, 'ActiveItemAmmoType', None)
            else:
                ammo_type = damage_source.type
        return self.get_bleed_sfx(damagetaken_data['body_zone'], ammo_type)

    def bleed_on_damage(self, damage_source, damagetaken_data):
        if damage_source['entity_id'] == BigWorld.player().id:
            return
        damager = BigWorld.entity(damage_source['entity_id'], True)
        blood_rel_pos = self.blood_rel_pos(damagetaken_data['body_zone']) + self.position
        if damager:
            bloodvector = self.position - damager.position + blood_rel_pos - (0.01, 1, 0.01)
            damager_pos = damager.position + (0.01, 1, 0.01)
            damager_dir = blood_rel_pos - damager_pos
            doCollide = self.skeletonCollider.doCollide(damager_pos, damager_dir)
            if doCollide:
                blood_rel_pos = self.skeletonCollider.impactPoint
        else:
            bloodvector = (0.01, 1, 0.01)
        sfx_id = self.blood_sfx_on_damage(damage_source, damagetaken_data)
        self.bleedglobal(blood_rel_pos, bloodvector, sfx_id)

    def playSoundM(self, soundPath, model):
        if not soundPath:
            return
        else:
            try:
                sound = playSound(soundPath, model)
            except Exception as e:
                traceback.print_exc()
                print 'soundPath', soundPath
                return

            if sound is None:
                return
            if sound.duration < 0:
                sound.autoDetach = False
                self.soundsList.append(sound)
            return sound

    def stopSounds(self):
        for s in xrange(len(self.soundsList)):
            sound = self.soundsList[s]
            if sound is not None:
                sound.stop()
                sound.releaseSound()

        self.soundsList = []
        return

    def beginAnimation(self, animationID, duration):
        pass

    def endAnimation(self, animationID):
        pass

    def onTeleportCalled(self, teleport_type, expected_position):
        self.filter = BigWorld.DumbFilter()

    def onTeleportEnded(self, wasSuccessful, direction = None):
        self.filter = BigWorld.AvatarDropFilter()

    def set_CarryingItems(self, old_value):
        if inRange(self, BigWorld.player(), Constants.INTERACTION_DISTANCE ** 2):
            BigWorld.player().NeedToUpdateItemCache()
        if not self.CarryingItems:
            self.targetCaps = []
            BigWorld.player().NeedToCloseItemCache(self)
            self.model.isCalcBoundBoxFromNodes = 0
            if self.dead:
                self.targetCaps = [CAP_EXCLUDE]
        elif self.dead and not self.isDecomposed:
            self.targetCaps = [CAP_CAN_OPEN_AND_EXPLORE]
            self.model.isCalcBoundBoxFromNodes = 1

    def set_dead(self, old):
        if self.dead:
            self.targetCaps = not self.isDecomposed and (self.CarryingItems or self.looted and not not self.CarryingItems) and [CAP_CAN_OPEN_AND_EXPLORE]
            self.name = self.get_name()
            self.height = 1.0
            self.model.isCalcBoundBoxFromNodes = 1
        else:
            BigWorld.player().NeedToCloseItemCache(self)
            self.targetCaps = [CAP_EXCLUDE]
            self.model.isCalcBoundBoxFromNodes = 0

    def get_interaction_dist(self):
        return self.get_config(Cfg.INTERACTION_DISTANCE)

    def water_callback(self, watered, water_volume):
        if watered:
            if self.water_listener_id:
                BigWorld.delWaterVolumeListener(self.water_listener_id)
            self.water_listener_id = None
            avatars = [ (avatar, avatar.position.distSqrTo(self.position)) for avatar in BigWorld.entities.values() if isinstance(avatar, Avatar) ]
            avatars.sort(key=lambda x: x[1])
            if len(avatars) == 1 or BigWorld.player() in (avatars[0][0], avatars[1][0]):
                self.cell.water_entered()
        return

    def burn(self, status):
        BurnInterface.burn(self, status)
        if status and not self.water_listener_id:
            self.water_listener_id = BigWorld.addWaterVolumeListener(self.matrix, self.water_callback)
        if not status and self.water_listener_id:
            BigWorld.delWaterVolumeListener(self.water_listener_id)
            self.water_listener_id = None
        return

    def onOpen(self, player):
        self.cell.onOpenContainer()

    def onClose(self, player):
        self.cell.onCloseContainer()

    def set_isBleending(self, old_value):
        self.checkBleeding()

    def checkBleeding(self):
        if self.isBleending:
            self.bleedDropEff()
        else:
            self.removeBleedDropEff()

    def setDefenceStat(self, defence):
        pass