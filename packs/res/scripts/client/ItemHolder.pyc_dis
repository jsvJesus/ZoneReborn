    def onUseItemOnTarget(self, target_id, itemID):
        if not self.canUse():
            return
        item = ItemsUtils.GetComplexItemByID(self, itemID)
        target = BigWorld.entities.get(target_id, None)
        if target is None:
            return
        elif target.dead and not ItemsUtils.is_it_medecine_item(item):
            return
        elif item:
            equippingitemType = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(equippingitemType)
            duration = Durations.GetItemUseDuration(self, equippingitemType)
            if item_class == ItemsCatalog.BUFF:
                self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, 10, lc('Items.GUIStrings.USING'))
                cast_data = ['UNC',
                 10,
                 lc('Items.GUIStrings.WAITING'),
                 None]
                BWPersonality.GUICore.setCastBarData(cast_data)
                self.cell.useItemOnTarget(target_id, itemID)
            return duration
        else:
            return

