    def GetItemsFromContainer(self, cacheObjectID, items):
        if not items:
            return
        if not cacheObjectID:
            return
        item_ids = []
        for item in items:
            item_id = item['complexItemID']
            item_ids.append(item_id)

        self.cell.GetItemsFromHolderClient(cacheObjectID, item_ids)

    def GetItemFromContainer(self, cacheObjectID, item):
        if not item:
            return
        item_id = item['complexItemID']
        self.cell.GetItemFromHolderClient(cacheObjectID, item_id)

    def PutItemToContainer(self, cacheObjectID, data):
        try:
            container = BigWorld.entities[cacheObjectID]
        except:
            return

        if getattr(container, 'LOCK_PUT_ITEM', False):
            return
        item = data
        if not item:
            return
        if ItemsUtils.IsItemMoveable(item):
            return
        container.cell.GetItemFromHolderClient(self.id, data['complexItemID'])

    def PutItemToWarehouse(self, trader_id, item):
        if not self.checkClanRights(Clan.FLAG_CAN_BASE_ADD_MONEY):
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.text_access_error'))
            return
        BigWorld.entities[trader_id].cell.addItem(item)

    def GetItemFromWarehouse(self, trader_id, item):
        if not self.checkClanRights(Clan.FLAG_CAN_BASE_WITHDRAW_MONEY):
            gui_jokes.askUserOk(lc('GUI.DonateBase.title'), lc('GUI.DonateBase.text_access_error'))
            return
        BigWorld.entities[trader_id].cell.removeItem(item)