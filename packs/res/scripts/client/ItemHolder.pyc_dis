    def getModelByNamesDict(self, names_dict):
        core_model = None
        if names_dict:
            body_entry = names_dict[ItemsCatalog.BODY]
            try:
                core_model = BigWorld.Model(body_entry[ItemsUtils.MODEL_LIST_POSITION])
            except:
                traceback.print_exc()
                print 'Error load gun model:', self
                print 'names_dict', names_dict
                print 'body_entry', body_entry
                print 'key', ItemsUtils.MODEL_LIST_POSITION
                print 'core_models', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                print
                return

            tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
            if tint_dict:
                for tint_key in tint_dict:
                    try:
                        setattr(core_model, tint_key, tint_dict[tint_key])
                    except:
                        traceback.print_exc()
                        print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                        print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print

            del names_dict[ItemsCatalog.BODY]
            if names_dict:
                for model_entry in names_dict.values():
                    if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                        try:
                            model = BigWorld.Model(model_entry[ItemsUtils.MODEL_LIST_POSITION])
                        except:
                            traceback.print_exc()
                            print 'ERROR load gun attach model:'
                            print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                            print
                            continue

                    else:
                        continue
                    tint_dict = model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                    if tint_dict:
                        for tint_key in tint_dict:
                            if hasattr(model, tint_key):
                                setattr(model, tint_key, tint_dict[tint_key])

                    try:
                        setattr(core_model, model_entry[ItemsUtils.MODEL_HP_POSITION], model)
                    except ValueError:
                        print 'Cant attach model at hp', repr(model_entry[ItemsUtils.MODEL_HP_POSITION]), ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model
                    except AttributeError:
                        print 'Cant attach model at hp', model_entry[ItemsUtils.MODEL_HP_POSITION], ' model name ', model_entry[ItemsUtils.MODEL_LIST_POSITION]
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                        return core_model

        return core_model

    def fetchModelByNamesDict(self, names_dict, callback):
        if not names_dict:
            callback(None)
            return
        else:
            core_model = []
            attach_models = {}
            count_models = 0
            for model_entry in names_dict.values():
                if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                    count_models += 1

            def checkResult():
                if not core_model or len(attach_models) != count_models - 1:
                    return
                for model_entry, model in attach_models.items():
                    try:
                        setattr(core_model[0], model_entry, model)
                    except ValueError:
                        print 'Cant attach model at hp', repr(model_entry), ' model', model
                        print 'core_model', core_model.sources
                        traceback.print_exc()
                    except AttributeError:
                        print 'Cant attach model at hp', model_entry, ' model ', model
                        print 'core_model', core_model.sources
                        traceback.print_exc()

                callback(core_model[0])

            def onLoadModel(_model_entry, model):
                if not model:
                    print "Can't load model", _model_entry[ItemsUtils.MODEL_LIST_POSITION]
                tint_dict = _model_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                if tint_dict:
                    for tint_key in tint_dict:
                        if hasattr(model, tint_key):
                            setattr(model, tint_key, tint_dict[tint_key])

                attach_models[_model_entry[ItemsUtils.MODEL_HP_POSITION]] = model
                checkResult()

            def onLoadCoreModel(model):
                if not model:
                    callback(None)
                core_model.append(model)
                tint_dict = body_entry[ItemsUtils.MODEL_TINT_DICT_POSITION]
                if tint_dict:
                    for tint_key in tint_dict:
                        try:
                            setattr(core_model[0], tint_key, tint_dict[tint_key])
                        except:
                            traceback.print_exc()
                            print 'ERROR set tint model', repr(tint_key), repr(tint_dict[tint_key])
                            print 'models:', body_entry[ItemsUtils.MODEL_LIST_POSITION]
                            print

                checkResult()
                return

            body_entry = names_dict[ItemsCatalog.BODY]
            BigWorld.fetchModel(body_entry[ItemsUtils.MODEL_LIST_POSITION], onLoadCoreModel)
            del names_dict[ItemsCatalog.BODY]
            for model_entry in names_dict.values():
                if model_entry[ItemsUtils.MODEL_LIST_POSITION]:
                    try:
                        BigWorld.fetchModel(model_entry[ItemsUtils.MODEL_LIST_POSITION], partial(onLoadModel, model_entry))
                    except:
                        traceback.print_exc()
                        print 'ERROR load gun attach model:'
                        print [model_entry[ItemsUtils.MODEL_LIST_POSITION]]
                        print
                        continue

                else:
                    continue

            return

    def getModelNameByNamesDict(self, names_dict):
        if names_dict:
            if len(names_dict) == 1:
                return names_dict[0]
            else:
                return names_dict
        else:
            return None
        return None

    def onPutOnItem(self, item, slot_number = 0):
        if not self.canEquip():
            return
        elif self.clone_model:
            return
        elif item:
            item_type = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            itemID = item['complexItemID']
            if ItemsUtils.GetComplexItemByID(self, itemID) is None:
                return
            unequiping_item_type = 0
            need_unequip_throw = False
            if item_class == ItemsCatalog.CLOTH:
                pass
            elif item_class == ItemsCatalog.ARTIFACT:
                if not self.CheckEquippedGadgetNumber():
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.a_lot_of_gadgets'))
                    return
                if not ItemsUtils.IsItemEquipable(None, item_params):
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.artefact_not_eqip'))
                    return
                depleet_time = ItemsUtils.GetArtefactDepleetionTime(item, item_params, BWPersonality.gpd.time_diff)
                if depleet_time != None and depleet_time < 0:
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.artefact_die'))
                    return
            if item_class in [ItemsCatalog.GADGET, ItemsCatalog.EXPLOSION]:
                if not self.CheckEquippedGadgetNumber():
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.a_lot_of_gadgets'))
                    return
                if not self.CheckEquippedGadgetSubType(item_type):
                    self.putMessage(CHANNEL_CONSTS.ITEMS, lc('ItemHolder.gadget_is_already'))
                    return
            if item_class == ItemsCatalog.WEAPON:
                gun_type = item_params['GunType']
                gun_priority = ItemsUtils.GetWeaponPriority(gun_type)
                unequiping_item_type = self.ActiveItemType
                self.ActiveItemID = itemID
                self.ActiveItemType = item_type
                self.updateShootingMode()
                if gun_priority == ItemsCatalog.SECONDARY:
                    self.ActiveWeaponSet.SecondarySlotID = itemID
                    self.ActiveWeaponSet.SecondarySlotType = item_type
                    self.ActiveWeaponSet.SecondarySlotTintID = ItemsUtils.getTintID(item)
                else:
                    self.ActiveWeaponSet.PrimarySlotID = itemID
                    self.ActiveWeaponSet.PrimarySlotType = item_type
                    self.ActiveWeaponSet.PrimarySlotTintID = ItemsUtils.getTintID(item)
                ItemsUtils.SetActiveWeaponUpgradesTypes(self, item)
                if self.ActiveThrowID and self.ActiveThrowType:
                    self.ActiveThrowID = 0
                    self.ActiveThrowType = 0
                    unequiping_item_type = 0
                    need_unequip_throw = True
            put_on_duration = Durations.GetPutOnDuration(self, item_type, unequiping_item_type)
            self.DrawItemPutOn(put_on_duration * 1.2, item_type, unequiping_item_type, need_unequip_throw)
            self.cell.putOnItem(itemID, slot_number)
            return put_on_duration
        else:
            return

    def putOnItemStep2(self, item):
        if not self.canEquip():
            return
        elif item:
            item_type = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            itemID = item['complexItemID']
            if ItemsUtils.GetComplexItemByID(self, itemID) is None:
                return
            unequiping_item_type = 0
            if item_class == ItemsCatalog.WEAPON:
                self.updateShootingMode()
            if item_class == ItemsCatalog.CLOTH:
                for types in item_params['ArmorType']:
                    what_putted_off = ItemsUtils.GetComplexItemByID(self, self.ActiveArmorSet[ItemsCatalog.cloth_dict[types][0]])
                    self.onPutOffItem(what_putted_off)
                    self.ActiveArmorSet[ItemsCatalog.cloth_dict[types][0]] = itemID
                    self.ActiveArmorSet[ItemsCatalog.cloth_dict[types][1]] = item_type

                put_on_duration = 0.0
            elif item_class == ItemsCatalog.ARTIFACT:
                put_on_duration = 0.0
            else:
                return 0.0
            self.DrawItemPutOn(put_on_duration, item_type, unequiping_item_type)
            self.cell.putOnItemStep2(itemID)
            return put_on_duration
        else:
            return

    def onPutOffItem(self, item):
        if not self.canEquip():
            return
        elif self.clone_model:
            return
        elif not item:
            return
        else:
            item_type = item['complexItemType']
            item_class = ItemsCatalog.GetItemClass(item_type)
            item_params = ItemsCatalog.GetItemParam(item_type)
            itemID = item['complexItemID']
            if itemID == 0:
                itemID = ItemsUtils.getEquippedItemIDByType(self, item_type)
            if item_class == ItemsCatalog.CLOTH:
                for types in item_params['ArmorType']:
                    self.ActiveArmorSet[ItemsCatalog.cloth_dict[types][0]] = 0
                    self.ActiveArmorSet[ItemsCatalog.cloth_dict[types][1]] = 0

            if item_class == ItemsCatalog.GADGET:
                for index, gadget in enumerate(self.ActiveGadgetList):
                    if itemID != gadget['GadjetID']:
                        continue
                    gadget_param = ItemsCatalog.GetItemParam(gadget['GadjetType'])
                    gadget_action = gadget_param.get('Action', None)
                    if gadget_action:
                        self.stopGadgetAction(gadget_action, item)
                    break

            if item_class == ItemsCatalog.EXPLOSION:
                pass
            if item_class == ItemsCatalog.WEAPON:
                gun_type = item_params['GunType']
                gun_priority = ItemsUtils.GetWeaponPriority(gun_type)
                if gun_priority == ItemsCatalog.SECONDARY:
                    if self.ActiveWeaponSet.SecondarySlotID == self.ActiveItemID:
                        self.ActiveItemID = 0
                        self.ActiveItemType = 0
                        self.updateShootingMode()
                    self.ActiveWeaponSet.SecondarySlotID = 0
                    self.ActiveWeaponSet.SecondarySlotType = 0
                else:
                    if self.ActiveWeaponSet.PrimarySlotID == self.ActiveItemID:
                        self.ActiveItemID = 0
                        self.ActiveItemType = 0
                        self.updateShootingMode()
                    self.ActiveWeaponSet.PrimarySlotID = 0
                    self.ActiveWeaponSet.PrimarySlotType = 0
                ItemsUtils.ClearActiveWeaponUpgradesTypes(self, item)
            if itemID:
                self.cell.putOffItem(itemID)
            if BWPersonality.GUICore.inventoryGUI:
                BWPersonality.GUICore.inventoryGUI.onItemAdded(0, item_type, itemID)
            self.UpdateAvatarModel()
            self.NeedToUpdateInventory()
            return

    def removeGadgetSlots(self, count):
        if not BWPersonality.GUICore.charScreen:
            return
        _charScreen = BWPersonality.GUICore.charScreen.component.script
        _ids = _charScreen.getLockedGadgetIds(count)
        _charScreen.lockGadgetSlots(True, count)
        self.cell.removeGadgets(_ids)

    def hasArmor(self):
        if self.ActiveArmorSet.ArmorID > 0:
            return True
        else:
            return False

    def hasBackpack(self):
        if self.ActiveArmorSet.BackPackID > 0:
            return True
        else:
            return False

    def onUseItem(self, item):
        error_level = ItemsUtils.FAIL_NO
        if not self.canUse() or self.is_throwing or self.sniping or self.binoculars_animation or self.reloading:
            error_level = ItemsUtils.FAIL_OTHER_ACTION
            return (error_level, None)
        else:
            if item:
                item_type = item['complexItemType']
                itemID = item['complexItemID']
                item_class = ItemsCatalog.GetItemClass(item_type)
                item_params = ItemsCatalog.GetItemParam(item_type)
                duration = 0.0
                if 'isBlackBox' in item_params:
                    self.cell.useItem(itemID)
                    return (ItemsUtils.FAIL_NO, None)
                if item_class in [ItemsCatalog.BUFF, ItemsCatalog.LOOT]:
                    if item_params.get('isSandbag', False) and self.CheckRestriction(RestrictionsUtils.CHANNEL_ITEMS):
                        self.startCreateSandbag(itemID)
                        return (error_level, duration)
                    if EffectNames.Suffocation in self.current_effects:
                        return (ItemsUtils.FAIL_IMPOSSIBLE_USE, None)
                    if item_params.get('Repair'):
                        self.ChooseRepairItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)
                        return (ItemsUtils.FAIL_NO, duration)
                    if 'Effect' in item_params and ItemsCatalog.EFFECTS_START_USERFIRE in item_params['Effect'].keys():
                        firePos = self.checkPosibleUserFire()
                        if firePos:
                            self.physics.velocity = (0, 0, 0)
                            self.cell.startCreateUserFire(firePos, itemID, item_type)
                            duration = Durations.GetItemUseDuration(self, item_type)
                            duration = item_params.get('Action_use_time', duration)
                        return (ItemsUtils.FAIL_NO, duration)
                    if 'Effect' in item_params and ItemsCatalog.EFFECTS_START_FIREWORKS in item_params['Effect'].keys():
                        self.cell.useItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)
                    if 'Effect' in item_params and ItemsCatalog.EFFECTS_HEAL in item_params['Effect'].keys():
                        self.cell.useItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)
                    if 'Effect' in item_params and ItemsCatalog.EFFECTS_RECIPE in item_params['Effect'].keys():
                        if item_params['Effect'][ItemsCatalog.EFFECTS_RECIPE] not in self.KnowingRecipes:
                            self.cell.useItem(itemID)
                            duration = Durations.GetItemUseDuration(self, item_type)
                            duration = item_params.get('Action_use_time', duration)
                        else:
                            error_level = ItemsUtils.FAIL_KNOWN_RECIPE
                    if 'Effect' in item_params and ItemsCatalog.EFFECTS_EAT in item_params['Effect'].keys():
                        self.cell.useItem(itemID)
                        duration = Durations.GetItemUseDuration(self, item_type)
                        duration = item_params.get('Action_use_time', duration)
                    self.DrawUseItem(item_type, duration)
                if item_class == ItemsCatalog.GADGET:
                    item_param = ItemsCatalog.GetItemParam(item_type)
                    if 'waterNumberOfSips' in item_param:
                        duration = item_param.get('Action_use_time', duration)
                        self.cell.useItem(itemID)
                        self.DrawUseItem(item_type, duration)
                        return (error_level, duration)
                    gadget_action = item_param.get('Action')
                    if gadget_action == ItemsCatalog.GADJET_ACTION_ART_GRAB:
                        if self.artefactExtractor:
                            self.artefactExtractor.DestroyExtractor()
                        else:
                            self.startArtifactExtraction(item_param, item)
                    elif gadget_action == ItemsCatalog.GADGET_ACTION_SCAN:
                        self.radiometer.switch(itemID)
            else:
                error_level = ItemsUtils.FAIL_ITEM_STRUCTURE
            return (error_level, duration)

    def startCreateSandbag(self, itemID):
        self.cell.createSandbag(Matrix(self.matrix).applyPoint((0, 0, 1.0)), self.yaw, itemID, 0)
        self.DoAction(RestrictionsUtils.CHANNEL_ITEMS, 2.0, u'Sandbag')

    def StartItemRepair(self, kit_id, item_id):
        kit = ItemsUtils.GetComplexItemByID(self, kit_id)
        kit_param = ItemsCatalog.GetItemParam(kit['complexItemType'])
        item = ItemsUtils.GetComplexItemByID(self, item_id)
        item_param = ItemsCatalog.GetItemParam(item['complexItemType'])
        if not ItemsUtils.CanRepairByKit(item, kit):
            self.putMessage(CHANNEL_CONSTS.ITEMS, lc('Items.Messages.FAIL_REPAIR_NOT_TYPE'))
            return
        self.cell.onItemRepair(item_id, kit_id)

