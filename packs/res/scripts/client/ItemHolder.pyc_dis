    def BeginSpare(self, item, quantity, source = ''):
        if ItemsUtils.GetNumItemsInInventory(self.CarryingItems) >= ItemsUtils.MAX_AVATAR_ITEMS:
            self.ReportFail(ItemsUtils.FAIL_TOO_MANY_ITEMS)
            return
        else:
            if not ItemsUtils.GetComplexItemByID(self, item['complexItemID']) and self.cacheObjectID:
                entity = BigWorld.entities.get(self.cacheObjectID, None)
                if not entity or entity.position.distSqrTo(self.position) > self.SQR_TRADE_RANGE:
                    self.ReportFail(ItemsUtils.FAIL_NOT_IN_RANGE)
                    return
            self.cell.DivideItem(item['complexItemID'], quantity, source)
            return

