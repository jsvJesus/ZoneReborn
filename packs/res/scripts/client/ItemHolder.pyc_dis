    def onEquipItem(self, item):
        if not self.canEquip():
            return None
        elif self.clone_model:
            return None
        else:
            need_unequip_throw = False
            unequippedType, equippedType, item_class, equippingGunType, unequippingGunType = (0, 0, None, None, None)
            if item:
                itemID = item['complexItemID']
                if self.ActiveItemID == itemID:
                    return None
                if itemID == 0:
                    return None
                if itemID and itemID not in (self.ActiveWeaponSet.SecondarySlotID, self.ActiveWeaponSet.PrimarySlotID):
                    print 'TEST BUG found', self, itemID, (self.ActiveWeaponSet.SecondarySlotID, self.ActiveWeaponSet.PrimarySlotID)
                    return None
                equippedType = item['complexItemType']
                item_class = ItemsCatalog.GetItemClass(equippedType)
                equipping_item_param = ItemsCatalog.GetItemParam(equippedType)
                if item_class == ItemsCatalog.WEAPON:
                    equippingGunType = equipping_item_param['GunType']
                    if self.ActiveItemID:
                        unequippedType = self.ActiveItemType
                        unequippedItemParams = ItemsCatalog.GetItemParam(unequippedType)
                        unequippingGunType = unequippedItemParams['GunType']
                    unequipping_time = Durations.GetEquipDuration(self, unequippingGunType)
                    equipping_time = Durations.GetEquipDuration(self, equippingGunType)
                    if self.ActiveThrowID and self.ActiveThrowType:
                        unequipping_time = Durations.getThrowUnEquipDuration(self)
                        unequippedType = 0
                        unequippingGunType = 0
                        self.ActiveThrowID = 0
                        self.ActiveThrowType = 0
                        need_unequip_throw = True
                    self.SetEquippedWeaponParams(itemID, equippedType, item, False)
                    self.DrawUnequipItem(unequippedType, equippedType, unequipping_time, equipping_time, need_unequip_throw)
                else:
                    if item_class == ItemsCatalog.EXPLOSION:
                        if self.ActiveThrowID == itemID:
                            return None
                        self.cell.equipThrow(itemID, True)
                        self.ActiveItemID = 0
                        self.ActiveItemType = 0
                        return False
                    return False
                self.cell.equipItem(itemID)
            else:
                equipping_time = 0
                if self.ActiveThrowID and self.ActiveThrowType:
                    self.ActiveItemID = 0
                    self.ActiveItemType = 0
                    self.cell.equipThrow(0, True)
                    unequipping_time = Durations.getThrowUnEquipDuration(self) * CharacterUtils.getEquipThrowModifier(self)
                elif self.ActiveItemID and self.ActiveItemType:
                    unequippedType = self.ActiveItemType
                    unequippedItemParams = ItemsCatalog.GetItemParam(unequippedType)
                    unequippingGunType = unequippedItemParams['GunType']
                    unequipping_time = Durations.GetEquipDuration(self, unequippingGunType)
                    self.ActiveItemID = 0
                    self.ActiveItemType = 0
                    self.DrawUnequipItem(unequippedType, equippedType, unequipping_time, equipping_time)
                    self.cell.equipItem(0)
                    self.updateShootingMode()
            return equipping_time + unequipping_time

