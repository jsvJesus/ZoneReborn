# Embedded file name: ./scripts/client/ClientTestTrigger.py
import BigWorld
import Math
import Pixie
import time
from ClientLightManager import lmanager
import client_lights
import client_lights.light
from client_lights.light import STATE_UND, STATE_OFF, STATE_ON

class ClientTestTrigger(BigWorld.Entity):
    """" client/ClientTestTrigger """

    def __init__(self):
        BigWorld.Entity.__init__(self)
        self._pl_hundle = 0
        self._last_enter_time = 0
        self.state = STATE_UND

    def onEnterWorld(self, prereqs):
        self.model = BigWorld.Model('')
        lmanager.createLights(self.targetNodes, self, self.DefaultState, self.onLoadUDO)

    def onLoadUDO(self):
        self.setState(self.DefaultState)
        self.initTrap()

    def initTrap(self):
        if self.TriggeredOnPlayer:
            self._pl_hundle = BigWorld.addPot(self.matrix, self.radius, self.onPlayerHitPot)

    def _drawRadius(self, radius):
        if not self.model:
            return
        else:
            self.model.addLineDraw(self.position, self.position + (0, 2, 0), (1, 1, 0, 1), 0)
            v = Math.Vector3()
            w = 0
            last = None
            segments = 20
            for x in range(segments + 1):
                w += 6.28 / segments
                v.setPitchYaw(0, w)
                pos1 = self.position + v * radius
                if last:
                    self.model.addLineDraw(last + (0, 0.05, 0), pos1 + (0, 0.05, 0), (1, 0, 0, 1), 0)
                last = pos1

            return

    def onPlayerHitPot(self, enteredTrap, handle):
        if enteredTrap:
            if time.time() - self._last_enter_time < self.ReUseOnEnterTime:
                return
            self._last_enter_time = time.time()
            if self.ChangeStateOnEnter != STATE_UND:
                self.setState(self.ChangeStateOnEnter)
        elif self.ChangeStateOnLeaveAll != STATE_UND:
            self.setState(self.ChangeStateOnLeaveAll)

    def setState(self, new_state):
        if new_state == STATE_UND:
            return
        self.state = new_state
        lmanager.setState(self.targetNodes, new_state, self.id)

    def onLeaveWorld(self):
        BigWorld.delPot(self._pl_hundle)
        lmanager.destroyLights([ udo.guid for udo in self.targetNodes ])
        self.model = None
        return