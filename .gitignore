__pycache__/
*.py[cod].new
*.log
*.tlog
.vscode/
.idea/

# Local credentials and environment files.
.env
.env.*
!.env.example

# Full client resources intentionally do not belong in this source archive.
game/
/src/.build/
packs/res/audio/
packs/res/models/
packs/res/textures/
user/webview2/
third_party/fmod/

!/src/x64/
/src/x64/*
!/src/.idea/
/src/.idea/*
!/src/server/x64/
/src/server/x64/*
!/src/client/x64/
/src/client/x64/*
!/src/core/x64/
/src/core/x64/*

*.dds
*.fsb
*.model
*.visual
*.animation
*.dll
*.exe
*.privkey
*.pdb
*.obj
*.iobj
*.zip
*.rar
*.lib
*.fla

# ============================================================
# WebView2 SDK
# Keep only headers + x64 static loader
# ============================================================

third_party/WebView2/*

!third_party/WebView2/build/
third_party/WebView2/build/*

!third_party/WebView2/build/native/
third_party/WebView2/build/native/*

# Headers
!third_party/WebView2/build/native/include/
!third_party/WebView2/build/native/include/**

# x64 static loader
!third_party/WebView2/build/native/x64/
third_party/WebView2/build/native/x64/*
!third_party/WebView2/build/native/x64/WebView2LoaderStatic.lib